@using System.Globalization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Wasla.Web.SharedResource> L
@{
    var requestPath = Context.Request.Path.Value ?? "/";
    var p = requestPath.TrimEnd('/');
    if (string.IsNullOrEmpty(p)) p = "/";
    var returnUrl = requestPath + (Context.Request.QueryString.HasValue ? Context.Request.QueryString.Value : "");
    var culture = CultureInfo.CurrentUICulture?.Name ?? "tr-TR";
    var isRtl = culture.StartsWith("ar", StringComparison.OrdinalIgnoreCase);
    var currentLangLabel = culture.StartsWith("en", StringComparison.OrdinalIgnoreCase)
        ? "English"
        : (isRtl ? "العربية" : "Türkçe");

    string AdminDash() => p == "/admin" ? "active" : "";
    string AdminCustomers() => requestPath.StartsWith("/admin/customers", StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<!DOCTYPE html>
<html lang="@culture" dir="@(isRtl ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Wasla") - @L["Layout.CentralAdmin"]</title>
    <script>
        (function () {
            try {
                var t = localStorage.getItem("Wasla.theme");
                if (t !== "dark" && t !== "light") t = "light";
                document.documentElement.setAttribute("data-bs-theme", t);
            } catch (e) { }
        })();
    </script>
    <!-- TODO: replace CDN links with local AdminLTE assets (wwwroot/theme/adminlte/) before production. -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@4.0.0-rc3/dist/css/adminlte.min.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/orderhub-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/orderhub-toast.css" asp-append-version="true" />
    @if (isRtl)
    {
        <link rel="stylesheet" href="~/css/rtl.css" asp-append-version="true" />
    }
</head>
<body class="layout-fixed sidebar-expand-lg oh-app" data-bs-theme="light">
    <div class="app-wrapper">
        <nav id="ohAppHeader" class="app-header navbar navbar-expand border-bottom">
            <div class="container-fluid d-flex flex-wrap align-items-center gap-2">
                <a class="navbar-brand text-decoration-none oh-sidebar-brand mb-0" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                    @L["Layout.CentralAdmin"]
                </a>
                <div class="ms-auto d-flex flex-wrap align-items-center gap-2">
                    <div class="dropdown">
                        <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-label="@L["Layout.Language"]">
                            <i class="bi bi-translate me-1"></i>@currentLangLabel
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <a class="dropdown-item" asp-controller="Culture" asp-action="Set" asp-route-culture="tr-TR" asp-route-returnUrl="@returnUrl">Türkçe</a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-controller="Culture" asp-action="Set" asp-route-culture="en-US" asp-route-returnUrl="@returnUrl">English</a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-controller="Culture" asp-action="Set" asp-route-culture="ar-SA" asp-route-returnUrl="@returnUrl">العربية</a>
                            </li>
                        </ul>
                    </div>
                    <button type="button" class="btn btn-outline-secondary btn-sm oh-theme-toggle" aria-pressed="false" aria-label="@L["Layout.Theme"]"
                            data-go-dark="@L["Layout.DarkMode"]" data-go-light="@L["Layout.LightMode"]">
                        <i class="bi bi-moon-stars oh-theme-moon"></i>
                        <i class="bi bi-sun oh-theme-sun d-none"></i>
                    </button>
                    <form method="post" asp-area="Admin" asp-controller="Auth" asp-action="Logout" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger">
                            <i class="bi bi-box-arrow-left me-1"></i>@L["Layout.Logout"]
                        </button>
                    </form>
                </div>
            </div>
        </nav>

        <aside class="app-sidebar" role="navigation" aria-label="Admin">
            <nav class="sidebar-menu p-3">
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link @AdminDash()" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                            <i class="bi bi-speedometer2 me-2"></i>@L["Layout.Dashboard"]
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @AdminCustomers()" asp-area="Admin" asp-controller="Customers" asp-action="Index">
                            <i class="bi bi-people me-2"></i>@L["Layout.Customers"]
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-box-arrow-up-right me-2"></i>@L["Layout.PublicSite"]
                        </a>
                    </li>
                </ul>
            </nav>
        </aside>

        <main class="app-main oh-content" role="main">
            <div class="app-content">
                <div class="container-fluid py-3">
                    @RenderBody()
                </div>
            </div>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
            crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/admin-lte@4.0.0-rc3/dist/js/adminlte.min.js" crossorigin="anonymous"></script>
    <script src="~/js/orderhub-toast.js" asp-append-version="true"></script>
    <partial name="~/Views/Shared/_Notifications.cshtml" />
    <script src="~/js/theme-mode.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
