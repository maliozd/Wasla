@model Wasla.Web.Areas.Admin.Models.CentralAdminDashboardViewModel
@using Microsoft.Extensions.Localization
@using Wasla.Domain.Enums
@inject IStringLocalizer<Wasla.Web.SharedResource> L
@{
    ViewData["Title"] = L["Admin.DashboardTitle"].Value;
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-4">
    <div>
        <h1 class="h4 mb-1">@L["Admin.DashboardTitle"]</h1>
        <p class="text-muted small mb-0">@L["Admin.BrandSubtitle"]</p>
    </div>
</div>

@* Tenant summary *@
<div class="row g-3 mb-3">
    <div class="col-sm-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-3 bg-primary bg-opacity-10 text-primary p-3">
                    <i class="bi bi-shop fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small">@L["Admin.TotalCustomers"]</div>
                    <div class="fs-3 fw-bold mb-0">@Model.TotalCustomers</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-3 bg-success bg-opacity-10 text-success p-3">
                    <i class="bi bi-check-circle fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small">@L["Admin.ActiveCustomers"]</div>
                    <div class="fs-3 fw-bold text-success mb-0">@Model.ActiveCustomers</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-3 bg-secondary bg-opacity-10 text-secondary p-3">
                    <i class="bi bi-pause-circle fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small">@L["Admin.InactiveCustomers"]</div>
                    <div class="fs-3 fw-bold text-secondary mb-0">@Model.InactiveCustomers</div>
                </div>
            </div>
        </div>
    </div>
</div>

@* Registration summary *@
<div class="row g-3 mb-4">
    <div class="col-sm-4">
        <a href="/admin/pending-registrations?filter=PendingPayment" class="text-decoration-none">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-warning bg-opacity-10 text-warning p-3">
                        <i class="bi bi-credit-card fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small">@L["Admin.RegPendingPayment"]</div>
                        <div class="fs-3 fw-bold mb-0">@Model.RegPendingPayment</div>
                    </div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-sm-4">
        <a href="/admin/pending-registrations?filter=PaymentReceivedSetupPending" class="text-decoration-none">
            <div class="card border-0 shadow-sm h-100 @(Model.RegPaymentReceivedSetupPending > 0 ? "border border-warning" : "")">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-3 @(Model.RegPaymentReceivedSetupPending > 0 ? "bg-warning bg-opacity-10 text-warning" : "bg-info bg-opacity-10 text-info") p-3">
                        <i class="bi bi-hourglass-split fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small">@L["Admin.RegPaymentReceivedSetupPending"]</div>
                        <div class="fs-3 fw-bold @(Model.RegPaymentReceivedSetupPending > 0 ? "text-warning" : "") mb-0">@Model.RegPaymentReceivedSetupPending</div>
                    </div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-sm-4">
        <a href="/admin/pending-registrations?filter=Provisioned" class="text-decoration-none">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-success bg-opacity-10 text-success p-3">
                        <i class="bi bi-cloud-check fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small">@L["Admin.RegProvisioned"]</div>
                        <div class="fs-3 fw-bold text-success mb-0">@Model.RegProvisioned</div>
                    </div>
                </div>
            </div>
        </a>
    </div>
</div>

@* Registrations requiring attention *@
@if (Model.AttentionRegistrations.Count > 0)
{
    <div class="card border-0 shadow-sm border-warning border-opacity-50 mb-4">
        <div class="card-header bg-white py-3 d-flex align-items-center justify-content-between">
            <span class="fw-semibold">
                <i class="bi bi-exclamation-triangle-fill text-warning me-2"></i>@L["Admin.Dashboard.RegistrationsNeedingAttention"]
            </span>
            <a class="btn btn-sm btn-outline-warning" href="/admin/pending-registrations?filter=PaymentReceivedSetupPending">@L["Admin.ViewAll"]</a>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead class="table-light">
                    <tr>
                        <th>@L["Admin.Name"]</th>
                        <th>@L["Admin.Slug"]</th>
                        <th>@L["Admin.PendingReg.Plan"]</th>
                        <th>@L["Admin.PendingReg.PaymentStatus"]</th>
                        <th>@L["Admin.CreatedAt"]</th>
                        <th class="text-end">@L["Admin.Actions"]</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var r in Model.AttentionRegistrations)
                    {
                        <tr>
                            <td class="fw-medium">@r.BusinessName</td>
                            <td><code class="small">@r.Slug</code></td>
                            <td class="small">@r.PlanCode / @r.BillingPeriod</td>
                            <td><span class="badge text-bg-success">@L["Admin.PendingReg.Status.PaymentSucceeded"]</span></td>
                            <td class="small text-muted">@r.CreatedAtUtc.ToString("yyyy-MM-dd")</td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-sm btn-outline-primary" href="/admin/pending-registrations/@r.Id">@L["Admin.Details"]</a>
                                @if (r.IsEligibleForProvisioning)
                                {
                                    <a class="btn btn-sm btn-warning" href="/admin/pending-registrations/@r.Id">@L["Admin.PendingReg.Provision"]</a>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@* Restaurants *@
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3 d-flex align-items-center justify-content-between">
        <span class="fw-semibold">@L["Admin.Customers"]</span>
        <a class="btn btn-sm btn-outline-primary" href="/admin/customers">@L["Admin.ViewAllRestaurants"]</a>
    </div>
    <div class="card-body p-0">
        @if (Model.RecentCustomers.Count == 0)
        {
            <div class="text-center text-muted py-5 px-3">
                <i class="bi bi-inbox fs-1 d-block mb-2 opacity-50"></i>
                <div class="fw-semibold">@L["Admin.NoCustomers"]</div>
                <div class="small">@L["Admin.NoCustomersHint"]</div>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead class="table-light">
                    <tr>
                        <th>@L["Admin.Name"]</th>
                        <th>@L["Admin.Slug"]</th>
                        <th>@L["Admin.PrimaryDomain"]</th>
                        <th>@L["Common.Status"]</th>
                        <th>@L["Admin.CreatedAt"]</th>
                        <th class="text-end">@L["Admin.Actions"]</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var c in Model.RecentCustomers)
                    {
                        <tr>
                            <td class="fw-medium">@c.Name</td>
                            <td><code class="small">@c.Slug</code></td>
                            <td class="small text-muted">@c.PrimaryDomain</td>
                            <td>
                                @if (c.IsActive)
                                {
                                    <span class="badge text-bg-success">@L["Admin.StatusActive"]</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">@L["Admin.StatusInactive"]</span>
                                }
                            </td>
                            <td class="small text-muted">@c.CreatedAt.ToString("yyyy-MM-dd")</td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-primary" href="/admin/customers/@c.Id">@L["Admin.Details"]</a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
