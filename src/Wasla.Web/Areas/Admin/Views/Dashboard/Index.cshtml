@model Wasla.Web.Areas.Admin.Models.TenantOperations.AdminOverviewViewModel
@using Microsoft.Extensions.Localization
@using Wasla.Web.Areas.Admin.Models.TenantOperations
@inject IStringLocalizer<Wasla.Web.SharedResource> L
@{
    ViewData["Title"] = L["Admin.Ops.OverviewTitle"].Value;
    var overview = Model.Overview;
}

<div class="wasla-admin-ops">
    <header class="d-flex flex-wrap align-items-end justify-content-between gap-2 mb-3">
        <div>
            <h1 class="h4 mb-1">@L["Admin.Ops.OverviewTitle"]</h1>
            <p class="text-body-secondary small mb-0">@L["Admin.Ops.OverviewSubtitle"]</p>
        </div>
        @if (overview is not null)
        {
            <p class="small text-body-secondary mb-0">@L["Admin.Ops.ReadAt"]: @AdminOperationsPresenter.Time(overview.ReadAtUtc)</p>
        }
    </header>

    @if (overview is null)
    {
        <partial name="_AdminLoadError" />
    }
    else
    {
        var tenants = overview.Tenants;
        var registrations = overview.Registrations;
        var fleet = overview.PrintBridge;

        <section class="mb-4" aria-labelledby="opsTenantsHeading">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                <h2 id="opsTenantsHeading" class="h6 text-uppercase text-body-secondary mb-0">@L["Admin.Ops.Section.Tenants"]</h2>
                <a class="small" href="/admin/customers">@L["Admin.ViewAllRestaurants"]</a>
            </div>
            <div class="row g-2 row-cols-2 row-cols-md-3 row-cols-xl-5">
                <div class="col">
                    <a class="wasla-admin-metric" href="/admin/customers">
                        <span class="wasla-admin-metric__label">@L["Admin.TotalCustomers"]</span>
                        <span class="wasla-admin-metric__value">@tenants.Total</span>
                    </a>
                </div>
                <div class="col">
                    <a class="wasla-admin-metric" href="/admin/customers?status=active">
                        <span class="wasla-admin-metric__label">@L["Admin.ActiveCustomers"]</span>
                        <span class="wasla-admin-metric__value">@tenants.Active</span>
                    </a>
                </div>
                <div class="col">
                    <a class="wasla-admin-metric" href="/admin/customers?status=inactive">
                        <span class="wasla-admin-metric__label">@L["Admin.InactiveCustomers"]</span>
                        <span class="wasla-admin-metric__value">@tenants.Inactive</span>
                    </a>
                </div>
                <div class="col">
                    <a class="wasla-admin-metric @(tenants.MigrationFailed > 0 ? "wasla-admin-metric--danger" : "")" href="/admin/customers?migration=failed">
                        <span class="wasla-admin-metric__label">@L["Admin.Ops.Metric.MigrationFailed"]</span>
                        <span class="wasla-admin-metric__value">@tenants.MigrationFailed</span>
                        @if (tenants.MigrationFailed > 0)
                        {
                            <span class="wasla-admin-metric__hint"><i class="bi bi-x-octagon" aria-hidden="true"></i> @L["Admin.Ops.Metric.NeedsAttention"]</span>
                        }
                    </a>
                </div>
                <div class="col">
                    <a class="wasla-admin-metric" href="/admin/customers?migration=not-recorded">
                        <span class="wasla-admin-metric__label">@L["Admin.Ops.Metric.MigrationNotRecorded"]</span>
                        <span class="wasla-admin-metric__value">@tenants.MigrationNotRecorded</span>
                    </a>
                </div>
            </div>
        </section>

        <section class="mb-4" aria-labelledby="opsSignupHeading">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                <h2 id="opsSignupHeading" class="h6 text-uppercase text-body-secondary mb-0">@L["Admin.Ops.Section.Signup"]</h2>
                <a class="small" href="/admin/pending-registrations">@L["Admin.ViewAll"]</a>
            </div>
            <div class="row g-2 row-cols-2 row-cols-md-3 row-cols-xl-5">
                <div class="col">
                    <a class="wasla-admin-metric" href="/admin/pending-registrations?filter=PendingPayment">
                        <span class="wasla-admin-metric__label">@L["Admin.RegPendingPayment"]</span>
                        <span class="wasla-admin-metric__value">@registrations.AwaitingPayment</span>
                    </a>
                </div>
                <div class="col">
                    <a class="wasla-admin-metric @(registrations.AwaitingProvisioning > 0 ? "wasla-admin-metric--warning" : "")" href="/admin/pending-registrations?filter=PaymentReceivedSetupPending">
                        <span class="wasla-admin-metric__label">@L["Admin.RegPaymentReceivedSetupPending"]</span>
                        <span class="wasla-admin-metric__value">@registrations.AwaitingProvisioning</span>
                        @if (registrations.OldestAwaitingProvisioningSinceUtc is { } oldest)
                        {
                            <span class="wasla-admin-metric__hint"><i class="bi bi-hourglass-split" aria-hidden="true"></i> @L["Admin.Ops.Metric.OldestWaiting", AdminOperationsPresenter.Age(oldest, overview.ReadAtUtc, L) ?? ""]</span>
                        }
                    </a>
                </div>
                <div class="col">
                    <div class="wasla-admin-metric @(registrations.PaymentFailed > 0 ? "wasla-admin-metric--warning" : "")">
                        <span class="wasla-admin-metric__label">@L["Admin.PendingReg.Status.PaymentFailed"]</span>
                        <span class="wasla-admin-metric__value">@registrations.PaymentFailed</span>
                    </div>
                </div>
                <div class="col">
                    <div class="wasla-admin-metric">
                        <span class="wasla-admin-metric__label">@L["Admin.Ops.Metric.ExpiredOrCancelled"]</span>
                        <span class="wasla-admin-metric__value">@registrations.ExpiredOrCancelled</span>
                    </div>
                </div>
                <div class="col">
                    <a class="wasla-admin-metric" href="/admin/pending-registrations?filter=Provisioned">
                        <span class="wasla-admin-metric__label">@L["Admin.RegProvisioned"]</span>
                        <span class="wasla-admin-metric__value">@registrations.Provisioned</span>
                    </a>
                </div>
            </div>
            <p class="small text-body-secondary mt-2 mb-0">@L["Admin.Ops.Signup.ProvisioningFailuresNotTracked"]</p>
        </section>

        <section class="mb-4" aria-labelledby="opsPrintBridgeHeading">
            <h2 id="opsPrintBridgeHeading" class="h6 text-uppercase text-body-secondary mb-2">@L["Admin.Ops.Section.PrintBridgeFleet"]</h2>
            <div class="row g-2 row-cols-2 row-cols-md-3 row-cols-xl-5">
                <div class="col">
                    <div class="wasla-admin-metric">
                        <span class="wasla-admin-metric__label"><i class="bi bi-wifi" aria-hidden="true"></i> @L["Admin.Ops.PrintBridge.Online"]</span>
                        <span class="wasla-admin-metric__value">@fleet.Online</span>
                    </div>
                </div>
                <div class="col">
                    <div class="wasla-admin-metric @(fleet.Stale > 0 ? "wasla-admin-metric--warning" : "")">
                        <span class="wasla-admin-metric__label"><i class="bi bi-hourglass-split" aria-hidden="true"></i> @L["Admin.Ops.PrintBridge.Stale"]</span>
                        <span class="wasla-admin-metric__value">@fleet.Stale</span>
                    </div>
                </div>
                <div class="col">
                    <div class="wasla-admin-metric @(fleet.Offline > 0 ? "wasla-admin-metric--danger" : "")">
                        <span class="wasla-admin-metric__label"><i class="bi bi-wifi-off" aria-hidden="true"></i> @L["Admin.Ops.PrintBridge.Offline"]</span>
                        <span class="wasla-admin-metric__value">@fleet.Offline</span>
                    </div>
                </div>
                <div class="col">
                    <div class="wasla-admin-metric">
                        <span class="wasla-admin-metric__label">@L["Admin.Ops.PrintBridge.NeverConnected"]</span>
                        <span class="wasla-admin-metric__value">@fleet.NeverConnected</span>
                    </div>
                </div>
                <div class="col">
                    <div class="wasla-admin-metric">
                        <span class="wasla-admin-metric__label">@L["Admin.Ops.PrintBridge.Disabled"]</span>
                        <span class="wasla-admin-metric__value">@fleet.Disabled</span>
                    </div>
                </div>
            </div>
            <p class="small text-body-secondary mt-2 mb-0">@L["Admin.Ops.PrintBridge.ThresholdNote"]</p>
        </section>

        @if (Model.AttentionRegistrations.Count > 0)
        {
            <section class="card wasla-admin-card mb-4" aria-labelledby="opsAttentionHeading">
                <div class="card-header d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <h2 id="opsAttentionHeading" class="h6 mb-0">
                        <i class="bi bi-exclamation-triangle text-warning-emphasis me-1" aria-hidden="true"></i>@L["Admin.Dashboard.RegistrationsNeedingAttention"]
                    </h2>
                    <a class="btn btn-sm btn-outline-secondary" href="/admin/pending-registrations?filter=PaymentReceivedSetupPending">@L["Admin.ViewAll"]</a>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                        <tr>
                            <th scope="col">@L["Admin.Name"]</th>
                            <th scope="col" class="d-none d-md-table-cell">@L["Admin.Slug"]</th>
                            <th scope="col" class="d-none d-lg-table-cell">@L["Admin.PendingReg.Plan"]</th>
                            <th scope="col">@L["Admin.PendingReg.PaymentSucceededAt"]</th>
                            <th scope="col" class="text-end"><span class="visually-hidden">@L["Admin.Actions"]</span></th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var r in Model.AttentionRegistrations)
                        {
                            <tr>
                                <td class="fw-medium">@r.BusinessName</td>
                                <td class="d-none d-md-table-cell"><code class="small">@r.Slug</code></td>
                                <td class="small d-none d-lg-table-cell">@r.PlanCode / @r.BillingPeriod</td>
                                <td class="small">@AdminOperationsPresenter.Time(r.PaymentSucceededAtUtc)</td>
                                <td class="text-end">
                                    <a class="btn btn-sm btn-outline-primary" href="/admin/pending-registrations/@r.Id">@L["Admin.Details"]<span class="visually-hidden">: @r.BusinessName</span></a>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </section>
        }

        <section class="card wasla-admin-card" aria-labelledby="opsRecentHeading">
            <div class="card-header d-flex flex-wrap align-items-center justify-content-between gap-2">
                <h2 id="opsRecentHeading" class="h6 mb-0">@L["Admin.Ops.RecentTenants"]</h2>
                <a class="btn btn-sm btn-outline-secondary" href="/admin/customers">@L["Admin.ViewAllRestaurants"]</a>
            </div>
            @if (overview.RecentTenants.Count == 0)
            {
                <div class="text-center text-body-secondary py-4 px-3">
                    <i class="bi bi-inbox fs-2 d-block mb-2" aria-hidden="true"></i>
                    <p class="fw-semibold mb-1">@L["Admin.NoCustomers"]</p>
                    <p class="small mb-0">@L["Admin.NoCustomersHint"]</p>
                </div>
            }
            else
            {
                <ul class="list-group list-group-flush">
                    @foreach (var t in overview.RecentTenants)
                    {
                        <li class="list-group-item d-flex flex-wrap align-items-center justify-content-between gap-2">
                            <div class="min-w-0">
                                <a class="fw-medium" href="/admin/customers/@t.Id">@t.Name</a>
                                <div class="small text-body-secondary"><code>@t.Slug</code> · @AdminOperationsPresenter.Time(t.CreatedAtUtc)</div>
                            </div>
                            <partial name="_AdminStatusBadge" model="AdminOperationsPresenter.TenantActive(t.IsActive)" />
                        </li>
                    }
                </ul>
            }
        </section>

        <p class="small text-body-secondary mt-3 mb-0"><i class="bi bi-info-circle" aria-hidden="true"></i> @L["Admin.Ops.OverviewCentralOnlyNote"]</p>
    }
</div>
