@model Wasla.Web.Areas.Admin.Models.AdminLoginViewModel
@using System.Globalization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Wasla.Web.SharedResource> L
@{
    Layout = null;
    var culture = CultureInfo.CurrentUICulture?.Name ?? "tr-TR";
    var isRtl = culture.StartsWith("ar", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="@culture" dir="@(isRtl ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@L["Admin.LoginTitle"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
    @if (isRtl)
    {
        <link rel="stylesheet" href="~/css/rtl.css" asp-append-version="true" />
    }
</head>
<body class="bg-light min-vh-100 d-flex align-items-center">
<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="text-center mb-4">
                <div class="d-inline-flex align-items-center justify-content-center oh-logo-mark rounded-3 mb-3">
                    <i class="bi bi-basket2-fill text-white fs-4"></i>
                </div>
                <h1 class="h4 mb-1">@L["Admin.LoginTitle"]</h1>
                <p class="text-muted small mb-0">@L["Admin.LoginSubtitle"]</p>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <div asp-validation-summary="ModelOnly" class="text-danger small"></div>

                    <form method="post" action="/admin/login">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ReturnUrl" />

                        <div class="mb-3">
                            <label class="form-label" asp-for="Email"></label>
                            <input class="form-control" asp-for="Email" autocomplete="username" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" asp-for="Password"></label>
                            <div class="input-group">
                                <input class="form-control" asp-for="Password" type="password" autocomplete="current-password" id="admin-login-password" />
                                <button class="btn btn-outline-secondary" type="button" id="admin-toggle-password"
                                        title="@L["Auth.ShowPassword"]"
                                        aria-label="@L["Auth.ShowPassword"]"
                                        data-show-label="@L["Auth.ShowPassword"]"
                                        data-hide-label="@L["Auth.HidePassword"]">
                                    <i class="bi bi-eye" id="admin-toggle-password-icon" aria-hidden="true"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="mb-3 form-check">
                            <input class="form-check-input" asp-for="RememberMe" />
                            <label class="form-check-label" asp-for="RememberMe">@L["Auth.RememberMe"]</label>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">@L["Auth.LoginButton"]</button>
                    </form>

                    <hr class="my-3" />
                    <div class="text-center">
                        <a class="btn btn-sm btn-outline-secondary" href="/">@L["Landing.BackToHome"]</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
        crossorigin="anonymous"></script>
@await Html.PartialAsync("_ValidationScriptsPartial")
<script>
(function () {
    var btn = document.getElementById('admin-toggle-password');
    var input = document.getElementById('admin-login-password');
    var icon = document.getElementById('admin-toggle-password-icon');
    if (!btn || !input || !icon) return;
    btn.addEventListener('click', function () {
        var isPassword = input.type === 'password';
        input.type = isPassword ? 'text' : 'password';
        icon.classList.toggle('bi-eye', !isPassword);
        icon.classList.toggle('bi-eye-slash', isPassword);
        var label = isPassword ? btn.dataset.hideLabel : btn.dataset.showLabel;
        btn.title = label;
        btn.setAttribute('aria-label', label);
    });
}());
</script>
</body>
</html>
