@model Wasla.Web.Models.TenantUsers.TenantUserDetailsViewModel
@{
    ViewData["Title"] = L["TenantUsers.DetailsTitle"];
}

<div class="oh-tenant-user-details-page">
    @await Html.PartialAsync("_CustomerPageHeader", new CustomerPageHeaderModel
    {
        Title = L["TenantUsers.DetailsTitle"].Value,
        Subtitle = Model.Email
    })

    @if (TempData["TenantUsersMessage"] is string message)
    {
        <div class="alert alert-success" role="alert">@message</div>
    }
    @if (TempData["TenantUsersError"] is string error)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }

    <div class="card oh-card mb-3">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">@L["TenantUsers.Name"]</dt>
                <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.FullName) ? "-" : Model.FullName)</dd>

                <dt class="col-sm-3">@L["TenantUsers.Email"]</dt>
                <dd class="col-sm-9">@Model.Email</dd>

                <dt class="col-sm-3">@L["TenantUsers.Role"]</dt>
                <dd class="col-sm-9">@L[$"TenantUsers.Role.{Model.Role}"]</dd>

                <dt class="col-sm-3">@L["TenantUsers.Status"]</dt>
                <dd class="col-sm-9">
                    <span class="badge @(Model.IsActive ? "text-bg-success" : "text-bg-secondary")">
                        @(Model.IsActive ? L["TenantUsers.Active"] : L["TenantUsers.Inactive"])
                    </span>
                </dd>

                <dt class="col-sm-3">@L["TenantUsers.CreatedAt"]</dt>
                <dd class="col-sm-9">@Model.CreatedAt.ToString("g")</dd>

                <dt class="col-sm-3">@L["TenantUsers.LastLogin"]</dt>
                <dd class="col-sm-9">@(Model.LastLoginAt?.ToString("g") ?? L["TenantUsers.LastLoginUnavailable"].Value)</dd>
            </dl>
        </div>
    </div>

    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-sm btn-outline-secondary" href="/settings/users">@L["TenantUsers.BackToUsers"]</a>
        <a class="btn btn-sm btn-primary"
           asp-area="Tenant"
           asp-controller="TenantUsers"
           asp-action="Edit"
           asp-route-id="@Model.Id">
            @L["TenantUsers.Edit"]
        </a>
        @if (Model.IsActive)
        {
            <form method="post"
                  asp-area="Tenant"
                  asp-controller="TenantUsers"
                  asp-action="Deactivate"
                  asp-route-id="@Model.Id">
                @Html.AntiForgeryToken()
                <button class="btn btn-sm btn-outline-danger" type="submit">@L["TenantUsers.Deactivate"]</button>
            </form>
        }
        else
        {
            <form method="post"
                  asp-area="Tenant"
                  asp-controller="TenantUsers"
                  asp-action="Activate"
                  asp-route-id="@Model.Id">
                @Html.AntiForgeryToken()
                <button class="btn btn-sm btn-outline-success" type="submit">@L["TenantUsers.Activate"]</button>
            </form>
        }
    </div>
</div>
