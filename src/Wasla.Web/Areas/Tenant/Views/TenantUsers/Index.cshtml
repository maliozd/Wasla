@model Wasla.Web.Models.TenantUsers.TenantUsersViewModel
@using Wasla.Domain.Enums
@{
    ViewData["Title"] = L["TenantUsers.Title"];
}

<div class="oh-tenant-users-page">
    @await Html.PartialAsync("_CustomerPageHeader", new CustomerPageHeaderModel
    {
        Title = L["TenantUsers.Title"].Value,
        Subtitle = L["TenantUsers.Subtitle"].Value
    })

    @if (TempData["TenantUsersMessage"] is string message)
    {
        <div class="alert alert-success" role="alert">@message</div>
    }
    @if (TempData["TenantUsersError"] is string error)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }

    <div class="d-flex justify-content-end mb-3">
        <a class="btn btn-sm btn-primary" href="/settings/users/create">@L["TenantUsers.AddUser"]</a>
    </div>

    <div class="card oh-card">
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead>
                    <tr>
                        <th>@L["TenantUsers.Name"]</th>
                        <th>@L["TenantUsers.Email"]</th>
                        <th>@L["TenantUsers.Role"]</th>
                        <th>@L["TenantUsers.Status"]</th>
                        <th>@L["TenantUsers.CreatedAt"]</th>
                        <th>@L["TenantUsers.LastLogin"]</th>
                        <th class="text-end">@L["TenantUsers.Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.Users)
                    {
                        <tr>
                            <td>@(string.IsNullOrWhiteSpace(user.FullName) ? "-" : user.FullName)</td>
                            <td>@user.Email</td>
                            <td>@L[$"TenantUsers.Role.{user.Role}"]</td>
                            <td>
                                <span class="badge @(user.IsActive ? "text-bg-success" : "text-bg-secondary")">
                                    @(user.IsActive ? L["TenantUsers.Active"] : L["TenantUsers.Inactive"])
                                </span>
                            </td>
                            <td>@user.CreatedAt.ToString("g")</td>
                            <td>@(user.LastLoginAt?.ToString("g") ?? L["TenantUsers.LastLoginUnavailable"].Value)</td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-primary"
                                   asp-area="Tenant"
                                   asp-controller="TenantUsers"
                                   asp-action="Details"
                                   asp-route-id="@user.Id">
                                    @L["TenantUsers.Details"]
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
