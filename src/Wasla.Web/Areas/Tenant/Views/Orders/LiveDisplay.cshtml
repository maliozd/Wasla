@model Wasla.Web.Models.Orders.OrderListViewModel
@using System.Collections.Generic
@using System.Text.Json
@using Microsoft.Extensions.Localization
@using Wasla.Web.Security
@inject IStringLocalizer<Wasla.Web.SharedResource> L
@inject ITenantNavigationAuthorizationService TenantNavigation
@{
    Layout = "_OrdersDisplayLayout";
    ViewData["Title"] = L["Orders.LiveDisplay.Title"];
    var today = Model.TurkeyLocalToday;
    var customerName = ViewData["CustomerName"] as string;
    var navPermissions = await TenantNavigation.GetPermissionsAsync(User);
}

<div id="ordersLiveDisplayRoot" class="oh-orders-live-display-root oh-live-screen-page">
    <header class="oh-live-display-header oh-fs-header">
        <div class="oh-live-display-header__left oh-fs-header__left">
            @if (!string.IsNullOrWhiteSpace(customerName))
            {
                <div class="oh-live-display-header__brand text-muted small mb-1">@customerName</div>
            }
            <h1 class="oh-live-display-header__title oh-fs-header__title mb-0">@L["Orders.LiveDisplay.Title"]</h1>
            <p class="oh-live-display-header__subtitle text-muted small mb-0">@L["Orders.LiveDisplay.Subtitle"]</p>
            <p class="oh-live-display-header__meta oh-fs-header__meta mb-0">
                <span>@L["Orders.Today"] — @today.ToString("d", System.Globalization.CultureInfo.CurrentCulture)</span>
                <span class="oh-fs-header__sep" aria-hidden="true">·</span>
                <span>@L["Orders.LiveDisplay.LastUpdated"]: <span id="ordersLiveDisplayLastUpdated">-</span></span>
            </p>
        </div>
        <div class="oh-live-display-header__actions oh-fs-header__actions d-flex flex-wrap align-items-center gap-2">
            @* Operational automation status belongs to the live service view, not the Orders search page. *@
            <div class="oh-orders-status-group" aria-label="@L["Settings.OrderSettings.Title"]">
                <span id="automationStatusSync" class="oh-orders-status-chip oh-orders-status-chip--muted">…</span>
                <span id="automationStatusAutoApprove" class="oh-orders-status-chip oh-orders-status-chip--muted">…</span>
                <span id="automationStatusReceipt" class="oh-orders-status-chip oh-orders-status-chip--muted">…</span>
            </div>
            @if (navPermissions.CanManageOrderSettings)
            {
                <a class="orders-manage-settings" href="/settings/orders" target="_blank" rel="noopener noreferrer">@L["Orders.ManageSettings"]</a>
            }
            <div class="btn-group btn-group-sm oh-live-screen-view-switch" role="group" aria-label="@L["Orders.ViewMode.Label"]">
                <button type="button" class="btn btn-outline-secondary" data-live-screen-view="cards" aria-pressed="true">@L["Orders.LiveScreen.ViewCards"]</button>
                <button type="button" class="btn btn-outline-secondary" data-live-screen-view="list" aria-pressed="false">@L["Orders.LiveScreen.ViewList"]</button>
            </div>
            <p class="oh-live-display-fullscreen-hint text-muted small mb-0">
                @L["Orders.LiveDisplay.FullscreenHintPrefix"]
                <kbd class="oh-live-display-kbd">F11</kbd>
                @L["Orders.LiveDisplay.FullscreenHintSuffix"]
            </p>
            <button type="button" id="ordersLiveDisplayClose" class="btn btn-outline-primary btn-sm oh-live-display-close-btn">
                @L["Orders.LiveDisplay.CloseDisplay"]
            </button>
        </div>
    </header>

    <div class="oh-live-display-summary oh-fs-summary row g-3">
        <div class="col-12 col-md-4">
            <div class="oh-fs-stat">
                <div class="oh-fs-stat__label">@L["Orders.TodaysOrders"]</div>
                <div class="oh-fs-stat__value" id="ordersLiveDisplayTodayCount">@Model.TotalCount</div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="oh-fs-stat">
                <div class="oh-fs-stat__label">@L["Orders.ActiveOrders"]</div>
                <div class="oh-fs-stat__value" id="ordersLiveDisplayActiveCount">0</div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="oh-fs-stat">
                <div class="oh-fs-stat__label">@L["Orders.CancelledOrders"]</div>
                <div class="oh-fs-stat__value" id="ordersLiveDisplayCancelledCount">0</div>
            </div>
        </div>
    </div>

    @* One card DOM tree; the view switch only changes its layout class, so nothing is rendered twice. *@
    <div id="ordersLiveScreenHost" class="oh-live-screen-host oh-live-screen-host--cards" data-live-screen-view="cards" aria-live="polite">
        @await Html.PartialAsync("_LiveScreenOrders", Model)
    </div>
</div>

<div class="modal fade" id="ordersLiveDetailModal" tabindex="-1" aria-hidden="true" aria-labelledby="ordersLiveDetailModalTitle">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h6 mb-0" id="ordersLiveDetailModalTitle">@L["Orders.Details.Title"]</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["Common.Close"]"></button>
            </div>
            <div class="modal-body" id="ordersLiveDetailModalBody">
                <p class="text-muted small mb-0">@L["Common.Loading"]</p>
            </div>
        </div>
    </div>
</div>

<form id="ordersLiveDisplayCsrfForm" class="d-none">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    <script>
        window.orderHubOrdersOptions = {
            pageMode: "liveDisplay",
            tableUrl: "/orders/table",
            liveScreenUrl: "/orders/live-screen",
            notificationSettingsUrl: "/notification-settings",
            notificationSettingsJsonUrl: "/notification-settings/current",
            orderSyncSettingsUrl: "/orders/sync-settings",
            orderSettingsUrl: "/orders/order-settings",
            orderDetailPanelUrl: "/orders/{id}/detail-panel",
            viewModeStorageKey: "Wasla.liveScreen.viewMode",
            defaultViewMode: "kitchen",
            pollingIntervalMs: 10000,
            todayYmd: "@today.ToString("yyyy-MM-dd")",
            liveDisplayPageSize: 100,
            defaultFoodImage: "/images/demo-food/chicken-rice-01.svg",
            messages: @Html.Raw(JsonSerializer.Serialize(new Dictionary<string, string>
            {
                ["genericError"] = L["Orders.GenericError"].Value,
                ["alertClose"] = L["Common.Close"].Value,
                ["newOrderArrived"] = L["Notification.NewOrderArrived"].Value,
                ["checkOrdersPage"] = L["Notification.CheckOrdersPage"].Value,
                ["soundUnlockHint"] = L["Notification.SoundUnlockHint"].Value,
                ["audioNotAllowed"] = L["Orders.AudioNotAllowed"].Value,
                ["audioPlayFailed"] = L["Orders.AudioPlayFailed"].Value,
                ["audioFileError"] = L["Orders.AudioFileError"].Value,
                ["notificationSettingsLoadFailed"] = L["Orders.NotificationSettingsLoadFailed"].Value,
                ["notificationSettingsUnexpectedFormat"] = L["Orders.NotificationSettingsUnexpectedFormat"].Value,
                ["notificationSettingsLoadException"] = L["Orders.NotificationSettingsLoadException"].Value,
                ["automationStatusSyncActive"] = L["Orders.AutomationStatus.SyncActive"].Value,
                ["automationStatusSyncDisabled"] = L["Orders.AutomationStatus.SyncDisabled"].Value,
                ["automationStatusAutoApproveActive"] = L["Orders.AutomationStatus.AutoApproveActive"].Value,
                ["automationStatusAutoApproveDisabled"] = L["Orders.AutomationStatus.AutoApproveDisabled"].Value,
                ["automationStatusReceiptPrintingActive"] = L["Orders.AutomationStatus.ReceiptPrintingActive"].Value,
                ["automationStatusReceiptPrintingDisabled"] = L["Orders.AutomationStatus.ReceiptPrintingDisabled"].Value,
                ["liveScreenDetailLoadFailed"] = L["Orders.LiveScreen.DetailLoadFailed"].Value,
                ["commonLoading"] = L["Common.Loading"].Value,
                ["tableRefreshFailed"] = L["Orders.TableRefreshFailed"].Value,
                ["tableReturnedFullPage"] = L["Orders.TableReturnedFullPage"].Value,
                ["tableMissingDataOrderId"] = L["Orders.TableMissingDataOrderId"].Value,
                ["tableHostMissing"] = L["Orders.TableHostMissing"].Value,
                ["tableRefreshException"] = L["Orders.TableRefreshException"].Value,
                ["ordersApproveConfirmTitle"] = L["Orders.ApproveConfirmTitle"].Value,
                ["ordersApproveConfirmMessage"] = L["Orders.ApproveConfirmMessage"].Value,
                ["ordersRejectConfirmTitle"] = L["Orders.RejectConfirmTitle"].Value,
                ["ordersRejectConfirmMessage"] = L["Orders.RejectConfirmMessage"].Value,
                ["ordersApproveSuccess"] = L["Orders.ApproveSuccess"].Value,
                ["ordersApproveFailed"] = L["Orders.ApproveFailed"].Value,
                ["ordersRejectSuccess"] = L["Orders.RejectSuccess"].Value,
                ["ordersRejectFailed"] = L["Orders.RejectFailed"].Value,
                ["ordersInvalidStatusForAction"] = L["Orders.InvalidStatusForAction"].Value,
                ["ordersActionFailed"] = L["Orders.ActionFailed"].Value,
                ["ordersOrderActionFailed"] = L["Orders.OrderActionFailed"].Value,
                ["ordersStartPreparingConfirmTitle"] = L["Orders.StartPreparingConfirmTitle"].Value,
                ["ordersStartPreparingConfirmMessage"] = L["Orders.StartPreparingConfirmMessage"].Value,
                ["ordersMarkReadyConfirmTitle"] = L["Orders.MarkReadyConfirmTitle"].Value,
                ["ordersMarkReadyConfirmMessage"] = L["Orders.MarkReadyConfirmMessage"].Value,
                ["ordersHandToCourierConfirmTitle"] = L["Orders.HandToCourierConfirmTitle"].Value,
                ["ordersHandToCourierConfirmMessage"] = L["Orders.HandToCourierConfirmMessage"].Value,
                ["ordersMarkDeliveredConfirmTitle"] = L["Orders.MarkDeliveredConfirmTitle"].Value,
                ["ordersMarkDeliveredConfirmMessage"] = L["Orders.MarkDeliveredConfirmMessage"].Value,
                ["ordersStartPreparingSuccess"] = L["Orders.StartPreparingSuccess"].Value,
                ["ordersMarkReadySuccess"] = L["Orders.MarkReadySuccess"].Value,
                ["ordersHandToCourierSuccess"] = L["Orders.HandToCourierSuccess"].Value,
                ["ordersMarkDeliveredSuccess"] = L["Orders.MarkDeliveredSuccess"].Value,
                ["noLiveOrders"] = L["Orders.NoLiveOrders"].Value,
                ["noLiveOrdersDescription"] = L["Orders.NoLiveOrdersDescription"].Value,
                ["itemsMore"] = L["Orders.ItemsMore"].Value,
                ["ordersFullscreenCustomer"] = L["Orders.Customer"].Value,
                ["ordersFullscreenTotal"] = L["Orders.TotalAmount"].Value,
                ["ordersFullscreenReceived"] = L["Orders.ReceivedAt"].Value
            }))
        };
    </script>
    <script src="~/js/orders/orders-core.js" asp-append-version="true"></script>
    <script src="~/js/orders/orders-audio.js" asp-append-version="true"></script>
    <script src="~/js/orders/orders-notification-settings.js" asp-append-version="true"></script>
    <script src="~/js/orders/orders-automation-status.js" asp-append-version="true"></script>
    <script src="~/js/orders/orders-table.js" asp-append-version="true"></script>
    <script src="~/js/orders/orders-actions.js" asp-append-version="true"></script>
    <script src="~/js/orders/orders-live-view.js" asp-append-version="true"></script>
    <script src="~/js/orders/orders-live-detail-modal.js" asp-append-version="true"></script>
    <script src="~/js/orders/orders-live-display-page.js" asp-append-version="true"></script>
}
