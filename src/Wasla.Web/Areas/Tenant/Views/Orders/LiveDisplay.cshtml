                ["boardCompleted"] = L["Orders.LiveScreen.Completed"].Value,
                ["boardEmpty"] = L["Orders.LiveScreen.EmptyColumn"].Value,
                ["groupShowing"] = L["Orders.LiveScreen.GroupShowing"].Value,
                ["groupShowMore"] = L["Orders.LiveScreen.GroupShowMore"].Value,
                ["columnOrder"] = L["Orders.LiveScreen.ColumnOrder"].Value,
                ["columnElapsed"] = L["Orders.LiveScreen.ColumnElapsed"].Value,
                ["columnProducts"] = L["Orders.Products"].Value,
                ["noLiveOrdersDescription"] = L["Orders.NoLiveOrdersDescription"].Value,
                ["itemsMore"] = L["Orders.ItemsMore"].Value,
                ["boardItemsMore"] = L["Orders.LiveScreen.BoardItemsMore"].Value,
                ["boardItemsHidden"] = L["Orders.LiveScreen.BoardItemsHidden"].Value,
                ["ordersFullscreenCustomer"] = L["Orders.Customer"].Value,
                ["ordersFullscreenTotal"] = L["Orders.TotalAmount"].Value,
