@model Wasla.Web.Models.Orders.OrderListViewModel
@using System.Collections.Generic
@using System.Text.Json
@using Microsoft.Extensions.Localization
@using Wasla.Application.Time
@using Wasla.Web.Security
@inject IStringLocalizer<Wasla.Web.SharedResource> L
@inject ITenantNavigationAuthorizationService TenantNavigation
@inject Wasla.Web.Realtime.LiveScreenPolling LivePolling
@{
    Layout = "_OrdersDisplayLayout";
    ViewData["Title"] = L["Orders.LiveDisplay.Title"];
    var today = Model.TurkeyLocalToday;
    var customerName = ViewData["CustomerName"] as string;
    var restaurantLogoUrl = ViewData["RestaurantLogoUrl"] as string;
    var restaurantLogoBackgroundClass = ViewData["RestaurantLogoBackgroundClass"] as string;
    var navPermissions = await TenantNavigation.GetPermissionsAsync(User);
    var timeZoneId = TimeZoneHelper.ResolveTurkeyTimeZone().Id;
    if (timeZoneId == "Turkey Standard Time")
    {
        timeZoneId = "Europe/Istanbul";
    }
}

<div id="ordersLiveDisplayRoot" class="wasla-orders-live-display-root wasla-live-screen-page">
    <header class="wasla-live-display-header wasla-fs-header">
        <div class="wasla-live-display-header__left wasla-fs-header__left">
            <div class="wasla-live-display-identity">
                @* The restaurant's logo when it has one, otherwise (or when it cannot be loaded, restaurant-logo.js) the
                   storefront icon. Decorative: the restaurant name beside it names the restaurant. Rendered once with the
                   page; polling never touches it. The Owner's background style is a CSS class (wasla-logo-bg--*), so a
                   theme switch restyles it without requesting the image again. *@
                @if (!string.IsNullOrEmpty(restaurantLogoUrl))
                {
                    <span class="wasla-live-display-identity__mark wasla-live-display-identity__mark--logo @restaurantLogoBackgroundClass" aria-hidden="true" data-restaurant-logo-mark>
                        <img class="wasla-live-display-identity__logo" src="@restaurantLogoUrl" alt="" width="48" height="48" decoding="async" data-restaurant-logo />
                        <i class="bi bi-shop" data-restaurant-logo-fallback hidden></i>
                    </span>
                }
                else
                {
                    <span class="wasla-live-display-identity__mark" aria-hidden="true"><i class="bi bi-shop"></i></span>
                }
                <div class="wasla-live-display-identity__copy">
                    <div class="wasla-live-display-identity__heading">
                        @if (!string.IsNullOrWhiteSpace(customerName))
                        {
                            <h1 class="wasla-live-display-header__title wasla-fs-header__title mb-0">@customerName</h1>
                        }
                        @* Platform synchronization as the server reports it on each snapshot (orders-platform-sync-status.js);
                           never "Live" until the backend says so. The words carry the state; the dot and icon are decorative. *@
                        <span id="ordersLiveDisplaySyncStatus" class="wasla-live-display-status wasla-live-display-status--pending" data-sync-state="pending" role="status">
                            <span class="wasla-live-display-status__dot" aria-hidden="true"></span>
                            <i class="wasla-live-display-status__icon bi" aria-hidden="true" hidden></i>
                            <span data-sync-status-text>@L["Common.Loading"]</span>
                        </span>
                    </div>
                    <p class="wasla-live-display-header__meta wasla-fs-header__meta mb-0">
                        <span>@L["Orders.Today"] @today.ToString("m", System.Globalization.CultureInfo.CurrentCulture)</span>
                        <span class="wasla-fs-header__sep" aria-hidden="true"></span>
                        <span>@L["Orders.LiveDisplay.LastUpdated"] <span id="ordersLiveDisplayLastUpdated">-</span></span>
                        <span id="ordersLiveDisplayLastSyncItem" class="wasla-live-display-last-sync" hidden>
                            <span class="wasla-fs-header__sep" aria-hidden="true"></span>
                            <span>@L["Orders.LiveDisplay.LastSync"] <time id="ordersLiveDisplayLastSync"></time></span>
                        </span>
                        <span id="ordersLiveDisplayConnection" class="wasla-live-display-connection" role="status" hidden></span>
                    </p>
                </div>
            </div>
        </div>
        <div class="wasla-live-display-header__actions wasla-fs-header__actions">
            @* On narrower screens only the key stays visible; the words remain for screen readers and as the tooltip. *@
            <p class="wasla-live-display-fullscreen-hint mb-0" title="@L["Orders.LiveDisplay.FullscreenHintPrefix"] F11 @L["Orders.LiveDisplay.FullscreenHintSuffix"]">
                <span class="wasla-live-display-fullscreen-hint__text">@L["Orders.LiveDisplay.FullscreenHintPrefix"]</span>
                <kbd class="wasla-live-display-kbd">F11</kbd>
                <span class="wasla-live-display-fullscreen-hint__text">@L["Orders.LiveDisplay.FullscreenHintSuffix"]</span>
            </p>
            <button type="button"
                    id="ordersLiveDisplayStopSound"
                    class="btn btn-sm btn-outline-secondary text-nowrap wasla-live-display-stop-sound-btn"
                    hidden>
                <i class="bi bi-volume-mute me-1" aria-hidden="true"></i>
                <span>@L["Notification.StopSoundButton"]</span>
            </button>
            <div class="wasla-live-screen-view-switch" role="group" aria-label="@L["Orders.ViewMode.Label"]" data-tour="live-view-selector">
                <button type="button" class="wasla-live-screen-view-switch__option" data-live-screen-view="board" aria-pressed="true">
                    <i class="bi bi-layout-three-columns" aria-hidden="true"></i>
                    <span>@L["Orders.LiveScreen.ViewBoard"]</span>
                </button>
                <button type="button" class="wasla-live-screen-view-switch__option" data-live-screen-view="list" aria-pressed="false">
                    <i class="bi bi-view-stacked" aria-hidden="true"></i>
                    <span>@L["Orders.LiveScreen.ViewList"]</span>
                </button>
                <button type="button" class="wasla-live-screen-view-switch__option" data-live-screen-view="focus" aria-pressed="false">
                    <i class="bi bi-layout-sidebar" aria-hidden="true"></i>
                    <span>@L["Orders.LiveScreen.ViewFocus"]</span>
                </button>
            </div>
            @* Operational status stays on the live screen, inside one settings menu. The gear is named by its aria-label
               (also its tooltip); the menu opens under it, aligned to its end. *@
            <div class="dropdown wasla-live-settings">
                <button type="button"
                        class="wasla-live-settings__toggle"
                        id="ordersLiveDisplaySettingsToggle"
                        data-bs-toggle="dropdown"
                        data-bs-display="static"
                        data-bs-auto-close="true"
                        aria-expanded="false"
                        aria-haspopup="true"
                        aria-controls="ordersLiveDisplaySettingsMenu"
                        aria-label="@L["Layout.Settings"]"
                        title="@L["Layout.Settings"]">
                    <i class="bi bi-gear" aria-hidden="true"></i>
                </button>
                <div class="dropdown-menu wasla-live-settings-menu"
                     id="ordersLiveDisplaySettingsMenu"
                     aria-labelledby="ordersLiveDisplaySettingsToggle">
                    <div class="wasla-live-settings-menu__status" aria-label="@L["Settings.OrderSettings.Title"]">
                        @* Two labelled groups: what runs automatically, then how new orders get attention. Values are read-only;
                           each heading row carries its compact Settings action (named "Settings" plus the group heading). *@
                        <div class="wasla-live-settings-menu__group" role="group" aria-labelledby="ordersLiveSettingsAutomationHeading">
                            <div class="wasla-live-settings-menu__heading-row">
                                <p class="wasla-live-settings-menu__heading" id="ordersLiveSettingsAutomationHeading">@L["Orders.LiveSettings.AutomationGroup"]</p>
                                @if (navPermissions.CanManageOrderSettings)
                                {
                                    @* Automation is configured on /settings/orders, behind the order-settings policy. *@
                                    <a class="wasla-live-settings-menu__action"
                                       id="ordersLiveDisplayAutomationSettings"
                                       href="/settings/orders"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       aria-labelledby="ordersLiveDisplayAutomationSettingsLabel ordersLiveSettingsAutomationHeading">
                                        <i class="bi bi-sliders" aria-hidden="true"></i>
                                        <span id="ordersLiveDisplayAutomationSettingsLabel">@L["Layout.Settings"]</span>
                                    </a>
                                }
                            </div>
                            <div class="wasla-live-settings-menu__row">
                                <span class="wasla-live-settings-menu__label">@L["Settings.OrderSynchronization.Title"]</span>
                                <span id="automationStatusSync" class="wasla-live-settings-menu__value wasla-orders-status-chip--muted">…</span>
                            </div>
                            <div class="wasla-live-settings-menu__row">
                                <span class="wasla-live-settings-menu__label">@L["Settings.AutoApproval.Title"]</span>
                                <span id="automationStatusAutoApprove" class="wasla-live-settings-menu__value wasla-orders-status-chip--muted">…</span>
                            </div>
                            <div class="wasla-live-settings-menu__row">
                                <span class="wasla-live-settings-menu__label">@L["Settings.ReceiptPrinting.Title"]</span>
                                <span id="automationStatusReceipt" class="wasla-live-settings-menu__value wasla-orders-status-chip--muted">…</span>
                            </div>
                            @* Shown while an automation is configured on but waits for setup; pending indicators point to it. *@
                            <p id="automationPendingSetupHint" class="wasla-live-settings-menu__hint" hidden>@L["Orders.Automation.PendingSetupDescription"]</p>
                        </div>
                        <div class="wasla-live-settings-menu__group" role="group" aria-labelledby="ordersLiveSettingsNotificationsHeading">
                            <div class="wasla-live-settings-menu__heading-row">
                                <p class="wasla-live-settings-menu__heading" id="ordersLiveSettingsNotificationsHeading">@L["Notification.Notifications"]</p>
                                @* Every Live Screen user sets their own sound, browser notification and highlight here (WAS-13): the
                                   shared notification settings modal, saved per user. *@
                                <button type="button"
                                        class="wasla-live-settings-menu__action"
                                        id="ordersLiveDisplayNotificationSettings"
                                        data-notification-settings-open
                                        aria-labelledby="ordersLiveDisplayNotificationSettingsLabel ordersLiveSettingsNotificationsHeading">
                                    <i class="bi bi-sliders" aria-hidden="true"></i>
                                    <span id="ordersLiveDisplayNotificationSettingsLabel">@L["Layout.Settings"]</span>
                                </button>
                            </div>
                            <div class="wasla-live-settings-menu__row">
                                <span class="wasla-live-settings-menu__label">@L["Orders.LiveDisplay.NotificationSound"]</span>
                                <span id="ordersLiveDisplaySoundStatus"
                                      class="wasla-live-settings-menu__value wasla-orders-status-chip--muted"
                                      data-label-active="@L["Common.Active"]"
                                      data-label-disabled="@L["Notification.Disabled"]">…</span>
                            </div>
                            <div id="ordersLiveDisplaySoundActive"
                                 class="wasla-live-display-sound-active"
                                 role="status"
                                 hidden>
                                <i class="bi bi-volume-up" aria-hidden="true"></i>
                                <span>@L["Notification.SoundActive"]</span>
                            </div>
                        </div>
                    </div>
                    @* The way back to the app: Kitchen and Cashier land here after sign-in and the screen has no other navigation.
                       It lives in this menu so the header stays clear in fullscreen; orders-live-display-page.js binds it by id. *@
                    <div class="wasla-live-settings-menu__footer">
                        <button type="button" id="ordersLiveDisplayClose" class="wasla-live-settings-menu__exit">
                            <i class="bi bi-box-arrow-left" aria-hidden="true"></i>
                            <span>@L["Orders.LiveDisplay.CloseDisplay"]</span>
                        </button>
                    </div>
                </div>
            </div>
            <span class="wasla-live-display-brand">
                @await Html.PartialAsync("_WaslaLogo", new Wasla.Web.Models.Ui.WaslaLogoModel { CssClass = "wasla-logo--live-screen" })
            </span>
        </div>
    </header>

    @* Today's figures on one line, each as icon, count and label; read-only, not a control. The board's columns carry
       the per-status counts. orders-live-store.js writes the counts in the page culture's number format and marks a 0
       with is-zero (quiet colours); active and cancelled start at 0 until the first snapshot. *@
    <div class="wasla-live-display-summary">
        <div class="wasla-live-summary">
            <div class="wasla-live-summary__metric@(Model.TotalCount == 0 ? " is-zero" : null)">
                <span class="wasla-live-summary__icon wasla-live-summary__icon--today" aria-hidden="true"></span>
                <span class="wasla-live-summary__value" id="ordersLiveDisplayTodayCount">@Model.TotalCount</span>
                <span class="wasla-live-summary__label">@L["Orders.TodaysOrders"]</span>
            </div>
            <div class="wasla-live-summary__metric is-zero">
                <span class="wasla-live-summary__icon wasla-live-summary__icon--active" aria-hidden="true"></span>
                <span class="wasla-live-summary__value" id="ordersLiveDisplayActiveCount">0</span>
                @* During order training the board holds only the practice order: this count is the real orders waiting
                   outside it, and its label says so (the store keeps it in step with each snapshot). *@
                <span class="wasla-live-summary__label" id="ordersLiveDisplayActiveLabel">@(Model.GuidedTraining is null ? L["Orders.ActiveOrders"] : L["Orders.LiveScreen.WaitingRealOrders"])</span>
            </div>
            <div class="wasla-live-summary__metric wasla-live-summary__metric--cancelled is-zero">
                <span class="wasla-live-summary__icon wasla-live-summary__icon--cancelled" aria-hidden="true"></span>
                <span class="wasla-live-summary__value" id="ordersLiveDisplayCancelledCount">0</span>
                <span class="wasla-live-summary__label">@L["Orders.CancelledOrders"]</span>
            </div>
        </div>
    </div>

    <div id="ordersLiveDisplaySoundBanner"
         class="wasla-live-display-sound-banner alert alert-warning border-0 shadow-sm d-none"
         role="status"
         hidden>
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div class="wasla-live-display-sound-banner__copy">
                <div class="fw-semibold">@L["Notification.SoundMayBeOffTitle"]</div>
                <div class="small mb-0">@L["Notification.SoundMayBeOffDescription"]</div>
            </div>
            <button type="button"
                    id="ordersLiveDisplayEnableNotificationSound"
                    class="btn btn-sm btn-primary text-nowrap wasla-orders-sound-enable-btn">
                <i class="bi bi-volume-up me-1" aria-hidden="true"></i>
                <span data-sound-enable-label>@L["Notification.EnableSoundButton"]</span>
            </button>
        </div>
    </div>

    @if (Model.GuidedTraining is not null)
    {
        @await Html.PartialAsync("_GuidedTrainingPanel", Model.GuidedTraining)
    }

    @* The first validated snapshot renders only the selected view. *@
    <div id="ordersLiveScreenHost" class="wasla-live-screen-host wasla-live-screen-host--board" data-live-screen-view="board" data-tour="live-orders" tabindex="-1" role="region" aria-label="@L["Orders.LiveDisplay.Title"]">
        <p data-live-loading role="status" class="text-muted p-3">@L["Common.Loading"]</p>
    </div>
</div>

<div class="modal fade" id="ordersLiveDetailModal" tabindex="-1" aria-hidden="true" aria-labelledby="ordersLiveDetailModalTitle">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h6 mb-0" id="ordersLiveDetailModalTitle">@L["Orders.Details.Title"]</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["Common.Close"]"></button>
            </div>
            <div class="modal-body" id="ordersLiveDetailModalBody">
                <p class="text-muted small mb-0">@L["Common.Loading"]</p>
            </div>
        </div>
    </div>
</div>

@await Html.PartialAsync("_NotificationSettingsModalShell")

<form id="ordersLiveDisplayCsrfForm" class="d-none">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    <script>
        window.waslaOrdersOptions = {
            pageMode: "liveDisplay",
            tableUrl: "/orders/table",
            liveDataUrl: "/orders/live-data",
            canManageOrders: @(navPermissions.CanManageOrders ? "true" : "false"),
            displayCulture: "@System.Globalization.CultureInfo.CurrentUICulture.Name",
            timeZoneId: "@timeZoneId",
            notificationSettingsUrl: "/notification-settings",
            notificationSettingsJsonUrl: "/notification-settings/current",
            orderDetailPanelUrl: "/orders/{id}/detail-panel",
            orderPrintUrl: "/orders/{id}/print",
            orderPrintStateUrl: "/orders/{id}/print-state",
            // Every Live Screen user receives order invalidation (WAS-24); the hub adds print status only for CanManualPrint.
            realtimeHubUrl: @Html.Raw(JsonSerializer.Serialize(Wasla.Web.Realtime.TenantEventsHub.Path)),
            viewModeStorageKey: "Wasla.liveScreen.viewMode",
            defaultViewMode: "kitchen",
            pollingIntervalMs: @LivePolling.IntervalMs.ToString(System.Globalization.CultureInfo.InvariantCulture),
            // Lower while connected only when this Web receives Worker and Api changes (WAS-103).
            connectedPollingIntervalMs: @LivePolling.ConnectedIntervalMs.ToString(System.Globalization.CultureInfo.InvariantCulture),
            todayYmd: "@Wasla.Application.Orders.OrdersReceivedAtQueryRange.FormatWebDate(today)",
            liveDisplayPageSize: 100,
            defaultFoodImage: "/images/demo-food/chicken-rice-01.svg",
            messages: @Html.Raw(JsonSerializer.Serialize(new Dictionary<string, string>
            {
                ["genericError"] = L["Orders.GenericError"].Value,
                ["alertClose"] = L["Common.Close"].Value,
                ["newOrderArrived"] = L["Notification.NewOrderArrived"].Value,
                ["checkOrdersPage"] = L["Notification.CheckOrdersPage"].Value,
                ["soundUnlockHint"] = L["Notification.SoundUnlockHint"].Value,
                ["enableNotificationSound"] = L["Notification.EnableSoundButton"].Value,
                ["soundActive"] = L["Notification.SoundActive"].Value,
                ["soundMayBeOffTitle"] = L["Notification.SoundMayBeOffTitle"].Value,
                ["soundMayBeOffDescription"] = L["Notification.SoundMayBeOffDescription"].Value,
                ["stopSound"] = L["Notification.StopSoundButton"].Value,
                ["audioNotAllowed"] = L["Orders.AudioNotAllowed"].Value,
                ["audioPlayFailed"] = L["Orders.AudioPlayFailed"].Value,
                ["audioFileError"] = L["Orders.AudioFileError"].Value,
                ["notificationSettingsLoadFailed"] = L["Orders.NotificationSettingsLoadFailed"].Value,
                ["notificationSettingsUnexpectedFormat"] = L["Orders.NotificationSettingsUnexpectedFormat"].Value,
                ["notificationSettingsLoadException"] = L["Orders.NotificationSettingsLoadException"].Value,
                ["notificationSettingsModalOpenFailed"] = L["Orders.NotificationSettingsModalOpenFailed"].Value,
                ["notificationSettingsSaveFailed"] = L["Orders.NotificationSettingsSaveFailed"].Value,
                ["notificationSettingsSaveException"] = L["Orders.NotificationSettingsSaveException"].Value,
                ["settingsSaved"] = L["Notification.SettingsSaved"].Value,
                ["settingsSaveFailed"] = L["Notification.SettingsSaveFailed"].Value,
                ["notificationsOff"] = L["Notification.Disabled"].Value,
                ["notificationsOffHelp"] = L["Notification.NotificationsHelp"].Value,
                ["waitingForAudio"] = L["Notification.WaitingForBrowserAudio"].Value,
                ["waitingForAudioHelp"] = L["Notification.NotificationsHelp"].Value,
                ["notificationsOn"] = L["Notification.Enabled"].Value,
                ["notificationsOnHelp"] = L["Notification.NotificationsHelp"].Value,
                ["automationStatusSyncActive"] = L["Common.Active"].Value,
                ["automationStatusSyncDisabled"] = L["Notification.Disabled"].Value,
                ["automationStatusAutoApproveActive"] = L["Common.Active"].Value,
                ["automationStatusAutoApproveDisabled"] = L["Notification.Disabled"].Value,
                ["automationStatusReceiptPrintingActive"] = L["Common.Active"].Value,
                ["automationStatusReceiptPrintingDisabled"] = L["Notification.Disabled"].Value,
                ["automationStatusPendingSetup"] = L["Orders.Automation.PendingSetup"].Value,
                ["syncStatusLive"] = L["Orders.LiveDisplay.LiveStatus"].Value,
                ["syncStatusNotConnected"] = L["Orders.LiveDisplay.SyncStatus.NotConnected"].Value,
                ["syncStatusSyncDisabled"] = L["Orders.LiveDisplay.SyncStatus.SyncDisabled"].Value,
                ["syncStatusIssue"] = L["Orders.LiveDisplay.SyncStatus.Issue"].Value,
                ["syncStatusIssueWithPlatforms"] = L["Orders.LiveDisplay.SyncStatus.IssueWithPlatforms"].Value,
                ["demoCountdownPickUp"] = L["Orders.DemoCountdown.PickUp"].Value,
                ["demoCountdownDeliver"] = L["Orders.DemoCountdown.Deliver"].Value,
                ["demoCountdownLeave"] = L["Orders.DemoCountdown.Leave"].Value,
                ["demoCountdownWaiting"] = L["Orders.DemoCountdown.Waiting"].Value,
