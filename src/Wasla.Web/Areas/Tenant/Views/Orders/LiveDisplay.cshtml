                ["liveScreenCountUnavailable"] = L["Orders.LiveScreen.CountUnavailable"].Value,
                ["liveScreenActiveOrders"] = L["Orders.ActiveOrders"].Value,
                ["liveScreenWaitingRealOrders"] = L["Orders.LiveScreen.WaitingRealOrders"].Value,
                ["ordersApprove"] = L["Orders.Approve"].Value,
                ["ordersReject"] = L["Orders.Reject"].Value,
                ["ordersStartPreparing"] = L["Orders.StartPreparing"].Value,
                ["ordersMarkReady"] = L["Orders.MarkReady"].Value,
                ["ordersActions"] = L["Orders.Actions"].Value,
                ["viewDetails"] = L["Orders.History.ViewDetails"].Value,
                ["selectOrder"] = L["Orders.LiveScreen.SelectOrder"].Value,
                ["selectOrderDescription"] = L["Orders.LiveScreen.SelectOrderDescription"].Value,
                ["noDisplayableOrders"] = L["Orders.LiveScreen.NoDisplayableOrders"].Value,
                ["noDisplayableOrdersDescription"] = L["Orders.LiveScreen.NoDisplayableOrdersDescription"].Value,
                ["noPracticeOrder"] = L["Orders.LiveScreen.NoPracticeOrder"].Value,
                ["noPracticeOrderDescription"] = L["Orders.LiveScreen.NoPracticeOrderDescription"].Value,
                ["backToQueue"] = L["Orders.LiveScreen.BackToQueue"].Value,
                ["detailRetry"] = L["Orders.LiveScreen.DetailRetry"].Value,
                ["focusQueue"] = L["Orders.LiveScreen.Queue"].Value,
                ["statusNewBadge"] = L["Orders.StatusNewBadge"].Value,
                ["statusNew"] = L["OrderStatus.New"].Value,
