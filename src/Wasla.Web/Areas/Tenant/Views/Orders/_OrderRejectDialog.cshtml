@using Wasla.Application.Orders
@using Wasla.Domain.Enums
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Wasla.Web.SharedResource> L
@* The one reject dialog of the Orders page and the Live Screen. orders-actions.js opens it for a Reject button whose
   order's platform has reasons (data-order-platform), shows only that platform's group, preselects nothing and posts
   the chosen reasonId. Platforms without reasons use the shared confirmation. The server checks the reason again
   against the stored order's platform. *@
<div class="modal fade wasla-order-reject-dialog" id="ordersRejectDialog" tabindex="-1"
     aria-labelledby="ordersRejectDialogTitle" aria-describedby="ordersRejectDialogBody" aria-hidden="true"
     data-order-reject-dialog>
    <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content" novalidate data-order-reject-form>
            <div class="modal-header">
                <h2 class="modal-title h5" id="ordersRejectDialogTitle">@L["Orders.RejectConfirmTitle"]</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["Confirm.Cancel"]"></button>
            </div>
            <div class="modal-body">
                <div class="wasla-confirm-identity" data-order-reject-identity hidden></div>
                <div class="alert alert-warning small mb-0 py-2" role="status" hidden data-order-reject-stale></div>
                <p id="ordersRejectDialogBody" data-order-reject-context>@L["Orders.RejectConfirmMessage"]</p>
                @foreach (var platform in Enum.GetValues<FoodPlatform>().Where(p => OrderRejectReasons.For(p).Count > 0))
                {
                    <fieldset class="mb-2" data-order-reject-reasons="@platform" hidden disabled
                              aria-describedby="ordersRejectDialogHint ordersRejectDialogError">
                        <legend class="form-label fw-semibold fs-6 mb-2">@L["Orders.RejectReason.Legend"]</legend>
                        @foreach (var reasonId in OrderRejectReasons.For(platform))
                        {
                            var inputId = $"ordersRejectReason-{platform}-{reasonId}";
                            <div class="form-check py-1">
                                <input class="form-check-input" type="radio" name="reasonId" id="@inputId" value="@reasonId" />
                                <label class="form-check-label" for="@inputId">@L[OrderRejectReasons.LabelKey(platform, reasonId)]</label>
                            </div>
                        }
                    </fieldset>
                }
                <p class="form-text mb-0" id="ordersRejectDialogHint" data-order-reject-context>@L["Orders.RejectReason.SentToPlatform"]</p>
                <p class="text-danger small fw-semibold mt-2 mb-0" id="ordersRejectDialogError" role="alert" hidden data-order-reject-error>@L["Orders.RejectReasonRequired"]</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@L["Confirm.Cancel"]</button>
                <button type="submit" class="btn btn-danger" data-order-reject-confirm>@L["Orders.Reject"]</button>
            </div>
        </form>
    </div>
</div>
