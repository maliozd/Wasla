@model Wasla.Web.Models.Orders.OrderListViewModel
@using Wasla.Domain.Enums
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using Wasla.Web.Security
@inject IStringLocalizer<Wasla.Web.SharedResource> L
@inject IAuthorizationService AuthorizationService

@{
    var f = Model.Filters;
    var canManageOrders = (await AuthorizationService.AuthorizeAsync(User, TenantPolicies.CanManageOrders)).Succeeded;
    string StatusLabel(OrderStatus s) => L[$"OrderStatus.{s}"];
}

<div class="orders-table-meta d-none" data-total-count="@Model.TotalCount"></div>

<div class="table-responsive">
    <table class="table table-sm align-middle mb-0 oh-orders-table">
        <thead>
        <tr>
            <th>@SortHeader("platform", L["Orders.Platform"])</th>
            <th>@L["Orders.OrderCode"]</th>
            <th>@SortHeader("customerName", L["Orders.Customer"])</th>
            <th>@SortHeader("status", L["Orders.Status"])</th>
            <th class="text-end">@SortHeader("totalAmount", L["Orders.TotalAmount"])</th>
            <th class="text-end">@SortHeader("receivedAt", L["Orders.ReceivedAt"])</th>
            <th class="text-end">@L["Orders.Actions"]</th>
        </tr>
        </thead>
        <tbody>
        @if (Model.Orders.Count == 0)
        {
            <tr>
                <td colspan="7" class="text-center text-muted py-4">
                    @(Model.UseSimpleNoOrdersMessage ? L["Orders.NoOrdersFound"] : L["Orders.NoFilteredOrdersFound"])
                </td>
            </tr>
        }
        else
        {
            @foreach (var o in Model.Orders)
            {
                <tr data-order-id="@o.Id"
                    data-order-status="@o.Status"
                    data-received-at="@o.ReceivedAtUtc.ToString("O")"
                    data-display-image="@o.DisplayImageUrl"
                    data-item-count="@o.ItemCount"
                    data-first-product="@o.FirstProductName">
                    <td>
                        @await Html.PartialAsync("_PlatformBadge", (Platform: (object?)o.Platform, DisplayName: (string?)null))
                    </td>
                    <td>
                        <a href="/orders/details/@o.Id">@o.ExternalOrderCode</a>
                        <span class="order-sound-indicator d-none" data-order-speaker="@o.Id" title="@L["Orders.SoundPlayingTitle"]">
                            <i class="bi bi-volume-up"></i>
                        </span>
                    </td>
                    <td>@o.CustomerName</td>
                    <td>
                        <span class="me-2">@StatusLabel(o.Status)</span>
                        <span class="badge text-bg-primary d-none oh-orders-new-badge" data-new-badge>@L["Orders.StatusNewBadge"]</span>
                    </td>
                    <td class="text-end">@o.TotalAmount.ToString("C")</td>
                    <td class="text-end">@o.ReceivedAtLocal.ToString("g")</td>
                    <td class="text-end">
                        @await Html.PartialAsync("_OrderLifecycleActions", new Wasla.Web.Models.Orders.OrderLifecycleActionsModel
                        {
                            OrderId = o.Id,
                            Status = o.Status,
                            CanManageOrders = canManageOrders,
                            ButtonSizeClass = "btn-sm"
                        })
                    </td>
                </tr>
            }
        }
        </tbody>
    </table>
</div>

@functions{
    private static string BuildOrdersUrl(IEnumerable<KeyValuePair<string, string>> pairs)
    {
        var list = pairs
            .Where(p => !string.IsNullOrWhiteSpace(p.Value))
            .Select(p => $"{Uri.EscapeDataString(p.Key)}={Uri.EscapeDataString(p.Value)}")
            .ToList();

        return list.Count == 0 ? "/orders" : "/orders?" + string.Join("&", list);
    }

    private Microsoft.AspNetCore.Html.IHtmlContent SortHeader(string sortBy, string title)
    {
        var currentBy = Model.Filters.SortBy;
        var currentDir = Model.Filters.SortDirection;

        var nextDir = "asc";
        if (string.Equals(currentBy, sortBy, StringComparison.OrdinalIgnoreCase))
        {
            nextDir = string.Equals(currentDir, "asc", StringComparison.OrdinalIgnoreCase) ? "desc" : "asc";
        }
        else
        {
            nextDir = sortBy == "receivedAt" ? "desc" : "asc";
        }

        var arrow = string.Empty;
        if (string.Equals(currentBy, sortBy, StringComparison.OrdinalIgnoreCase))
        {
            arrow = string.Equals(currentDir, "asc", StringComparison.OrdinalIgnoreCase) ? " ↑" : " ↓";
        }

        var pairs = new List<KeyValuePair<string, string>>();
        if (Model.Filters.Platform.HasValue) pairs.Add(new("platform", Model.Filters.Platform.Value.ToString()));
        if (Model.Filters.Status.HasValue) pairs.Add(new("status", Model.Filters.Status.Value.ToString()));
        if (Model.Filters.StartDate.HasValue) pairs.Add(new("startDate", Model.Filters.StartDate.Value.ToString("yyyy-MM-dd")));
        if (Model.Filters.EndDate.HasValue) pairs.Add(new("endDate", Model.Filters.EndDate.Value.ToString("yyyy-MM-dd")));
        pairs.Add(new("page", "1"));
        pairs.Add(new("pageSize", Model.Filters.PageSize.ToString()));
        pairs.Add(new("sortBy", sortBy));
        pairs.Add(new("sortDirection", nextDir));

        var href = BuildOrdersUrl(pairs);
        var html = $"<a href=\"{href}\">{System.Net.WebUtility.HtmlEncode(title)}{arrow}</a>";
        return new Microsoft.AspNetCore.Html.HtmlString(html);
    }
}

