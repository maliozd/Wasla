@model Wasla.Web.Models.Orders.OrderListViewModel
@using Wasla.Domain.Enums
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using Wasla.Web.Models.Ui
@using Wasla.Web.Security
@inject IStringLocalizer<Wasla.Web.SharedResource> L
@inject IAuthorizationService AuthorizationService

@{
    var canManageOrders = (await AuthorizationService.AuthorizeAsync(User, TenantPolicies.CanManageOrders)).Succeeded;
}

<div class="orders-table-meta d-none" data-total-count="@Model.TotalCount"></div>

@* Shared tenant table (wasla-table): sortable headers are server-side links; on phones rows stack with cell labels. *@
<div class="wasla-table-wrap">
    <table class="wasla-table wasla-table--stack wasla-table--stack-lg wasla-table--sortable wasla-orders-table">
        <caption class="visually-hidden">@L["Orders.Title"]</caption>
        <thead>
        <tr>
            @await Html.PartialAsync("_OrderListSortHeaderLink", new OrderListSortHeaderModel(Model.ListBasePath, Model.Filters, "platform", L["Orders.Platform"].Value))
            <th scope="col">@L["Orders.OrderCode"]</th>
            @await Html.PartialAsync("_OrderListSortHeaderLink", new OrderListSortHeaderModel(Model.ListBasePath, Model.Filters, "customerName", L["Orders.Customer"].Value))
            @await Html.PartialAsync("_OrderListSortHeaderLink", new OrderListSortHeaderModel(Model.ListBasePath, Model.Filters, "status", L["Orders.Status"].Value))
            @await Html.PartialAsync("_OrderListSortHeaderLink", new OrderListSortHeaderModel(Model.ListBasePath, Model.Filters, "totalAmount", L["Orders.TotalAmount"].Value, IsNumeric: true))
            @await Html.PartialAsync("_OrderListSortHeaderLink", new OrderListSortHeaderModel(Model.ListBasePath, Model.Filters, "receivedAt", L["Orders.ReceivedAt"].Value, IsNumeric: true))
            <th scope="col" class="wasla-table__actions">@L["Orders.Actions"]</th>
        </tr>
        </thead>
        <tbody>
        @if (Model.Orders.Count == 0)
        {
            <tr class="wasla-table__empty-row">
                <td colspan="7">
                    <div class="wasla-table__empty">
                        <i class="bi bi-inbox" aria-hidden="true"></i>
                        <span>@(Model.UseSimpleNoOrdersMessage ? L["Orders.NoOrdersFound"] : L["Orders.NoFilteredOrdersFound"])</span>
                    </div>
                </td>
            </tr>
        }
        else
        {
            @foreach (var o in Model.Orders)
            {
                <tr data-order-id="@o.Id"
                    data-order-status="@o.Status"
                    data-received-at="@o.ReceivedAtUtc.ToString("O")"
                    data-display-image="@o.DisplayImageUrl"
                    data-item-count="@o.ItemCount"
                    data-first-product="@o.FirstProductName">
                    <td>
                        <span class="wasla-table__cell-label" aria-hidden="true">@L["Orders.Platform"]</span>
                        @await Html.PartialAsync("_PlatformBadge", (Platform: (object?)o.Platform, DisplayName: (string?)null))
                    </td>
                    <td class="wasla-table__primary">
                        <span class="wasla-table__cell-label" aria-hidden="true">@L["Orders.OrderCode"]</span>
                        <span>
                            <a class="wasla-table__link" href="/orders/details/@o.Id">@o.ExternalOrderCode</a>
                            <span class="order-sound-indicator d-none" data-order-speaker="@o.Id" title="@L["Orders.SoundPlayingTitle"]">
                                <i class="bi bi-volume-up"></i>
                            </span>
                        </span>
                    </td>
                    <td class="wasla-table__truncate">
                        <span class="wasla-table__cell-label" aria-hidden="true">@L["Orders.Customer"]</span>
                        <span dir="auto" title="@o.CustomerName">@o.CustomerName</span>
                    </td>
                    <td>
                        <span class="wasla-table__cell-label" aria-hidden="true">@L["Orders.Status"]</span>
                        <span class="wasla-table__status">
                            @await Html.PartialAsync("_OrderStatusBadge", new OrderStatusBadgeModel(o.Status))
                            <span class="badge text-bg-primary d-none wasla-orders-new-badge" data-new-badge>@L["Orders.StatusNewBadge"]</span>
                        </span>
                    </td>
                    <td class="wasla-table__num wasla-table__amount">
                        <span class="wasla-table__cell-label" aria-hidden="true">@L["Orders.TotalAmount"]</span>
                        <span>@o.TotalAmount.ToString("C")</span>
                    </td>
                    <td class="wasla-table__num wasla-table__muted wasla-table__datetime">
                        <span class="wasla-table__cell-label" aria-hidden="true">@L["Orders.ReceivedAt"]</span>
                        @await Html.PartialAsync("_ReceivedAtTime", new ReceivedAtTimeModel(o.ReceivedAtUtc, o.ReceivedAtLocal, Model.TurkeyLocalToday))
                    </td>
                    <td class="wasla-table__actions">
                        @await Html.PartialAsync("_OrderLifecycleActions", new Wasla.Web.Models.Orders.OrderLifecycleActionsModel
                        {
                            OrderId = o.Id,
                            Status = o.Status,
                            CanManageOrders = canManageOrders,
                            ButtonSizeClass = "btn-sm"
                        })
                    </td>
                </tr>
            }
        }
        </tbody>
    </table>
</div>

@* Inside the refreshed fragment so page indicator and links stay consistent after a lifecycle action. *@
@await Html.PartialAsync("_OrderListPagination", Model)
