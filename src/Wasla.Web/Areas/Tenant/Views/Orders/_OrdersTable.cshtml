@model Wasla.Web.Models.Orders.OrderListViewModel
@using Wasla.Domain.Enums
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using Wasla.Web.Models.Ui
@using Wasla.Web.Security
@inject IStringLocalizer<Wasla.Web.SharedResource> L
@inject IAuthorizationService AuthorizationService

@{
    var canManageOrders = (await AuthorizationService.AuthorizeAsync(User, TenantPolicies.CanManageOrders)).Succeeded;
    string StatusLabel(OrderStatus s) => L[$"OrderStatus.{s}"];
}

<div class="orders-table-meta d-none" data-total-count="@Model.TotalCount"></div>

<div class="table-responsive">
    <table class="table table-sm align-middle mb-0 wasla-orders-table">
        <thead>
        <tr>
            <th>@await Html.PartialAsync("_OrderListSortHeaderLink", new OrderListSortHeaderModel(Model.ListBasePath, Model.Filters, "platform", L["Orders.Platform"].Value))</th>
            <th>@L["Orders.OrderCode"]</th>
            <th>@await Html.PartialAsync("_OrderListSortHeaderLink", new OrderListSortHeaderModel(Model.ListBasePath, Model.Filters, "customerName", L["Orders.Customer"].Value))</th>
            <th>@await Html.PartialAsync("_OrderListSortHeaderLink", new OrderListSortHeaderModel(Model.ListBasePath, Model.Filters, "status", L["Orders.Status"].Value))</th>
            <th class="text-end">@await Html.PartialAsync("_OrderListSortHeaderLink", new OrderListSortHeaderModel(Model.ListBasePath, Model.Filters, "totalAmount", L["Orders.TotalAmount"].Value))</th>
            <th class="text-end">@await Html.PartialAsync("_OrderListSortHeaderLink", new OrderListSortHeaderModel(Model.ListBasePath, Model.Filters, "receivedAt", L["Orders.ReceivedAt"].Value))</th>
            <th class="text-end">@L["Orders.Actions"]</th>
        </tr>
        </thead>
        <tbody>
        @if (Model.Orders.Count == 0)
        {
            <tr>
                <td colspan="7" class="text-center text-muted py-4">
                    @(Model.UseSimpleNoOrdersMessage ? L["Orders.NoOrdersFound"] : L["Orders.NoFilteredOrdersFound"])
                </td>
            </tr>
        }
        else
        {
            @foreach (var o in Model.Orders)
            {
                <tr data-order-id="@o.Id"
                    data-order-status="@o.Status"
                    data-received-at="@o.ReceivedAtUtc.ToString("O")"
                    data-display-image="@o.DisplayImageUrl"
                    data-item-count="@o.ItemCount"
                    data-first-product="@o.FirstProductName">
                    <td>
                        @await Html.PartialAsync("_PlatformBadge", (Platform: (object?)o.Platform, DisplayName: (string?)null))
                    </td>
                    <td>
                        <a href="/orders/details/@o.Id">@o.ExternalOrderCode</a>
                        <span class="order-sound-indicator d-none" data-order-speaker="@o.Id" title="@L["Orders.SoundPlayingTitle"]">
                            <i class="bi bi-volume-up"></i>
                        </span>
                    </td>
                    <td>@o.CustomerName</td>
                    <td>
                        <span class="me-2">@StatusLabel(o.Status)</span>
                        <span class="badge text-bg-primary d-none wasla-orders-new-badge" data-new-badge>@L["Orders.StatusNewBadge"]</span>
                    </td>
                    <td class="text-end">@o.TotalAmount.ToString("C")</td>
                    <td class="text-end">@o.ReceivedAtLocal.ToString("g")</td>
                    <td class="text-end">
                        @await Html.PartialAsync("_OrderLifecycleActions", new Wasla.Web.Models.Orders.OrderLifecycleActionsModel
                        {
                            OrderId = o.Id,
                            Status = o.Status,
                            CanManageOrders = canManageOrders,
                            ButtonSizeClass = "btn-sm"
                        })
                    </td>
                </tr>
            }
        }
        </tbody>
    </table>
</div>

@* Inside the refreshed fragment so page indicator and links stay consistent after a lifecycle action. *@
@await Html.PartialAsync("_OrderListPagination", Model)
