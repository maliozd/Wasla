    </script>
    <script src="~/js/orders/orders-core.js" asp-append-version="true"></script>
    <script src="~/js/orders/orders-audio.js" asp-append-version="true"></script>
    <script src="~/js/orders/orders-sound-control.js" asp-append-version="true"></script>
    <script src="~/js/orders/orders-notification-settings.js" asp-append-version="true"></script>
    <script src="~/js/orders/orders-automation-status.js" asp-append-version="true"></script>
    <script src="~/js/orders/orders-view-mode.js" asp-append-version="true"></script>
    <script src="~/js/orders/orders-open-live-display.js" asp-append-version="true"></script>
    <script src="~/js/orders/orders-table.js" asp-append-version="true"></script>
    <script src="~/js/orders/orders-actions.js" asp-append-version="true"></script>
    <script src="~/js/orders/orders-page.js" asp-append-version="true"></script>
}

