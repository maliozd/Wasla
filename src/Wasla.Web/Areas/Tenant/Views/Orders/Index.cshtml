@model Wasla.Web.Models.Orders.OrderListViewModel
@using System.Collections.Generic
@using System.Text.Json
@using Wasla.Domain.Enums
@using Microsoft.Extensions.Localization
@using Wasla.Web.Security
@inject IStringLocalizer<Wasla.Web.SharedResource> L
@inject ITenantNavigationAuthorizationService TenantNavigation
@{
    ViewData["Title"] = L["Orders.Title"];
    var f = Model.Filters;
    var today = Model.TurkeyLocalToday;
    var navPermissions = await TenantNavigation.GetPermissionsAsync(User);
    string StatusLabel(OrderStatus s) => L[$"OrderStatus.{s}"];
}

<div class="wasla-orders-page">
<div class="orders-page-header">
    <div class="orders-page-header__main">
        <h1 class="orders-page-header__title">@L["Orders.Title"]</h1>
        <p class="orders-page-header__subtitle">@L["Orders.Subtitle"]</p>
        <p class="orders-page-header__subtitle">
            @L["Orders.Today"] — @today.ToString("d")
        </p>
    </div>
    <div class="orders-page-header__metric orders-total-card">
        <span class="orders-page-header__metric-value orders-total-card__number" id="ordersTotalCount">@Model.TotalCount</span>
        <span class="orders-page-header__metric-label orders-total-card__label">@L["Orders.History.TotalResults"]</span>
    </div>
</div>

@if (navPermissions.CanViewLiveScreen)
{
    <div class="orders-toolbar">
        <div class="orders-toolbar-right ms-auto">
            @* Live Screen is the operational display and opens in its own tab. *@
            <a class="btn btn-sm btn-primary text-nowrap" href="/orders/live-display"
               target="_blank" rel="noopener noreferrer" title="@L["Orders.OpenLiveDisplay"]">
                <i class="bi bi-display me-1" aria-hidden="true"></i>@L["Orders.OpenLiveDisplay"]
            </a>
        </div>
    </div>
}

<div id="ordersMessageHost"></div>

<div id="ordersFiltersPanel" class="card wasla-card mb-3 wasla-orders-filters">
    <div class="card-body">
        <form id="ordersFilterForm" method="get" action="/orders" class="row g-3 align-items-end">
            <div class="col-12 col-md-6 col-lg-3">
                <label class="form-label" for="platformSelect">@L["Orders.Platform"]</label>
                <select id="platformSelect" class="form-select" name="platform">
                    <option value="">@L["Common.AllPlatforms"]</option>
                    @foreach (var p in Enum.GetValues<FoodPlatform>())
                    {
                        if (f.Platform == p)
                        {
                            <option value="@p" selected>@p</option>
                        }
                        else
                        {
                            <option value="@p">@p</option>
                        }
                    }
                </select>
            </div>
            <div class="col-12 col-md-6 col-lg-3">
                <label class="form-label" for="statusSelect">@L["Orders.Status"]</label>
                <select id="statusSelect" class="form-select" name="status">
                    <option value="">@L["Common.AllStatuses"]</option>
                    @foreach (var s in Enum.GetValues<OrderStatus>())
                    {
                        if (f.Status == s)
                        {
                            <option value="@s" selected>@StatusLabel(s)</option>
                        }
                        else
                        {
                            <option value="@s">@StatusLabel(s)</option>
                        }
                    }
                </select>
            </div>
            <div class="col-12 col-md-4 col-lg-2">
                <label class="form-label" for="ordersStartDate">@L["Orders.StartDate"]</label>
                <input id="ordersStartDate" class="form-control" type="date" name="startDate" value="@(f.StartDate?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-12 col-md-4 col-lg-2">
                <label class="form-label" for="ordersEndDate">@L["Orders.EndDate"]</label>
                <input id="ordersEndDate" class="form-control" type="date" name="endDate" value="@(f.EndDate?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-12 col-md-4 col-lg-2">
                <label class="form-label" for="ordersPageSize">@L["Orders.History.PageSize"]</label>
                <select id="ordersPageSize" class="form-select" name="pageSize">
                    @foreach (var size in new[] { 25, 50, 100 })
                    {
                        if (f.PageSize == size)
                        {
                            <option value="@size" selected>@size</option>
                        }
                        else
                        {
                            <option value="@size">@size</option>
                        }
                    }
                </select>
            </div>
            <div class="col-12 col-lg-8">
                <label class="form-label" for="ordersSearch">@L["Orders.History.Search"]</label>
                <input id="ordersSearch" class="form-control" type="search" name="search" value="@f.Search"
                       placeholder="@L["Orders.History.SearchPlaceholder"]" autocomplete="off" />
            </div>
            <div class="col-12 col-lg-4 d-flex gap-2">
                <button class="btn btn-primary flex-grow-1" type="submit">@L["Orders.Filter"]</button>
                <a class="btn btn-outline-secondary" href="/orders">@L["Orders.Clear"]</a>
            </div>

            <input type="hidden" name="sortBy" value="@f.SortBy" />
            <input type="hidden" name="sortDirection" value="@f.SortDirection" />
            <input type="hidden" name="page" value="1" />
        </form>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="mt-2">
                <div class="text-danger small">
                    @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@e.ErrorMessage</div>
                    }
                </div>
            </div>
        }
    </div>
</div>

<div id="ordersNormalTableSlot">
<div class="card wasla-card wasla-orders-table-card wasla-orders-normal-content">
    <div class="card-body p-0 p-md-3">
        <div id="ordersTableHost" class="wasla-orders-table-host">
            @await Html.PartialAsync("_OrdersTable", Model)
        </div>
    </div>
</div>
</div>

</div>

<form id="ordersCsrfForm" class="d-none">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    <script>
        window.waslaOrdersOptions = {
            tableUrl: "/orders/table",
            todayYmd: "@today.ToString("yyyy-MM-dd")",
            messages: @Html.Raw(JsonSerializer.Serialize(new Dictionary<string, string>
            {
                ["genericError"] = L["Orders.GenericError"].Value,
                ["alertClose"] = L["Common.Close"].Value,
                ["debugBadgeEnabled"] = L["Orders.DebugBadgeEnabled"].Value,
                ["tableRefreshFailed"] = L["Orders.TableRefreshFailed"].Value,
                ["tableReturnedFullPage"] = L["Orders.TableReturnedFullPage"].Value,
                ["tableMissingDataOrderId"] = L["Orders.TableMissingDataOrderId"].Value,
                ["tableHostMissing"] = L["Orders.TableHostMissing"].Value,
                ["tableRefreshException"] = L["Orders.TableRefreshException"].Value,
                ["pageInitFailed"] = L["Orders.PageInitFailed"].Value,
                ["ordersApproveConfirmTitle"] = L["Orders.ApproveConfirmTitle"].Value,
                ["ordersApproveConfirmMessage"] = L["Orders.ApproveConfirmMessage"].Value,
                ["ordersRejectConfirmTitle"] = L["Orders.RejectConfirmTitle"].Value,
                ["ordersRejectConfirmMessage"] = L["Orders.RejectConfirmMessage"].Value,
                ["ordersApproveSuccess"] = L["Orders.ApproveSuccess"].Value,
                ["ordersApproveFailed"] = L["Orders.ApproveFailed"].Value,
                ["ordersRejectSuccess"] = L["Orders.RejectSuccess"].Value,
                ["ordersRejectFailed"] = L["Orders.RejectFailed"].Value,
                ["ordersInvalidStatusForAction"] = L["Orders.InvalidStatusForAction"].Value,
                ["ordersActionFailed"] = L["Orders.ActionFailed"].Value,
                ["ordersOrderActionFailed"] = L["Orders.OrderActionFailed"].Value,
                ["ordersStartPreparingConfirmTitle"] = L["Orders.StartPreparingConfirmTitle"].Value,
                ["ordersStartPreparingConfirmMessage"] = L["Orders.StartPreparingConfirmMessage"].Value,
                ["ordersMarkReadyConfirmTitle"] = L["Orders.MarkReadyConfirmTitle"].Value,
                ["ordersMarkReadyConfirmMessage"] = L["Orders.MarkReadyConfirmMessage"].Value,
                ["ordersStartPreparingSuccess"] = L["Orders.StartPreparingSuccess"].Value,
                ["ordersMarkReadySuccess"] = L["Orders.MarkReadySuccess"].Value
            }))
        };
    </script>
    <script src="~/js/orders/orders-core.js" asp-append-version="true"></script>
    <script src="~/js/orders/orders-table.js" asp-append-version="true"></script>
    <script src="~/js/orders/orders-actions.js" asp-append-version="true"></script>
    <script src="~/js/orders/orders-page.js" asp-append-version="true"></script>
}
