@model Wasla.Web.Models.Orders.OrderListViewModel
@using System.Collections.Generic
@using System.Text.Json
@using Wasla.Domain.Enums
@using Microsoft.Extensions.Localization
@using Wasla.Web.Security
@inject IStringLocalizer<Wasla.Web.SharedResource> L
@inject ITenantNavigationAuthorizationService TenantNavigation
@{
    ViewData["Title"] = L["Orders.Title"];
    var f = Model.Filters;
    var today = Model.TurkeyLocalToday;
    var navPermissions = await TenantNavigation.GetPermissionsAsync(User);
    string StatusLabel(OrderStatus s) => L[$"OrderStatus.{s}"];
    var isDefaultLive = f.Page == 1
        && string.Equals(f.SortBy, "receivedAt", StringComparison.OrdinalIgnoreCase)
        && string.Equals(f.SortDirection, "desc", StringComparison.OrdinalIgnoreCase)
        && f.StartDate == today && f.EndDate == today;
}

<div class="oh-orders-page">
<div class="orders-page-header">
    <div class="orders-page-header__main">
        <h1 class="orders-page-header__title">@L["Orders.Title"]</h1>
        <p class="orders-page-header__subtitle">
            @L["Orders.Today"] — @today.ToString("d") · @L["Orders.LastUpdated"]: <span id="ordersLastUpdated">-</span>
        </p>
    </div>
    <div class="orders-page-header__metric orders-total-card" aria-live="polite">
        <span class="orders-page-header__metric-value orders-total-card__number" id="ordersTotalCount">@Model.TotalCount</span>
        <span class="orders-page-header__metric-label orders-total-card__label">@L["Orders.TotalOrders"]</span>
    </div>
</div>

<div class="orders-toolbar">
    <div class="orders-toolbar-left">
        @if (navPermissions.CanManageOrderSettings)
        {
            <div class="oh-orders-status-group" id="ordersAutomationStatusGroup" aria-label="@L["Settings.OrderSettings.Title"]">
                <span id="automationStatusSync" class="oh-orders-status-chip oh-orders-status-chip--muted" hidden>@L["Common.Loading"]</span>
                <span id="automationStatusAutoApprove" class="oh-orders-status-chip oh-orders-status-chip--muted" hidden>@L["Common.Loading"]</span>
                <span id="automationStatusReceipt" class="oh-orders-status-chip oh-orders-status-chip--muted" hidden>@L["Common.Loading"]</span>
            </div>
        }
        @if (navPermissions.CanViewOrderSettingsPage)
        {
            <a class="orders-manage-settings" href="/settings/orders#notifications">@L["Orders.ManageSettings"]</a>
        }
    </div>
    <div class="orders-toolbar-right">
        @if (navPermissions.CanManageOrderNotifications)
        {
        <div class="dropdown oh-orders-sound-control" id="ordersSoundControl">
            <button type="button"
                    class="btn btn-sm btn-outline-secondary text-nowrap dropdown-toggle"
                    id="ordersSoundControlToggle"
                    data-bs-toggle="dropdown"
                    data-bs-auto-close="outside"
                    aria-expanded="false"
                    aria-controls="ordersSoundControlMenu">
                <i class="bi bi-volume-up me-1" aria-hidden="true"></i>
                <span>@L["Notification.SoundControlLabel"]</span>
            </button>
            <div class="dropdown-menu dropdown-menu-end p-3 oh-orders-sound-control__menu" id="ordersSoundControlMenu" aria-labelledby="ordersSoundControlToggle">
                <div class="mb-2">
                    <label class="form-label small mb-1" for="ordersSoundSelect">@L["Notification.SelectSound"]</label>
                    <select id="ordersSoundSelect" class="form-select form-select-sm">
                        <option value="bell1">Bell 1</option>
                        <option value="bell2">Bell 2</option>
                        <option value="bell3">Bell 3</option>
                        <option value="bell4">Bell 4</option>
                        <option value="bell5">Bell 5</option>
                        <option value="bell6">Bell 6</option>
                    </select>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-sm btn-outline-primary" id="ordersSoundTestBtn">
                        <i class="bi bi-play-fill me-1" aria-hidden="true"></i>@L["Notification.TestSound"]
                    </button>
                    <button type="button"
                            class="btn btn-sm btn-primary oh-orders-sound-enable-btn"
                            id="ordersEnableNotificationSound"
                            hidden>
                        <i class="bi bi-volume-up me-1" aria-hidden="true"></i>
                        <span data-sound-enable-label>@L["Notification.EnableSoundButton"]</span>
                    </button>
                </div>
            </div>
        </div>
        <div id="ordersNotificationSoundActive"
             class="oh-orders-sound-active-pill text-nowrap d-none"
             hidden
             aria-live="polite">
            <i class="bi bi-check2-circle me-1" aria-hidden="true"></i>@L["Notification.SoundActive"]
        </div>
        }
        <div class="btn-group btn-group-sm oh-orders-view-mode" role="group" aria-label="@L["Orders.ViewMode.Label"]">
            <button type="button" class="btn btn-outline-secondary" data-orders-view-mode="table" aria-pressed="false">@L["Orders.ViewMode.Table"]</button>
            <button type="button" class="btn btn-outline-secondary" data-orders-view-mode="compact" aria-pressed="false">@L["Orders.ViewMode.Compact"]</button>
            <button type="button" class="btn btn-outline-secondary" data-orders-view-mode="kitchen" aria-pressed="false">@L["Orders.ViewMode.Kitchen"]</button>
        </div>
        @if (navPermissions.CanViewLiveScreen)
        {
            <button type="button" id="ordersOpenLiveDisplay" class="btn btn-sm btn-primary text-nowrap"
                    title="@L["Orders.OpenLiveDisplay"]">
                <i class="bi bi-display me-1" aria-hidden="true"></i>@L["Orders.OpenLiveDisplay"]
            </button>
        }
        <a class="btn btn-sm btn-outline-secondary text-nowrap" href="/orders/history">@L["Orders.History.ViewOrderHistory"]</a>
    </div>
</div>

<button type="button"
        id="ordersFilterToggle"
        class="btn btn-sm btn-link orders-filter-toggle d-none px-0 mb-2"
        aria-expanded="false"
        aria-controls="ordersFiltersPanel">
    @L["Orders.ShowFilters"]
</button>

@if (!isDefaultLive)
{
    <div class="alert alert-info small py-2 mb-3 d-flex flex-wrap align-items-center justify-content-between gap-2" role="status">
        <span>@L["Orders.LiveTrackingLimited"]</span>
        <a class="btn btn-sm btn-outline-primary flex-shrink-0" href="/orders">@L["Orders.DefaultLiveView"]</a>
    </div>
}

<div id="ordersMessageHost"></div>

<div id="ordersFiltersPanel" class="card oh-card mb-3 oh-orders-filters">
    <div class="card-body">
        <form id="ordersFilterForm" method="get" action="/orders" class="row g-3 align-items-end">
            <div class="col-12 col-md-3">
                <label class="form-label">@L["Orders.Platform"]</label>
                <select id="platformSelect" class="form-select" name="platform">
                    <option value="">@L["Common.AllPlatforms"]</option>
                    @foreach (var p in Enum.GetValues<FoodPlatform>())
                    {
                        if (f.Platform == p)
                        {
                            <option value="@p" selected>@p</option>
                        }
                        else
                        {
                            <option value="@p">@p</option>
                        }
                    }
                </select>
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label">@L["Orders.Status"]</label>
                <select id="statusSelect" class="form-select" name="status">
                    <option value="">@L["Common.AllStatuses"]</option>
                    @foreach (var s in Enum.GetValues<OrderStatus>())
                    {
                        if (f.Status == s)
                        {
                            <option value="@s" selected>@StatusLabel(s)</option>
                        }
                        else
                        {
                            <option value="@s">@StatusLabel(s)</option>
                        }
                    }
                </select>
            </div>
            <div class="col-12 col-md-2">
                <label class="form-label">@L["Orders.StartDate"]</label>
                <input class="form-control" type="date" name="startDate" value="@(f.StartDate?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-12 col-md-2">
                <label class="form-label">@L["Orders.EndDate"]</label>
                <input class="form-control" type="date" name="endDate" value="@(f.EndDate?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-12 col-md-2 d-flex gap-2">
                <button class="btn btn-primary flex-grow-1" type="submit">@L["Orders.Filter"]</button>
                <a class="btn btn-outline-secondary" href="/orders">@L["Orders.Clear"]</a>
            </div>

            <input type="hidden" name="sortBy" value="@f.SortBy" />
            <input type="hidden" name="sortDirection" value="@f.SortDirection" />
            <input type="hidden" name="page" value="@f.Page" />
            <input type="hidden" name="pageSize" value="@f.PageSize" />
        </form>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="mt-2">
                <div class="text-danger small">
                    @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@e.ErrorMessage</div>
                    }
                </div>
            </div>
        }
    </div>
</div>

<div id="ordersCardsHost" class="orders-card-grid oh-orders-cards-host d-none" role="list" hidden></div>

<div id="ordersNormalTableSlot">
<div class="card oh-card oh-orders-table-card oh-orders-normal-content">
    <div class="card-body p-0 p-md-3">
        <div id="ordersTableHost" class="oh-orders-table-host">
            @await Html.PartialAsync("_OrdersTable", Model)
        </div>
    </div>
</div>
</div>

</div>

<form id="ordersOperatorSoundForm" class="d-none" method="post" action="/notification-settings">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
