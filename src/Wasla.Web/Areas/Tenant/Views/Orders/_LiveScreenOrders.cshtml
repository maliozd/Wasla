@model Wasla.Web.Models.Orders.OrderListViewModel
@using System.Globalization
@using Wasla.Domain.Enums
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using Wasla.Web.Models.Orders
@using Wasla.Web.Models.Ui
@using Wasla.Web.Security
@using Wasla.Web.Ui
@inject IStringLocalizer<Wasla.Web.SharedResource> L
@inject IAuthorizationService AuthorizationService

@{
    var canManageOrders = (await AuthorizationService.AuthorizeAsync(User, TenantPolicies.CanManageOrders)).Succeeded;
    var turkeyToday = Model.TurkeyLocalToday;
    var utcNow = DateTime.UtcNow;

    var activeCount = Model.Orders.Count(o =>
        o.Status is OrderStatus.New
            or OrderStatus.Accepted
            or OrderStatus.Preparing
            or OrderStatus.ReadyForPickup
            or OrderStatus.OnTheWay);
    var cancelledCount = Model.Orders.Count(o => o.Status == OrderStatus.Cancelled);

    string StatusLabel(OrderStatus s) => L[$"OrderStatus.{s}"].Value;

    string FormatElapsed(DateTime receivedAtUtc)
    {
        var minutes = Math.Max(0, (int)Math.Floor((utcNow - receivedAtUtc).TotalMinutes));
        return L["Orders.LiveScreen.ElapsedMinutes", minutes].Value;
    }
}

<div class="orders-live-screen-meta d-none"
     data-total-count="@Model.TotalCount"
     data-active-count="@activeCount"
     data-cancelled-count="@cancelledCount"></div>

@if (Model.Orders.Count == 0)
{
    <div class="oh-orders-empty text-center py-5" role="status">
        <div class="oh-orders-empty__title fw-semibold mb-1">@L["Orders.NoLiveOrders"]</div>
        <div class="oh-orders-empty__desc text-muted">@L["Orders.NoLiveOrdersDescription"]</div>
    </div>
}
else
{
    <div class="orders-card-grid oh-live-screen-grid" role="list">
        @foreach (var o in Model.Orders
            .OrderBy(x => x.Status switch
            {
                OrderStatus.New => 0,
                OrderStatus.Accepted => 1,
                OrderStatus.Preparing => 2,
                OrderStatus.ReadyForPickup => 3,
                OrderStatus.OnTheWay => 4,
                OrderStatus.Delivered => 5,
                OrderStatus.Cancelled => 6,
                _ => 7
            })
            .ThenByDescending(x => x.ReceivedAtUtc))
        {
            var muted = o.Status is OrderStatus.Delivered or OrderStatus.Cancelled or OrderStatus.Failed;
            var receivedDisplay = OrderUiHelper.FormatReceivedAtLocal(o.ReceivedAtLocal, turkeyToday);
            var elapsed = FormatElapsed(o.ReceivedAtUtc);
            <article class="orders-card orders-card--kitchen oh-orders-card oh-orders-card--kitchen oh-live-screen-card@(muted ? " orders-card--muted" : "")"
                     role="listitem"
                     data-order-id="@o.Id"
                     data-order-status="@o.Status"
                     data-received-at="@o.ReceivedAtUtc.ToString("O", CultureInfo.InvariantCulture)">
                <div class="orders-card-image orders-card-image--kitchen">
                    <img src="@o.DisplayImageUrl"
                         alt="@(o.FirstProductName ?? o.CustomerName)"
                         loading="lazy" />
                </div>
                <div class="orders-card-body">
                    <div class="orders-card-top">
                        <div class="orders-card-badges">
                            <div class="orders-card-platform">
                                @await Html.PartialAsync("_PlatformBadge", (Platform: (object?)o.Platform, DisplayName: (string?)null))
                            </div>
                            @await Html.PartialAsync("_OrderStatusBadge", new OrderStatusBadgeModel(o.Status, StatusLabel(o.Status)))
                            <span class="badge text-bg-primary d-none oh-orders-new-badge" data-new-badge>@L["Orders.StatusNewBadge"]</span>
                        </div>
                    </div>

                    <div class="orders-card-code oh-live-screen-card__code">
                        <a href="/orders/details/@o.Id">@o.ExternalOrderCode</a>
                    </div>

                    <div class="orders-card-customer">
                        <span class="orders-card-meta__label">@L["Orders.Customer"]:</span>
                        @o.CustomerName
                    </div>

                    @if (o.LineItems.Count > 0)
                    {
                        <ul class="oh-live-screen-card__items list-unstyled mb-2">
                            @foreach (var item in o.LineItems)
                            {
                                <li class="oh-live-screen-card__item">
                                    <span class="oh-live-screen-card__qty">@item.Quantity×</span>
                                    <span class="oh-live-screen-card__product">@item.ProductName</span>
                                    @if (!string.IsNullOrWhiteSpace(item.Notes))
                                    {
                                        <div class="oh-live-screen-card__note text-muted">@item.Notes</div>
                                    }
                                </li>
                            }
                        </ul>
                    }

                    <div class="orders-card-meta orders-card-meta--kitchen">
                        <div class="orders-card-meta__row">
                            <span class="orders-card-meta__label">@L["Orders.TotalAmount"]:</span>
                            @o.TotalAmount.ToString("C", CultureInfo.CurrentCulture)
                        </div>
                        <div class="orders-card-meta__row">
                            <span class="orders-card-meta__label">@L["Orders.ReceivedAt"]:</span>
                            @receivedDisplay
                            <span class="oh-live-screen-card__elapsed text-muted">· @elapsed</span>
                        </div>
                    </div>

                    <div class="orders-card-actions oh-orders-card__actions">
                        @await Html.PartialAsync("_OrderLifecycleActions", new OrderLifecycleActionsModel
                        {
                            OrderId = o.Id,
                            Status = o.Status,
                            CanManageOrders = canManageOrders,
                            ButtonSizeClass = "btn-lg"
                        })
                    </div>
                </div>
            </article>
        }
    </div>
}
