@model Wasla.Web.Models.Notifications.NotificationSettingsViewModel
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Wasla.Web.SharedResource> L

@{
    var f = Model;
}

<div class="modal-header py-2 px-3">
    <h5 class="modal-title h6">@L["Notification.Settings"]</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["Common.Close"]"></button>
</div>

<div class="modal-body p-3">
    <div class="d-flex align-items-start justify-content-between gap-2 mb-2">
        <div class="flex-grow-1 min-w-0">
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <span id="notificationStatusBadge" class="badge text-bg-secondary">@L["Common.Status"]</span>
                <span class="text-muted" style="font-size:0.8rem">@L["Notification.PersistentHelp"]</span>
            </div>
            <div id="notificationStatusHelp" class="small text-muted mt-1">@L["Notification.NotificationsHelp"]</div>
            <div id="notificationStatusWarning" class="small text-danger mt-1 d-none"></div>
        </div>
    </div>

    <input type="hidden" id="NewOrderSoundEnabled" name="NewOrderSoundEnabled" value="@(f.NewOrderSoundEnabled ? "true" : "false")" />

    <div class="mb-2">
        <div class="d-flex align-items-center justify-content-between">
            <label class="form-label small mb-0" for="NewOrderSoundEnabledToggle">@L["Notification.Notifications"]</label>
            <div class="form-check form-switch mb-0">
                <input class="form-check-input" type="checkbox" id="NewOrderSoundEnabledToggle" @(f.NewOrderSoundEnabled ? "checked" : "")>
            </div>
        </div>
    </div>

    <div class="mb-2">
        <label class="form-label small mb-1" for="newOrderSoundSelect">@L["Notification.Sound"]</label>
        <div class="d-flex flex-wrap align-items-stretch gap-2">
            <select class="form-select form-select-sm flex-grow-1" id="newOrderSoundSelect" style="min-width: 8rem" aria-label="@L["Notification.Sound"]">
                @foreach (var s in f.AvailableSounds)
                {
                    if (string.Equals(f.NewOrderSoundName, s.Name, StringComparison.OrdinalIgnoreCase))
                    {
                        <option value="@s.Name" data-sound-url="@s.Url" selected="selected">@s.Label</option>
                    }
                    else
                    {
                        <option value="@s.Name" data-sound-url="@s.Url">@s.Label</option>
                    }
                }
            </select>
            <button type="button" class="btn btn-sm btn-outline-primary flex-shrink-0" id="testSelectedSoundBtn">@L["Notification.TestSelectedSound"]</button>
            <button type="button" class="btn btn-sm btn-outline-secondary flex-shrink-0" id="notificationPreviewStopSound" hidden disabled>@L["Notification.StopSoundButton"]</button>
        </div>
        <input type="hidden" id="NewOrderSoundName" name="NewOrderSoundName" value="@f.NewOrderSoundName" />
    </div>

    <div class="row g-2 mb-2">
        <div class="col-6 col-md-4">
            <label class="form-label small mb-0" for="NewOrderSoundRepeatCount">@L["Notification.RepeatCount"]</label>
            <select class="form-select form-select-sm" id="NewOrderSoundRepeatCount" name="NewOrderSoundRepeatCount">
                @foreach (var i in new[] { 1, 2, 3 })
                {
                    <option value="@i" selected="@(f.NewOrderSoundRepeatCount == i)">@i</option>
                }
            </select>
        </div>
        <div class="col-6 col-md-4">
            <label class="form-label small mb-0" for="NewOrderSoundVolumePercent">@L["Notification.Volume"]</label>
            <select class="form-select form-select-sm" id="NewOrderSoundVolumePercent" name="NewOrderSoundVolumePercent">
                <option value="25" selected="@(f.NewOrderSoundVolumePercent == 25)">%25</option>
                <option value="50" selected="@(f.NewOrderSoundVolumePercent == 50)">%50</option>
                <option value="75" selected="@(f.NewOrderSoundVolumePercent == 75)">%75</option>
                <option value="100" selected="@(f.NewOrderSoundVolumePercent == 100)">%100</option>
            </select>
        </div>
        <div class="col-12 col-md-4 d-flex align-items-end">
            <div class="form-check w-100">
                <input class="form-check-input" type="checkbox" id="ShowBrowserNotification" name="ShowBrowserNotification" value="true" @(f.ShowBrowserNotification ? "checked" : "")>
                <input type="hidden" name="ShowBrowserNotification" value="false" />
                <label class="form-check-label small" for="ShowBrowserNotification">@L["Notification.BrowserNotification"]</label>
            </div>
        </div>
    </div>

    <hr class="my-2 text-muted opacity-25" />
    <div class="fw-semibold small mb-2">@L["Notification.Highlight"]</div>
    <div class="row g-2">
        <div class="col-6">
            <label class="form-label small mb-0" for="NewOrderHighlightColor">@L["Notification.HighlightColor"]</label>
            <div class="d-flex flex-wrap align-items-center gap-2">
                <input type="hidden" id="NewOrderHighlightColor" name="NewOrderHighlightColor" value="@f.NewOrderHighlightColor" />

                <button type="button" class="btn btn-sm wasla-color-swatch" data-highlight-color="yellow" aria-label="@L["Notification.HighlightColorYellow"]"></button>
                <button type="button" class="btn btn-sm wasla-color-swatch" data-highlight-color="orange" aria-label="@L["Notification.HighlightColorOrange"]"></button>
                <button type="button" class="btn btn-sm wasla-color-swatch" data-highlight-color="blue" aria-label="@L["Notification.HighlightColorBlue"]"></button>
                <button type="button" class="btn btn-sm wasla-color-swatch" data-highlight-color="green" aria-label="@L["Notification.HighlightColorGreen"]"></button>
                <button type="button" class="btn btn-sm wasla-color-swatch" data-highlight-color="red" aria-label="@L["Notification.HighlightColorRed"]"></button>

                <div class="d-flex align-items-center gap-2 ms-1">
                    <span class="text-muted small">@L["Notification.CustomColor"]</span>
                    <input type="color" id="NewOrderHighlightColorCustom" value="#fff3cd" class="form-control form-control-color form-control-color-sm" aria-label="@L["Notification.HighlightColorCustom"]" />
                </div>
            </div>
        </div>
        <div class="col-6">
            <label class="form-label small mb-0" for="NewOrderHighlightBehavior">@L["Notification.HighlightBehavior"]</label>
            <select class="form-select form-select-sm" id="NewOrderHighlightBehavior" name="NewOrderHighlightBehavior">
                <option value="fade" selected="@(string.Equals(f.NewOrderHighlightBehavior, "fade", StringComparison.OrdinalIgnoreCase))">@L["Notification.HighlightBehaviorFade"]</option>
                <option value="pulse" selected="@(string.Equals(f.NewOrderHighlightBehavior, "pulse", StringComparison.OrdinalIgnoreCase))">@L["Notification.HighlightBehaviorPulse"]</option>
                <option value="blink" selected="@(string.Equals(f.NewOrderHighlightBehavior, "blink", StringComparison.OrdinalIgnoreCase))">@L["Notification.HighlightBehaviorBlink"]</option>
                <option value="borderGlow" selected="@(string.Equals(f.NewOrderHighlightBehavior, "borderGlow", StringComparison.OrdinalIgnoreCase))">@L["Notification.HighlightBehaviorBorderGlow"]</option>
                <option value="none" selected="@(string.Equals(f.NewOrderHighlightBehavior, "none", StringComparison.OrdinalIgnoreCase))">@L["Notification.HighlightBehaviorNone"]</option>
            </select>
        </div>
        <div class="col-12 col-md-6">
            <label class="form-label small mb-0" for="NewOrderHighlightDurationSeconds">@L["Notification.HighlightDuration"]</label>
            <select class="form-select form-select-sm" id="NewOrderHighlightDurationSeconds" name="NewOrderHighlightDurationSeconds">
                <option value="10" selected="@(f.NewOrderHighlightDurationSeconds == 10)">@L["Notification.HighlightDuration10"]</option>
                <option value="20" selected="@(f.NewOrderHighlightDurationSeconds == 20)">@L["Notification.HighlightDuration20"]</option>
                <option value="30" selected="@(f.NewOrderHighlightDurationSeconds == 30)">@L["Notification.HighlightDuration30"]</option>
                <option value="60" selected="@(f.NewOrderHighlightDurationSeconds == 60)">@L["Notification.HighlightDuration60"]</option>
            </select>
        </div>
    </div>

    <div class="mt-2">
        <div class="d-flex align-items-center justify-content-between">
            <div class="fw-semibold small">@L["Notification.HighlightPreview"]</div>
        </div>
        <div class="text-muted small mb-2">@L["Notification.HighlightPreviewHelp"]</div>

        <div id="newOrderHighlightPreview" class="order-highlight-preview">
            <div class="d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="badge text-bg-light border">Yemeksepeti</span>
                    <span class="font-monospace">YS-ORDER-12345</span>
                    <span class="text-muted small">— @L["Notification.PreviewCustomer"]</span>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge text-bg-danger">@L["OrderStatus.New"]</span>
                    <span class="font-monospace">₺420</span>
                </div>
            </div>
        </div>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="mt-2 text-danger small" role="alert">
            @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@e.ErrorMessage</div>
            }
        </div>
    }
</div>

<div class="modal-footer py-2 px-3">
    <button type="submit" class="btn btn-sm btn-primary" id="saveNotificationsBtn">@L["Common.Save"]</button>
    <button type="button" class="btn btn-sm btn-light" data-bs-dismiss="modal">@L["Common.Close"]</button>
</div>
