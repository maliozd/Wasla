@model Wasla.Web.Models.PrintBridge.PrintBridgeSetupViewModel
@using System.Text.Json
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Wasla.Web.SharedResource> L
@{
    ViewData["Title"] = L["PrintBridge.SetupPageTitle"];
    var sessionCreateUrl = Url.Action("CreateSetupSession", "PrintBridge", new { area = "Tenant" })
        ?? "/print-bridge/setup/session";
    var setupConfig = new
    {
        serverUrl = Model.ServerUrl ?? "",
        sessionCreateUrl,
        messages = new
        {
            copied = L["PrintBridge.Copied"].Value,
            copyFailed = L["PrintBridge.CopyFailed"].Value,
            copyServerUrl = L["PrintBridge.CopyServerUrl"].Value,
            copy = L["PrintBridge.Copy"].Value,
            copyToken = L["PrintBridge.CopyToken"].Value,
            tokenCopied = L["PrintBridge.TokenCopied"].Value,
            tokenCopyFailed = L["PrintBridge.TokenCopyFailed"].Value,
            tokenShownOnce = L["PrintBridge.TokenShownOnce"].Value,
            tokenCreated = L["PrintBridge.TokenCreated"].Value,
            tokenRegenerated = L["PrintBridge.TokenRegenerated"].Value,
            oldTokenInvalidAfterRegenerate = L["PrintBridge.OldTokenInvalidAfterRegenerate"].Value,
            confirmRegenerateToken = L["PrintBridge.RegenerateConfirm", Model.ActiveDeviceName ?? ""].Value,
            manualTokenFailed = L["PrintBridge.Auto.ManualTokenFailed"].Value,
            autoReplaceTokenConfirm = L["PrintBridge.Auto.ReplaceTokenConfirm", Model.ActiveDeviceName ?? ""].Value,
            starting = L["PrintBridge.Auto.Starting"].Value,
            waiting = L["PrintBridge.Auto.Waiting"].Value,
            connected = L["PrintBridge.Auto.Connected"].Value,
            savedUnverified = L["PrintBridge.Auto.SavedUnverified"].Value,
            failed = L["PrintBridge.Auto.Failed"].Value,
            expired = L["PrintBridge.Auto.Expired"].Value,
            sessionError = L["PrintBridge.Auto.SessionError"].Value
        },
        hasActiveDevice = Model.HasActiveDevice,
        activeDeviceId = Model.ActiveDeviceId,
        createDeviceUrl = "/print-bridge/devices/create",
        regenerateTokenUrlTemplate = "/print-bridge/devices/{id}/regenerate-token"
    };
}

<div class="oh-print-bridge-page oh-print-bridge-setup-page">
    <div class="oh-customer-page-header mb-3">
        <h1 class="oh-customer-page-header__title h4 mb-1">@L["PrintBridge.SetupPageTitle"]</h1>
        <p class="oh-customer-page-header__subtitle text-muted small mb-0">@L["PrintBridge.SetupPageSubtitle"]</p>
    </div>

    <div id="printBridgeSetupMessageHost" class="mb-3"></div>

    @Html.AntiForgeryToken()

    <section class="card oh-card border-primary mb-3" id="pbAutoSetupCard">
        <div class="card-body">
            <div class="d-flex align-items-start justify-content-between gap-2 mb-2">
                <h2 class="h6 mb-0">@L["PrintBridge.Auto.SectionTitle"]</h2>
                <span class="badge text-bg-primary">@L["PrintBridge.Auto.RecommendedBadge"]</span>
            </div>
            <p class="text-muted small mb-3">@L["PrintBridge.Auto.Intro"]</p>
            @if (Model.HasActiveDevice)
            {
                <div class="alert alert-warning small py-2 mb-3" role="alert">
                    @L["PrintBridge.Auto.TokenRotationNotice", Model.ActiveDeviceName ?? ""]
                </div>
            }

            <button type="button" class="btn btn-primary" id="pbAutoOpenBtn" data-server-url="@(Model.ServerUrl ?? "")">
                <i class="bi bi-box-arrow-up-right me-1" aria-hidden="true"></i>@L["PrintBridge.Auto.OpenButton"]
            </button>

            <div id="pbAutoStatus" class="mt-3 d-none" role="status" aria-live="polite">
                <div class="d-flex align-items-center gap-2">
                    <span class="spinner-border spinner-border-sm text-primary" id="pbAutoSpinner" aria-hidden="true"></span>
                    <span id="pbAutoStatusText" class="small"></span>
                </div>
            </div>

            <div id="pbAutoFallback" class="mt-3 d-none">
                <p class="small text-muted mb-2">@L["PrintBridge.Auto.NotOpening"]</p>
                <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-outline-primary btn-sm" id="pbAutoRetryBtn">
                        <i class="bi bi-arrow-clockwise me-1" aria-hidden="true"></i>@L["PrintBridge.Auto.TryAgain"]
                    </button>
                    <a class="btn btn-outline-secondary btn-sm" href="@Model.PackageDownloadUrl">
                        <i class="bi bi-download me-1" aria-hidden="true"></i>@L["PrintBridge.Auto.Download"]
                    </a>
                    <a class="btn btn-outline-secondary btn-sm" href="#pbManualSetup">
                        <i class="bi bi-sliders me-1" aria-hidden="true"></i>@L["PrintBridge.Auto.UseManual"]
                    </a>
                </div>
            </div>

            <p class="small text-muted mt-3 mb-0">
                <i class="bi bi-info-circle me-1" aria-hidden="true"></i>@L["PrintBridge.Auto.InstalledHint"]
            </p>
        </div>
    </section>

    <h2 class="h6 mb-2" id="pbManualSetup">@L["PrintBridge.Auto.ManualSectionTitle"]</h2>
    <p class="text-muted small mb-3">@L["PrintBridge.Auto.NetworkHelp"]</p>

    <div class="row g-3 mb-3">
        <div class="col-lg-6">
            <section class="card oh-card oh-print-bridge-download-card h-100">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex align-items-start justify-content-between gap-2 mb-2">
                        <h2 class="h6 mb-0">@L["PrintBridge.DownloadCardTitle"]</h2>
                        <span class="badge text-bg-secondary">@L["PrintBridge.PackageTypeLabel"]</span>
                    </div>
                    <p class="text-muted small mb-3">@L["PrintBridge.DownloadCardText"]</p>
                    @if (Model.PackageAvailable)
                    {
                        <a class="btn btn-primary btn-sm align-self-start" href="@Model.PackageDownloadUrl">
                            <i class="bi bi-download me-1" aria-hidden="true"></i>@L["PrintBridge.DownloadButton"]
                        </a>
                        <p class="small text-muted mt-3 mb-0">
                            <i class="bi bi-file-earmark-zip me-1" aria-hidden="true"></i>@Model.PackageFileName
                        </p>
                    }
                    else
                    {
                        <div class="alert alert-warning small py-2 mb-2" role="alert">
                            @L["PrintBridge.PackageNotPrepared"]
                        </div>
                        @if (Model.IsDevelopment)
                        {
                            <p class="small text-muted mb-0">@L["PrintBridge.PackageNotPreparedDevHint"]</p>
                        }
                    }
                </div>
            </section>
        </div>

        <div class="col-lg-6">
            <section class="card oh-card oh-print-bridge-connection-card h-100">
                <div class="card-body">
                    <h2 class="h6 mb-3">@L["PrintBridge.ConnectionInfoTitle"]</h2>

                    <label class="form-label small fw-semibold mb-1" for="pbSetupServerUrl">@L["PrintBridge.ServerUrlLabel"]</label>
                    @if (!string.IsNullOrWhiteSpace(Model.ServerUrl))
                    {
                        <div class="input-group input-group-sm mb-3">
                            <input type="text"
                                   class="form-control font-monospace oh-print-bridge-setup-value"
                                   id="pbSetupServerUrl"
                                   value="@Model.ServerUrl"
                                   readonly />
                            <button type="button"
                                    class="btn btn-outline-secondary"
                                    id="pbSetupCopyServerUrlBtn"
                                    title="@L["PrintBridge.CopyServerUrl"]"
                                    aria-label="@L["PrintBridge.CopyServerUrl"]">
                                <i class="bi bi-clipboard" aria-hidden="true"></i>
                                <span class="d-none d-md-inline ms-1">@L["PrintBridge.Copy"]</span>
                            </button>
                        </div>
                    }
                    else
                    {
                        <p class="small text-muted mb-3">@L["PrintBridge.ServerUrlUnavailable"]</p>
                    }

                    <label class="form-label small fw-semibold mb-1" for="pbSetupDeviceToken">@L["PrintBridge.DeviceTokenLabel"]</label>
                    @if (Model.HasActiveDevice)
                    {
                        <div class="input-group input-group-sm mb-2">
                            <input type="text"
                                   class="form-control font-monospace oh-print-bridge-setup-value"
                                   id="pbSetupDeviceToken"
                                   value="@L["PrintBridge.DeviceTokenMasked"].Value"
                                   readonly
                                   aria-describedby="pbSetupDeviceTokenHelp" />
                        </div>
                        <p id="pbSetupDeviceTokenHelp" class="small text-muted mb-2">
                            @L["PrintBridge.DeviceTokenMaskedHelp", Model.ActiveDeviceName ?? ""]
                        </p>
                        <div class="d-flex flex-wrap gap-2">
                            <button type="button"
                                    class="btn btn-outline-primary btn-sm"
                                    id="pbManualRegenerateTokenBtn"
                                    data-device-id="@Model.ActiveDeviceId">
                                <i class="bi bi-arrow-repeat me-1" aria-hidden="true"></i>@L["PrintBridge.RegenerateToken"]
                            </button>
                            <a class="btn btn-outline-secondary btn-sm" href="@Model.DevicesUrl">
                                <i class="bi bi-hdd-network me-1" aria-hidden="true"></i>@L["PrintBridge.ManageDevicesAction"]
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning small py-2 mb-2" role="alert">
                            @L["PrintBridge.NoDeviceWarning"]
                        </div>
                        <button type="button" class="btn btn-outline-primary btn-sm" id="pbManualCreateDeviceBtn">
                            <i class="bi bi-hdd-network me-1" aria-hidden="true"></i>@L["PrintBridge.CreateDeviceAction"]
                        </button>
                    }

                    <div id="pbManualTokenBox" class="alert alert-info mt-3 d-none" role="status" aria-live="polite">
                        <div class="fw-semibold small mb-1" id="pbManualTokenTitle"></div>
                        <p class="small mb-2" id="pbManualTokenNotice"></p>
                        <div id="pbManualTokenWarning" class="alert alert-danger small py-2 mb-2 d-none" role="alert"></div>
                        <div class="d-flex flex-wrap align-items-stretch gap-2">
                            <pre id="pbManualTokenValue" class="font-monospace small flex-grow-1 mb-0 p-3 rounded border bg-body user-select-all text-break oh-print-bridge-token-value"></pre>
                            <button type="button" class="btn btn-sm btn-primary align-self-start" id="pbManualCopyTokenBtn">
                                <i class="bi bi-clipboard me-1" aria-hidden="true"></i>@L["PrintBridge.CopyToken"]
                            </button>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>

    <section class="card oh-card mb-3">
        <div class="card-body">
            <h2 class="h6 mb-3">@L["PrintBridge.SetupStepsTitle"]</h2>
            <ol class="oh-print-bridge-setup-steps small text-muted mb-0">
                <li>@L["PrintBridge.SetupStep1"]</li>
                <li>@L["PrintBridge.SetupStep2"]</li>
                <li>@L["PrintBridge.SetupStep3"]</li>
                <li>@L["PrintBridge.SetupStep4"]</li>
                <li>@L["PrintBridge.SetupStep5"]</li>
                <li>@L["PrintBridge.SetupStep6"]</li>
                <li>@L["PrintBridge.SetupStep7"]</li>
            </ol>
        </div>
    </section>

    <section class="card oh-card mb-3">
        <div class="card-body">
            <h2 class="h6 mb-2">@L["PrintBridge.RequirementsTitle"]</h2>
            <ul class="oh-print-bridge-guide-checklist small text-muted mb-0">
                <li>@L["PrintBridge.Requirement1"]</li>
                <li>@L["PrintBridge.Requirement2"]</li>
                <li>@L["PrintBridge.Requirement3"]</li>
                <li>@L["PrintBridge.Requirement4"]</li>
                <li>@L["PrintBridge.Requirement5"]</li>
            </ul>
        </div>
    </section>

    <section class="card oh-card mb-3">
        <div class="card-body">
            <h2 class="h6 mb-3">@L["PrintBridge.Troubleshooting"]</h2>
            <div class="accordion accordion-flush oh-print-bridge-faq" id="printBridgeSetupFaq">
                <div class="accordion-item">
                    <h3 class="accordion-header" id="pbFaqHeading1">
                        <button class="accordion-button collapsed small py-2" type="button" data-bs-toggle="collapse" data-bs-target="#pbFaq1" aria-expanded="false" aria-controls="pbFaq1">
                            @L["PrintBridge.FaqConnectionFailed"]
                        </button>
                    </h3>
                    <div id="pbFaq1" class="accordion-collapse collapse" aria-labelledby="pbFaqHeading1" data-bs-parent="#printBridgeSetupFaq">
                        <div class="accordion-body small text-muted pt-0">@L["PrintBridge.FaqConnectionFailedAnswer"]</div>
                    </div>
                </div>
                <div class="accordion-item">
                    <h3 class="accordion-header" id="pbFaqHeading2">
                        <button class="accordion-button collapsed small py-2" type="button" data-bs-toggle="collapse" data-bs-target="#pbFaq2" aria-expanded="false" aria-controls="pbFaq2">
                            @L["PrintBridge.FaqPrinterMissing"]
                        </button>
                    </h3>
                    <div id="pbFaq2" class="accordion-collapse collapse" aria-labelledby="pbFaqHeading2" data-bs-parent="#printBridgeSetupFaq">
                        <div class="accordion-body small text-muted pt-0">@L["PrintBridge.FaqPrinterMissingAnswer"]</div>
                    </div>
                </div>
                <div class="accordion-item">
                    <h3 class="accordion-header" id="pbFaqHeading3">
                        <button class="accordion-button collapsed small py-2" type="button" data-bs-toggle="collapse" data-bs-target="#pbFaq3" aria-expanded="false" aria-controls="pbFaq3">
                            @L["PrintBridge.FaqNoReceipt"]
                        </button>
                    </h3>
                    <div id="pbFaq3" class="accordion-collapse collapse" aria-labelledby="pbFaqHeading3" data-bs-parent="#printBridgeSetupFaq">
                        <div class="accordion-body small text-muted pt-0">@L["PrintBridge.FaqNoReceiptAnswer"]</div>
                    </div>
                </div>
                <div class="accordion-item">
                    <h3 class="accordion-header" id="pbFaqHeading4">
                        <button class="accordion-button collapsed small py-2" type="button" data-bs-toggle="collapse" data-bs-target="#pbFaq4" aria-expanded="false" aria-controls="pbFaq4">
                            @L["PrintBridge.FaqTokenChanged"]
                        </button>
                    </h3>
                    <div id="pbFaq4" class="accordion-collapse collapse" aria-labelledby="pbFaqHeading4" data-bs-parent="#printBridgeSetupFaq">
                        <div class="accordion-body small text-muted pt-0">@L["PrintBridge.FaqTokenChangedAnswer"]</div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

<script type="application/json" id="printBridgeSetupConfig">@Html.Raw(JsonSerializer.Serialize(setupConfig))</script>
<script src="~/js/print-bridge/print-bridge-setup.js" asp-append-version="true"></script>
