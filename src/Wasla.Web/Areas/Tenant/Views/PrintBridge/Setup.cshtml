@model Wasla.Web.Models.PrintBridge.PrintBridgeSetupViewModel
@using System.Text.Json
@using Microsoft.Extensions.Localization
@using Wasla.Web.Models.PrintBridge
@inject IStringLocalizer<Wasla.Web.SharedResource> L
@functions {
    private static string ReconnectDeviceDisplayName(PrintBridgeSetupDeviceOptionViewModel device)
    {
        var name = device.Name?.Trim() ?? "";
        if (!string.IsNullOrEmpty(name))
            return name;

        return device.MachineName?.Trim() ?? "";
    }
}
@{
    ViewData["Title"] = L["PrintBridge.SetupPageTitle"];
    var sessionCreateUrl = Url.Action("CreateSetupSession", "PrintBridge", new { area = "Tenant" })
        ?? "/print-bridge/setup/session";
    var setupConfig = new
    {
        serverUrl = Model.ServerUrl ?? "",
        sessionCreateUrl,
        messages = new
        {
            copied = L["PrintBridge.Copied"].Value,
            copyFailed = L["PrintBridge.CopyFailed"].Value,
            copyServerUrl = L["PrintBridge.CopyServerUrl"].Value,
            copy = L["PrintBridge.Copy"].Value,
            copyToken = L["PrintBridge.CopyToken"].Value,
            tokenCopied = L["PrintBridge.TokenCopied"].Value,
            tokenCopyFailed = L["PrintBridge.TokenCopyFailed"].Value,
            tokenShownOnce = L["PrintBridge.TokenShownOnce"].Value,
            tokenCreated = L["PrintBridge.TokenCreated"].Value,
            tokenRegenerated = L["PrintBridge.TokenRegenerated"].Value,
            oldTokenInvalidAfterRegenerate = L["PrintBridge.OldTokenInvalidAfterRegenerate"].Value,
            confirmRegenerateToken = L["PrintBridge.RegenerateConfirm", Model.ActiveDeviceName ?? ""].Value,
            manualTokenFailed = L["PrintBridge.Auto.ManualTokenFailed"].Value,
            autoReplaceTokenConfirm = L["PrintBridge.Auto.ReplaceTokenConfirm", Model.ActiveDeviceName ?? ""].Value,
            selectDevice = L["PrintBridge.Auto.SelectDevice"].Value,
            reconnectTokenWarning = L["PrintBridge.Auto.ReconnectTokenWarning"].Value,
            reconnectConfirm = L["PrintBridge.Auto.ReconnectConfirm"].Value,
            generateNewDeviceSetupCode = L["PrintBridge.Auto.GenerateNewDeviceSetupCode"].Value,
            generateReconnectSetupCode = L["PrintBridge.Auto.GenerateReconnectSetupCode"].Value,
            oneTimeSetupCodeCreated = L["PrintBridge.Auto.OneTimeSetupCodeCreated"].Value,
            setupCodeExpires = L["PrintBridge.Auto.SetupCodeExpires"].Value,
            starting = L["PrintBridge.Auto.Starting"].Value,
            waiting = L["PrintBridge.Auto.Waiting"].Value,
            connected = L["PrintBridge.Auto.Connected"].Value,
            savedUnverified = L["PrintBridge.Auto.SavedUnverified"].Value,
            failed = L["PrintBridge.Auto.Failed"].Value,
            expired = L["PrintBridge.Auto.Expired"].Value,
            sessionError = L["PrintBridge.Auto.SessionError"].Value,
            openButton = L["PrintBridge.Auto.OpenButton"].Value,
            reconnectOpenButton = L["PrintBridge.Auto.ReconnectOpenButton"].Value,
            deviceActive = L["Orders.Active"].Value,
            devicePassive = L["Orders.Passive"].Value,
            lastSeen = L["PrintBridge.LastSeen"].Value,
            lastSeenNever = L["PrintBridge.LastSeenNever"].Value,
            today = L["Common.Today"].Value,
            reconnectMachineLabel = L["PrintBridge.Auto.ReconnectMachineLabel"].Value
        },
        hasActiveDevice = Model.HasActiveDevice,
        devices = Model.Devices.Select(d => new
        {
            id = d.Id,
            name = d.Name,
            machineName = d.MachineName,
            isActive = d.IsActive,
            status = L[d.ConnectionStatusLabelKey].Value,
            lastSeenAtUtc = d.LastSeenAtUtc
        }),
        regenerateTokenUrlTemplate = "/print-bridge/devices/{id}/regenerate-token"
    };
}

<div class="oh-print-bridge-page oh-print-bridge-setup-page">
    <div class="oh-print-bridge-setup-layout">
        <div id="printBridgeSetupMessageHost" class="mb-3"></div>

        @Html.AntiForgeryToken()

        <section class="card oh-card oh-print-bridge-setup-main-card mb-3" id="pbAutoSetupCard">
            <div class="card-body">
                <header class="oh-print-bridge-setup-header mb-4">
                    <h1 class="h4 mb-2">@L["PrintBridge.SetupPageTitle"]</h1>
                    <p class="text-muted mb-0">@L["PrintBridge.SetupPageSubtitle"]</p>
                </header>

                <fieldset class="mb-4" id="pbSetupModeGroup">
                    <legend class="form-label fw-semibold mb-3">@L["PrintBridge.Auto.SetupModeTitle"]</legend>
                    <div class="vstack gap-3">
                        <label class="oh-print-bridge-setup-mode-option rounded-3 p-3 d-flex gap-3" for="pbSetupModeNew">
                            <input class="form-check-input flex-shrink-0 mt-1"
                                   type="radio"
                                   name="pbSetupMode"
                                   id="pbSetupModeNew"
                                   value="new"
                                   checked />
                            <span class="flex-grow-1">
                                <span class="d-flex flex-wrap align-items-center gap-2 mb-1">
                                    <span class="fw-semibold">@L["PrintBridge.Auto.NewDeviceModeTitle"]</span>
                                    <span class="badge rounded-pill oh-print-bridge-setup-badge">@L["PrintBridge.Auto.RecommendedBadge"]</span>
                                </span>
                                <span class="small text-muted d-block">@L["PrintBridge.Auto.NewDeviceModeHelp"]</span>
                            </span>
                        </label>
                        <label class="oh-print-bridge-setup-mode-option rounded-3 p-3 d-flex gap-3" for="pbSetupModeReconnect">
                            <input class="form-check-input flex-shrink-0 mt-1"
                                   type="radio"
                                   name="pbSetupMode"
                                   id="pbSetupModeReconnect"
                                   value="reconnect" />
                            <span class="flex-grow-1">
                                <span class="fw-semibold d-block mb-1">@L["PrintBridge.Auto.ReconnectModeTitle"]</span>
                                <span class="small text-muted d-block">@L["PrintBridge.Auto.ReconnectModeHelp"]</span>
                            </span>
                        </label>
                    </div>
                </fieldset>

                <div class="mb-4 d-none oh-print-bridge-setup-reconnect-panel" id="pbReconnectDeviceSection">
                    <label class="form-label fw-semibold mb-2" for="pbReconnectDeviceSelect">@L["PrintBridge.Auto.ReconnectDeviceLabel"]</label>
                    <select class="form-select" id="pbReconnectDeviceSelect">
                        <option value="">@L["PrintBridge.Auto.ReconnectDevicePlaceholder"]</option>
                        @foreach (var device in Model.Devices)
                        {
                            <option value="@device.Id">@ReconnectDeviceDisplayName(device)</option>
                        }
                    </select>
                    <div class="oh-print-bridge-reconnect-device-details d-none mt-2" id="pbReconnectDeviceDetails" aria-live="polite">
                        <div class="fw-semibold small" id="pbReconnectDeviceTitle"></div>
                        <div class="text-muted small d-none" id="pbReconnectDeviceMachine"></div>
                        <div class="d-flex flex-wrap align-items-center gap-2 small mt-1" id="pbReconnectDeviceBadges"></div>
                        <div class="text-muted small mt-1" id="pbReconnectDeviceLastSeen"></div>
                    </div>
                    <p class="small text-muted mt-2 mb-0" id="pbReconnectDeviceNotice">@L["PrintBridge.Auto.ReconnectConnectionNotice"]</p>
                    <p class="small text-primary mt-2 mb-0 d-none" id="pbReconnectDeviceGuidance" role="status">@L["PrintBridge.Auto.SelectReconnectDevice"]</p>
                </div>

                <div class="oh-print-bridge-setup-cta-block">
                    <button type="button" class="btn btn-primary btn-lg" id="pbAutoOpenBtn" data-server-url="@(Model.ServerUrl ?? "")">
                        <i class="bi bi-box-arrow-up-right me-1" aria-hidden="true"></i><span id="pbAutoOpenBtnText">@L["PrintBridge.Auto.OpenButton"]</span>
                    </button>

                    <p class="small text-muted mt-3 mb-0 oh-print-bridge-setup-helper">
                        @L["PrintBridge.Auto.InstalledHint"]
                        <a class="oh-print-bridge-setup-manual-link" href="#pbManualSetup" id="pbOpenManualSetupLink">@L["PrintBridge.Auto.OpenManualSetup"]</a>
                    </p>
                </div>

                <div id="pbAutoStatus" class="mt-3 d-none" role="status" aria-live="polite">
                    <div class="d-flex align-items-center gap-2">
                        <span class="spinner-border spinner-border-sm text-primary" id="pbAutoSpinner" aria-hidden="true"></span>
                        <span id="pbAutoStatusText" class="small"></span>
                    </div>
                </div>

                <div id="pbAutoFallback" class="mt-3 d-none">
                    <p class="small text-muted mb-2">@L["PrintBridge.Auto.NotOpening"]</p>
                    <div class="d-flex flex-wrap gap-2">
                        <button type="button" class="btn btn-outline-primary btn-sm" id="pbAutoRetryBtn">
                            <i class="bi bi-arrow-clockwise me-1" aria-hidden="true"></i>@L["PrintBridge.Auto.TryAgain"]
                        </button>
                        <a class="btn btn-outline-secondary btn-sm" href="@Model.PackageDownloadUrl">
                            <i class="bi bi-download me-1" aria-hidden="true"></i>@L["PrintBridge.Auto.Download"]
                        </a>
                        <a class="btn btn-outline-secondary btn-sm" href="#pbManualSetup" id="pbAutoUseManualLink">
                            <i class="bi bi-sliders me-1" aria-hidden="true"></i>@L["PrintBridge.Auto.UseManual"]
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <div class="oh-print-bridge-setup-below-fold">
        <div class="accordion oh-print-bridge-setup-accordion mb-2" id="pbManualSetup">
            <div class="accordion-item border-0">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed oh-print-bridge-setup-accordion-btn"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#pbManualSetupCollapse"
                            aria-expanded="false"
                            aria-controls="pbManualSetupCollapse">
                        @L["PrintBridge.Auto.ManualSectionTitle"]
                    </button>
                </h2>
                <div id="pbManualSetupCollapse" class="accordion-collapse collapse" data-bs-parent="#pbManualSetup">
                    <div class="accordion-body pt-0">
                        <section class="mb-4 oh-print-bridge-package-card" id="pbPackageSection">
                            @if (Model.PackageAvailable)
                            {
                                <h3 class="h6 mb-2">@L["PrintBridge.PackageCardTitle"]</h3>
                                <p class="text-muted small mb-3">@L["PrintBridge.DownloadCardText"]</p>
                                <div class="oh-print-bridge-package-placeholder-row oh-print-bridge-package-placeholder-row--ready">
                                    <div class="oh-print-bridge-package-placeholder-row__icon" aria-hidden="true">
                                        <i class="bi bi-file-earmark-zip"></i>
                                    </div>
                                    <div class="flex-grow-1 min-width-0">
                                        <div class="fw-semibold small text-truncate">@Model.PackageFileName</div>
                                        <div class="text-muted small">@L["PrintBridge.PackageStatusLabel"] @L["PrintBridge.PackageReadyStatus"]</div>
                                    </div>
                                    <a class="btn btn-outline-primary btn-sm flex-shrink-0" href="@Model.PackageDownloadUrl">
                                        <i class="bi bi-download me-1" aria-hidden="true"></i>@L["PrintBridge.DownloadButton"]
                                    </a>
                                </div>
                            }
                            else
                            {
                                <div id="pbPackagePlaceholderCard">
                                    <h3 class="h6 mb-2">@L["PrintBridge.PackageCardTitle"]</h3>
                                    <p class="text-muted small mb-3">@L["PrintBridge.PackageComingSoon"]</p>
                                    <div class="oh-print-bridge-package-placeholder-row">
                                        <div class="oh-print-bridge-package-placeholder-row__icon" aria-hidden="true">
                                            <i class="bi bi-file-earmark-zip"></i>
                                        </div>
                                        <div class="flex-grow-1 min-width-0">
                                            <div class="fw-semibold small text-truncate">@L["PrintBridge.PackagePlaceholderFileName"]</div>
                                            <div class="text-muted small">@L["PrintBridge.PackageStatusLabel"] @L["PrintBridge.PackageNotReadyStatus"]</div>
                                        </div>
                                        <span class="badge rounded-pill oh-print-bridge-package-status-badge flex-shrink-0">@L["PrintBridge.PackageNotReadyStatus"]</span>
                                    </div>
                                    <button type="button" class="btn btn-outline-secondary btn-sm mt-3" id="pbPackageDownloadUnavailableBtn" disabled>
                                        @L["PrintBridge.PackageDownloadUnavailable"]
                                    </button>
                                    @if (Model.IsDevelopment)
                                    {
                                        <p class="small text-muted mt-3 mb-0">@L["PrintBridge.PackageNotPreparedDevHint"]</p>
                                    }
                                </div>
                            }
                        </section>

                        <section class="mb-4 oh-print-bridge-connection-card">
                            <h3 class="h6 mb-2">@L["PrintBridge.ConnectionInfoTitle"]</h3>
                            <label class="form-label small fw-semibold mb-1" for="pbSetupServerUrl">@L["PrintBridge.ServerUrlLabel"]</label>
                            @if (!string.IsNullOrWhiteSpace(Model.ServerUrl))
                            {
                                <div class="input-group input-group-sm mb-2">
                                    <input type="text"
                                           class="form-control font-monospace oh-print-bridge-setup-value"
                                           id="pbSetupServerUrl"
                                           value="@Model.ServerUrl"
                                           readonly />
                                    <button type="button"
                                            class="btn btn-outline-secondary"
                                            id="pbSetupCopyServerUrlBtn"
                                            title="@L["PrintBridge.CopyServerUrl"]"
                                            aria-label="@L["PrintBridge.CopyServerUrl"]">
                                        <i class="bi bi-clipboard" aria-hidden="true"></i>
                                        <span class="d-none d-md-inline ms-1">@L["PrintBridge.Copy"]</span>
                                    </button>
                                </div>
                            }
                            else
                            {
                                <p class="small text-muted mb-2">@L["PrintBridge.ServerUrlUnavailable"]</p>
                            }
                            <p class="small text-muted mb-0">@L["PrintBridge.Auto.NetworkHelp"]</p>
                        </section>

                        <section class="mb-4" id="pbManualSetupCodeCard">
                            <h3 class="h6 mb-2">@L["PrintBridge.Auto.OneTimeSetupCode"]</h3>
                            <p class="small text-muted mb-3">@L["PrintBridge.Auto.SetupCodeHelp"]</p>
                            <button type="button" class="btn btn-outline-primary btn-sm" id="pbManualSetupCodeActionBtn">
                                <i class="bi bi-shield-lock me-1" aria-hidden="true"></i><span id="pbManualSetupCodeActionText">@L["PrintBridge.Auto.GenerateNewDeviceSetupCode"]</span>
                            </button>

                            <div id="pbManualSetupCodeBox" class="oh-print-bridge-setup-code-result mt-3 d-none" role="status" aria-live="polite">
                                <div class="fw-semibold small mb-1" id="pbManualSetupCodeTitle"></div>
                                <p class="small text-muted mb-2" id="pbManualSetupCodeNotice"></p>
                                <div id="pbManualSetupCodeWarning" class="small text-danger mb-2 d-none" role="alert"></div>
                                <div class="d-flex flex-wrap align-items-stretch gap-2">
                                    <pre id="pbManualSetupCodeValue" class="font-monospace small flex-grow-1 mb-0 p-3 rounded border bg-body user-select-all text-break oh-print-bridge-token-value"></pre>
                                    <button type="button" class="btn btn-sm btn-outline-primary align-self-start" id="pbManualCopySetupCodeBtn">
                                        <i class="bi bi-clipboard me-1" aria-hidden="true"></i>@L["PrintBridge.Auto.CopySetupCode"]
                                    </button>
                                </div>
                            </div>
                        </section>

                        <section class="mb-4">
                            <h3 class="h6 mb-2">@L["PrintBridge.SetupStepsTitle"]</h3>
                            <ol class="oh-print-bridge-setup-steps small text-muted mb-0">
                                <li>@L["PrintBridge.SetupStep1"]</li>
                                <li>@L["PrintBridge.SetupStep2"]</li>
                                <li>@L["PrintBridge.SetupStep3"]</li>
                                <li>@L["PrintBridge.SetupStep4"]</li>
                                <li>@L["PrintBridge.SetupStep5"]</li>
                                <li>@L["PrintBridge.SetupStep6"]</li>
                            </ol>
                        </section>

                        <section>
                            <h3 class="h6 mb-2">@L["PrintBridge.RequirementsTitle"]</h3>
                            <ul class="oh-print-bridge-guide-checklist small text-muted mb-0">
                                <li>@L["PrintBridge.Requirement1"]</li>
                                <li>@L["PrintBridge.Requirement2"]</li>
                                <li>@L["PrintBridge.Requirement3"]</li>
                                <li>@L["PrintBridge.Requirement4"]</li>
                            </ul>
                        </section>
                    </div>
                </div>
            </div>
        </div>

        <div class="accordion oh-print-bridge-setup-accordion mb-3" id="pbTroubleshootingSection">
            <div class="accordion-item border-0">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed oh-print-bridge-setup-accordion-btn"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#pbTroubleshootingCollapse"
                            aria-expanded="false"
                            aria-controls="pbTroubleshootingCollapse">
                        @L["PrintBridge.Troubleshooting"]
                    </button>
                </h2>
                <div id="pbTroubleshootingCollapse" class="accordion-collapse collapse" data-bs-parent="#pbTroubleshootingSection">
                    <div class="accordion-body pt-0">
                        <div class="accordion accordion-flush oh-print-bridge-faq" id="printBridgeSetupFaq">
                            <div class="accordion-item">
                                <h3 class="accordion-header" id="pbFaqHeading1">
                                    <button class="accordion-button collapsed small py-2" type="button" data-bs-toggle="collapse" data-bs-target="#pbFaq1" aria-expanded="false" aria-controls="pbFaq1">
                                        @L["PrintBridge.FaqConnectionFailed"]
                                    </button>
                                </h3>
                                <div id="pbFaq1" class="accordion-collapse collapse" aria-labelledby="pbFaqHeading1" data-bs-parent="#printBridgeSetupFaq">
                                    <div class="accordion-body small text-muted pt-0">@L["PrintBridge.FaqConnectionFailedAnswer"]</div>
                                </div>
                            </div>
                            <div class="accordion-item">
                                <h3 class="accordion-header" id="pbFaqHeading2">
                                    <button class="accordion-button collapsed small py-2" type="button" data-bs-toggle="collapse" data-bs-target="#pbFaq2" aria-expanded="false" aria-controls="pbFaq2">
                                        @L["PrintBridge.FaqPrinterMissing"]
                                    </button>
                                </h3>
                                <div id="pbFaq2" class="accordion-collapse collapse" aria-labelledby="pbFaqHeading2" data-bs-parent="#printBridgeSetupFaq">
                                    <div class="accordion-body small text-muted pt-0">@L["PrintBridge.FaqPrinterMissingAnswer"]</div>
                                </div>
                            </div>
                            <div class="accordion-item">
                                <h3 class="accordion-header" id="pbFaqHeading3">
                                    <button class="accordion-button collapsed small py-2" type="button" data-bs-toggle="collapse" data-bs-target="#pbFaq3" aria-expanded="false" aria-controls="pbFaq3">
                                        @L["PrintBridge.FaqNoReceipt"]
                                    </button>
                                </h3>
                                <div id="pbFaq3" class="accordion-collapse collapse" aria-labelledby="pbFaqHeading3" data-bs-parent="#printBridgeSetupFaq">
                                    <div class="accordion-body small text-muted pt-0">@L["PrintBridge.FaqNoReceiptAnswer"]</div>
                                </div>
                            </div>
                            <div class="accordion-item">
                                <h3 class="accordion-header" id="pbFaqHeading4">
                                    <button class="accordion-button collapsed small py-2" type="button" data-bs-toggle="collapse" data-bs-target="#pbFaq4" aria-expanded="false" aria-controls="pbFaq4">
                                        @L["PrintBridge.FaqTokenChanged"]
                                    </button>
                                </h3>
                                <div id="pbFaq4" class="accordion-collapse collapse" aria-labelledby="pbFaqHeading4" data-bs-parent="#printBridgeSetupFaq">
                                    <div class="accordion-body small text-muted pt-0">@L["PrintBridge.FaqTokenChangedAnswer"]</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        </div>
    </div>
</div>

<script type="application/json" id="printBridgeSetupConfig">@Html.Raw(JsonSerializer.Serialize(setupConfig))</script>
<script src="~/js/print-bridge/print-bridge-setup.js" asp-append-version="true"></script>
