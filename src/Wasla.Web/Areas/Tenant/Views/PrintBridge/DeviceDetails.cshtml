@model Wasla.Web.Models.PrintBridge.PrintBridgeDeviceDetailsViewModel
@using System.Text.Json
@using Microsoft.Extensions.Localization
@using Wasla.Application.Abstractions.Printing
@inject IStringLocalizer<Wasla.Web.SharedResource> L
@{
    ViewData["Title"] = L["PrintBridge.DeviceDetailsTitle"];

    string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value.Trim();
    string FormatDate(DateTime? value) => value.HasValue ? value.Value.ToLocalTime().ToString("g") : L["PrintBridge.LastSeenNever"].Value;
    var connectionBadgeClass = Model.ConnectionStatus switch
    {
        PrintBridgeConnectionStatus.Connected => "text-bg-success",
        PrintBridgeConnectionStatus.Inactive => "text-bg-secondary",
        _ => "text-bg-warning"
    };
    var activeBadgeClass = Model.IsActive ? "text-bg-success" : "text-bg-secondary";
    var setActiveLabel = Model.IsActive ? L["PrintBridge.DisableDevice"] : L["PrintBridge.EnableDevice"];
    var setActiveIcon = Model.IsActive ? "bi-pause-circle" : "bi-play-circle";
    var deviceDetailsConfigJson = JsonSerializer.Serialize(new
    {
        endpoints = new
        {
            regenerate = $"/print-bridge/devices/{Model.Id}/regenerate-token",
            setActive = $"/print-bridge/devices/{Model.Id}/set-active",
            nextIsActive = !Model.IsActive
        },
        messages = new
        {
            confirmRegenerateToken = L["PrintBridge.ConfirmRegenerateToken", Model.Name].Value,
            tokenRegenerateWarning = L["PrintBridge.TokenRegenerateWarning"].Value,
            tokenRegenerateFailed = L["PrintBridge.TokenRegenerateFailed"].Value,
            tokenMasked = L["PrintBridge.TokenMasked"].Value,
            tokenCopied = L["PrintBridge.TokenCopied"].Value,
            tokenCopyFailed = L["PrintBridge.TokenCopyFailed"].Value,
            copied = L["PrintBridge.Copied"].Value,
            deviceUpdateFailed = L["PrintBridge.DeviceUpdateFailed"].Value
        }
    });
}

<div class="oh-customer-page-header d-flex flex-wrap align-items-start justify-content-between gap-3 mb-3">
    <div class="oh-customer-page-header__main">
        <div class="mb-2">
            <a class="small text-decoration-none" href="@Model.DevicesUrl">
                <i class="bi bi-arrow-left me-1"></i>@L["PrintBridge.BackToDevices"]
            </a>
        </div>
        <h1 class="oh-customer-page-header__title h4 mb-1">@L["PrintBridge.DeviceDetailsTitle"]</h1>
        <p class="oh-customer-page-header__subtitle text-muted small mb-0">@L["PrintBridge.DeviceDetailsSubtitle"]</p>
    </div>
</div>

@if (TempData["PrintBridgeDeviceMessage"] is string successMessage)
{
    <div class="alert alert-success small py-2" role="alert">@successMessage</div>
}
@if (TempData["PrintBridgeDeviceError"] is string errorMessage)
{
    <div class="alert alert-danger small py-2" role="alert">@errorMessage</div>
}

<form id="printBridgeDeviceAntiForgery" method="post" class="d-none">
    @Html.AntiForgeryToken()
</form>

<div id="printBridgeDeviceMessageHost"></div>

<div class="row g-3">
    <div class="col-lg-5">
        <div class="card oh-card h-100">
            <div class="card-body">
                <h2 class="h6 mb-3">@L["PrintBridge.DeviceIdentity"]</h2>
                <div class="d-flex align-items-start justify-content-between gap-3 mb-3">
                    <div>
                        <div class="text-muted small">@L["PrintBridge.WebDisplayName"]</div>
                        <div class="h4 mb-1">@Model.Name</div>
                        <div class="text-muted small">@L["PrintBridge.MachineName"]: @Display(Model.MachineName)</div>
                    </div>
                    <div class="d-flex flex-column align-items-end gap-1">
                        <span class="badge @connectionBadgeClass">@L[Model.ConnectionStatusLabelKey]</span>
                        <span class="badge @activeBadgeClass">@(Model.IsActive ? L["PrintBridge.Enabled"] : L["PrintBridge.Disabled"])</span>
                    </div>
                </div>

                <form asp-action="RenameDevice" asp-route-id="@Model.Id" method="post" class="border rounded-3 p-3 bg-body-tertiary">
                    @Html.AntiForgeryToken()
                    <label class="form-label small fw-semibold" for="deviceName">@L["PrintBridge.WebDisplayName"]</label>
                    <input class="form-control form-control-sm" id="deviceName" name="name"
                           value="@Model.Name" maxlength="@PrintBridgeDeviceNameRules.MaxWebDisplayNameLength" required />
                    <div class="form-text">@L["PrintBridge.WebDisplayNameHelp"]</div>
                    <div class="d-flex flex-wrap align-items-center gap-2 mt-3">
                        <button type="submit" class="btn btn-primary btn-sm">
                            <i class="bi bi-save me-1"></i>@L["Common.Save"]
                        </button>
                        <a class="btn btn-outline-secondary btn-sm" href="@Model.DevicesUrl">@L["Common.Cancel"]</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card oh-card h-100">
            <div class="card-body">
                <h2 class="h6 mb-3">@L["PrintBridge.DeviceTechnicalInfo"]</h2>
                <dl class="row small mb-0">
                    <dt class="col-sm-5">@L["PrintBridge.MachineName"]</dt>
                    <dd class="col-sm-7">@Display(Model.MachineName)</dd>

                    <dt class="col-sm-5">@L["PrintBridge.ConnectionStatus"]</dt>
                    <dd class="col-sm-7"><span class="badge @connectionBadgeClass">@L[Model.ConnectionStatusLabelKey]</span></dd>

                    <dt class="col-sm-5">@L["PrintBridge.DeviceState"]</dt>
                    <dd class="col-sm-7"><span class="badge @activeBadgeClass">@(Model.IsActive ? L["PrintBridge.Enabled"] : L["PrintBridge.Disabled"])</span></dd>

                    <dt class="col-sm-5">@L["PrintBridge.LastSeen"]</dt>
                    <dd class="col-sm-7">@FormatDate(Model.LastSeenAtUtc)</dd>

                    <dt class="col-sm-5">@L["PrintBridge.AppVersion"]</dt>
                    <dd class="col-sm-7">@Display(Model.AppVersion)</dd>

                    <dt class="col-sm-5">@L["PrintBridge.PrinterName"]</dt>
                    <dd class="col-sm-7">@Display(Model.PrinterName)</dd>

                    <dt class="col-sm-5">@L["PrintBridge.CreatedAt"]</dt>
                    <dd class="col-sm-7">@Model.CreatedAtUtc.ToLocalTime().ToString("g")</dd>

                    <dt class="col-sm-5">@L["PrintBridge.TokenStatus"]</dt>
                    <dd class="col-sm-7">@(Model.HasToken ? L["PrintBridge.TokenConfigured"] : L["PrintBridge.TokenMissing"])</dd>
                </dl>
            </div>
        </div>
    </div>
</div>

<div class="card oh-card mt-3">
    <div class="card-body">
        <h2 class="h6 mb-2">@L["PrintBridge.DeviceActions"]</h2>
        <p class="text-muted small mb-3">@L["PrintBridge.DeviceTokenSafeNote"]</p>

        <div id="printBridgeDetailTokenBox" class="d-none border rounded-3 p-3 mb-3 bg-body-tertiary" role="region" aria-live="polite">
            <div class="d-flex align-items-start justify-content-between gap-2 mb-2">
                <div class="flex-grow-1">
                    <div class="form-label small fw-semibold mb-1">@L["PrintBridge.DeviceToken"]</div>
                    <div id="printBridgeDetailTokenTitle" class="small fw-semibold text-warning-emphasis"></div>
                    <div id="printBridgeDetailTokenNotice" class="text-muted small mt-1 mb-0"></div>
                </div>
                <button type="button" class="btn-close btn-close-sm mt-1" id="printBridgeDetailDismissTokenBtn"
                        aria-label="@L["PrintBridge.DismissTokenBox"]"></button>
            </div>
            <div id="printBridgeDetailTokenWarning" class="alert alert-danger small py-2 mb-2 d-none" role="alert"></div>
            <div class="d-flex flex-wrap align-items-stretch gap-2">
                <pre id="printBridgeDetailTokenValue" class="font-monospace small flex-grow-1 mb-0 p-3 rounded border bg-body user-select-all text-break oh-print-bridge-token-value"></pre>
                <button type="button" class="btn btn-sm btn-primary align-self-start" id="printBridgeDetailCopyTokenBtn">
                    <i class="bi bi-clipboard me-1"></i>@L["PrintBridge.CopyToken"]
                </button>
            </div>
        </div>

        <div class="d-flex flex-wrap align-items-center gap-2">
            <a class="btn btn-outline-secondary btn-sm" href="@Model.SetupUrl">
                <i class="bi bi-arrow-repeat me-1"></i>@L["PrintBridge.SetupReconnectAction"]
            </a>
            <button type="button" class="btn btn-outline-warning btn-sm" id="printBridgeDetailRegenerateTokenBtn">
                <i class="bi bi-key me-1"></i>@L["PrintBridge.RegenerateToken"]
            </button>
            <button type="button" class="btn btn-outline-secondary btn-sm" id="printBridgeDetailSetActiveBtn">
                <i class="bi @setActiveIcon me-1"></i>@setActiveLabel
            </button>
            <a class="btn btn-outline-secondary btn-sm" href="@Model.PrintJobsUrl">
                <i class="bi bi-receipt me-1"></i>@L["PrintBridge.RecentPrintActivity"]
            </a>
        </div>
    </div>
</div>

<div class="card border-danger mt-3">
    <div class="card-body">
        <div class="d-flex flex-wrap align-items-start justify-content-between gap-3">
            <div>
                <h2 class="h6 text-danger mb-2">@L["PrintBridge.DeviceRemoveDangerTitle"]</h2>
                <p class="small mb-2">@L["PrintBridge.DeviceRemoveConfirmMessage", Model.Name]</p>
                <p class="text-muted small mb-0">@L["PrintBridge.DeviceDisableRemoveExplanation"]</p>
            </div>
            <button type="button" class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#printBridgeRemoveDeviceModal">
                <i class="bi bi-trash3 me-1"></i>@L["PrintBridge.RemoveDevice"]
            </button>
        </div>
    </div>
</div>

<div class="modal fade" id="printBridgeRemoveDeviceModal" tabindex="-1" aria-labelledby="printBridgeRemoveDeviceModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h6" id="printBridgeRemoveDeviceModalTitle">@L["PrintBridge.DeviceRemoveDangerTitle"]</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["Common.Cancel"]"></button>
            </div>
            <div class="modal-body">
                <p class="mb-2">@L["PrintBridge.DeviceRemoveConfirmMessage", Model.Name]</p>
                <p class="text-muted small mb-0">@L["PrintBridge.DeviceDisableRemoveExplanation"]</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">@L["PrintBridge.DeviceRemoveCancel"]</button>
                <form asp-action="RemoveDevice" asp-route-id="@Model.Id" method="post" class="m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger btn-sm">@L["PrintBridge.DeviceRemoveConfirm"]</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            "use strict";

            var config = @Html.Raw(deviceDetailsConfigJson);
            var currentToken = null;
            var endpoints = config.endpoints;
            var messages = config.messages;

            function getToken() {
                var form = document.getElementById("printBridgeDeviceAntiForgery");
                var el = form ? form.querySelector("input[name='__RequestVerificationToken']") : null;
                return el ? el.value : "";
            }

            function showMessage(text, type) {
                var host = document.getElementById("printBridgeDeviceMessageHost");
                if (!host) return;
                var cls = type === "danger" ? "alert-danger" : "alert-success";
                host.innerHTML = '<div class="alert ' + cls + ' small py-2" role="alert">' + escapeHtml(text || "") + '</div>';
            }

            function escapeHtml(value) {
                return String(value == null ? "" : value)
                    .replace(/&/g, "&amp;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;")
                    .replace(/"/g, "&quot;");
            }

            function post(url, fields) {
                var body = new URLSearchParams();
                var token = getToken();
                body.set("__RequestVerificationToken", token);
                Object.keys(fields || {}).forEach(function (key) { body.set(key, fields[key]); });
                return fetch(url, {
                    method: "POST",
                    headers: { "RequestVerificationToken": token, "X-Requested-With": "fetch" },
                    body: body
                }).then(function (resp) {
                    if (!resp.ok) {
                        return resp.json().catch(function () { return {}; }).then(function (err) {
                            throw new Error((err && err.message) || messages.deviceUpdateFailed);
                        });
                    }
                    return resp.json();
                });
            }

            function hideToken() {
                currentToken = null;
                var box = document.getElementById("printBridgeDetailTokenBox");
                if (box) box.classList.add("d-none");
            }

            function showToken(data) {
                currentToken = data && data.token;
                var box = document.getElementById("printBridgeDetailTokenBox");
                var value = document.getElementById("printBridgeDetailTokenValue");
                var title = document.getElementById("printBridgeDetailTokenTitle");
                var notice = document.getElementById("printBridgeDetailTokenNotice");
                var warning = document.getElementById("printBridgeDetailTokenWarning");
                if (!box || !value || !currentToken) return;
                value.textContent = currentToken;
                if (title) title.textContent = data.tokenTitle || "";
                if (notice) notice.textContent = data.tokenNotice || "";
                if (warning) {
                    warning.textContent = data.tokenWarning || "";
                    warning.classList.toggle("d-none", !data.tokenWarning);
                }
                box.classList.remove("d-none");
                box.scrollIntoView({ behavior: "smooth", block: "nearest" });
            }

            function copyCurrentToken(btn) {
                if (!currentToken) {
                    showMessage(messages.tokenMasked, "danger");
                    return;
                }
                navigator.clipboard.writeText(currentToken).then(function () {
                    var original = btn.innerHTML;
                    btn.innerHTML = '<i class="bi bi-check2 me-1"></i>' + escapeHtml(messages.copied);
                    setTimeout(function () { btn.innerHTML = original; }, 1800);
                }).catch(function () {
                    showMessage(messages.tokenCopyFailed, "danger");
                });
            }

            document.addEventListener("DOMContentLoaded", function () {
                hideToken();

                var regenerateBtn = document.getElementById("printBridgeDetailRegenerateTokenBtn");
                if (regenerateBtn) {
                    regenerateBtn.addEventListener("click", function () {
                        var confirmText = messages.confirmRegenerateToken + "\n\n" + messages.tokenRegenerateWarning;
                        if (!window.confirm(confirmText)) return;
                        regenerateBtn.disabled = true;
                        post(endpoints.regenerate, {})
                            .then(function (data) {
                                showToken(data);
                                if (data.message) showMessage(data.message, "success");
                            })
                            .catch(function () { showMessage(messages.tokenRegenerateFailed, "danger"); })
                            .finally(function () { regenerateBtn.disabled = false; });
                    });
                }

                var setActiveBtn = document.getElementById("printBridgeDetailSetActiveBtn");
                if (setActiveBtn) {
                    setActiveBtn.addEventListener("click", function () {
                        setActiveBtn.disabled = true;
                        post(endpoints.setActive, { isActive: endpoints.nextIsActive ? "true" : "false" })
                            .then(function () { window.location.reload(); })
                            .catch(function (e) { showMessage(e.message || messages.deviceUpdateFailed, "danger"); })
                            .finally(function () { setActiveBtn.disabled = false; });
                    });
                }

                var copyBtn = document.getElementById("printBridgeDetailCopyTokenBtn");
                if (copyBtn) copyBtn.addEventListener("click", function () { copyCurrentToken(copyBtn); });

                var dismissBtn = document.getElementById("printBridgeDetailDismissTokenBtn");
                if (dismissBtn) dismissBtn.addEventListener("click", hideToken);
            });
        })();
    </script>
}
