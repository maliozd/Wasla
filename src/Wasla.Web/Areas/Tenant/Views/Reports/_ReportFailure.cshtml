<div class="rpt-panel rpt-state" role="alert">
    <span class="rpt-state__icon rpt-state__icon--danger" aria-hidden="true"><i class="bi bi-wifi-off"></i></span>
    <h2 class="rpt-state__title">@L["Reports.FailureTitle"]</h2>
    <p class="rpt-state__text">@L["Reports.FailureHint"]</p>
    <button type="button" class="rpt-btn rpt-btn--primary" data-rpt-retry><i class="bi bi-arrow-repeat" aria-hidden="true"></i><span>@L["Reports.Retry"]</span></button>
</div>
