@model (Wasla.Application.Abstractions.Reports.OrderReportFigures Figures, Wasla.Application.Abstractions.Reports.OrderReportFigures Total)
@using Wasla.Web.Models.Reports
@{
    var f = Model.Figures;
    var cells = new (string Key, string Value)[]
    {
        ("Reports.OrderCount", ReportFormat.Count(f.OrderCount)),
        ("Reports.OrderShare", ReportFormat.Percent(ReportPresenter.Share(f.OrderCount, Model.Total.OrderCount))),
        ("Reports.Outcome.Delivered", ReportFormat.Count(f.CompletedOrderCount)),
        ("Reports.CompletedValue", ReportFormat.Money(f.CompletedOrderValue)),
        ("Reports.ValueShare", ReportFormat.Percent(ReportPresenter.Share(f.CompletedOrderValue, Model.Total.CompletedOrderValue))),
        ("Reports.AverageCompletedValue", ReportFormat.Money(f.AverageCompletedOrderValue)),
        ("Reports.Outcome.Cancelled", ReportFormat.Count(f.CancelledOrderCount)),
        ("Reports.CancellationRate", ReportFormat.Percent(f.CancellationRate))
    };
}
@foreach (var cell in cells)
{
    <td class="wasla-table__num">
        <span class="wasla-table__cell-label" aria-hidden="true">@L[cell.Key]</span>
        <bdi>@cell.Value</bdi>
    </td>
}
