@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Wasla.Web.SharedResource> L
@{
    ViewData["Title"] = L["Onboarding.Title"];
}
<div class="oh-onboarding-page">
    <div class="mb-4">
        <h1 class="h4 mb-2">@L["Onboarding.Title"]</h1>
        <p class="text-muted mb-0">@L["Onboarding.Subtitle"]</p>
    </div>

    <div class="row g-3">
        <div class="col-md-6 col-xl-3">
            <div class="card oh-card h-100">
                <div class="card-body">
                    <div class="oh-onboarding-icon mb-2"><i class="bi bi-plug"></i></div>
                    <h2 class="h6 fw-semibold">@L["Onboarding.StepPlatformsTitle"]</h2>
                    <p class="small text-muted mb-3">@L["Onboarding.StepPlatformsDescription"]</p>
                    <a class="btn btn-sm btn-outline-primary" href="/platform-connections">@L["Onboarding.Open"]</a>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card oh-card h-100">
                <div class="card-body">
                    <div class="oh-onboarding-icon mb-2"><i class="bi bi-receipt"></i></div>
                    <h2 class="h6 fw-semibold">@L["Onboarding.StepReceiptTitle"]</h2>
                    <p class="small text-muted mb-3">@L["Onboarding.StepReceiptDescription"]</p>
                    <a class="btn btn-sm btn-outline-primary" href="/settings/receipt-printer">@L["Onboarding.Open"]</a>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card oh-card h-100">
                <div class="card-body">
                    <div class="oh-onboarding-icon mb-2"><i class="bi bi-printer"></i></div>
                    <h2 class="h6 fw-semibold">@L["Onboarding.StepPrintBridgeTitle"]</h2>
                    <p class="small text-muted mb-3">@L["Onboarding.StepPrintBridgeDescription"]</p>
                    <a class="btn btn-sm btn-outline-primary" href="/print-bridge">@L["Onboarding.Open"]</a>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card oh-card h-100">
                <div class="card-body">
                    <div class="oh-onboarding-icon mb-2"><i class="bi bi-gear"></i></div>
                    <h2 class="h6 fw-semibold">@L["Onboarding.StepSettingsTitle"]</h2>
                    <p class="small text-muted mb-3">@L["Onboarding.StepSettingsDescription"]</p>
                    <a class="btn btn-sm btn-outline-primary" href="/settings/account">@L["Onboarding.Open"]</a>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-4 d-flex flex-wrap gap-2">
        <a class="btn btn-primary" href="/dashboard">@L["Onboarding.GoToDashboard"]</a>
        <a class="btn btn-outline-secondary" href="/orders">@L["Onboarding.GoToOrders"]</a>
    </div>
</div>
