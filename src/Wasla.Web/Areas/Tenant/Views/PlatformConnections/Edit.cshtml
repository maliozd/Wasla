@model Wasla.Web.Models.PlatformConnections.EditPlatformConnectionViewModel
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Wasla.Web.SharedResource> L
@{
    ViewData["Title"] = L["PlatformConnections.Edit"];
    var isTrendyol = Model.Platform == Wasla.Domain.Enums.FoodPlatform.TrendyolYemek;
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h1 class="h4 mb-0">@L["PlatformConnections.Edit"]</h1>
    <a class="btn btn-sm btn-outline-primary" href="/platform-connections">@L["PlatformConnections.Back"]</a>
</div>

<div class="card wasla-card">
    <div class="card-body">
        <form method="post" action="/platform-connections/@Model.Id/edit">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            @if (Model.CredentialsNeedReentry)
            {
                <div class="alert alert-warning" role="status">@L["PlatformConnections.CredentialsReenter"]</div>
            }

            <div class="row g-3">
                <div class="col-12 col-md-4">
                    <label class="form-label" asp-for="Platform"></label>
                    <input class="form-control" value="@Model.Platform" readonly />
                    <input type="hidden" asp-for="Platform" />
                </div>

                <div class="col-12 col-md-8">
                    <label class="form-label" asp-for="StoreId"></label>
                    <input class="form-control" asp-for="StoreId" />
                    <div id="trendyolStoreIdHelp" class="form-text @(isTrendyol ? "" : "d-none")">
                        @L["PlatformConnections.TrendyolStoreIdHelp"]
                    </div>
                    <span class="text-danger" asp-validation-for="StoreId"></span>
                </div>

                <div class="col-12 col-md-6 trendyol-only @(isTrendyol ? "" : "d-none")">
                    <label class="form-label" asp-for="SupplierId"></label>
                    <input class="form-control" asp-for="SupplierId" />
                    <div class="form-text">@L["PlatformConnections.SupplierIdHelp"]</div>
                    <span class="text-danger" asp-validation-for="SupplierId"></span>
                </div>

                <div class="col-12 col-md-6 trendyol-only @(isTrendyol ? "" : "d-none")">
                    <label class="form-label" asp-for="ExecutorEmail"></label>
                    <input class="form-control" asp-for="ExecutorEmail" type="email" autocomplete="email" />
                    <div class="form-text">@L["PlatformConnections.ExecutorEmailHelp"]</div>
                    <span class="text-danger" asp-validation-for="ExecutorEmail"></span>
                </div>

                <div class="col-12 col-md-8 d-flex align-items-end">
                    <div class="form-check form-switch">
                        <input class="form-check-input" asp-for="IsActive" />
                        <label class="form-check-label" asp-for="IsActive"></label>
                    </div>
                </div>

                @* Provider credentials: masked and always empty. A stored value never reaches the browser, only whether one
                   is stored. Empty keeps the stored value; a new value replaces it once the whole edit succeeds. The reveal
                   control only shows what was typed into this form. *@
                <div class="col-12 col-md-6">
                    <label class="form-label" asp-for="ApiKey"></label>
                    <div class="input-group">
                        <input class="form-control" asp-for="ApiKey" type="password" autocomplete="off" autocapitalize="off" spellcheck="false" dir="ltr"
                               aria-describedby="apiKeyStored" />
                        <button class="btn btn-outline-secondary" type="button" data-credential-toggle aria-controls="ApiKey" aria-pressed="false"
                                aria-label="@L["PlatformConnections.ShowApiKey"]" title="@L["PlatformConnections.ShowApiKey"]" hidden>
                            <i class="bi bi-eye" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="form-text" id="apiKeyStored">
                        @if (Model.HasStoredApiKey)
                        {
                            <span><i class="bi bi-shield-lock" aria-hidden="true"></i> @L["PlatformConnections.CredentialSaved"] @L["PlatformConnections.ApiLeaveEmptyHelp"]</span>
                        }
                        else
                        {
                            <span>@L["PlatformConnections.CredentialMissing"]</span>
                        }
                    </div>
                    <span class="text-danger" asp-validation-for="ApiKey"></span>
                </div>

                <div class="col-12 col-md-6">
                    <label class="form-label" asp-for="ApiSecret"></label>
                    <div class="input-group">
                        <input class="form-control" asp-for="ApiSecret" type="password" autocomplete="off" autocapitalize="off" spellcheck="false" dir="ltr"
                               aria-describedby="apiSecretStored" />
                        <button class="btn btn-outline-secondary" type="button" data-credential-toggle aria-controls="ApiSecret" aria-pressed="false"
                                aria-label="@L["PlatformConnections.ShowApiSecret"]" title="@L["PlatformConnections.ShowApiSecret"]" hidden>
                            <i class="bi bi-eye" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="form-text" id="apiSecretStored">
                        @if (Model.HasStoredApiSecret)
                        {
                            <span><i class="bi bi-shield-lock" aria-hidden="true"></i> @L["PlatformConnections.CredentialSaved"] @L["PlatformConnections.ApiLeaveEmptyHelp"]</span>
                        }
                        else
                        {
                            <span>@L["PlatformConnections.CredentialMissing"]</span>
                        }
                    </div>
                    <span class="text-danger" asp-validation-for="ApiSecret"></span>
                </div>

                <div class="col-12 d-flex gap-2">
                    <button class="btn btn-primary" type="submit">@L["PlatformConnections.Update"]</button>
                    <a class="btn btn-outline-secondary" href="/platform-connections">@L["Common.Cancel"]</a>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script src="~/js/platform-connections/platform-connection-form.js" asp-append-version="true"></script>
}
