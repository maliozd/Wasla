@model Wasla.Web.Models.PlatformConnections.PlatformConnectionListViewModel
@using Microsoft.Extensions.Localization
@using System.Text.Json
@inject IStringLocalizer<Wasla.Web.SharedResource> L
@{
    ViewData["Title"] = L["PlatformConnections.Title"];

    var pcMessages = new
    {
        activeText = L["PlatformConnections.Active"].Value,
        inactiveText = L["PlatformConnections.Inactive"].Value,
        toggled = L["PlatformConnections.Updated"].Value,
        toggleFailed = L["PlatformConnections.ToggleFailed"].Value
    };
    var pcMessagesJson = JsonSerializer.Serialize(pcMessages);
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h1 class="h4 mb-0">@L["PlatformConnections.Title"]</h1>
    <a class="btn btn-sm btn-primary" href="/platform-connections/create">@L["PlatformConnections.Create"]</a>
</div>

<div class="card oh-card">
    <div class="card-body">
        <form id="platformConnectionsAntiForgery" class="d-none" method="post">
            @Html.AntiForgeryToken()
        </form>
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead>
                <tr>
                    <th>@L["PlatformConnections.Platform"]</th>
                    <th>@L["PlatformConnections.StoreId"]</th>
                    <th>@L["Common.Status"]</th>
                    <th class="text-end">@L["PlatformConnections.ErrorCount"]</th>
                    <th class="text-end">@L["PlatformConnections.CircuitOpenUntil"]</th>
                    <th class="text-end">@L["PlatformConnections.LastSuccessfulSync"]</th>
                    <th class="text-end">@L["PlatformConnections.Actions"]</th>
                </tr>
                </thead>
                <tbody>
                @if (Model.Connections.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">@L["PlatformConnections.NoConnectionsFound"]</td>
                    </tr>
                }
                else
                {
                    @foreach (var c in Model.Connections)
                    {
                        <tr>
                            <td>@c.Platform</td>
                            <td>@c.StoreId</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge @(c.IsActive ? "text-bg-success" : "text-bg-secondary")">
                                        @(c.IsActive ? L["PlatformConnections.Active"] : L["PlatformConnections.Inactive"])
                                    </span>
                                    <div class="form-check form-switch m-0">
                                        <input class="form-check-input pc-active-toggle"
                                               type="checkbox"
                                               role="switch"
                                               data-connection-id="@c.Id"
                                               @(c.IsActive ? "checked" : null) />
                                    </div>
                                </div>
                            </td>
                            <td class="text-end">@c.ConsecutiveFailures</td>
                            <td class="text-end">@c.CircuitOpenUntilUtc?.ToString("u")</td>
                            <td class="text-end">@c.LastSuccessfulSyncUtc?.ToString("u")</td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-primary"
                                   href="/platform-connections/@c.Id/edit">
                                    @L["PlatformConnections.Edit"]
                                </a>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
        <div class="text-muted small mt-2">
            @L["PlatformConnections.NoteRole"]
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.platformConnectionsMessages = @Html.Raw(pcMessagesJson);
    </script>
    <script src="~/js/platform-connections/platform-connections.js" asp-append-version="true"></script>
}
