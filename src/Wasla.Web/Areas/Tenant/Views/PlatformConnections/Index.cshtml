@model Wasla.Web.Models.PlatformConnections.PlatformConnectionListViewModel
@using Microsoft.Extensions.Localization
@using System.Text.Json
@inject IStringLocalizer<Wasla.Web.SharedResource> L
@{
    ViewData["Title"] = L["PlatformConnections.Title"];

    var pcMessages = new
    {
        activeText = L["PlatformConnections.Active"].Value,
        inactiveText = L["PlatformConnections.Inactive"].Value,
        toggled = L["PlatformConnections.Updated"].Value,
        toggleFailed = L["PlatformConnections.ToggleFailed"].Value
    };
    var pcMessagesJson = JsonSerializer.Serialize(pcMessages);
}

<div class="wasla-connections">
    @await Html.PartialAsync("_WaslaPageHeader", new WaslaPageHeaderModel
    {
        Title = L["PlatformConnections.Title"].Value,
        Description = L["PlatformConnections.NoteRole"].Value,
        ActionUrl = "/platform-connections/create",
        ActionText = L["PlatformConnections.Create"].Value,
        ActionIconClass = "bi bi-plus-lg",
        ActionTourTarget = "platform-connect"
    })

    @if (Model.GuidedSetup is not null)
    {
        @await Html.PartialAsync("_GuidedSetupSectionPanel", Model.GuidedSetup)
    }

    <section class="wasla-surface" aria-labelledby="platform-connections-heading" data-tour="platform-list">
        <h2 id="platform-connections-heading" class="visually-hidden">@L["PlatformConnections.Title"]</h2>
        <form id="platformConnectionsAntiForgery" class="d-none" method="post">
            @Html.AntiForgeryToken()
        </form>

        @if (Model.Connections.Count == 0)
        {
            <div class="wasla-empty">
                <p class="wasla-empty__title">@L["PlatformConnections.NoConnectionsFound"]</p>
            </div>
        }
        else
        {
            <div class="wasla-table-wrap">
                <table class="wasla-table">
                    <thead>
                    <tr>
                        <th scope="col">@L["PlatformConnections.Platform"]</th>
                        <th scope="col">@L["PlatformConnections.StoreId"]</th>
                        <th scope="col">@L["Common.Status"]</th>
                        <th scope="col">@L["PlatformConnections.LastSuccessfulSync"]</th>
                        <th scope="col">@L["PlatformConnections.Actions"]</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var c in Model.Connections)
                    {
                        <tr>
                            <td data-label="@L["PlatformConnections.Platform"]">
                                <span class="wasla-table__cell-label" aria-hidden="true">@L["PlatformConnections.Platform"]</span>
                                <span class="wasla-table__name">@c.Platform</span>
                            </td>
                            <td data-label="@L["PlatformConnections.StoreId"]">
                                <span class="wasla-table__cell-label" aria-hidden="true">@L["PlatformConnections.StoreId"]</span>
                                <span class="wasla-connections__secondary">@c.StoreId</span>
                            </td>
                            <td data-label="@L["Common.Status"]">
                                <span class="wasla-table__cell-label" aria-hidden="true">@L["Common.Status"]</span>
                                <div class="wasla-connections__status">
                                    <div class="wasla-connections__status-main">
                                        <div class="form-check form-switch wasla-connections__switch">
                                            <input class="form-check-input pc-active-toggle"
                                                   type="checkbox"
                                                   role="switch"
                                                   data-connection-id="@c.Id"
                                                   aria-labelledby="pc-status-@c.Id"
                                                   @(c.IsActive ? "checked" : null) />
                                        </div>
                                        <span id="pc-status-@c.Id" class="wasla-connections__status-text@(c.IsActive ? " is-active" : null)">
                                            @(c.IsActive ? L["PlatformConnections.Active"] : L["PlatformConnections.Inactive"])
                                        </span>
                                    </div>
                                    @if (PlatformConnectionListPresentation.ShowConsecutiveErrors(c.ConsecutiveFailures))
                                    {
                                        <p class="wasla-connections__warning">@L["PlatformConnections.ErrorCount"]: @c.ConsecutiveFailures</p>
                                    }
                                    @if (c.CircuitOpenUntilUtc is DateTime circuitOpenUntil
                                         && PlatformConnectionListPresentation.ShowCircuitOpen(circuitOpenUntil, DateTime.UtcNow))
                                    {
                                        <p class="wasla-connections__warning">@L["PlatformConnections.CircuitOpenUntil"]: @circuitOpenUntil.ToString("u")</p>
                                    }
                                </div>
                            </td>
                            <td data-label="@L["PlatformConnections.LastSuccessfulSync"]">
                                <span class="wasla-table__cell-label" aria-hidden="true">@L["PlatformConnections.LastSuccessfulSync"]</span>
                                <span class="wasla-connections__secondary">@c.LastSuccessfulSyncUtc?.ToString("u")</span>
                            </td>
                            <td data-label="@L["PlatformConnections.Actions"]">
                                <span class="wasla-table__cell-label" aria-hidden="true">@L["PlatformConnections.Actions"]</span>
                                <div class="wasla-connections__actions">
                                    <a class="wasla-btn wasla-btn--quiet"
                                       href="/platform-connections/@c.Id/edit">
                                        @L["PlatformConnections.Edit"]
                                    </a>
                                    @* Every state (active, inactive, circuit open) can be removed; the dialog below asks first. *@
                                    <button type="button"
                                            class="wasla-btn wasla-btn--quiet wasla-connections__remove"
                                            data-bs-toggle="modal"
                                            data-bs-target="#pc-remove-@c.Id"
                                            data-connection-remove="@c.Id">
                                        <i class="bi bi-trash3" aria-hidden="true"></i>
                                        <span>@L["PlatformConnections.Remove"]</span>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

            @* One confirmation per connection (a tenant has at most one per platform). It posts that connection's id only;
               Cancel, the close button and Escape send nothing. *@
            @foreach (var c in Model.Connections)
            {
                <div class="modal fade wasla-connections__remove-dialog" id="pc-remove-@c.Id" tabindex="-1"
                     aria-labelledby="pc-remove-@c.Id-title" aria-describedby="pc-remove-@c.Id-body" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h2 class="modal-title h6" id="pc-remove-@c.Id-title">@L["PlatformConnections.RemoveConfirmTitle"]</h2>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["Common.Cancel"]"></button>
                            </div>
                            <div class="modal-body" id="pc-remove-@c.Id-body">
                                <dl class="wasla-connections__remove-facts">
                                    <div>
                                        <dt>@L["PlatformConnections.Platform"]</dt>
                                        <dd>@c.Platform</dd>
                                    </div>
                                    <div>
                                        <dt>@L["PlatformConnections.StoreId"]</dt>
                                        <dd dir="auto">@c.StoreId</dd>
                                    </div>
                                </dl>
                                <p class="mb-2">@L["PlatformConnections.RemoveConfirmStopsSync"]</p>
                                <p class="text-muted small mb-0">@L["PlatformConnections.RemoveConfirmKeepsOrders"]</p>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">@L["Common.Cancel"]</button>
                                <form method="post" action="/platform-connections/@c.Id/remove" class="m-0" data-connection-remove-form>
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-danger btn-sm" data-connection-remove-confirm>@L["PlatformConnections.Remove"]</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </section>
</div>

@section Scripts {
    <script>
        window.platformConnectionsMessages = @Html.Raw(pcMessagesJson);
    </script>
    <script src="~/js/platform-connections/platform-connections.js" asp-append-version="true"></script>
}
