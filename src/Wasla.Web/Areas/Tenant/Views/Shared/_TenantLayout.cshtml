@using Wasla.Application.Abstractions.Tenant

@using System.Globalization

@using Microsoft.Extensions.Localization
@using Wasla.Web.Security

@inject IStringLocalizer<Wasla.Web.SharedResource> L

@inject ICurrentTenantService CurrentTenant

@inject ITenantNavigationAuthorizationService TenantNavigation

@{

    var path = Context.Request.Path.Value ?? "/";

    var culture = CultureInfo.CurrentUICulture?.Name ?? "tr-TR";

    var isRtl = culture.StartsWith("ar", StringComparison.OrdinalIgnoreCase);

    var customerName = CurrentTenant.CurrentTenant?.Name ?? Context.Request.Host.Host;

    var navPermissions = await TenantNavigation.GetPermissionsAsync(User);
    var brandUrl = navPermissions.CanViewReports ? "/dashboard" : "/orders";



    string Active(string href) => path.Equals(href, StringComparison.OrdinalIgnoreCase) || path.StartsWith(href + "/", StringComparison.OrdinalIgnoreCase) ? "active" : "";

    string ActiveOrders() => path.Equals("/orders", StringComparison.OrdinalIgnoreCase) || path.StartsWith("/orders/details/", StringComparison.OrdinalIgnoreCase) ? "active" : "";

    var printBridgeSection = path.Equals("/print-bridge", StringComparison.OrdinalIgnoreCase)
        || path.StartsWith("/print-bridge/", StringComparison.OrdinalIgnoreCase);
    var printBridgeDevicesActive = path.Equals("/print-bridge/devices", StringComparison.OrdinalIgnoreCase)
        || path.Equals("/print-bridge", StringComparison.OrdinalIgnoreCase);
    var printBridgeSetupActive = path.Equals("/print-bridge/setup", StringComparison.OrdinalIgnoreCase)
        || path.StartsWith("/print-bridge/download", StringComparison.OrdinalIgnoreCase);

}

<!DOCTYPE html>

<html lang="@culture" dir="@(isRtl ? "rtl" : "ltr")">

<head>

    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Wasla</title>

    <script>

        (function () {

            try {

                var t = localStorage.getItem("Wasla.theme");

                if (t !== "dark" && t !== "light") t = "light";

                document.documentElement.setAttribute("data-bs-theme", t);

            } catch (e) { }

        })();

    </script>

    <!-- TODO: replace CDN links with local AdminLTE assets (wwwroot/theme/adminlte/) before production. -->

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"

          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@4.0.0-rc3/dist/css/adminlte.min.css" crossorigin="anonymous" />

    <link rel="stylesheet" href="~/css/wasla-theme.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/css/wasla-foundation.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/css/wasla-toast.css" asp-append-version="true" />

    @if (isRtl)

    {

        <link rel="stylesheet" href="~/css/rtl.css" asp-append-version="true" />

    }

</head>

<body class="wasla-app wasla-tenant wasla-tenant-shell" data-bs-theme="light">

    <div class="app-wrapper">

        <aside class="app-sidebar" id="app-sidebar-tenant" data-wasla-nav="sidebar" role="navigation" aria-label="@L["Layout.TenantNavigation"]">

            <nav class="sidebar-menu wasla-sidebar-shell">

                <div class="wasla-sidebar-brand-area">
                    <div class="wasla-sidebar-brand-row">
                        <a class="wasla-sidebar-brand text-decoration-none min-w-0" href="@brandUrl">
                            <span class="wasla-sidebar-brand-mark" aria-hidden="true">W</span>
                            <span class="brand-text">Wasla</span>
                        </a>
                        <button type="button" id="tenantSidebarToggle" class="wasla-sidebar-collapse-btn flex-shrink-0"
                                data-title-collapse="@L["Layout.CollapseSidebar"]" data-title-expand="@L["Layout.ExpandSidebar"]"
                                data-label-toggle="@L["Layout.ToggleSidebar"]" title="@L["Layout.CollapseSidebar"]" aria-expanded="true" aria-controls="app-sidebar-tenant">
                            <i class="bi bi-layout-sidebar-inset" aria-hidden="true"></i>
                        </button>
                        <button type="button" id="tenantNavClose" class="wasla-tenant-nav-close flex-shrink-0"
                                data-wasla-nav="close" aria-label="@L["Layout.CloseNavigation"]">
                            <i class="bi bi-x-lg" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="wasla-sidebar-tenant-name text-truncate" title="@customerName">@customerName</div>
                </div>



                <ul class="nav flex-column wasla-sidebar-nav-main">

                    @if (navPermissions.CanViewReports)
                    {
                    <li class="nav-item">

                        <a class="nav-link @Active("/dashboard")" asp-area="Tenant" asp-controller="Dashboard" asp-action="Index">

                            <i class="bi bi-speedometer2 me-2"></i><span class="nav-text">@L["Layout.Dashboard"]</span>

                        </a>

                    </li>
                    }

                    @if (navPermissions.CanViewOrders)
                    {
                    <li class="nav-item">

                        <a class="nav-link @ActiveOrders()" asp-area="Tenant" asp-controller="Orders" asp-action="Index">

                            <i class="bi bi-bag me-2"></i><span class="nav-text">@L["Layout.Orders"]</span>

                        </a>

                    </li>
                    }

                    @if (navPermissions.CanViewLiveScreen)
                    {
                    <li class="nav-item">

                        @* Live Screen is an operational display: open it in its own tab instead of replacing the panel. *@
                        <a class="nav-link @Active("/orders/live-display")" asp-area="Tenant" asp-controller="Orders" asp-action="LiveDisplay"
                           target="_blank" rel="noopener noreferrer">

                            <i class="bi bi-display me-2"></i><span class="nav-text">@L["Layout.LiveScreen"]</span>

                        </a>

                    </li>
                    }

                    @if (navPermissions.CanViewAnyPrintBridgeLink)
                    {
                    <li class="nav-item wasla-sidebar-nav-group @(printBridgeSection ? "wasla-sidebar-nav-group--open" : "")">

                        <a class="nav-link wasla-sidebar-nav-group__head @(printBridgeSection ? "wasla-sidebar-nav-parent--current" : "")"
                           href="@(navPermissions.CanManagePrintBridgeDevices ? "/print-bridge/devices" : "/print-bridge/setup")">

                            <i class="bi bi-printer me-2"></i><span class="nav-text">@L["PrintBridge.Title"]</span>

                        </a>

                        <ul class="wasla-sidebar-nav-sub nav flex-column">

                            @if (navPermissions.CanManagePrintBridgeDevices)
                            {
                            <li class="nav-item">

                                <a class="nav-link wasla-sidebar-nav-sub__link @(printBridgeDevicesActive ? "active" : "")"
                                   href="/print-bridge/devices">

                                    <span class="nav-text">@L["PrintBridge.NavDevices"]</span>

                                </a>

                            </li>
                            }

                            @if (navPermissions.CanManageDeviceSecurity)
                            {
                            <li class="nav-item">

                                <a class="nav-link wasla-sidebar-nav-sub__link @(printBridgeSetupActive ? "active" : "")"
                                   href="/print-bridge/setup">

                                    <span class="nav-text">@L["PrintBridge.NavSetup"]</span>

                                </a>

                            </li>
                            }

                        </ul>

                    </li>
                    }

                    @if (navPermissions.CanManageTenantSettings)
                    {
                    <li class="nav-item">

                        <a class="nav-link @Active("/platform-connections")" asp-area="Tenant" asp-controller="PlatformConnections" asp-action="Index">

                            <i class="bi bi-plug me-2"></i><span class="nav-text">@L["Layout.PlatformConnections"]</span>

                        </a>

                    </li>

                    <li class="nav-item">

                        <a class="nav-link @Active("/branches")" asp-area="Tenant" asp-controller="Branches" asp-action="Index">

                            <i class="bi bi-diagram-3 me-2"></i><span class="nav-text">@L["Layout.Branches"]</span>

                        </a>

                    </li>
                    }

                    @if (navPermissions.CanManageTenantUsers)
                    {
                    <li class="nav-item">

                        <a class="nav-link @Active("/settings/users")" asp-area="Tenant" asp-controller="TenantUsers" asp-action="Index">

                            <i class="bi bi-people me-2"></i><span class="nav-text">@L["Navigation.UserSettings"]</span>

                        </a>

                    </li>
                    }

                    @if (navPermissions.CanViewOrders)
                    {
                    <li class="nav-item">
                        <a class="nav-link @Active("/help")" asp-area="Tenant" asp-controller="Help" asp-action="Index">
                            <i class="bi bi-question-circle me-2" aria-hidden="true"></i><span class="nav-text">@L["Help.Title"]</span>
                        </a>
                    </li>
                    }

                </ul>



                <div class="wasla-sidebar-bottom">
                    @await Html.PartialAsync("_TenantSidebarFooter")
                    @await Html.PartialAsync("_TenantSettingsNav")
                </div>

            </nav>

        </aside>



        <main class="app-main wasla-content" id="tenant-main" role="main">

            <div class="app-content">

                <div class="container-fluid py-3">

                    <div class="wasla-tenant-nav-bar">
                        <button type="button" id="tenantNavOpen" class="wasla-tenant-nav-trigger"
                                data-wasla-nav="trigger"
                                aria-controls="app-sidebar-tenant"
                                aria-expanded="false"
                                aria-label="@L["Layout.OpenNavigation"]">
                            <i class="bi bi-list" aria-hidden="true"></i>
                            <span class="wasla-tenant-nav-trigger__text">@L["Layout.OpenNavigation"]</span>
                        </button>
                    </div>

                    @RenderBody()

                </div>

            </div>

        </main>

    </div>

    <div id="tenantNavBackdrop" class="wasla-tenant-nav-backdrop" data-wasla-nav="backdrop" hidden></div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"

            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>

    <script src="~/js/wasla-toast.js" asp-append-version="true"></script>

    <partial name="~/Views/Shared/_Notifications.cshtml" />

    <script src="~/js/theme-mode.js" asp-append-version="true"></script>

    <script src="~/js/sidebar-toggle.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>

