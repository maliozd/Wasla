@model Wasla.Web.Models.Ui.TenantPageHeaderModel

<div class="wasla-tenant-page-header d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
    <div class="wasla-tenant-page-header__main">
        <h1 class="wasla-tenant-page-header__title h4 mb-1">@Model.Title</h1>
        @if (!string.IsNullOrEmpty(Model.Subtitle))
        {
            <p class="wasla-tenant-page-header__subtitle text-muted small mb-0">@Model.Subtitle</p>
        }
    </div>
</div>
