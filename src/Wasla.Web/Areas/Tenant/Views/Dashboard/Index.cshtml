@model Wasla.Web.Models.Dashboard.DashboardViewModel
@using System.Globalization
@using Wasla.Web.Ui
@using Wasla.Web.Models.Ui
@{
    ViewData["Title"] = L["Dashboard.Title"];
    var (tz, turkeyToday) = OrderUiHelper.GetTurkeyDisplayContext();
    var todayLabel = turkeyToday.ToDateTime(TimeOnly.MinValue).ToString("d", CultureInfo.CurrentCulture);
    var averageOrderValue = Model.TodayOrderCount > 0
        ? Model.TodayRevenue / Model.TodayOrderCount
        : 0m;
    var kpis = new[]
    {
        (Modifier: "orders", Icon: "bi-receipt", LabelKey: "Dashboard.TodayOrders", HintKey: "Dashboard.OrdersReceivedToday",
            Value: Model.TodayOrderCount.ToString("N0", CultureInfo.CurrentCulture)),
        (Modifier: "revenue", Icon: "bi-cash-stack", LabelKey: "Dashboard.TodayRevenue", HintKey: "Dashboard.TotalOrderAmountToday",
            Value: Model.TodayRevenue.ToString("C", CultureInfo.CurrentCulture)),
        (Modifier: "active", Icon: "bi-lightning-charge", LabelKey: "Dashboard.ActiveOrders", HintKey: "Dashboard.CurrentlyActiveOrders",
            Value: Model.ActiveOrderCount.ToString("N0", CultureInfo.CurrentCulture)),
        (Modifier: "cancelled", Icon: "bi-x-circle", LabelKey: "Dashboard.CancelledOrders", HintKey: "Dashboard.CancelledToday",
            Value: Model.CancelledOrderCount.ToString("N0", CultureInfo.CurrentCulture)),
        (Modifier: "average", Icon: "bi-calculator", LabelKey: "Dashboard.AverageOrderValue", HintKey: "Dashboard.AverageValuePerOrder",
            Value: averageOrderValue.ToString("C", CultureInfo.CurrentCulture))
    };
}

<div class="wasla-dashboard">

    <header class="wasla-customer-page-header wasla-dash-header d-flex flex-wrap align-items-start justify-content-between gap-3 mb-4">
        <div class="wasla-customer-page-header__main">
            <h1 class="wasla-customer-page-header__title wasla-dash-header__title h4 mb-1">@L["Dashboard.Title"]</h1>
            <p class="wasla-customer-page-header__subtitle text-muted small mb-0">@L["Dashboard.TodayOverview"]</p>
        </div>
        <div class="wasla-dash-header__scope text-md-end">
            <span class="badge rounded-pill text-bg-light border wasla-dash-today-badge">
                @L.GetString("Dashboard.TodayDateLabel", L["Common.Today"], todayLabel)
            </span>
        </div>
    </header>

    @if (Model.GuidedSetup is not null)
    {
        @* Calm and optional: no modal and no automatic coachmark. *@
        @await Html.PartialAsync("_GuidedSetupCard", Model.GuidedSetup)
    }

    @if (Model.Setup is not null)
    {
        @* The operational checklist stays; only its welcome banner yields to the guided-setup card. *@
        @await Html.PartialAsync("_TenantSetupPanel", Model.Setup, new ViewDataDictionary(ViewData) { ["HideSetupWelcome"] = Model.GuidedSetup is not null })
    }

    @* Today's figures: label first, one emphasized number, a short qualifier. Compact enough for a phone. *@
    <section class="wasla-dash-kpis mb-4" data-tour="dashboard-summary" aria-label="@L["Dashboard.TodayOverview"]">
        @foreach (var kpi in kpis)
        {
            <article class="wasla-dash-kpi wasla-dash-kpi--@kpi.Modifier">
                <div class="wasla-dash-kpi__head">
                    <span class="wasla-dash-kpi__icon" aria-hidden="true"><i class="bi @kpi.Icon"></i></span>
                    <p class="wasla-dash-kpi__label">@L[kpi.LabelKey]</p>
                </div>
                <p class="wasla-dash-kpi__value">@kpi.Value</p>
                <p class="wasla-dash-kpi__hint">@L[kpi.HintKey]</p>
            </article>
        }
    </section>

    <div class="row g-3">
        <div class="col-12" data-tour="dashboard-recent">
            <div class="card wasla-card wasla-dash-section">
                <div class="card-body">
                    <div class="d-flex flex-wrap align-items-start justify-content-between gap-2 mb-3">
                        <div>
                            <h2 class="wasla-dash-section__title h6 mb-1">@L["Dashboard.RecentOrders"]</h2>
                            <p class="text-muted small mb-0">@L["Dashboard.LatestOrdersReceivedToday"]</p>
                        </div>
                        <a href="/orders" class="btn btn-sm btn-outline-primary">@L["Dashboard.ViewAll"]</a>
                    </div>

                    @if (Model.RecentOrders.Count == 0)
                    {
                        <div class="wasla-customer-empty-state wasla-dash-empty text-center py-4">
                            <div class="wasla-dash-empty__icon text-muted mb-2" aria-hidden="true">
                                <i class="bi bi-inbox"></i>
                            </div>
                            <p class="wasla-dash-empty__title mb-1">@L["Dashboard.NoOrdersYetToday"]</p>
                            <p class="wasla-dash-empty__hint text-muted small mb-0">@L["Dashboard.NewOrdersWillAppearHere"]</p>
                        </div>
                    }
                    else
                    {
                        <div class="wasla-table-wrap wasla-dash-table-wrap">
                            <table class="wasla-table wasla-table--stack wasla-dash-table">
                                <caption class="visually-hidden">@L["Dashboard.RecentOrders"]</caption>
                                <thead>
                                <tr>
                                    <th scope="col">@L["Dashboard.Platform"]</th>
                                    <th scope="col">@L["Dashboard.Code"]</th>
                                    <th scope="col">@L["Dashboard.Customer"]</th>
                                    <th scope="col" class="wasla-table__num">@L["Dashboard.Total"]</th>
                                    <th scope="col">@L["Dashboard.Status"]</th>
                                    <th scope="col" class="wasla-table__num">@L["Dashboard.Received"]</th>
                                </tr>
                                </thead>
                                <tbody>
                                @foreach (var o in Model.RecentOrders)
                                {
                                    <tr>
                                        <td>
                                            <span class="wasla-table__cell-label" aria-hidden="true">@L["Dashboard.Platform"]</span>
                                            @await Html.PartialAsync("_PlatformBadge", (Platform: (object?)o.Platform, DisplayName: (string?)null))
                                        </td>
                                        <td class="wasla-table__primary">
                                            <span class="wasla-table__cell-label" aria-hidden="true">@L["Dashboard.Code"]</span>
                                            <a href="/orders/details/@o.Id" class="wasla-table__link wasla-dash-order-code">@o.ExternalOrderCode</a>
                                        </td>
                                        <td class="wasla-table__truncate wasla-dash-customer">
                                            <span class="wasla-table__cell-label" aria-hidden="true">@L["Dashboard.Customer"]</span>
                                            <span dir="auto" title="@o.CustomerName">@OrderUiHelper.DisplayOrDash(o.CustomerName)</span>
                                        </td>
                                        <td class="wasla-table__num wasla-table__amount">
                                            <span class="wasla-table__cell-label" aria-hidden="true">@L["Dashboard.Total"]</span>
                                            <span>@o.TotalAmount.ToString("C", CultureInfo.CurrentCulture)</span>
                                        </td>
                                        <td>
                                            <span class="wasla-table__cell-label" aria-hidden="true">@L["Dashboard.Status"]</span>
                                            @await Html.PartialAsync("_OrderStatusBadge", new OrderStatusBadgeModel(o.Status))
                                        </td>
                                        <td class="wasla-table__num wasla-table__muted wasla-table__datetime wasla-dash-received">
                                            <span class="wasla-table__cell-label" aria-hidden="true">@L["Dashboard.Received"]</span>
                                            @await Html.PartialAsync("_ReceivedAtTime", new ReceivedAtTimeModel(o.ReceivedAtUtc, TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(o.ReceivedAtUtc, DateTimeKind.Utc), tz), turkeyToday))
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card wasla-card wasla-dash-section">
                <div class="card-body">
                    <h2 class="wasla-dash-section__title h6 mb-1">@L["Dashboard.PlatformSummary"]</h2>
                    <p class="text-muted small mb-3">@L["Dashboard.OrdersByPlatformToday"]</p>

                    @if (Model.PlatformSummary.Count == 0)
                    {
                        <div class="wasla-customer-empty-state wasla-dash-empty text-center py-4">
                            <p class="wasla-dash-empty__title text-muted mb-0">@L["Dashboard.NoPlatformSummary"]</p>
                        </div>
                    }
                    else
                    {
                        <div class="wasla-dash-platform-list">
                            @foreach (var p in Model.PlatformSummary)
                            {
                                var share = Model.TodayRevenue > 0
                                    ? Math.Round(p.Revenue / Model.TodayRevenue * 100m, 1)
                                    : 0m;
                                <div class="wasla-dash-platform-item">
                                    <div class="wasla-dash-platform-item__header">
                                        @await Html.PartialAsync("_PlatformBadge", (Platform: (object?)p.Platform, DisplayName: (string?)null))
                                        <div class="wasla-dash-platform-item__stats">
                                            <span class="wasla-dash-platform-item__count">
                                                @p.Count <span class="text-muted">@L["Dashboard.Orders"]</span>
                                            </span>
                                            <span class="wasla-dash-platform-item__revenue">@p.Revenue.ToString("C", CultureInfo.CurrentCulture)</span>
                                        </div>
                                    </div>
                                    @if (share > 0)
                                    {
                                        <div class="wasla-dash-platform-item__share">
                                            <div class="wasla-dash-platform-item__bar" role="presentation">
                                                <span class="wasla-dash-platform-item__bar-fill" style="width: @(share.ToString(CultureInfo.InvariantCulture))%"></span>
                                            </div>
                                            <span class="wasla-dash-platform-item__pct small text-muted">
                                                @L.GetString("Dashboard.ShareOfTotal", share.ToString("0.#", CultureInfo.CurrentCulture))
                                            </span>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
