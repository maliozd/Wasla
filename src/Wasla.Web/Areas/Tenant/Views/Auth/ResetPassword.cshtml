@model Wasla.Web.Models.Auth.ResetPasswordViewModel
@using System.Globalization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Wasla.Web.SharedResource> L
@{
    Layout = null;
    ViewData["Title"] = L["Auth.ResetPassword.Title"];
    var culture = CultureInfo.CurrentUICulture?.Name ?? "tr-TR";
    var isRtl = culture.StartsWith("ar", StringComparison.OrdinalIgnoreCase);
}

<!DOCTYPE html>
<html lang="@culture" dir="@(isRtl ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Wasla</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @if (isRtl)
    {
        <link rel="stylesheet" href="~/css/rtl.css" asp-append-version="true" />
    }
</head>
<body class="wasla-auth-bg">
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
            <div class="mb-4">
                @await Html.PartialAsync("_WaslaLogo", new WaslaLogoModel { CssClass = "wasla-logo--auth" })
            </div>
            <div class="card wasla-card">
                <div class="card-body p-4">
                    <h1 class="h4 mb-3">@L["Auth.ResetPassword.Title"]</h1>

                    @if (Model.IsInvalidToken)
                    {
                        <div class="alert alert-warning">@L["Auth.ResetPassword.InvalidOrExpired"]</div>
                        <div class="mt-3 text-center">
                            <a href="/auth/forgot-password">@L["Auth.ForgotPassword.Link"]</a>
                        </div>
                        <div class="mt-2 text-center">
                            <a href="/auth/login">@L["Auth.ReturnToLogin"]</a>
                        </div>
                    }
                    else
                    {
                        <form method="post" action="/auth/reset-password">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="Token" />
                            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                            <div class="mb-3">
                                <label class="form-label" asp-for="NewPassword">@L["Auth.ResetPassword.NewPassword"]</label>
                                <input class="form-control" asp-for="NewPassword" type="password" autocomplete="new-password" />
                                <span class="text-danger" asp-validation-for="NewPassword"></span>
                            </div>

                            <div class="mb-3">
                                <label class="form-label" asp-for="ConfirmPassword">@L["Auth.ResetPassword.ConfirmNewPassword"]</label>
                                <input class="form-control" asp-for="ConfirmPassword" type="password" autocomplete="new-password" />
                                <span class="text-danger" asp-validation-for="ConfirmPassword"></span>
                            </div>

                            <button class="btn btn-primary w-100" type="submit">@L["Auth.ResetPassword.UpdatePassword"]</button>
                        </form>

                        <div class="mt-3 text-center">
                            <a href="/auth/login">@L["Auth.ReturnToLogin"]</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await Html.PartialAsync("_ValidationScriptsPartial")
</body>
</html>
