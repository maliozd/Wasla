@model Wasla.Web.Models.Auth.ForgotPasswordViewModel
@using System.Globalization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Wasla.Web.SharedResource> L
@{
    Layout = null;
    ViewData["Title"] = L["Auth.ForgotPassword.Title"];
    var culture = CultureInfo.CurrentUICulture?.Name ?? "tr-TR";
    var isRtl = culture.StartsWith("ar", StringComparison.OrdinalIgnoreCase);
}

<!DOCTYPE html>
<html lang="@culture" dir="@(isRtl ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Wasla</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @if (isRtl)
    {
        <link rel="stylesheet" href="~/css/rtl.css" asp-append-version="true" />
    }
</head>
<body class="oh-auth-bg">
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
            <div class="card oh-card">
                <div class="card-body p-4">
                    @if (Model.EmailSent)
                    {
                        <h1 class="h4 mb-3">@L["Auth.ForgotPassword.ConfirmationTitle"]</h1>
                        <p class="text-muted small mb-4">@L["Auth.ForgotPassword.ConfirmationDescription"]</p>
                        <a class="btn btn-primary w-100" href="/auth/login">@L["Auth.ReturnToLogin"]</a>
                    }
                    else
                    {
                        <h1 class="h4 mb-3">@L["Auth.ForgotPassword.Title"]</h1>
                        <p class="text-muted small">@L["Auth.ForgotPassword.HelpText"]</p>

                        <form method="post" action="/auth/forgot-password">
                            @Html.AntiForgeryToken()
                            <div asp-validation-summary="ModelOnly" class="alert alert-warning py-2 small mb-3"></div>

                            <div class="mb-3">
                                <label class="form-label" asp-for="Email">@L["Auth.Email"]</label>
                                <input class="form-control" asp-for="Email" autocomplete="email" />
                                <span class="text-danger" asp-validation-for="Email"></span>
                            </div>

                            <button class="btn btn-primary w-100" type="submit">@L["Auth.ForgotPassword.SendResetLink"]</button>
                        </form>

                        <div class="mt-3 text-center">
                            <a href="/auth/login">@L["Auth.ReturnToLogin"]</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await Html.PartialAsync("_ValidationScriptsPartial")
</body>
</html>
