@{
    ViewData["Title"] = L["Auth.AccessDenied.Title"];
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <div class="card oh-card text-center">
            <div class="card-body py-5">
                <div class="display-6 text-warning mb-3">
                    <i class="bi bi-shield-lock"></i>
                </div>
                <h1 class="h4 mb-2">@L["Auth.AccessDenied.Title"]</h1>
                <p class="text-muted mb-4">@L["Auth.AccessDenied.Description"]</p>
                <a class="btn btn-primary" href="/orders">@L["Auth.AccessDenied.BackToOrders"]</a>
            </div>
        </div>
    </div>
</div>
