@model Wasla.Web.Models.Auth.LogoutViewModel
@using System.Globalization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Wasla.Web.SharedResource> L
@{
    // Standalone and light, like the sign-in pages: it queries nothing, so the logout failure page
    // (TenantLogoutFailureMiddleware) renders while the tenant database is unavailable.
    Layout = null;
    var culture = CultureInfo.CurrentUICulture?.Name ?? "tr-TR";
    var isRtl = culture.StartsWith("ar", StringComparison.OrdinalIgnoreCase);
}

<!DOCTYPE html>
<html lang="@culture" dir="@(isRtl ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @await Html.PartialAsync("_FaviconLinks")
    <title>@L["Account.Logout"] - Wasla</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @if (isRtl)
    {
        <link rel="stylesheet" href="~/css/rtl.css" asp-append-version="true" />
    }
</head>
<body class="wasla-auth-bg">
<main class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
            <div class="mb-4">
                @await Html.PartialAsync("_WaslaLogo", new WaslaLogoModel { CssClass = "wasla-logo--auth" })
            </div>
            <div class="card wasla-card">
                <div class="card-body p-4">
                    <h1 class="h4 mb-3">@L["Account.Logout"]</h1>

                    @if (Model.Failed)
                    {
                        @* No form here: while the session cannot be checked, no antiforgery token for it can be issued.
                           The logout page offers the form once the session is checked again. *@
                        <div class="alert alert-danger" role="alert" data-logout-failed>@L["Auth.Logout.Failed"]</div>
                        <a class="btn btn-primary w-100" href="/auth/logout" data-logout-retry>@L["Auth.Logout.TryAgain"]</a>
                    }
                    else
                    {
                        <form method="post" action="/auth/logout">
                            @Html.AntiForgeryToken()
                            <button class="btn btn-primary w-100" type="submit" data-logout-submit>@L["Account.Logout"]</button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</main>
</body>
</html>
