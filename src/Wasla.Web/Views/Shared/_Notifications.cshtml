@using System.Text.Json
@{
    var success = TempData["Success"] as string;
    var error = TempData["Error"] as string;

    if (!string.IsNullOrWhiteSpace(success) || !string.IsNullOrWhiteSpace(error))
    {
        var payload = new { success = success, error = error };
        var payloadJson = JsonSerializer.Serialize(payload);
        <script>
            (function () {
                var data = @Html.Raw(payloadJson);
                function fire() {
                    if (!window.WaslaToast) return;
                    if (data.success) window.WaslaToast.success(data.success);
                    if (data.error)   window.WaslaToast.error(data.error);
                }
                if (document.readyState === "loading") {
                    document.addEventListener("DOMContentLoaded", fire);
                } else {
                    fire();
                }
            })();
        </script>
    }
}

