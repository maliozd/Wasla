@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Wasla.Web.SharedResource> L
@{
    // The code length is the server's (the phone verification status reports codeLength); without one the field
    // takes any number of digits and signup-code-input.js does not submit by itself.
    var codeLength = ViewData["SignupCodeLength"] as int?;
    var hidden = ViewData["SignupCodeHidden"] is true;
}
@* The SMS code field of the phone verification step (Figma "Kaynak · Code input", T1–T7, MT2k): one field, not one
   box per digit, so paste, the keyboard's one-time-code suggestion and WebOTP fill it in one go. Digits are Latin and
   the field stays left to right in Arabic (Figma L3). Errors are under the field and named by aria-describedby. *@
<div class="su-field" data-su-code-field hidden="@(hidden ? "hidden" : null)">
    <label class="su-label" for="signupPhoneCode">@L["Signup.Phone.CodeLabel"]</label>
    <div class="su-code" data-su-code data-state="">
        <input class="su-code__input"
               id="signupPhoneCode"
               name="code"
               type="text"
               inputmode="numeric"
               autocomplete="one-time-code"
               enterkeyhint="done"
               pattern="[0-9]*"
               autocapitalize="off"
               autocorrect="off"
               spellcheck="false"
               dir="ltr"
               maxlength="@(codeLength > 0 ? codeLength : null)"
               data-su-code-length="@(codeLength > 0 ? codeLength : null)"
               placeholder="@L["Signup.Phone.CodePlaceholder"]"
               aria-describedby="signupPhoneCode-error" />
        <i class="bi bi-check2 su-code__check" aria-hidden="true"></i>
    </div>
    <p class="su-error" id="signupPhoneCode-error" role="alert"></p>
</div>
