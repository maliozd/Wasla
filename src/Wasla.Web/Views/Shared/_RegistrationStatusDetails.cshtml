@model Wasla.Web.Models.Signup.SignupPendingViewModel
@using Microsoft.Extensions.Localization
@using Wasla.Web.Formatting
@inject IStringLocalizer<Wasla.Web.SharedResource> L
@* The applicant's contact details (Figma 03 "İletişim bilgileri"), shared by every owner status page. The design
   abbreviates them to the name and email; every detail the page showed before stays here. The server decides: nothing
   renders without ShowPrivateDetails, which only the browser holding the signup's ownership proof gets.
   The summary is one full-width row (title and preview at the start, chevron at the end); opened, the details are a
   label/value grid, stacked below 576 px. *@
@if (Model.ShowPrivateDetails)
{
    <details class="su-status-contact">
        <summary class="su-status-contact__toggle">
            <span class="su-status-contact__heading">
                <span class="su-status-contact__title">@L["RegistrationStatus.ContactDetails"]</span>
                <span class="su-status-contact__preview"><bdi>@Model.OwnerFullName</bdi> · <bdi>@Model.OwnerEmail</bdi></span>
            </span>
            <i class="bi bi-chevron-down su-status-contact__chevron" aria-hidden="true"></i>
        </summary>
        <dl class="su-status-contact__list">
            <div class="su-status-contact__row">
                <dt>@L["Signup.PendingLabelOwnerName"]</dt>
                <dd dir="auto">@Model.OwnerFullName</dd>
            </div>
            <div class="su-status-contact__row">
                <dt>@L["Signup.PendingLabelOwnerEmail"]</dt>
                <dd><bdi>@Model.OwnerEmail</bdi></dd>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.OwnerPhone))
            {
                <div class="su-status-contact__row">
                    <dt>@L["Signup.PendingLabelOwnerPhone"]</dt>
                    <dd><bdi class="su-ltr">@TurkishPhoneDisplayFormatter.FormatWithCountryCode(Model.OwnerPhone)</bdi></dd>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.BusinessPhone))
            {
                <div class="su-status-contact__row">
                    <dt>@L["Signup.PendingLabelBusinessPhone"]</dt>
                    <dd><bdi class="su-ltr">@TurkishPhoneDisplayFormatter.FormatWithCountryCode(Model.BusinessPhone)</bdi></dd>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.BusinessEmail))
            {
                <div class="su-status-contact__row">
                    <dt>@L["Signup.PendingLabelBusinessEmail"]</dt>
                    <dd><bdi>@Model.BusinessEmail</bdi></dd>
                </div>
            }
            <div class="su-status-contact__row">
                <dt>@L["Signup.PendingLabelCreatedAt"]</dt>
                <dd>@Model.CreatedAtUtc.ToLocalTime().ToString("g")</dd>
            </div>
        </dl>
    </details>
}
