@using System.Globalization
@using Microsoft.Extensions.Localization
@using Wasla.Web.Models.Marketing
@using Microsoft.Extensions.Options
@using Wasla.Infrastructure.Options
@using Wasla.Web.Routing
@inject IStringLocalizer<Wasla.Web.SharedResource> L
@inject IOptions<TenantOnboardingOptions> Onboarding
@inject IWebHostEnvironment Environment
@{
    var returnUrl = (Context.Request.Path.Value ?? "/") + (Context.Request.QueryString.HasValue ? Context.Request.QueryString.Value : "");
    var culture = CultureInfo.CurrentUICulture?.Name ?? "tr-TR";
    var isRtl = culture.StartsWith("ar", StringComparison.OrdinalIgnoreCase);
    // Marketing pages (homepage, Wasla POS) hand over their metadata; signup, checkout and other public pages keep their title only.
    var metadata = ViewData[PublicPageMetadata.ViewDataKey] as PublicPageMetadata;
    var canonicalUrl = metadata is null ? null : PublicSiteUrls.BuildCanonicalUrl(Context.Request, Environment, Onboarding.Value.MarketingBaseDomain, metadata.CanonicalPath);
}
<!DOCTYPE html>
<html lang="@culture" dir="@(isRtl ? "rtl" : "ltr")" class="wm-no-js">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @if (metadata is not null)
    {
        <title>@metadata.Title</title>
        <meta name="description" content="@metadata.Description" />
        <link rel="canonical" href="@canonicalUrl" />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="@L["Brand.LogoAlt"]" />
        <meta property="og:title" content="@metadata.Title" />
        <meta property="og:description" content="@metadata.Description" />
        <meta property="og:url" content="@canonicalUrl" />
        <meta property="og:locale" content="@culture.Replace('-', '_')" />
        <meta name="twitter:card" content="summary" />
    }
    else
    {
        <title>@ViewData["Title"] - Wasla</title>
    }
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/wasla-marketing.css" asp-append-version="true" />
    @if (isRtl)
    {
        <link rel="stylesheet" href="~/css/rtl.css" asp-append-version="true" />
    }
    <script src="~/js/wasla-marketing.js" asp-append-version="true" defer></script>
</head>
<body class="wasla-landing@(metadata is null ? string.Empty : " wm-site")">
    <a class="wm-skip-link" href="#main-content">@L["Marketing.SkipToContent"]</a>
    @await Html.PartialAsync("_PublicHeader", returnUrl)
    <main id="main-content" tabindex="-1">
        @RenderBody()
    </main>
    @await Html.PartialAsync("_PublicFooter", returnUrl)
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
            crossorigin="anonymous"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
