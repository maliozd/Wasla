@model Wasla.Web.Models.Checkout.CheckoutResultViewModel
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Wasla.Web.SharedResource> L
@{
    // A rate-limited registration change (status 429): the same page whoever asks, with nothing about the registration.
    Layout = "_RegistrationStatusLayout";
    ViewData["Title"] = L["RegistrationStatus.TooManyTitle"];
    ViewData["LanguageReturnUrl"] = $"/checkout/review/{Model.RegistrationId}";
}
<div class="su-shell su-status-page">
    <div class="su-container su-status__layout su-status__layout--single">
        <div class="su-status__main">
            <h1 class="su-title">@L["RegistrationStatus.TooManyTitle"]</h1>
            <div class="su-notice su-notice--warning" role="alert">
                <i class="bi bi-hourglass-split" aria-hidden="true"></i>
                <p>@L["Checkout.TooManyAttempts"]</p>
            </div>
            <div class="su-status__actions">
                <a class="su-btn su-btn--primary" href="/checkout/review/@Model.RegistrationId">@L[Model.IsPaymentSimulatorAvailable ? "Checkout.TryAgain" : "Checkout.ReturnToRegistrationSummary"]</a>
            </div>
        </div>
    </div>
</div>
