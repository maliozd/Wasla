@model Wasla.Web.Models.Checkout.CheckoutResultViewModel
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Wasla.Web.SharedResource> L
@{
    Layout = "_PublicLayout";
    ViewData["Title"] = L["Checkout.TooManyAttempts"];
}
<div class="wasla-signup-page py-4 py-md-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm wasla-signup-card">
                    <div class="card-body p-4 p-md-5 text-center">
                        <div class="mb-3 text-warning">
                            <i class="bi bi-hourglass-split" style="font-size: 2.5rem;" aria-hidden="true"></i>
                        </div>
                        <h1 class="h5 fw-bold mb-4" role="alert">@L["Checkout.TooManyAttempts"]</h1>
                        <a class="btn btn-primary rounded-pill" href="/checkout/review/@Model.RegistrationId">@L["Checkout.TryAgain"]</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
