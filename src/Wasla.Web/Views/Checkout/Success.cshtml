@model Wasla.Web.Models.Signup.SignupPendingViewModel
@using Microsoft.Extensions.Localization
@using Wasla.Domain.Enums
@inject IStringLocalizer<Wasla.Web.SharedResource> L
@{
    Layout = "_RegistrationStatusLayout";
    var isProvisioned = Model.Status == PendingRegistrationStatus.Provisioned;
    ViewData["Title"] = isProvisioned ? L["Checkout.PanelReadyTitle"] : L["Checkout.PaymentReceivedPreparingTitle"];
}
<div class="wasla-signup-page py-4 py-md-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm wasla-signup-card">
                    <div class="card-body p-4 p-md-5 text-center">
                        <partial name="_RegistrationStatusCard" model="Model" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
