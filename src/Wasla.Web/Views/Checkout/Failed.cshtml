@model Wasla.Web.Models.Checkout.CheckoutResultViewModel
@using Microsoft.Extensions.Localization
@using Wasla.Domain.Enums
@using Wasla.Web.Models.Signup
@inject IStringLocalizer<Wasla.Web.SharedResource> L
@{
    // Public page (Figma 03 failed): it carries only the ID and generic text, never the applicant's details. Only the
    // Development simulator says the failure was simulated.
    Layout = "_RegistrationStatusLayout";
    var simulator = Model.IsPaymentSimulatorAvailable;
    var titleKey = simulator ? "Checkout.FailedTitle" : "Checkout.PaymentNotCompletedTitle";
    ViewData["Title"] = L[titleKey];
    var badge = RegistrationStatusPresentation.Badge(PendingRegistrationStatus.PaymentFailed, simulator);
}
<div class="su-shell su-status-page">
    <div class="su-container su-status__layout">
        <div class="su-status__main">
            <h1 class="su-title">@L[titleKey]</h1>
            @if (simulator)
            {
                <p class="su-lead">@L["Checkout.FailedMessage"] @L["Checkout.FailedNoWorkspace"]</p>
            }
            else
            {
                <p class="su-lead">@L["Checkout.PaymentNotCompletedMessage"]</p>
            }

            <div class="su-notice su-notice--info" role="note">
                <i class="bi bi-info-circle" aria-hidden="true"></i>
                <div>
                    <strong class="su-notice__title">@L["RegistrationStatus.DetailsKeptTitle"]</strong>
                    <p>@L["RegistrationStatus.DetailsKeptBody"]</p>
                </div>
            </div>

            <div class="su-status__actions">
                <a class="su-btn su-btn--primary" asp-controller="Checkout" asp-action="Review" asp-route-id="@Model.RegistrationId">@L[simulator ? "Checkout.TryAgain" : "Checkout.ReturnToRegistrationSummary"]</a>
                <a class="su-btn su-btn--quiet" href="/signup">@L["Checkout.RegisterAgain"]</a>
            </div>
        </div>

        <aside class="su-status__aside">
            <section class="su-receipt su-status-card" aria-labelledby="failedCardTitle">
                <header class="su-receipt__head">
                    <h2 class="su-receipt__title" id="failedCardTitle">@L["Signup.Receipt.Title"]</h2>
                </header>
                <div class="su-status-card__body">
                    <partial name="_RegistrationStatusBadge" model="badge" />
                    <p class="su-help">@L["RegistrationStatus.FailedCardHelp"]</p>
                </div>
            </section>
        </aside>
    </div>
</div>
