@using System.Globalization
@using Microsoft.Extensions.Localization
@model Wasla.Web.Models.ErrorPageViewModel
@inject IStringLocalizer<Wasla.Web.SharedResource> L
@{
    Layout = null;
    var culture = CultureInfo.CurrentUICulture?.Name ?? "tr-TR";
    var isRtl = culture.StartsWith("ar", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="@culture" dir="@(isRtl ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@L["Errors.UnexpectedTitle"] - Wasla</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
    @if (isRtl)
    {
        <link rel="stylesheet" href="~/css/rtl.css" asp-append-version="true" />
    }
</head>
<body class="wasla-landing">
<main class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4 p-md-5">
                    <h1 class="h4 mb-3">@L["Errors.UnexpectedTitle"]</h1>
                    <p class="mb-4">@L["Errors.UnexpectedMessage"]</p>
                    <p class="small text-muted mb-0">@L["Errors.ReferenceCode"]: <span class="font-monospace">@Model.TraceId</span></p>
                </div>
            </div>
        </div>
    </div>
</main>
</body>
</html>
