                </div>
                <span class="wm-route__line" aria-hidden="true"></span>
                <p class="wm-route__product m-0"><span class="wm-icon-tile wm-icon-tile--s wm-icon-tile--ink" aria-hidden="true"><i class="bi bi-grid-3x3-gap"></i></span>@L["Marketing.Product.Pos"] <span class="wm-soon">@L["Marketing.ComingSoon"]</span></p>
                <a class="wm-btn wm-btn--tertiary wm-route__cta" href="@PublicSiteUrls.PosPath">@L["Marketing.Cta.ExplorePos"] <i class="bi bi-arrow-right wm-flip-rtl" aria-hidden="true"></i></a>
            </div>
            <div class="wm-route">
                <div>
