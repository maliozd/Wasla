@model Wasla.Web.Models.Marketing.MarketingHomeViewModel
@using System.Globalization
@using Microsoft.Extensions.Localization
@using Wasla.Application.Abstractions.Plans
@using Wasla.Web.Formatting
@using Wasla.Web.Models.Marketing
@using Wasla.Web.Routing
@using Wasla.Web.Ui
@inject IStringLocalizer<Wasla.Web.SharedResource> L
@inject IWaslaPlanCatalog PlanCatalog
@{
    ViewData[PublicPageMetadata.ViewDataKey] = new PublicPageMetadata(
        L["Marketing.Home.MetaTitle"].Value,
        L["Marketing.Home.MetaDescription"].Value,
        "/");
    ViewData[PublicLayoutViewData.HeaderOverlay] = true;
    var signupUrl = Url.Action("Index", "Signup")!;
    string Money(decimal amount) => OrderUiHelper.FormatMoney(amount);
    string Minutes(int value) => L["Marketing.Mock.MinutesAgo", value].Value;
    var trendyol = L["Orders.PlatformTrendyolGo"].Value;

    // Sample orders of the decorative Live Screen. Dish names and customer notes are order data, shown as they would
    // arrive from a platform in every culture, like the order content of the real Live Screen.
    var board = new[]
    {
        (Status: "new", Label: L["OrderStatus.New"].Value, Icon: "bi-receipt", Orders: new[]
        {
            (Code: "#1046", Minutes: 1, Items: new[] { "1× Kuzu Şiş", "1× Pilav", "1× Şalgam" }, Note: "Ekstra lavaş ekleyin.", Total: 465m),
            (Code: "#1045", Minutes: 4, Items: new[] { "2× Lahmacun", "2× Ayran" }, Note: (string?)null, Total: 290m)
        }),
        (Status: "preparing", Label: L["OrderStatus.Preparing"].Value, Icon: "bi-fire", Orders: new[]
        {
            (Code: "#1044", Minutes: 9, Items: new[] { "1× İskender", "1× Ayran" }, Note: (string?)null, Total: 395m),
            (Code: "#1043", Minutes: 14, Items: new[] { "2× Tavuk Şiş", "1× Çoban Salata" }, Note: (string?)null, Total: 520m),
            (Code: "#1040", Minutes: 22, Items: new[] { "1× Karışık Pide", "1× Künefe" }, Note: (string?)null, Total: 428m)
        }),
        (Status: "ready", Label: L["OrderStatus.ReadyForPickup"].Value, Icon: "bi-check-circle", Orders: new[]
        {
            (Code: "#1039", Minutes: 17, Items: new[] { "3× Lahmacun", "1× Şalgam" }, Note: (string?)null, Total: 342m)
        }),
        (Status: "on-the-way", Label: L["OrderStatus.OnTheWay"].Value, Icon: "bi-scooter", Orders: new[]
        {
            (Code: "#1037", Minutes: 24, Items: new[] { "1× Adana Kebap", "1× Mercimek Çorbası" }, Note: (string?)null, Total: 410m),
            (Code: "#1035", Minutes: 31, Items: new[] { "2× Beyti", "2× Ayran" }, Note: (string?)null, Total: 690m)
        })
    };
    var sampleDay = new DateTime(2026, 10, 27).ToString("d MMMM", CultureInfo.CurrentCulture);
}
@* Wasla homepage (Figma "Wasla Landing — Refined Direction": desktop 1440 and mobile 390). Product visuals are
   decorative mockups hidden from assistive technology; the text around them carries the content. Photos are from
   Pexels (free licence) and are credited where they are large. *@

<section class="wm-home-hero wm-on-dark" id="orders" aria-labelledby="home-title">
    <picture class="wm-home-hero__media">
        <source media="(max-width: 767.98px)" srcset="~/images/marketing/hero-kitchen-pass-m.jpg" width="900" height="1350" />
        <img src="~/images/marketing/hero-kitchen-pass.jpg" alt="" width="1920" height="1146" fetchpriority="high" />
    </picture>
    <div class="wm-container wm-container--wide wm-home-hero__inner">
        <div class="wm-home-hero__copy">
            <p class="wm-eyebrow wm-eyebrow--on-dark">@L["Marketing.Home.HeroEyebrow"]</p>
            <h1 class="wm-display-xl" id="home-title">
                <span class="wm-line">@L["Marketing.Home.HeroTitleLine1"]</span>
                <span class="wm-line">@L["Marketing.Home.HeroTitleLine2"] <span class="wm-accent">@L["Marketing.Home.HeroTitleAccent"]</span></span>
            </h1>
            <p class="wm-home-hero__lead">@L["Marketing.Home.HeroLead"]</p>
            <div class="wm-actions">
                <a class="wm-btn wm-btn--primary" href="@signupUrl">@L["Marketing.Cta.StartWithOrders"] <i class="bi bi-arrow-right wm-flip-rtl" aria-hidden="true"></i></a>
                <a class="wm-btn wm-btn--secondary-dark" href="#how-it-works">@L["Marketing.Cta.SeeHowItWorks"] <i class="bi bi-arrow-right wm-flip-rtl" aria-hidden="true"></i></a>
            </div>
        </div>

        <div class="wm-flowstrip wm-mock" aria-hidden="true">
            <div class="wm-flowstrip__platforms">
                <span class="wm-plate"><img src="~/images/platforms/trendyolgo.svg" asp-append-version="true" alt="" width="77" height="18" /></span>
                <span class="wm-plate"><img src="~/images/platforms/yemeksepeti.svg" asp-append-version="true" alt="" width="70" height="14" /></span>
                <span class="wm-plate"><img src="~/images/platforms/getiryemek-plate.svg" asp-append-version="true" alt="" width="66" height="12" /></span>
                <span class="wm-plate"><img src="~/images/platforms/migrosyemek.svg" asp-append-version="true" alt="" width="48" height="18" /></span>
            </div>
            <i class="bi bi-arrow-right wm-flip-rtl wm-flowstrip__arrow"></i>
            <span class="wm-flowstrip__order">
                <span class="wm-flowstrip__order-text">
                    <span class="wm-mk-strong">@L["Marketing.Mock.NewOrderCode", "#1042"]</span>
                    <span class="wm-mk-meta">@L["Marketing.Mock.OrderSummary", trendyol, 3, Money(486.5m)]</span>
                </span>
                <span class="wm-mk-btn wm-mk-btn--approve">@L["Orders.Approve"]</span>
            </span>
            <i class="bi bi-arrow-right wm-flip-rtl wm-flowstrip__arrow"></i>
            <span class="wm-flowstrip__bridge">
                <img class="wm-app-icon" src="~/images/brand/wasla-app-icon.svg" asp-append-version="true" alt="" width="44" height="44" />
                <span class="wm-mono">@L["Marketing.Mock.PrintBridge"]</span>
            </span>
            <i class="bi bi-arrow-right wm-flip-rtl wm-flowstrip__arrow"></i>
            <span class="wm-flowstrip__done"><i class="bi bi-printer"></i>@L["Marketing.Mock.SentToKitchenPrinter"]</span>
        </div>
    </div>
    <p class="wm-photo-credit">@L["Marketing.PhotoCredit", "Saad Emris"]</p>
</section>

@* Below 992 px the hero strip becomes this vertical flow (Figma mobile "Order flow"); it repeats what the page says
   in text, so it is decorative. *@
<section class="wm-mobile-flow wm-mock" aria-hidden="true">
    <div class="wm-mobile-flow__stage wm-on-dark">
        <p class="wm-mobile-flow__step">01 · @L["Marketing.Home.FlowStepPlatforms"]</p>
        <div class="wm-mobile-flow__platforms">
            <span class="wm-plate"><img src="~/images/platforms/trendyolgo.svg" asp-append-version="true" alt="" width="98" height="23" /></span>
            <span class="wm-plate"><img src="~/images/platforms/yemeksepeti.svg" asp-append-version="true" alt="" width="98" height="19" /></span>
            <span class="wm-plate"><img src="~/images/platforms/getiryemek-plate.svg" asp-append-version="true" alt="" width="90" height="17" /></span>
            <span class="wm-plate"><img src="~/images/platforms/migrosyemek.svg" asp-append-version="true" alt="" width="62" height="23" /></span>
        </div>
        <p class="wm-mobile-flow__connector">@L["Marketing.Mock.NewOrder"]</p>
        <p class="wm-mobile-flow__step">02 · @L["Marketing.Product.Orders"]</p>
        <div class="wm-mobile-flow__screen">
            <div class="wm-mobile-flow__bar">
                <span class="wm-mk-strong">Lezzet Ocakbaşı</span>
                <span class="wm-live-pill">@L["Orders.LiveDisplay.LiveStatus"]</span>
                @await Html.PartialAsync("_WaslaLogo", new Wasla.Web.Models.Ui.WaslaLogoModel { CssClass = "wasla-logo--hub", Decorative = true })
            </div>
            <div class="wm-mobile-flow__column">
                <div class="wm-live-col-head wm-live-col-head--new"><span>@L["OrderStatus.New"]</span><span>1</span></div>
                <div class="wm-live-card wm-live-card--new wm-live-card--highlight">
                    <div class="wm-live-card__top">
                        <span class="wm-mk-pill wm-mk-pill--platform">@trendyol</span>
                        <span class="wm-mk-pill wm-mk-pill--new">@L["OrderStatus.New"]</span>
                        <span class="wm-mk-meta wm-live-card__age">@Minutes(1)</span>
                    </div>
                    <span class="wm-live-card__code">#1042</span>
                    <span class="wm-live-card__items">2× Adana Dürüm<br />1× Mercimek Çorbası<br />2× Ayran</span>
                    <span class="wm-live-card__note">Acısız olsun, zili çalmayın.</span>
                    <div class="wm-live-card__bottom">
                        <span class="wm-live-card__total">@Money(486.5m)</span>
                        <span class="wm-mk-btn wm-mk-btn--approve">@L["Orders.Approve"]</span>
                        <span class="wm-mk-btn wm-mk-btn--reject">@L["Orders.Reject"]</span>
                    </div>
                </div>
            </div>
        </div>
        <p class="wm-mobile-flow__caption">@L["Marketing.Home.SimplifiedVisualization"]</p>
        <p class="wm-mobile-flow__connector">@L["Marketing.Mock.Approved"]</p>
        <div class="wm-mobile-flow__bridge">
            <img class="wm-app-icon" src="~/images/brand/wasla-app-icon.svg" asp-append-version="true" alt="" width="28" height="28" />
            <span>
                <span class="wm-mk-strong">@L["Marketing.Product.PrintBridge"]</span>
                <span class="wm-mono wm-mobile-flow__state">@L["Marketing.Mock.ConnectedKitchenPc"]</span>
            </span>
        </div>
        <p class="wm-mobile-flow__step">03 · @L["Marketing.Home.FlowStepKitchen"]</p>
        <div class="wm-mobile-flow__printer">
            <img src="~/images/marketing/kitchen-pass-heat-lamps-m.jpg" alt="" width="900" height="600" loading="lazy" />
            <div class="wm-ticket-paper">
                <span class="wm-ticket-paper__row"><strong>@trendyol.ToUpper(CultureInfo.CurrentCulture) · @L["Marketing.Mock.Takeaway"].Value.ToUpper(CultureInfo.CurrentCulture)</strong></span>
                <span class="wm-ticket-paper__row"><span>@L["Marketing.Mock.OrderNumber", "#1042"]</span><span>19:42</span></span>
                <span class="wm-ticket-paper__rule"></span>
                <span>2× Adana Dürüm</span>
                <span>&nbsp;&nbsp;· Acısız</span>
                <span>1× Mercimek Çorbası</span>
                <span>2× Ayran</span>
                <span class="wm-ticket-paper__rule"></span>
                <span class="wm-ticket-paper__row"><strong>@L["Common.Total"].Value.ToUpper(CultureInfo.CurrentCulture)</strong><strong>@Money(486.5m)</strong></span>
            </div>
            <span class="wm-printer-body"><span class="wm-printer-body__led"></span></span>
        </div>
        <p class="wm-success-pill"><i class="bi bi-check-circle"></i>@L["Marketing.Mock.ReceiptSentToPrinter"] <span class="wm-mono">19:42</span></p>
        <p class="wm-mobile-flow__message">@L["Marketing.Home.PrintBridgeTitle"]</p>
    </div>
</section>

<section class="wm-section wm-section--canvas wm-platforms" id="platforms" aria-labelledby="platforms-title">
    <div class="wm-container wm-container--wide wm-platforms__grid">
        <div class="wm-platforms__copy">
            <p class="wm-eyebrow wm-eyebrow--chip">@L["Marketing.Nav.Integrations"]</p>
            <h2 class="wm-display-l" id="platforms-title">
                <span class="wm-line">@L["Marketing.Home.PlatformsTitleLine1"]</span>
                <span class="wm-line">@L["Marketing.Home.PlatformsTitleLine2"]</span>
            </h2>
            <p class="wm-body-m">@L["Marketing.Home.PlatformsLead"]</p>
            <p class="wm-body-s wm-text-muted">@L["Marketing.Home.PlatformsNote"]</p>
        </div>
        <ul class="wm-platforms__logos">
            <li><img src="~/images/platforms/trendyolgo.svg" asp-append-version="true" alt="@L["Orders.PlatformTrendyolGo"]" width="177" height="42" /></li>
            <li><img src="~/images/platforms/yemeksepeti.svg" asp-append-version="true" alt="@L["Orders.PlatformYemeksepeti"]" width="160" height="31" /></li>
            <li><img src="~/images/platforms/getiryemek-plate.svg" asp-append-version="true" alt="@L["Orders.PlatformGetirYemek"]" width="150" height="27" /></li>
            <li><img src="~/images/platforms/migrosyemek.svg" asp-append-version="true" alt="@L["Marketing.Platform.MigrosYemek"]" width="104" height="39" /></li>
        </ul>
    </div>
</section>

<section class="wm-section wm-section--surface wm-steps" id="how-it-works" aria-labelledby="steps-title">
    <div class="wm-container wm-container--wide">
        <div class="wm-split-heading">
            <div>
                <p class="wm-eyebrow wm-eyebrow--chip">@L["Marketing.Nav.HowItWorks"]</p>
                <h2 class="wm-display-l wm-split-heading__title" id="steps-title">@L["Marketing.Home.StepsTitle"]</h2>
            </div>
            <p class="wm-body-l">@L["Marketing.Home.StepsLead"]</p>
        </div>
        <ol class="wm-steps__list">
            <li class="wm-step">
                <div class="wm-step__visual wm-mock" aria-hidden="true">
                    <div class="wm-mk-card wm-alert-card">
                        <div class="wm-alert-card__top">
                            <span class="wm-mk-tile wm-mk-tile--orange"><i class="bi bi-bell"></i></span>
                            <span>
                                <span class="wm-mk-title">@L["Marketing.Mock.NewOrder"]</span>
                                <span class="wm-mk-meta">@trendyol · #1042 · @Money(486.5m)</span>
                            </span>
                        </div>
                        <div class="wm-alert-card__sound">
                            <span class="wm-mk-label">@L["Orders.LiveDisplay.NotificationSound"]</span>
                            <span class="wm-mk-switch"></span>
                        </div>
                    </div>
                </div>
                <h3 class="wm-step__title"><span class="wm-step__num">01</span>@L["Marketing.Home.Step1Title"]</h3>
                <p class="wm-body-m">@L["Marketing.Home.Step1Text"]</p>
            </li>
            <li class="wm-step">
                <div class="wm-step__visual wm-mock" aria-hidden="true">
                    <div class="wm-mk-card wm-timeline-card">
                        <div class="wm-timeline-card__head">
                            <span class="wm-mk-title">#1042</span>
                            <span class="wm-mk-pill wm-mk-pill--platform">@trendyol</span>
                        </div>
                        <span class="wm-timeline-card__row"><span class="wm-dot wm-dot--new"></span><span class="wm-mk-label">@L["OrderStatus.New"]</span><span class="wm-mk-meta">19:41</span></span>
                        <span class="wm-timeline-card__row"><span class="wm-dot wm-dot--preparing"></span><span class="wm-mk-label">@L["OrderStatus.Preparing"]</span><span class="wm-mk-meta">19:43</span></span>
                        <span class="wm-timeline-card__row"><span class="wm-dot wm-dot--ready"></span><span class="wm-mk-label">@L["OrderStatus.ReadyForPickup"]</span><span class="wm-mk-meta">19:58</span></span>
                        <span class="wm-timeline-card__row wm-timeline-card__row--pending"><span class="wm-dot wm-dot--pending"></span><span class="wm-mk-label">@L["OrderStatus.OnTheWay"]</span><span class="wm-mk-meta">@L["Marketing.Mock.WithCourier"]</span></span>
                    </div>
                </div>
                <h3 class="wm-step__title"><span class="wm-step__num">02</span>@L["Marketing.Home.Step2Title"]</h3>
                <p class="wm-body-m">@L["Marketing.Home.Step2Text"]</p>
            </li>
            <li class="wm-step">
                <div class="wm-step__visual wm-mock" aria-hidden="true">
                    <div class="wm-mk-card wm-job-card">
                        <div class="wm-job-card__device">
                            <span class="wm-mk-tile wm-mk-tile--sand"><i class="bi bi-printer"></i></span>
                            <span>
                                <span class="wm-mk-label wm-mk-label--strong">@L["Marketing.Mock.KitchenPrinter"]</span>
                                <span class="wm-mk-meta">@L["Marketing.Mock.PrintBridgeConnected"]</span>
                            </span>
                        </div>
                        <span class="wm-job-card__state"><i class="bi bi-check-circle"></i><span>@L["Marketing.Mock.Queued"]</span><span class="wm-mono">19:41:58</span></span>
                        <span class="wm-job-card__state"><i class="bi bi-check-circle"></i><span>@L["PrintBridge.PrintJobStatusPrinting"]</span><span class="wm-mono">19:41:59</span></span>
                        <span class="wm-job-card__state wm-job-card__state--done"><i class="bi bi-check-circle"></i><span>@L["Marketing.Mock.ReceiptSentToPrinter"]</span><span class="wm-mono">19:42:01</span></span>
                    </div>
                </div>
                <h3 class="wm-step__title"><span class="wm-step__num">03</span>@L["Marketing.Home.Step3Title"]</h3>
                <p class="wm-body-m">@L["Marketing.Home.Step3Text"]</p>
            </li>
        </ol>
    </div>
</section>

<section class="wm-section wm-section--canvas wm-live" id="live-screen" aria-labelledby="live-title">
    <div class="wm-container wm-container--wide">
        <div class="wm-split-heading">
            <div>
                <p class="wm-eyebrow wm-eyebrow--chip">@L["Marketing.Home.LiveEyebrow"]</p>
                <h2 class="wm-display-l wm-split-heading__title" id="live-title">@L["Marketing.Home.LiveTitle"]</h2>
            </div>
            <p class="wm-body-l">@L["Marketing.Home.LiveLead"]</p>
        </div>
        <figure class="wm-live__figure">
            <div class="wm-browser wm-mock" aria-hidden="true">
                <div class="wm-browser__bar">
                    <span class="wm-browser__dots"><span></span><span></span><span></span></span>
                    <span class="wm-browser__address">lezzetocakbasi.app.wasla.tr/orders/live-display</span>
                </div>
                <div class="wm-live-app">
                    <div class="wm-live-app__top">
                        <span class="wm-live-app__avatar">LO</span>
                        <span class="wm-live-app__name">
                            <span class="wm-live-app__title">Lezzet Ocakbaşı <span class="wm-live-app__sync">@L["Marketing.Mock.SyncOn"]</span></span>
                            <span class="wm-mk-meta">@L["Marketing.Mock.TodayUpdated", sampleDay, "19:42:10"]</span>
                        </span>
                        <span class="wm-live-app__hint">@L["Orders.LiveDisplay.FullscreenHintPrefix"] <kbd>F11</kbd></span>
                        <span class="wm-live-app__views">
                            <span class="is-active">@L["Orders.LiveScreen.ViewBoard"]</span>
                            <span>@L["Orders.LiveScreen.ViewList"]</span>
                            <span>@L["Orders.LiveScreen.ViewFocus"]</span>
                        </span>
                        <span class="wm-live-app__brand">@await Html.PartialAsync("_WaslaLogo", new Wasla.Web.Models.Ui.WaslaLogoModel { CssClass = "wasla-logo--hub", Decorative = true })</span>
                    </div>
                    <div class="wm-live-app__chips">
                        <span class="wm-count-chip">@L["OrderStatus.New"] <span class="wm-count-chip__n wm-count-chip__n--new">2</span></span>
                        <span class="wm-count-chip">@L["OrderStatus.Preparing"] <span class="wm-count-chip__n wm-count-chip__n--preparing">3</span></span>
                        <span class="wm-count-chip">@L["OrderStatus.ReadyForPickup"] <span class="wm-count-chip__n wm-count-chip__n--ready">1</span></span>
                        <span class="wm-count-chip">@L["OrderStatus.OnTheWay"] <span class="wm-count-chip__n wm-count-chip__n--on-the-way">2</span></span>
                        <span class="wm-count-chip">@L["Orders.LiveScreen.Completed"] <span class="wm-count-chip__n">4</span></span>
                    </div>
                    <div class="wm-live-app__board">
                        @foreach (var column in board)
                        {
                            <div class="wm-live-col wm-live-col--@column.Status">
                                <div class="wm-live-col-head wm-live-col-head--@column.Status">
                                    <i class="bi @column.Icon"></i>
                                    <span>@column.Label</span>
                                    <span class="wm-live-col-head__n">@column.Orders.Length</span>
                                </div>
                                @foreach (var order in column.Orders)
                                {
                                    <div class="wm-live-card wm-live-card--@column.Status">
                                        <div class="wm-live-card__top">
                                            <span class="wm-mk-pill wm-mk-pill--platform">@trendyol</span>
                                            @if (column.Status == "new")
                                            {
                                                <span class="wm-mk-pill wm-mk-pill--new">@L["OrderStatus.New"]</span>
                                            }
                                            <span class="wm-mk-meta wm-live-card__age">@Minutes(order.Minutes)</span>
                                        </div>
                                        <span class="wm-live-card__code">@order.Code</span>
                                        <span class="wm-live-card__items">
                                            @for (var i = 0; i < order.Items.Length; i++)
                                            {
                                                @order.Items[i]
                                                if (i < order.Items.Length - 1)
                                                {
                                                    <br />
                                                }
                                            }
                                        </span>
                                        @if (order.Note is not null)
                                        {
                                            <span class="wm-live-card__note">@order.Note</span>
                                        }
                                        <div class="wm-live-card__bottom">
                                            <span class="wm-live-card__total">@Money(order.Total)</span>
                                            @if (column.Status == "new")
                                            {
                                                <span class="wm-mk-btn wm-mk-btn--approve">@L["Orders.Approve"]</span>
                                                <span class="wm-mk-btn wm-mk-btn--reject">@L["Orders.Reject"]</span>
                                            }
                                            else
                                            {
                                                if (column.Status == "preparing")
                                                {
                                                    <span class="wm-mk-btn wm-mk-btn--ready">@L["Orders.MarkReady"]</span>
                                                }
                                                <span class="wm-mk-btn wm-mk-btn--quiet">@L["Marketing.Mock.Details"]</span>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
            <figcaption class="wm-mono-caption">@L["Marketing.Home.LiveCaption"]</figcaption>
        </figure>
        <ul class="wm-features">
            <li class="wm-feature"><i class="bi bi-display" aria-hidden="true"></i><h3 class="wm-heading-m">@L["Marketing.Home.LiveFeature1Title"]</h3><p class="wm-body-s">@L["Marketing.Home.LiveFeature1Text"]</p></li>
            <li class="wm-feature"><i class="bi bi-bell" aria-hidden="true"></i><h3 class="wm-heading-m">@L["Marketing.Home.LiveFeature2Title"]</h3><p class="wm-body-s">@L["Marketing.Home.LiveFeature2Text"]</p></li>
            <li class="wm-feature"><i class="bi bi-clock-history" aria-hidden="true"></i><h3 class="wm-heading-m">@L["Marketing.Home.LiveFeature3Title"]</h3><p class="wm-body-s">@L["Marketing.Home.LiveFeature3Text"]</p></li>
            <li class="wm-feature"><i class="bi bi-people" aria-hidden="true"></i><h3 class="wm-heading-m">@L["Marketing.Home.LiveFeature4Title"]</h3><p class="wm-body-s">@L["Marketing.Home.LiveFeature4Text"]</p></li>
            <li class="wm-feature"><i class="bi bi-globe2" aria-hidden="true"></i><h3 class="wm-heading-m">@L["Marketing.Home.LiveFeature5Title"]</h3><p class="wm-body-s">@L["Marketing.Home.LiveFeature5Text"]</p></li>
