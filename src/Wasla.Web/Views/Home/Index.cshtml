@model Wasla.Web.Models.Marketing.MarketingHomeViewModel
@using Microsoft.Extensions.Localization
@using Wasla.Application.Abstractions.Plans
@using Wasla.Web.Formatting
@using Wasla.Web.Models.Marketing
@using Wasla.Web.Routing
@using Wasla.Web.Ui
@inject IStringLocalizer<Wasla.Web.SharedResource> L
@inject IWaslaPlanCatalog PlanCatalog
@{
    ViewData[PublicPageMetadata.ViewDataKey] = new PublicPageMetadata(
        L["Marketing.Home.MetaTitle"].Value,
        L["Marketing.Home.MetaDescription"].Value,
        "/");
    var signupUrl = Url.Action("Index", "Signup")!;
    string Money(decimal amount) => OrderUiHelper.FormatMoney(amount);
}
@* Wasla Marketing homepage (Figma 20:2). Product visuals are decorative mockups and hidden from assistive technology;
   the text around them carries the content. Photos marked temporary in Figma are not used. *@

<section class="wm-hero" aria-labelledby="home-title">
    <div class="wm-container wm-hero__grid">
        <div class="wm-hero__copy">
            <h1 class="wm-h1" id="home-title">@L["Marketing.Home.HeroTitle"] <span class="wm-h1__accent">@L["Marketing.Home.HeroTitleAccent"]</span></h1>
            <p class="wm-hero__lead">@L["Marketing.Home.HeroLead"]</p>
            <div class="wm-actions">
                <a class="wm-btn wm-btn--primary" href="#products">@L["Marketing.Cta.ExploreProducts"]</a>
                <a class="wm-btn wm-btn--secondary" href="@signupUrl">@L["Marketing.Cta.Start"]</a>
            </div>
            <div class="wm-shortcuts">
                <a class="wm-shortcut" href="#orders">
                    <span class="wm-icon-tile wm-icon-tile--s" aria-hidden="true"><i class="bi bi-display"></i></span>
                    <span class="wm-shortcut__text">
                        <span class="wm-shortcut__title">@L["Marketing.Product.Orders"]</span>
                        <span class="wm-shortcut__desc">@L["Marketing.Product.OrdersShort"]</span>
                    </span>
                    <i class="bi bi-arrow-right wm-flip-rtl" aria-hidden="true"></i>
                </a>
                <a class="wm-shortcut" href="@PublicSiteUrls.PosPath">
                    <span class="wm-icon-tile wm-icon-tile--s wm-icon-tile--ink" aria-hidden="true"><i class="bi bi-grid-3x3-gap"></i></span>
                    <span class="wm-shortcut__text">
                        <span class="wm-shortcut__title">@L["Marketing.Product.Pos"] <span class="wm-soon">@L["Marketing.ComingSoon"]</span></span>
                        <span class="wm-shortcut__desc">@L["Marketing.Product.PosShort"]</span>
                    </span>
                    <i class="bi bi-arrow-right wm-flip-rtl" aria-hidden="true"></i>
                </a>
            </div>
        </div>

        <div class="wm-hero-visual wm-mock" aria-hidden="true">
            <div class="wm-hero-visual__backdrop"></div>
            <div class="wm-hero-visual__line wm-hero-visual__line--orders"></div>
            <div class="wm-hero-visual__line wm-hero-visual__line--pos"></div>
            <div class="wm-hero-visual__line wm-hero-visual__line--kitchen"></div>
            <div class="wm-window wm-window--orders">
                <div class="wm-window__row wm-window__head">
                    <span class="wm-icon-tile wm-icon-tile--xs"><i class="bi bi-display"></i></span>
                    <span class="wm-window__title">
                        <span class="wm-ui-title">@L["Marketing.Product.Orders"]</span>
                        <span class="wm-ui-caption">@L["Marketing.Mock.OnlinePlatformOrders"]</span>
                    </span>
                    <span class="wm-badge wm-badge--green">@L["Orders.LiveDisplay.LiveStatus"]</span>
                </div>
                <div class="wm-window__row">
                    @await Html.PartialAsync("_MarketingPlatformMark", new MarketingPlatformMarkModel("yemeksepeti"))
                    <span class="wm-ui-code">#YS-48213</span>
                    <span class="wm-badge wm-badge--amber">@L["OrderStatus.New"]</span>
                    <span class="wm-ui-time">00:42</span>
                </div>
                <div class="wm-window__row">
                    @await Html.PartialAsync("_MarketingPlatformMark", new MarketingPlatformMarkModel("trendyolgo"))
                    <span class="wm-ui-code">#TY-90412</span>
                    <span class="wm-badge wm-badge--blue">@L["OrderStatus.Preparing"]</span>
                    <span class="wm-ui-time">04:10</span>
                </div>
                <div class="wm-window__row">
                    @await Html.PartialAsync("_MarketingPlatformMark", new MarketingPlatformMarkModel("getiryemek"))
                    <span class="wm-ui-code">#GY-20577</span>
                    <span class="wm-badge wm-badge--green">@L["OrderStatus.ReadyForPickup"]</span>
                    <span class="wm-ui-time">11:36</span>
                </div>
            </div>
            <div class="wm-hub">
                @await Html.PartialAsync("_WaslaLogo", new Wasla.Web.Models.Ui.WaslaLogoModel { CssClass = "wasla-logo--hub", Decorative = true })
                <span class="wm-hub__text">
                    <span class="wm-hub__title">@L["Marketing.Mock.OneFamily"]</span>
                    <span class="wm-ui-caption">@L["Marketing.Mock.SameTeam"]</span>
                </span>
            </div>
            <div class="wm-kitchen-chip">
                <i class="bi bi-printer"></i>
                <span class="wm-ui-strong">@L["Marketing.Mock.KitchenTicketPrinted"]</span>
            </div>
            <div class="wm-window wm-window--pos">
                <div class="wm-window__row wm-window__head wm-window__head--ink">
                    <span class="wm-icon-tile wm-icon-tile--xs wm-icon-tile--raised"><i class="bi bi-grid-3x3-gap"></i></span>
                    <span class="wm-window__title">
                        <span class="wm-ui-title">@L["Marketing.Product.Pos"]</span>
                        <span class="wm-ui-caption">@L["Marketing.Mock.TableAndTakeaway"]</span>
                    </span>
                    <span class="wm-ui-strong">@L["Marketing.Mock.Hall"]</span>
                </div>
                <div class="wm-pos-tables">
                    <span class="wm-table wm-table--occupied"><span class="wm-table__name">@L["Marketing.Mock.Table", 4]</span><span class="wm-table__meta">@L["Marketing.Mock.Guests", 2]</span></span>
                    <span class="wm-table"><span class="wm-table__name">@L["Marketing.Mock.Table", 5]</span><span class="wm-table__meta">@L["Marketing.Mock.TableFree"]</span></span>
                    <span class="wm-table wm-table--selected"><span class="wm-table__name">@L["Marketing.Mock.Table", 6]</span><span class="wm-table__meta">@L["Marketing.Mock.Guests", 4]</span></span>
                </div>
                <div class="wm-pos-total">
                    <span class="wm-ui-title">@L["Marketing.Mock.Table", 6] · @Money(905m)</span>
                    <span class="wm-mini-btn wm-mini-btn--action">@L["Marketing.Mock.TakePayment"]</span>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="wm-section wm-section--white" id="products" aria-labelledby="products-title">
    <div class="wm-container">
        <div class="wm-section-heading">
            <h2 class="wm-h2" id="products-title">@L["Marketing.Home.ProductsTitle"]</h2>
            <p class="wm-lead">@L["Marketing.Home.ProductsLead"]</p>
        </div>
        <div class="wm-products">
            <article class="wm-product" id="orders" aria-labelledby="orders-title">
                <div class="wm-product__head">
                    <span class="wm-icon-tile" aria-hidden="true"><i class="bi bi-display"></i></span>
                    <div>
                        <h3 class="wm-product__title" id="orders-title">@L["Marketing.Product.Orders"]</h3>
                        <p class="wm-product__desc">@L["Marketing.Home.OrdersTagline"]</p>
                    </div>
                </div>
                <div class="wm-orders-visual wm-mock" aria-hidden="true">
                    <div class="wm-orders-visual__sources">
                        <span class="wm-source-chip">@await Html.PartialAsync("_MarketingPlatformMark", new MarketingPlatformMarkModel("yemeksepeti"))</span>
                        <span class="wm-source-chip">@await Html.PartialAsync("_MarketingPlatformMark", new MarketingPlatformMarkModel("trendyolgo"))</span>
                        <span class="wm-source-chip">@await Html.PartialAsync("_MarketingPlatformMark", new MarketingPlatformMarkModel("getiryemek"))</span>
                    </div>
                    <span class="wm-orders-visual__arrow"><i class="bi bi-arrow-right wm-flip-rtl"></i></span>
                    <div class="wm-orders-visual__stack">
                        <div class="wm-order-card">
                            <div class="wm-order-card__top">
                                @await Html.PartialAsync("_MarketingPlatformMark", new MarketingPlatformMarkModel("yemeksepeti"))
                                <span class="wm-ui-time"><i class="bi bi-clock"></i> 00:12</span>
                            </div>
                            <span class="wm-ui-code">#YS-48213</span>
                            <span class="wm-ui-caption">@L["Marketing.Mock.OrderItems"]</span>
                            <div class="wm-order-card__bottom">
                                <span class="wm-order-card__amount">@Money(418m)</span>
                                <span class="wm-mini-btn wm-mini-btn--action">@L["Marketing.Mock.Approve"]</span>
                            </div>
                        </div>
                        <div class="wm-receipt">@L["Marketing.Mock.ReceiptPlatform"]
#YS-48213   19:42
- - - - - - - - - - - -
2x @L["Marketing.Mock.ItemAdana"]
1x @L["Marketing.Mock.ItemLentilSoup"]
1x @L["Marketing.Mock.ItemAyran"]
- - - - - - - - - - - -
@L["Common.Total"]   @Money(486.5m)</div>
                    </div>
                </div>
                <ul class="wm-checks wm-checks--two">
                    <li>@L["Marketing.Home.OrdersFeature1"]</li>
                    <li>@L["Marketing.Home.OrdersFeature2"]</li>
                    <li>@L["Marketing.Home.OrdersFeature3"]</li>
                    <li>@L["Marketing.Home.OrdersFeature4"]</li>
                </ul>
                <p class="wm-note">@L["Marketing.Home.IntegrationsNote"]</p>
                <div class="wm-product__cta">
                    <a class="wm-btn wm-btn--secondary" href="#pricing">@L["Marketing.Cta.ViewPlans"]</a>
                </div>
            </article>

            <article class="wm-product wm-product--ink wm-on-dark" id="pos" aria-labelledby="pos-title">
                <div class="wm-product__head">
                    <span class="wm-icon-tile wm-icon-tile--raised" aria-hidden="true"><i class="bi bi-grid-3x3-gap"></i></span>
                    <div>
                        <h3 class="wm-product__title" id="pos-title">@L["Marketing.Product.Pos"] <span class="wm-soon">@L["Marketing.ComingSoon"]</span></h3>
                        <p class="wm-product__desc">@L["Marketing.Home.PosTagline"]</p>
                    </div>
                </div>
                <div class="wm-dining wm-mock" aria-hidden="true">
                    <div class="wm-pos-tables">
                        <span class="wm-table wm-table--occupied"><span class="wm-table__name">@L["Marketing.Mock.Table", 2]</span><span class="wm-table__meta">@L["Marketing.Mock.TableOccupied"]</span></span>
                        <span class="wm-table wm-table--bill"><span class="wm-table__name">@L["Marketing.Mock.Table", 3]</span><span class="wm-table__meta">@L["Marketing.Mock.TableBill"]</span></span>
                        <span class="wm-table"><span class="wm-table__name">@L["Marketing.Mock.Table", 5]</span><span class="wm-table__meta">@L["Marketing.Mock.TableFree"]</span></span>
                    </div>
                </div>
                <p class="wm-product__caption">@L["Marketing.ConceptUi"]</p>
                <ul class="wm-checks">
                    <li>@L["Marketing.Home.PosFeature1"]</li>
                    <li>@L["Marketing.Home.PosFeature2"]</li>
                    <li>@L["Marketing.Home.PosFeature3"]</li>
                    <li>@L["Marketing.Home.PosFeature4"]</li>
                </ul>
                <div class="wm-product__cta">
                    <a class="wm-btn wm-btn--secondary-dark" href="@PublicSiteUrls.PosPath">@L["Marketing.Cta.ExplorePos"]</a>
                </div>
            </article>
        </div>
    </div>
</section>

<section class="wm-section wm-section--canvas" id="channels" aria-labelledby="channels-title">
    <div class="wm-container">
        <div class="wm-section-heading">
            <h2 class="wm-h2" id="channels-title">@L["Marketing.Home.ChannelsTitle"]</h2>
            <p class="wm-lead">@L["Marketing.Home.ChannelsLead"]</p>
        </div>
        <div class="wm-channels">
            <div class="wm-channel">
                <div class="wm-channel__head">
                    <h3 class="wm-channel__title">@L["Marketing.Home.ChannelOnlineTitle"]</h3>
                    <p class="wm-channel__desc">@L["Marketing.Home.ChannelOnlineDesc"]</p>
                </div>
                <div class="wm-mock" aria-hidden="true">
                    <div class="wm-channel__row">@await Html.PartialAsync("_MarketingPlatformMark", new MarketingPlatformMarkModel("yemeksepeti"))<span class="wm-channel__row-text">@L["Marketing.Mock.NewOrderAmount", Money(418m)]</span><span class="wm-ui-time">19:42</span></div>
                    <div class="wm-channel__row">@await Html.PartialAsync("_MarketingPlatformMark", new MarketingPlatformMarkModel("trendyolgo"))<span class="wm-channel__row-text">@L["Marketing.Mock.NewOrderAmount", Money(312m)]</span><span class="wm-ui-time">19:44</span></div>
                    <div class="wm-channel__row">@await Html.PartialAsync("_MarketingPlatformMark", new MarketingPlatformMarkModel("getiryemek"))<span class="wm-channel__row-text">@L["Marketing.Mock.NewOrderAmount", Money(465m)]</span><span class="wm-ui-time">19:47</span></div>
                </div>
                <div class="wm-channel__foot"><i class="bi bi-display" aria-hidden="true"></i>@L["Marketing.Home.ChannelOnlineFoot"]</div>
            </div>
            <div class="wm-kitchen-node" aria-hidden="true">
                <span class="wm-kitchen-node__arrows"><i class="bi bi-arrow-right wm-flip-rtl"></i><i class="bi bi-arrow-left wm-flip-rtl"></i></span>
                <span class="wm-kitchen-node__card">
                    <span class="wm-icon-tile wm-icon-tile--success"><i class="bi bi-printer"></i></span>
                    <span class="wm-kitchen-node__title">@L["Marketing.Home.SameKitchen"]</span>
                    <span class="wm-ui-caption">@L["Marketing.Home.ReceiptAndPrinter"]</span>
                </span>
            </div>
            <div class="wm-channel wm-channel--pos">
                <div class="wm-channel__head">
                    <h3 class="wm-channel__title">@L["Marketing.Home.ChannelInStoreTitle"]</h3>
                    <p class="wm-channel__desc">@L["Marketing.Home.ChannelInStoreDesc"]</p>
                </div>
                <div class="wm-mock" aria-hidden="true">
                    <div class="wm-channel__row"><i class="bi bi-grid-3x3-gap"></i><span class="wm-channel__row-text">@L["Marketing.Mock.Table", 6] · @L["Marketing.Mock.Guests", 4]</span><span class="wm-ui-time">@Money(905m)</span></div>
                    <div class="wm-channel__row"><i class="bi bi-bag"></i><span class="wm-channel__row-text">@L["Marketing.Mock.PhoneTakeaway"]</span><span class="wm-ui-time">@L["OrderStatus.Preparing"]</span></div>
                    <div class="wm-channel__row"><i class="bi bi-clock-history"></i><span class="wm-channel__row-text">@L["Marketing.Mock.PickupAt"]</span><span class="wm-ui-time">@L["OrderStatus.ReadyForPickup"]</span></div>
                    <div class="wm-channel__row"><i class="bi bi-lightning-charge"></i><span class="wm-channel__row-text">@L["Marketing.Mock.QuickSaleCounter"]</span><span class="wm-ui-time">@Money(95m)</span></div>
                </div>
                <div class="wm-channel__foot"><i class="bi bi-grid-3x3-gap" aria-hidden="true"></i>@L["Marketing.Home.ChannelInStoreFoot"] <span class="wm-soon">@L["Marketing.ComingSoon"]</span></div>
            </div>
        </div>
        <p class="wm-note mt-4">@L["Marketing.Home.IntegrationsNote"]</p>
    </div>
</section>

<section class="wm-section wm-section--peach" id="which-product" aria-labelledby="routes-title">
    <div class="wm-container">
        <div class="wm-section-heading">
            <h2 class="wm-h2" id="routes-title">@L["Marketing.Home.RoutesTitle"]</h2>
            <p class="wm-lead">@L["Marketing.Home.RoutesLead"]</p>
