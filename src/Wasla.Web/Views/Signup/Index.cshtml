@model Wasla.Web.Models.Signup.SignupViewModel
@using System.Globalization
@using System.Text.Json
@using Microsoft.Extensions.Localization
@using Wasla.Application.Abstractions.Plans
@using Wasla.Web.Formatting
@using Wasla.Web.Models.Signup
@using BusinessPhoneTypeEnum = Wasla.Domain.Enums.BusinessPhoneType
@inject IStringLocalizer<Wasla.Web.SharedResource> L
@inject IWaslaPlanCatalog PlanCatalog
@{
    Layout = "_PublicLayout";
    ViewData["Title"] = L["Signup.Title"];

    // The browser's registration draft (WAS-192): the page restores its steps from it; nothing posts this form.
    var draft = Model.InitialDraft;
    var simulator = Model.IsPaymentSimulatorAvailable;

    // ---- Plans and prices: every amount, VAT text and saving is the Central Admin price in effect (WAS-147). ----
    var publicPlans = PlanCatalog.GetPublicPlans();
    var selfServicePlans = publicPlans.Where(plan => !plan.IsContactSales).ToList();
    var billingPeriod = draft.Plan.BillingPeriod ?? Model.BillingPeriod;
    var isYearly = string.Equals(billingPeriod, PlanPriceText.Yearly, StringComparison.OrdinalIgnoreCase);
    var shownPeriod = isYearly ? PlanPriceText.Yearly : PlanPriceText.Monthly;
    var periodWordMonthly = L["Signup.Receipt.PeriodMonthly"].Value;
    var periodWordYearly = L["Signup.Receipt.PeriodYearly"].Value;

    object PeriodSummary(WaslaPlanDefinition plan, string period)
    {
        if (plan.IsContactSales)
        {
            var label = period == PlanPriceText.Yearly ? L["Signup.PlanPrice.Enterprise.Yearly"].Value : L[plan.ContactSalesPriceLabelKey!].Value;
            return new { price = label, vat = (string?)null, amount = (string?)null, vatIncluded = (bool?)null };
        }

        var quote = PlanPriceText.Find(Model.PlanPrices, plan.PlanCode, period);
        return new
        {
            price = PlanPriceText.PerPeriod(quote, period, L),
            vat = PlanPriceText.Vat(quote, L),
            amount = quote is null ? null : PlanPriceText.Amount(quote.Price, L),
            vatIncluded = quote?.VatIncluded
        };
    }

    var planSummaries = publicPlans.Select(plan =>
    {
        var name = L[plan.DisplayNameKey].Value;
        var monthly = PlanPriceText.Find(Model.PlanPrices, plan.PlanCode, PlanPriceText.Monthly);
        var yearly = PlanPriceText.Find(Model.PlanPrices, plan.PlanCode, PlanPriceText.Yearly);
        return new
        {
            code = plan.PlanCode,
            name,
            packageTitle = string.Format(L["Signup.SelectedPlanPackageLabel"].Value, name),
            description = L[plan.DescriptionKey].Value,
            monthly = PeriodSummary(plan, PlanPriceText.Monthly),
            yearly = PeriodSummary(plan, PlanPriceText.Yearly),
            // A yearly saving is claimed only when the configured prices show one.
            yearlySaving = plan.IsContactSales ? null : PlanPriceText.YearlySaving(monthly, yearly, L),
            deviceLimit = L[plan.DeviceLimitKey].Value,
            features = plan.FeatureKeys.Select(key => L[key].Value).ToArray(),
            isContactSales = plan.IsContactSales
        };
    }).ToArray();

    // The plan the page starts with: the saved one, else ?plan= (a self-service plan), else the model's default.
    var requestedPlan = PlanCatalog.FindByCode(Model.RequestedPlanCode);
    var startPlanCode = draft.Plan.PlanCode
        ?? (requestedPlan is { IsContactSales: false } ? requestedPlan.PlanCode : null)
        ?? (requestedPlan is { IsContactSales: true } ? null : Model.PlanCode);
    var showEnterpriseNotice = draft.Plan.PlanCode is null && requestedPlan is { IsContactSales: true };

    // ---- The receipt's first render, so nothing shifts when the script starts (signup-receipt.js planView). ----
    // "Due today" and "renews automatically" only where a payment step can follow (the Development simulator);
    // elsewhere the amount is the plan price with its period and VAT text (WAS-194 decision).
    var amountLabel = L[simulator ? "Signup.Receipt.DueToday" : "Signup.Receipt.PlanPrice"].Value;
    var periodNoteMonthlyKey = simulator ? "Signup.Receipt.PeriodNoteMonthly" : "Signup.Receipt.PeriodLineMonthly";
    var periodNoteYearlyKey = simulator ? "Signup.Receipt.PeriodNoteYearly" : "Signup.Receipt.PeriodLineYearly";
    var selectedPlan = selfServicePlans.FirstOrDefault(plan => string.Equals(plan.PlanCode, startPlanCode, StringComparison.OrdinalIgnoreCase));
    var selectedName = selectedPlan is null ? string.Empty : L[selectedPlan.DisplayNameKey].Value;
    var selectedQuote = selectedPlan is null ? null : PlanPriceText.Find(Model.PlanPrices, selectedPlan.PlanCode, shownPeriod);
    var periodWord = isYearly ? periodWordYearly : periodWordMonthly;
    var receiptPlanLine = selectedPlan is null ? string.Empty : string.Format(L["Signup.Receipt.PlanLine"].Value, selectedName, periodWord);
    var receiptVat = selectedQuote is null ? null : PlanPriceText.Vat(selectedQuote, L);
    var receiptPriceLine = selectedPlan is null
        ? string.Empty
        : receiptVat is null
            ? PlanPriceText.PerPeriod(selectedQuote, shownPeriod, L)
            : string.Format(L["Signup.Receipt.PriceLine"].Value, PlanPriceText.PerPeriod(selectedQuote, shownPeriod, L), receiptVat);
    var receiptAmount = selectedQuote is not null
        ? PlanPriceText.Amount(selectedQuote.Price, L)
        : selectedPlan is null ? L["Signup.Receipt.ChoosePlan"].Value : L["Billing.PriceNotSet"].Value;
    var receiptPeriodNote = selectedQuote is null
        ? null
        : string.Format(L[isYearly ? periodNoteYearlyKey : periodNoteMonthlyKey].Value, selectedName);
    var receiptStripDetail = selectedPlan is null
        ? string.Empty
        : receiptVat is null ? receiptPlanLine : string.Format(L["Signup.Receipt.StripDetail"].Value, selectedName, periodWord, receiptVat);
    var slugValue = draft.Restaurant.Slug;
    var domain = string.IsNullOrWhiteSpace(slugValue) ? string.Empty : $"{slugValue.Trim().ToLowerInvariant()}.{Model.ApplicationBaseDomain}";

    string FormatMobile(string? digits) =>
        digits is { Length: 10 } d ? $"+90 {d[..3]} {d[3..6]} {d[6..8]} {d[8..]}" : string.Empty;

    var phoneVerified = draft.Phone.State == SignupPhoneStates.Verified;
    var fullPhone = FormatMobile(draft.Owner.MobilePhone);

    // ---- Steps, in flow order. Where the visitor continues comes from the draft (signup-draft.js currentStep). ----
    var flowSteps = new List<SignupFlowStep>
    {
        new("plan", 1, L["Signup.StepPlan"], L["Signup.Receipt.HintPlan"],
            [new("planLine", receiptPlanLine), new("priceLine", receiptPriceLine)]),
        new("restaurant", 2, L["Signup.StepBusiness"], L["Signup.Receipt.HintRestaurant"],
            [new("businessName", draft.Restaurant.BusinessName), new("domain", domain, Ltr: true)]),
        new("owner", 3, L["Signup.StepOwner"], L["Signup.Receipt.HintOwner"],
            [new("ownerName", draft.Owner.FullName), new("ownerEmail", draft.Owner.Email, Ltr: true)]),
        new("phone", 4, L["Signup.StepPhone"], L["Signup.Receipt.HintPhone"],
            [new("phoneLine", phoneVerified ? fullPhone : draft.Phone.MaskedPhone, Ltr: true),
             new("phoneState", phoneVerified ? L["Signup.Receipt.PhoneVerified"].Value : null)]),
        new("review", 5, L["Signup.StepReview"], L["Signup.Receipt.HintReview"], [])
    };
    var stepOrder = flowSteps.Select(step => step.Id).ToList();
    var completedSteps = new List<string>();
    if (draft.Plan.Complete) completedSteps.Add("plan");
    if (draft.Restaurant.Complete) completedSteps.Add("restaurant");
    if (draft.Owner.Complete) completedSteps.Add("owner");
    if (draft.Owner.Complete && phoneVerified) completedSteps.Add("phone");
    var initialStep = !draft.Plan.Complete ? "plan"
        : !draft.Restaurant.Complete ? "restaurant"
        : !draft.Owner.Complete ? "owner"
        : phoneVerified ? "review" : "phone";
    string StepStatus(string id) => id == initialStep ? "current" : completedSteps.Contains(id) ? "done" : "upcoming";
    string Counter(int number) => string.Format(CultureInfo.CurrentCulture, L["Signup.Flow.StepCounter"].Value, number, flowSteps.Count);
    string? Hidden(string id) => initialStep == id ? null : "hidden";

    var asideReceipt = new SignupReceiptView("signupReceipt", flowSteps, initialStep, completedSteps, amountLabel, receiptAmount,
        selectedQuote is not null, receiptVat, receiptPeriodNote, receiptStripDetail);
    var sheetReceipt = asideReceipt with { IdPrefix = "signupSummarySheet" };

    var submitLabel = L[simulator ? "Signup.ContinueToPayment" : "Signup.SubmitRegistration"].Value;
    var supportEmail = Model.SupportEmail;

    // The landline hint names the chosen city's area code. The catalog holds one code per city and keeps 212 for
    // İstanbul (TurkeyReferenceDataSeeder), whose Asian side dials 216, so İstanbul lists both. Only a hint: the number
    // typed is never changed or checked against it.
    string[] LandlineAreaCodes(string cityName, string? code) =>
        string.Equals(cityName, "İstanbul", StringComparison.Ordinal) ? ["212", "216"]
        : string.IsNullOrWhiteSpace(code) ? [] : [code.Trim()];

    var signupConfig = new
    {
        cities = Model.Cities.Select(c => new { id = c.Id, name = c.Name, phoneAreaCodes = LandlineAreaCodes(c.Name, c.PhoneAreaCode) }),
        districtsUrl = Model.Endpoints?.Districts ?? Url.Action("Districts", "Signup"),
        neighborhoodsUrl = Model.Endpoints?.Neighborhoods ?? Url.Action("Neighborhoods", "Signup"),
        streetsUrl = Model.Endpoints?.Streets ?? Url.Action("Streets", "Signup"),
        selectDistrictText = L["Signup.SelectDistrict"].Value,
        neighborhoodManualHint = L["Signup.NeighborhoodManualHint"].Value,
        streetManualHint = L["Signup.StreetManualHint"].Value,
        address = new
        {
            search = L["Signup.Address.Search"].Value,
            loading = L["Signup.Address.Loading"].Value,
            noMatches = L["Signup.Address.NoMatches"].Value,
            empty = L["Signup.Address.Empty"].Value,
            noSuggestions = L["Signup.Address.NoSuggestions"].Value,
            useTyped = L["Signup.Address.UseTyped"].Value,
            results = L["Signup.Address.Results"].Value,
            districtsFailed = L["Signup.Address.DistrictsFailed"].Value,
            districtsFailedShort = L["Signup.Address.DistrictsFailedShort"].Value,
            neighborhoodsFailed = L["Signup.Address.NeighborhoodsFailed"].Value,
            streetsFailed = L["Signup.Address.StreetsFailed"].Value,
            neighborhoodPlaceholder = L["Signup.Address.NeighborhoodPlaceholder"].Value,
            streetPlaceholder = L["Signup.Address.StreetPlaceholder"].Value
        },
        showPasswordText = L["Common.ShowPassword"].Value,
        hidePasswordText = L["Common.HidePassword"].Value,
        showPasswordLabel = L["Signup.Password.Show"].Value,
        hidePasswordLabel = L["Signup.Password.Hide"].Value,
        passwordMismatchText = L["Validation.PasswordMismatch"].Value,
        emailInvalidText = L["Validation.EmailInvalid"].Value,
        mobileHint = L["Signup.MobilePhoneHint"].Value,
        landlineHint = L["Signup.LandlinePhoneHint"].Value,
        landlineAreaCodeHint = L["Signup.LandlineAreaCodeHint"].Value,
        defaultCountryCode = "+90",
        plans = planSummaries,
        selfServicePlans = selfServicePlans.Select(plan => plan.PlanCode),
        requestedPlanCode = Model.RequestedPlanCode,
        businessSubtypeRequiredText = L["Validation.BusinessSubtypeRequired"].Value,
        businessCategorySubtypeRequiredText = L["Validation.BusinessCategorySubtypeRequired"].Value,
        baseDomain = Model.ApplicationBaseDomain,
        codeLength = Model.PhoneCodeLength,
        flow = new { order = stepOrder },
        messages = new
        {
            periodMonthly = periodWordMonthly,
            periodYearly = periodWordYearly,
            planLine = L["Signup.Receipt.PlanLine"].Value,
            priceLine = L["Signup.Receipt.PriceLine"].Value,
            periodNoteMonthly = L[periodNoteMonthlyKey].Value,
            periodNoteYearly = L[periodNoteYearlyKey].Value,
            stripDetail = L["Signup.Receipt.StripDetail"].Value,
            choosePlan = L["Signup.Receipt.ChoosePlan"].Value,
            priceNotSet = L["Billing.PriceNotSet"].Value,
            stateDone = L["Signup.Receipt.StateDone"].Value,
            stateCurrent = L["Signup.Receipt.StateCurrent"].Value,
            stateUpcoming = L["Signup.Receipt.StateUpcoming"].Value,
            phoneVerified = L["Signup.Receipt.PhoneVerified"].Value,
            planRequired = L["Validation.PlanRequired"].Value,
            payPlanRow = L["Signup.Pay.PlanRow"].Value,
            payVatIncluded = L["Signup.Pay.VatIncluded"].Value,
            payVatExcluded = L["Signup.Pay.VatExcluded"].Value,
            payPeriodMonthly = L["Signup.Pay.PeriodMonthly"].Value,
            payPeriodYearly = L["Signup.Pay.PeriodYearly"].Value,
            payRenewMonthly = L["Signup.Pay.RenewMonthly"].Value,
            payRenewYearly = L["Signup.Pay.RenewYearly"].Value,
            reviewNotProvided = L["Signup.Review.NotProvidedOptional"].Value,
            reviewPasswordSet = L["Signup.Review.PasswordSet"].Value,
            reviewBusinessTypeLine = L["Signup.Review.BusinessTypeLine"].Value,
            reviewBuilding = L["Signup.Review.AddressBuilding"].Value,
            reviewFloor = L["Signup.Review.AddressFloor"].Value,
            reviewDoor = L["Signup.Review.AddressDoor"].Value,
            passwordRuleMet = L["Signup.Flow.RuleMet"].Value,
            passwordRuleUnmet = L["Signup.Flow.RuleUnmet"].Value,
            slugChecking = L["Signup.Flow.SlugChecking"].Value,
            slugAvailable = L["Signup.Flow.SlugAvailable"].Value,
            slugTaken = L["Signup.SlugUnavailable"].Value,
            slugInvalid = L["Validation.SlugInvalid"].Value,
            slugCheckFailed = L["Signup.Flow.SlugCheckFailed"].Value,
            addressTakenBody = L["Signup.Flow.AddressTakenBody"].Value,
            invalidRequest = L["Signup.Draft.InvalidRequest"].Value,
            networkError = L["Signup.Flow.NetworkError"].Value,
            serverError = L["Signup.Flow.ServerError"].Value,
            reload = L["Signup.Flow.Reload"].Value,
            startAgain = L["Signup.Flow.StartAgain"].Value,
            submitted = L["Signup.Draft.Submitted"].Value,
            openRegistration = L["Signup.Flow.OpenRegistration"].Value
        },
        phoneMessages = new
        {
            send = L["Signup.Phone.Send"].Value,
            resend = L["Signup.Phone.Resend"].Value,
            verify = L["Signup.Phone.Verify"].Value,
            toReview = L["Signup.Flow.ToReview"].Value,
            sendToNumber = L["Signup.Phone.SendToNumber"].Value,
            sent = L["Signup.Phone.Sent"].Value,
            codeExpired = L["Signup.Phone.CodeExpired"].Value,
            codeFormat = L["Signup.Phone.CodeFormatInvalid"].Value,
            verifiedMoving = L["Signup.Phone.VerifiedMoving"].Value,
            deliveryFailedTitle = L["Signup.Phone.DeliveryFailedTitle"].Value
        }
    };

    string Optional() => L["Setup.Optional"].Value;
}
<link rel="stylesheet" href="~/css/wasla-signup.css" asp-append-version="true" />
<div class="su-shell" data-su-root data-su-current="@initialStep" data-su-period-shown="@shownPeriod" style="--su-step-count: @flowSteps.Count">
    <div class="su-container">
        <h1 class="su-visually-hidden">@L["Signup.Title"]</h1>

        <noscript>
            <div class="su-notice su-notice--danger su-noscript">
                <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
                <p>@L["Signup.Flow.NoScript"]</p>
            </div>
        </noscript>

        <div class="su-progress" aria-hidden="true">
            @foreach (var step in flowSteps)
            {
                <span class="su-progress__segment" data-su-progress="@step.Id" data-state="@StepStatus(step.Id)"></span>
            }
        </div>

        @* The page needs the draft API: nothing posts this form. The action only keeps a stray submission (no script)
           away from the address bar; the server answers it with 405 and stores nothing. *@
        <form asp-action="Index" method="post" novalidate id="signupForm" class="su-layout">
            <div class="su-main">
                <div class="su-notice su-notice--danger su-page-alert" data-su-page-alert role="alert" tabindex="-1" hidden>
                    <i class="bi bi-x-circle" aria-hidden="true"></i>
                    <div>
                        <p data-su-page-alert-text></p>
                        <a class="su-link" data-su-page-alert-link href="#" hidden></a>
                    </div>
                </div>

                @if (!Model.IsPhoneVerificationAvailable)
                {
                    <div class="su-notice su-notice--danger" role="status">
                        <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
                        <div>
                            <strong class="su-notice__title">@L["Signup.Flow.PhoneUnavailableTitle"]</strong>
                            <p>@L["Signup.Phone.Unavailable"]</p>
                            @if (!string.IsNullOrWhiteSpace(supportEmail))
                            {
                                <p><a class="su-link" href="mailto:@supportEmail"><bdi>@supportEmail</bdi></a></p>
                            }
                        </div>
                    </div>
                }

                @* ---------------------------------------------------------------- 1. Plan (Figma D1, M1) *@
                <section class="su-step" id="signupStep-plan" data-su-step="plan" aria-labelledby="signupStep-plan-title"
                         data-su-strip-label="@L["Signup.Strip.Continue"]" data-su-strip-carries hidden="@Hidden("plan")">
                    <div class="su-step__bar">
                        <span class="su-step__counter">@Counter(1)</span>
                    </div>
                    <h2 class="su-title" id="signupStep-plan-title" tabindex="-1">@L["Signup.Flow.PlanTitle"]</h2>
                    <p class="su-lead">@L["Signup.Flow.PlanLead"]</p>
                    <partial name="_SignupErrorSummary" />

                    <div class="su-section">
                        <fieldset class="su-field">
                            <legend class="su-label">@L["Signup.BillingPeriod"]</legend>
                            @* autocomplete="off" on the period, plan and phone-type radios: the saved draft and the server's
                               prices decide them. A browser that reloads the page from its history (no back/forward cache)
                               would otherwise check the visitor's last unsaved choice after the script drew the receipt, with
                               no change event, leaving one plan checked beside another plan's price. *@
                            <div class="su-segment">
                                @foreach (var period in new[] { PlanPriceText.Monthly, PlanPriceText.Yearly })
                                {
                                    <span class="su-segment__option">
                                        <input class="su-segment__input" type="radio" name="BillingPeriod" value="@period" id="signupBillingPeriod-@period" autocomplete="off"
                                               data-su-field="@(period == PlanPriceText.Monthly ? "plan.billingPeriod" : null)"
                                               checked="@(string.Equals(billingPeriod, period, StringComparison.OrdinalIgnoreCase) ? "checked" : null)" />
                                        <label class="su-segment__label" for="signupBillingPeriod-@period">@L[period == PlanPriceText.Monthly ? "Signup.BillingMonthly" : "Signup.BillingYearly"]</label>
                                    </span>
                                }
                            </div>
                            <span class="field-validation-valid" data-su-error-for="plan.billingPeriod"></span>
                        </fieldset>

                        <div id="signupEnterpriseNotice" class="su-notice" role="status" hidden="@(showEnterpriseNotice ? null : "hidden")">
                            <i class="bi bi-info-circle" aria-hidden="true"></i>
                            <div>
                                <strong class="su-notice__title">@L["Signup.EnterpriseNoticeTitle"]</strong>
                                <p>@L["Signup.EnterpriseNoticeBody"]</p>
                            </div>
                        </div>

                        <fieldset class="su-field" aria-describedby="signupPlanCode-error">
                            <legend class="su-visually-hidden">@L["Signup.Plan"]</legend>
                            <div class="su-plans" id="signupPlans">
                                @for (var i = 0; i < selfServicePlans.Count; i++)
                                {
                                    var plan = selfServicePlans[i];
                                    var summary = planSummaries.First(p => p.code == plan.PlanCode);
                                    var inputId = $"signupPlan-{plan.PlanCode}";
                                    <div class="su-plan" data-su-plan="@plan.PlanCode">
                                        <input class="su-plan__input" type="radio" name="PlanCode" value="@plan.PlanCode" id="@inputId" autocomplete="off"
                                               data-su-field="@(i == 0 ? "plan.planCode" : null)"
                                               checked="@(string.Equals(plan.PlanCode, startPlanCode, StringComparison.OrdinalIgnoreCase) ? "checked" : null)"
                                               aria-describedby="@inputId-description @inputId-price" />
                                        <div class="su-plan__body">
                                            <label class="su-plan__name" for="@inputId">@summary.name</label>
                                            <span class="su-plan__description" id="@inputId-description">@summary.description</span>
                                            <span class="su-plan__devices">@summary.deviceLimit</span>
                                        </div>
                                        <div class="su-plan__price" id="@inputId-price">
                                            @foreach (var period in new[] { PlanPriceText.Monthly, PlanPriceText.Yearly })
                                            {
                                                var quote = PlanPriceText.Find(Model.PlanPrices, plan.PlanCode, period);
                                                <span data-su-period="@period">
                                                    @if (quote is null)
                                                    {
                                                        <span class="su-plan__amount su-plan__amount--unset">@L["Billing.PriceNotSet"]</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="su-plan__amount"><bdi>@PlanPriceText.Amount(quote.Price, L)</bdi></span>
                                                        <span class="su-plan__meta">@string.Format(L["Signup.Flow.PlanPriceMeta"].Value, period == PlanPriceText.Yearly ? periodWordYearly : periodWordMonthly, PlanPriceText.Vat(quote, L))</span>
                                                    }
                                                </span>
                                            }
                                        </div>
                                        <div class="su-plan__more">
                                            @if (summary.yearlySaving is not null)
                                            {
                                                <p class="su-plan__saving" data-su-period="@PlanPriceText.Yearly">@summary.yearlySaving</p>
                                            }
                                            <ul class="su-plan__features">
                                                @foreach (var feature in summary.features)
                                                {
                                                    <li><i class="bi bi-check2" aria-hidden="true"></i><span>@feature</span></li>
                                                }
                                            </ul>
                                        </div>
                                    </div>
                                }
                            </div>
                            <span class="field-validation-valid" id="signupPlanCode-error" data-su-error-for="plan.planCode"></span>
                        </fieldset>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(supportEmail))
                    {
                        <p class="su-inline-note">
                            @L["Signup.Flow.EnterpriseQuestion"]
                            <a class="su-link" href="mailto:@supportEmail">@L["Signup.Flow.EnterpriseLink"]</a>
                        </p>
                    }

                    <div class="su-actions su-actions--strip">
                        <button type="button" class="su-btn su-btn--primary" data-su-next>@L["Signup.Flow.ToRestaurant"]</button>
                    </div>
                </section>

                @* ---------------------------------------------------------------- 2. Restaurant (Figma D2, M2, P1, L1, S10) *@
                <section class="su-step" id="signupStep-restaurant" data-su-step="restaurant" aria-labelledby="signupStep-restaurant-title"
                         data-su-strip-label="@L["Signup.Strip.Continue"]" data-su-strip-carries hidden="@Hidden("restaurant")">
                    <div class="su-step__bar">
                        <button type="button" class="su-back" data-su-go="plan" aria-label="@string.Format(L["Signup.Flow.BackTo"].Value, L["Signup.StepPlan"].Value)">
                            <i class="bi bi-chevron-left su-flip-rtl" aria-hidden="true"></i>@L["Signup.StepPlan"]
                        </button>
                        <span class="su-step__counter">@Counter(2)</span>
                    </div>
                    <h2 class="su-title" id="signupStep-restaurant-title" tabindex="-1">@L["Signup.Flow.RestaurantTitle"]</h2>
                    <p class="su-lead">@L["Signup.Flow.RestaurantLead"]</p>
                    <div class="su-notice su-notice--danger" data-su-address-taken role="alert" hidden>
                        <i class="bi bi-x-circle" aria-hidden="true"></i>
                        <div>
                            <strong class="su-notice__title">@L["Signup.Flow.AddressTakenTitle"]</strong>
                            <p data-su-address-taken-text></p>
                        </div>
                    </div>
                    <partial name="_SignupErrorSummary" />

                    <div class="su-section">
                        <h3 class="su-section__title">@L["Signup.Flow.SectionBusiness"]</h3>
                        <div class="su-field">
                            <label class="su-label" for="signupBusinessName">@L["Signup.BusinessName"]</label>
                            <input asp-for="BusinessName" class="su-input" id="signupBusinessName" dir="auto" autocomplete="organization"
                                   data-su-field="restaurant.businessName" aria-describedby="signupBusinessName-error" />
                            <span asp-validation-for="BusinessName" id="signupBusinessName-error" data-su-error-for="restaurant.businessName"></span>
                        </div>
                        <fieldset class="su-field" aria-describedby="signupBusinessTypesHint signupBusinessTypeClientError signupBusinessTypes-error">
                            <legend class="su-label">@L["Signup.BusinessType"]</legend>
                            <p class="su-help" id="signupBusinessTypesHint">@L["Signup.BusinessSubtypeHint"]</p>
                            <div id="signupBusinessTypes">
                                <div class="su-chips">
                                    @for (var i = 0; i < Model.BusinessCategories.Count; i++)
                                    {
                                        var category = Model.BusinessCategories[i];
                                        var categoryId = $"businessCategory-{category.CategoryCode}";
                                        <span class="su-chip">
                                            <input class="su-chip__input" type="checkbox" id="@categoryId" data-category-toggle="@category.CategoryCode"
                                                   data-su-field="@(i == 0 ? "restaurant.businessTypeCodes" : null)"
                                                   aria-controls="businessSubtypes-@category.CategoryCode" />
                                            <label class="su-chip__label" for="@categoryId"><i class="bi bi-check2" aria-hidden="true"></i>@category.Label</label>
                                        </span>
                                    }
                                </div>
                                @foreach (var category in Model.BusinessCategories)
                                {
                                    <div class="su-subtypes is-collapsed" id="businessSubtypes-@category.CategoryCode"
                                         data-category-panel="@category.CategoryCode" role="group" aria-labelledby="businessSubtypes-@category.CategoryCode-title">
                                        <p class="su-subtypes__title" id="businessSubtypes-@category.CategoryCode-title">@string.Format(L["Signup.Flow.SubtypesFor"].Value, category.Label)</p>
                                        <div class="su-chips">
                                            @foreach (var subtype in category.Subtypes)
                                            {
                                                var subtypeId = $"businessType-{subtype.Code}";
                                                <span class="su-chip">
                                                    <input class="su-chip__input" type="checkbox" name="SelectedBusinessTypeCodes" value="@subtype.Code" id="@subtypeId"
                                                           data-category="@category.CategoryCode" />
                                                    <label class="su-chip__label" for="@subtypeId"><i class="bi bi-check2" aria-hidden="true"></i>@subtype.Label</label>
                                                </span>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                            <p class="su-error" id="signupBusinessTypeClientError" hidden></p>
                            <span class="field-validation-valid" id="signupBusinessTypes-error" data-su-error-for="restaurant.businessTypeCodes"></span>
                        </fieldset>
                    </div>

                    <div class="su-section">
                        <h3 class="su-section__title">@L["Signup.Flow.SectionPanelAddress"]</h3>
                        <p class="su-section__hint">@L["Signup.Flow.PanelAddressHint"]</p>
                        <div class="su-field">
                            <label class="su-label" for="signupSlug">@L["Signup.Slug"]</label>
                            <div class="su-group" dir="ltr">
                                <input asp-for="Slug" class="su-input" id="signupSlug" pattern="[a-z0-9][a-z0-9_-]*" autocomplete="off" autocapitalize="off"
                                       autocorrect="off" spellcheck="false" data-su-field="restaurant.slug"
                                       aria-describedby="signupSlug-error signupSlugStatus signupSlugRules" />
                                <span class="su-group__addon su-group__addon--suffix">.@Model.ApplicationBaseDomain</span>
                            </div>
                            <span asp-validation-for="Slug" id="signupSlug-error" data-su-error-for="restaurant.slug"></span>
                            <p class="su-status" id="signupSlugStatus" data-su-slug-status data-state="preview" aria-live="polite">
                                <i class="bi su-status__icon" aria-hidden="true"></i>
                                <span data-su-slug-preview>@L["Signup.SlugHelp"] <bdi class="su-domain" id="signupDomainPreview">@(string.IsNullOrEmpty(domain) ? $"your-name.{Model.ApplicationBaseDomain}" : domain)</bdi></span>
                                <span data-su-slug-message hidden></span>
                            </p>
                            <p class="su-help" id="signupSlugRules">@L["Signup.Flow.SlugRules"]</p>
                        </div>
                    </div>

                    <div class="su-section">
                        <h3 class="su-section__title">@L["Signup.StepAddress"]</h3>
                        <p class="su-section__hint">@L["Signup.Flow.AddressHint"]</p>
                        <p class="su-fact">
                            <i class="bi bi-geo-alt" aria-hidden="true"></i>
                            <span>@L["Signup.Country"]</span>
                            <strong>@Model.Country</strong>
                        </p>
                        <input type="hidden" asp-for="Country" id="signupCountry" />
                        <span class="field-validation-valid" data-su-error-for="restaurant.country"></span>
                        @* The four address fields are searchable lists (signup-combobox.js). City and district keep their
                           native selects, visually hidden, as the value, the validation and the events the page uses;
                           the text input beside each is what the visitor sees and types in. Neighbourhood and street are
                           the inputs themselves: catalog names are suggestions, typed text is a valid value. *@
                        <div class="su-row su-row--aligned su-row--2">
                            <div class="su-field">
                                <label class="su-label" for="signupCityInput">@L["Signup.CityLabel"]</label>
                                <div class="su-combo" id="signupCityCombo" data-su-combo="city">
                                    <div class="su-combo__control">
                                        <i class="bi bi-search su-combo__search" aria-hidden="true"></i>
                                        <input type="text" class="su-input su-combo__input" id="signupCityInput" dir="auto" spellcheck="false"
                                               aria-required="true" aria-describedby="signupCityId-error" data-su-combo-input />
                                        <span class="su-combo__toggle" data-su-combo-toggle aria-hidden="true"><i class="bi bi-chevron-down"></i></span>
                                    </div>
                                    <div class="su-combo__popup" data-su-combo-popup hidden>
                                        <ul class="su-combo__list" role="listbox" id="signupCityList" aria-label="@L["Signup.CityLabel"]"></ul>
                                        <p class="su-combo__state" data-su-combo-state hidden><span data-su-combo-state-text></span></p>
                                    </div>
                                    <span class="su-visually-hidden" aria-live="polite" data-su-combo-live></span>
                                    <select asp-for="CityId" asp-items="Model.CityOptions" class="su-select su-combo__native su-visually-hidden" id="signupCityId"
                                            tabindex="-1" aria-hidden="true" data-su-field="restaurant.cityId"></select>
                                </div>
                                <span asp-validation-for="CityId" id="signupCityId-error" data-su-error-for="restaurant.cityId"></span>
                            </div>
                            <div class="su-field">
                                <label class="su-label" for="signupDistrictInput">@L["Signup.DistrictLabel"]</label>
                                <div class="su-combo" id="signupDistrictCombo" data-su-combo="district">
                                    <div class="su-combo__control">
                                        <i class="bi bi-search su-combo__search" aria-hidden="true"></i>
                                        <input type="text" class="su-input su-combo__input" id="signupDistrictInput" dir="auto" spellcheck="false"
                                               aria-required="true" aria-describedby="signupDistrictId-error" data-su-combo-input />
                                        <span class="su-combo__toggle" data-su-combo-toggle aria-hidden="true"><i class="bi bi-chevron-down"></i></span>
                                    </div>
                                    <div class="su-combo__popup" data-su-combo-popup hidden>
                                        <ul class="su-combo__list" role="listbox" id="signupDistrictList" aria-label="@L["Signup.DistrictLabel"]"></ul>
                                        <p class="su-combo__state" data-su-combo-state hidden>
                                            <span data-su-combo-state-text></span>
                                            <button type="button" class="su-combo__retry" data-su-combo-retry hidden>@L["Signup.Address.Retry"]</button>
                                        </p>
                                    </div>
                                    <p class="su-combo__alert" id="signupDistrictAlert" data-su-combo-alert hidden>
                                        <i class="bi bi-exclamation-circle" aria-hidden="true"></i>
                                        <span>@L["Signup.Address.DistrictsFailed"]</span>
                                        <button type="button" class="su-combo__retry" data-su-combo-retry>@L["Signup.Address.Retry"]</button>
                                    </p>
                                    <span class="su-visually-hidden" aria-live="polite" data-su-combo-live></span>
                                    <select asp-for="DistrictId" asp-items="Model.DistrictOptions" class="su-select su-combo__native su-visually-hidden" id="signupDistrictId"
                                            tabindex="-1" aria-hidden="true" data-su-field="restaurant.districtId"></select>
                                </div>
                                <span asp-validation-for="DistrictId" id="signupDistrictId-error" data-su-error-for="restaurant.districtId"></span>
                            </div>
                        </div>
                        <div class="su-row su-row--aligned su-row--2 su-row--stack-sm">
                            <div class="su-field">
                                <label class="su-label" for="signupNeighborhood">@L["Signup.Address.NeighborhoodLabel"]</label>
                                <div class="su-combo" id="signupNeighborhoodCombo" data-su-combo="neighborhood">
                                    <div class="su-combo__control">
                                        <i class="bi bi-search su-combo__search" aria-hidden="true"></i>
                                        <input asp-for="Neighborhood" class="su-input su-combo__input" id="signupNeighborhood" dir="auto" spellcheck="false"
                                               aria-required="true" data-su-field="restaurant.neighborhood" data-su-combo-input
                                               aria-describedby="signupNeighborhood-error signupNeighborhoodHint" />
                                        <span class="su-combo__toggle" data-su-combo-toggle aria-hidden="true"><i class="bi bi-chevron-down"></i></span>
                                    </div>
                                    <div class="su-combo__popup" data-su-combo-popup hidden>
                                        <ul class="su-combo__list" role="listbox" id="signupNeighborhoodList" aria-label="@L["Signup.Address.NeighborhoodLabel"]"></ul>
                                        <p class="su-combo__state" data-su-combo-state hidden>
                                            <span data-su-combo-state-text></span>
                                            <button type="button" class="su-combo__retry" data-su-combo-retry hidden>@L["Signup.Address.Retry"]</button>
                                        </p>
                                    </div>
                                    <p class="su-combo__alert" id="signupNeighborhoodAlert" data-su-combo-alert hidden>
                                        <i class="bi bi-exclamation-circle" aria-hidden="true"></i>
                                        <span>@L["Signup.Address.NeighborhoodsFailed"]</span>
                                        <button type="button" class="su-combo__retry" data-su-combo-retry>@L["Signup.Address.Retry"]</button>
                                    </p>
                                    <span class="su-visually-hidden" aria-live="polite" data-su-combo-live></span>
                                </div>
                                <input type="hidden" asp-for="NeighborhoodId" id="signupNeighborhoodId" />
                                <span asp-validation-for="Neighborhood" id="signupNeighborhood-error" data-su-error-for="restaurant.neighborhood"></span>
                                <p id="signupNeighborhoodHint" class="su-help"></p>
                            </div>
                            <div class="su-field">
                                <label class="su-label" for="signupPostalCode">@L["Signup.PostalCode"] <span class="su-optional">@Optional()</span></label>
                                <input asp-for="PostalCode" class="su-input" id="signupPostalCode" autocomplete="postal-code" inputmode="numeric"
                                       data-su-field="restaurant.postalCode" aria-describedby="signupPostalCode-error" />
                                <span asp-validation-for="PostalCode" id="signupPostalCode-error" data-su-error-for="restaurant.postalCode"></span>
                            </div>
                        </div>
                        <div class="su-field">
                            <label class="su-label" for="signupStreetAddress">@L["Signup.Address.StreetLabel"]</label>
                            <div class="su-combo" id="signupStreetCombo" data-su-combo="street">
                                <div class="su-combo__control">
                                    <i class="bi bi-search su-combo__search" aria-hidden="true"></i>
                                    <input asp-for="StreetAddress" class="su-input su-combo__input" id="signupStreetAddress" dir="auto" spellcheck="false"
                                           aria-required="true" data-su-field="restaurant.streetAddress" data-su-combo-input
                                           aria-describedby="signupStreetAddress-error signupStreetId-error signupStreetHint" />
                                    <span class="su-combo__toggle" data-su-combo-toggle aria-hidden="true"><i class="bi bi-chevron-down"></i></span>
                                </div>
                                <div class="su-combo__popup" data-su-combo-popup hidden>
                                    <ul class="su-combo__list" role="listbox" id="signupStreetList" aria-label="@L["Signup.Address.StreetLabel"]"></ul>
                                    <p class="su-combo__state" data-su-combo-state hidden>
                                        <span data-su-combo-state-text></span>
                                        <button type="button" class="su-combo__retry" data-su-combo-retry hidden>@L["Signup.Address.Retry"]</button>
                                    </p>
                                </div>
                                <p class="su-combo__alert" id="signupStreetAlert" data-su-combo-alert hidden>
                                    <i class="bi bi-exclamation-circle" aria-hidden="true"></i>
                                    <span>@L["Signup.Address.StreetsFailed"]</span>
                                    <button type="button" class="su-combo__retry" data-su-combo-retry>@L["Signup.Address.Retry"]</button>
                                </p>
                                <span class="su-visually-hidden" aria-live="polite" data-su-combo-live></span>
                            </div>
                            <input type="hidden" asp-for="StreetId" id="signupStreetId" />
                            <span asp-validation-for="StreetAddress" id="signupStreetAddress-error" data-su-error-for="restaurant.streetAddress"></span>
                            <span class="field-validation-valid" id="signupStreetId-error" data-su-error-for="restaurant.streetId"></span>
                            <p id="signupStreetHint" class="su-help"></p>
                        </div>
                        <div class="su-row su-row--aligned su-row--3">
                            <div class="su-field">
                                <label class="su-label" for="signupBuildingNumber">@L["Signup.BuildingNumber"] <span class="su-optional">@Optional()</span></label>
                                <input asp-for="BuildingNumber" class="su-input" id="signupBuildingNumber" dir="auto"
                                       data-su-field="restaurant.buildingNumber" aria-describedby="signupBuildingNumber-error" />
                                <span asp-validation-for="BuildingNumber" id="signupBuildingNumber-error" data-su-error-for="restaurant.buildingNumber"></span>
                            </div>
                            <div class="su-field">
                                <label class="su-label" for="signupFloor">@L["Signup.Floor"] <span class="su-optional">@Optional()</span></label>
                                <input asp-for="Floor" class="su-input" id="signupFloor" dir="auto"
                                       data-su-field="restaurant.floor" aria-describedby="signupFloor-error" />
                                <span asp-validation-for="Floor" id="signupFloor-error" data-su-error-for="restaurant.floor"></span>
                            </div>
                            <div class="su-field">
                                <label class="su-label" for="signupDoorNumber">@L["Signup.DoorNumber"] <span class="su-optional">@Optional()</span></label>
                                <input asp-for="DoorNumber" class="su-input" id="signupDoorNumber" dir="auto"
                                       data-su-field="restaurant.doorNumber" aria-describedby="signupDoorNumber-error" />
                                <span asp-validation-for="DoorNumber" id="signupDoorNumber-error" data-su-error-for="restaurant.doorNumber"></span>
                            </div>
                        </div>
                        <details class="su-disclosure">
                            <summary><i class="bi bi-plus-lg" aria-hidden="true"></i>@L["Signup.Flow.AddressMore"]</summary>
                            <div class="su-disclosure__body">
                                <div class="su-field">
                                    <label class="su-label" for="signupAddressNote">@L["Signup.AddressNote"] <span class="su-optional">@Optional()</span></label>
                                    <input asp-for="AddressNote" class="su-input" id="signupAddressNote" dir="auto"
                                           data-su-field="restaurant.addressNote" aria-describedby="signupAddressNote-error" />
                                    <span asp-validation-for="AddressNote" id="signupAddressNote-error" data-su-error-for="restaurant.addressNote"></span>
                                </div>
                                <div class="su-field">
                                    <label class="su-label" for="signupLocationUrl">@L["Signup.LocationUrl"] <span class="su-optional">@Optional()</span></label>
                                    <input asp-for="LocationUrl" class="su-input" id="signupLocationUrl" placeholder="@L["Signup.LocationUrlPlaceholder"]" inputmode="url"
                                           dir="ltr" data-su-field="restaurant.locationUrl" aria-describedby="signupLocationUrl-error signupLocationUrlHelp" />
                                    <span asp-validation-for="LocationUrl" id="signupLocationUrl-error" data-su-error-for="restaurant.locationUrl"></span>
                                    <p class="su-help" id="signupLocationUrlHelp">@L["Signup.LocationUrlHelp"]</p>
                                </div>
                            </div>
                        </details>
                    </div>

                    <div class="su-section">
                        <h3 class="su-section__title">@L["Signup.StepContact"]</h3>
                        <div class="su-row su-row--2 su-row--stack-sm">
                            <fieldset class="su-field">
                                <legend class="su-label">@L["Signup.BusinessPhoneType"]</legend>
                                <div class="su-segment su-segment--fill">
                                    <span class="su-segment__option">
                                        <input class="su-segment__input" type="radio" asp-for="BusinessPhoneType" value="@nameof(BusinessPhoneTypeEnum.Mobile)" id="signupBusinessPhoneType-Mobile"
                                               autocomplete="off" data-su-field="restaurant.businessPhoneType" />
                                        <label class="su-segment__label" for="signupBusinessPhoneType-Mobile">@L["Signup.PhoneTypeMobile"]</label>
                                    </span>
                                    <span class="su-segment__option">
                                        <input class="su-segment__input" type="radio" asp-for="BusinessPhoneType" value="@nameof(BusinessPhoneTypeEnum.Landline)" id="signupBusinessPhoneType-Landline"
                                               autocomplete="off" />
                                        <label class="su-segment__label" for="signupBusinessPhoneType-Landline">@L["Signup.PhoneTypeLandline"]</label>
                                    </span>
                                </div>
                                <span class="field-validation-valid" data-su-error-for="restaurant.businessPhoneType"></span>
                            </fieldset>
                            <div class="su-field">
                                <label class="su-label" for="signupBusinessPhone">@L["Signup.BusinessPhone"]</label>
                                <div class="su-group" dir="ltr">
                                    <span class="su-group__addon su-group__addon--prefix" id="signupPhonePrefix">+90</span>
                                    <input asp-for="BusinessPhone" class="su-input" id="signupBusinessPhone" autocomplete="tel-national" inputmode="tel"
                                           data-su-field="restaurant.businessPhone" aria-describedby="signupPhonePrefix signupBusinessPhone-error signupPhoneHint" />
                                </div>
                                <span asp-validation-for="BusinessPhone" id="signupBusinessPhone-error" data-su-error-for="restaurant.businessPhone"></span>
                                <p id="signupPhoneHint" class="su-help"></p>
                            </div>
                        </div>
                        <div class="su-field">
                            <label class="su-label" for="signupBusinessEmail">@L["Signup.BusinessEmail"] <span class="su-optional">@Optional()</span></label>
                            <input asp-for="BusinessEmail" class="su-input" id="signupBusinessEmail" placeholder="@L["Signup.BusinessEmailPlaceholder"]"
                                   autocomplete="email" inputmode="email" dir="ltr" data-su-field="restaurant.businessEmail"
                                   aria-describedby="signupBusinessEmail-error signupBusinessEmailHelp" />
                            <span asp-validation-for="BusinessEmail" id="signupBusinessEmail-error" data-su-error-for="restaurant.businessEmail"></span>
                            <p class="su-help" id="signupBusinessEmailHelp">@L["Signup.BusinessEmailHelp"]</p>
                        </div>
                    </div>

                    <div class="su-actions su-actions--strip">
                        <button type="button" class="su-btn su-btn--primary" data-su-next>@L["Signup.Flow.ToOwner"]</button>
                    </div>
                </section>

                @* ---------------------------------------------------------------- 3. Account owner (Figma D3, M3) *@
                <section class="su-step" id="signupStep-owner" data-su-step="owner" aria-labelledby="signupStep-owner-title"
                         data-su-strip-label="@L["Signup.Phone.Send"]" data-su-strip-carries hidden="@Hidden("owner")">
                    <div class="su-step__bar">
                        <button type="button" class="su-back" data-su-go="restaurant" aria-label="@string.Format(L["Signup.Flow.BackTo"].Value, L["Signup.StepBusiness"].Value)">
                            <i class="bi bi-chevron-left su-flip-rtl" aria-hidden="true"></i>@L["Signup.StepBusiness"]
                        </button>
                        <span class="su-step__counter">@Counter(3)</span>
                    </div>
                    <h2 class="su-title" id="signupStep-owner-title" tabindex="-1">@L["Signup.StepOwner"]</h2>
                    <p class="su-lead">@L["Signup.Flow.OwnerLead"]</p>
                    <partial name="_SignupErrorSummary" />

                    <div class="su-section">
                        <h3 class="su-section__title">@L["Signup.Flow.SectionPerson"]</h3>
                        <div class="su-field">
                            <label class="su-label" for="signupOwnerFullName">@L["Signup.OwnerFullName"]</label>
                            <input asp-for="OwnerFullName" class="su-input" id="signupOwnerFullName" dir="auto" autocomplete="name"
                                   data-su-field="owner.fullName" aria-describedby="signupOwnerFullName-error" />
                            <span asp-validation-for="OwnerFullName" id="signupOwnerFullName-error" data-su-error-for="owner.fullName"></span>
                        </div>
                        <div class="su-field">
                            <label class="su-label" for="signupOwnerEmail">@L["Signup.OwnerEmail"]</label>
                            <input asp-for="OwnerEmail" class="su-input" id="signupOwnerEmail" autocomplete="email" inputmode="email" dir="ltr"
                                   data-su-field="owner.email" aria-describedby="signupOwnerEmail-error signupOwnerEmailHelp" />
                            <span asp-validation-for="OwnerEmail" id="signupOwnerEmail-error" data-su-error-for="owner.email"></span>
                            <p class="su-help" id="signupOwnerEmailHelp">@L["Signup.Flow.OwnerEmailHelp"]</p>
                        </div>
                        <div class="su-field">
                            <label class="su-label" for="signupOwnerPhone">@L["Signup.Flow.OwnerMobile"]</label>
                            <div class="su-group" dir="ltr">
                                <span class="su-group__addon su-group__addon--prefix" id="signupOwnerPhonePrefix">+90</span>
                                <input asp-for="OwnerPhone" class="su-input" id="signupOwnerPhone" autocomplete="tel-national" inputmode="tel"
                                       data-su-field="owner.mobilePhone" aria-describedby="signupOwnerPhonePrefix signupOwnerPhone-error signupOwnerPhoneHint" />
                            </div>
                            <span asp-validation-for="OwnerPhone" id="signupOwnerPhone-error" data-su-error-for="owner.mobilePhone"></span>
                            <p id="signupOwnerPhoneHint" class="su-help">@L["Signup.Flow.OwnerPhoneHelp"]</p>
                        </div>
                    </div>

                    <div class="su-section">
                        <h3 class="su-section__title">@L["Signup.Password"]</h3>
                        <p class="su-section__hint" data-su-password-kept hidden="@(draft.Owner.PasswordSet ? null : "hidden")">@L["Signup.Flow.PasswordKept"]</p>
                        <div class="su-row su-row--aligned su-row--2 su-row--stack-sm">
                            <div class="su-field">
                                <label class="su-label" for="signupPassword">@L["Signup.Password"]</label>
                                @* Show / Hide: one text control at the field's trailing edge (signup-form.js keeps the value,
                                   the caret and the focus when it switches). Its name says what it does next. *@
                                <div class="su-reveal">
                                    <input asp-for="Password" type="password" class="su-input su-reveal__input" id="signupPassword" autocomplete="new-password"
                                           data-su-field="owner.password" aria-describedby="signupPassword-error signupPasswordRules" />
                                    <button type="button" class="su-reveal__toggle signup-password-toggle" data-target="signupPassword" aria-controls="signupPassword"
                                            aria-label="@L["Common.ShowPassword"]">@L["Signup.Password.Show"]</button>
                                </div>
                                <span asp-validation-for="Password" id="signupPassword-error" data-su-error-for="owner.password"></span>
                            </div>
                            <div class="su-field">
                                <label class="su-label" for="signupConfirmPassword">@L["Signup.ConfirmPassword"]</label>
                                <div class="su-reveal">
                                    <input asp-for="ConfirmPassword" type="password" class="su-input su-reveal__input" id="signupConfirmPassword" autocomplete="new-password"
                                           data-su-field="owner.confirmPassword" aria-describedby="signupConfirmPassword-error" />
                                    <button type="button" class="su-reveal__toggle signup-password-toggle" data-target="signupConfirmPassword" aria-controls="signupConfirmPassword"
                                            aria-label="@L["Common.ShowPassword"]">@L["Signup.Password.Show"]</button>
                                </div>
                                <span asp-validation-for="ConfirmPassword" id="signupConfirmPassword-error" data-su-error-for="owner.confirmPassword"></span>
                            </div>
                        </div>
                        <ul class="su-rules" id="signupPasswordRules" data-su-password-rules>
                            <li data-su-rule="length" data-state="neutral">
                                <i class="bi bi-circle" aria-hidden="true"></i>
                                <span>@L["Signup.Flow.PasswordRuleLength"]</span>
                                <span class="su-visually-hidden" data-su-rule-state></span>
                            </li>
                            <li data-su-rule="match" data-state="neutral">
                                <i class="bi bi-circle" aria-hidden="true"></i>
                                <span>@L["Signup.Flow.PasswordRuleMatch"]</span>
                                <span class="su-visually-hidden" data-su-rule-state></span>
                            </li>
                        </ul>
                    </div>

                    <p class="su-help su-inline-note">@L["Signup.SetupLaterNote"]</p>

                    <div class="su-actions su-actions--strip">
                        <button type="button" class="su-btn su-btn--primary" data-su-next data-su-autosend>@L["Signup.Flow.ToPhone"]</button>
                    </div>
                </section>

                @* ---------------------------------------------------------------- 4. Phone verification (Figma T1–T7, MT1–MT7, L3) *@
                <section class="su-step" id="signupStep-phone" data-su-step="phone" aria-labelledby="signupStep-phone-title" hidden="@Hidden("phone")">
                    <div class="su-step__bar">
                        <button type="button" class="su-back" data-su-go="owner" aria-label="@string.Format(L["Signup.Flow.BackTo"].Value, L["Signup.StepOwner"].Value)">
                            <i class="bi bi-chevron-left su-flip-rtl" aria-hidden="true"></i>@L["Signup.StepOwner"]
                        </button>
                        <span class="su-step__counter">@Counter(4)</span>
                    </div>
                    <partial name="_SignupPhoneVerification" model="Model" />
                </section>

                @* ---------------------------------------------------------------- 5. Review (Figma D4, M4) *@
                <section class="su-step" id="signupStep-review" data-su-step="review" aria-labelledby="signupStep-review-title"
                         data-su-strip-label="@submitLabel" data-su-strip-carries hidden="@Hidden("review")">
                    <div class="su-step__bar">
                        <button type="button" class="su-back" data-su-go="phone" aria-label="@string.Format(L["Signup.Flow.BackTo"].Value, L["Signup.StepPhone"].Value)">
                            <i class="bi bi-chevron-left su-flip-rtl" aria-hidden="true"></i>@L["Signup.StepPhone"]
                        </button>
                        <span class="su-step__counter">@Counter(5)</span>
                    </div>
                    <h2 class="su-title" id="signupStep-review-title" tabindex="-1">@L["Signup.Flow.ReviewTitle"]</h2>
                    <p class="su-lead">@L["Signup.Flow.ReviewLead"]</p>

                    <div class="su-review">
                        <section class="su-review__section" aria-labelledby="signupReview-plan">
                            <div class="su-review__head">
                                <h3 class="su-section__title" id="signupReview-plan">@L["Signup.StepPlan"]</h3>
                                <button type="button" class="su-btn su-btn--quiet" data-su-go="plan"><i class="bi bi-pencil" aria-hidden="true"></i>@L["Common.Edit"]<span class="su-visually-hidden">: @L["Signup.StepPlan"]</span></button>
                            </div>
                            <dl class="su-review__list">
                                <div class="su-review__item"><dt>@L["Signup.Plan"]</dt><dd dir="auto" data-su-review="plan"></dd></div>
                                <div class="su-review__item"><dt>@L["Signup.BillingPeriod"]</dt><dd dir="auto" data-su-review="period"></dd></div>
                                <div class="su-review__item"><dt>@L["Signup.Review.Amount"]</dt><dd dir="auto" data-su-review="price"></dd></div>
                            </dl>
                        </section>
                        <section class="su-review__section" aria-labelledby="signupReview-restaurant">
                            <div class="su-review__head">
                                <h3 class="su-section__title" id="signupReview-restaurant">@L["Signup.StepBusiness"]</h3>
                                <button type="button" class="su-btn su-btn--quiet" data-su-go="restaurant"><i class="bi bi-pencil" aria-hidden="true"></i>@L["Common.Edit"]<span class="su-visually-hidden">: @L["Signup.StepBusiness"]</span></button>
                            </div>
                            <dl class="su-review__list">
                                <div class="su-review__item"><dt>@L["Signup.BusinessName"]</dt><dd dir="auto" data-su-review="businessName"></dd></div>
                                <div class="su-review__item"><dt>@L["Signup.BusinessType"]</dt><dd dir="auto" data-su-review="businessTypes"></dd></div>
                                <div class="su-review__item"><dt>@L["Signup.Flow.SectionPanelAddress"]</dt><dd><bdi class="su-domain" data-su-review="domain"></bdi></dd></div>
                                <div class="su-review__item"><dt>@L["Signup.StepAddress"]</dt><dd dir="auto" data-su-review="address"></dd></div>
                                <div class="su-review__item"><dt>@L["Signup.BusinessPhone"]</dt><dd dir="auto" data-su-review="businessPhone"></dd></div>
                                <div class="su-review__item"><dt>@L["Signup.BusinessEmail"]</dt><dd dir="auto" data-su-review="businessEmail"></dd></div>
                            </dl>
                        </section>
                        <section class="su-review__section" aria-labelledby="signupReview-owner">
                            <div class="su-review__head">
                                <h3 class="su-section__title" id="signupReview-owner">@L["Signup.StepOwner"]</h3>
                                <button type="button" class="su-btn su-btn--quiet" data-su-go="owner"><i class="bi bi-pencil" aria-hidden="true"></i>@L["Common.Edit"]<span class="su-visually-hidden">: @L["Signup.StepOwner"]</span></button>
                            </div>
                            <dl class="su-review__list">
                                <div class="su-review__item"><dt>@L["Signup.OwnerFullName"]</dt><dd dir="auto" data-su-review="ownerName"></dd></div>
                                <div class="su-review__item"><dt>@L["Signup.OwnerEmail"]</dt><dd><bdi data-su-review="ownerEmail"></bdi></dd></div>
                                <div class="su-review__item">
                                    <dt>@L["Signup.Flow.OwnerMobile"]</dt>
                                    <dd class="su-review__phone">
                                        <bdi data-su-review="ownerPhone"></bdi>
                                        <span class="su-badge su-badge--success" data-su-review-verified hidden="@(phoneVerified ? null : "hidden")"><i class="bi bi-check2" aria-hidden="true"></i>@L["Signup.Receipt.PhoneVerified"]</span>
                                    </dd>
                                </div>
                                <div class="su-review__item"><dt>@L["Signup.Password"]</dt><dd data-su-review="password"></dd></div>
                            </dl>
                            <p class="su-help">@L["Signup.Review.ReverifyNote"]</p>
                        </section>
                    </div>
                </section>
            </div>

            <aside class="su-aside">
                <div class="su-receipt-block">
                    <partial name="_SignupReceipt" model="asideReceipt" />
                    <p class="su-receipt__note" data-su-note-step="phone">
                        <i class="bi bi-shield-check" aria-hidden="true"></i>
                        <span>@L["Signup.Phone.ShareWarning"]</span>
                    </p>
                </div>

                @* The review step's card (Figma D4 aside, M4 inline): below 992 px it follows the review content. *@
                <section class="su-receipt su-pay" aria-labelledby="signupPayTitle">
                    <header class="su-receipt__head">
                        <h2 class="su-receipt__title" id="signupPayTitle">@L["Signup.Pay.Title"]</h2>
                    </header>
                    <dl class="su-pay__rows">
                        <div class="su-pay__row"><dt data-su-text="payPlanRow"></dt><dd><bdi data-su-text="payAmount"></bdi></dd></div>
                        <div class="su-pay__row"><dt>@L["Signup.Pay.Vat"]</dt><dd data-su-text="payVat"></dd></div>
                        <div class="su-pay__row"><dt>@L["Signup.Pay.Period"]</dt><dd data-su-text="payPeriod"></dd></div>
                        @if (simulator)
                        {
                            <div class="su-pay__row"><dt>@L["Signup.Pay.AutoRenew"]</dt><dd data-su-text="payRenewal"></dd></div>
                        }
                    </dl>
                    <div class="su-receipt__cut" aria-hidden="true"></div>
                    <div class="su-pay__body">
                        <div class="su-receipt__total">
                            <span class="su-receipt__total-label">@amountLabel</span>
                            <div class="su-receipt__amount-row">
                                <span class="su-receipt__amount@(selectedQuote is null ? " su-receipt__amount--unset" : string.Empty)" data-su-amount><bdi data-su-text="amount">@receiptAmount</bdi></span>
                                <span class="su-receipt__vat" data-su-text="vat">@receiptVat</span>
                            </div>
                            <p class="su-receipt__period" data-su-text="periodNote">@receiptPeriodNote</p>
                        </div>
                        <p class="su-help">@L[simulator ? "Signup.BillingNote" : "Signup.BillingNoteAwaitingPayment"]</p>
                        @if (!string.IsNullOrWhiteSpace(supportEmail))
                        {
                            <p class="su-help">@Html.Raw(string.Format(L["Signup.Pay.SupportLine"].Value, $"<a class=\"su-link\" href=\"mailto:{System.Net.WebUtility.HtmlEncode(supportEmail)}\"><bdi>{System.Net.WebUtility.HtmlEncode(supportEmail)}</bdi></a>"))</p>
                        }
                        <div class="su-actions su-actions--strip">
                            <button type="submit" id="signupSubmitButton" class="su-btn su-btn--primary su-btn--block" data-su-submit>@submitLabel</button>
                        </div>
                    </div>
                </section>
            </aside>
            <input type="hidden" id="signupBaseDomain" value="@Model.ApplicationBaseDomain" />
        </form>
    </div>

    <partial name="_SignupMobileSummary" model="sheetReceipt" />
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script type="application/json" id="signupFormConfig">@Html.Raw(JsonSerializer.Serialize(signupConfig))</script>
    <script type="application/json" id="signupDraftState">@Json.Serialize(Model.InitialDraft)</script>
    <script type="application/json" id="signupEndpoints">@Json.Serialize(Model.Endpoints)</script>
    <script src="~/js/signup/signup-phone-format.js" asp-append-version="true"></script>
    <script src="~/js/signup/signup-business-types.js" asp-append-version="true"></script>
    <script src="~/js/signup/signup-plan-price.js" asp-append-version="true"></script>
    <script src="~/js/signup/signup-steps.js" asp-append-version="true"></script>
    <script src="~/js/signup/signup-receipt.js" asp-append-version="true"></script>
    <script src="~/js/signup/signup-review.js" asp-append-version="true"></script>
    <script src="~/js/signup/signup-countdown.js" asp-append-version="true"></script>
    <script src="~/js/signup/signup-code-input.js" asp-append-version="true"></script>
    <script src="~/js/signup/signup-address-check.js" asp-append-version="true"></script>
    <script src="~/js/signup/signup-api.js" asp-append-version="true"></script>
    <script src="~/js/signup/signup-draft.js" asp-append-version="true"></script>
    <script src="~/js/signup/signup-sheet.js" asp-append-version="true"></script>
    <script src="~/js/signup/signup-viewport.js" asp-append-version="true"></script>
    <script src="~/js/signup/signup-address-search.js" asp-append-version="true"></script>
    <script src="~/js/signup/signup-combobox.js" asp-append-version="true"></script>
    <script src="~/js/signup/signup-form.js" asp-append-version="true"></script>
    <script src="~/js/signup/signup-phone-step.js" asp-append-version="true"></script>
    <script src="~/js/signup/signup-flow.js" asp-append-version="true"></script>
}
