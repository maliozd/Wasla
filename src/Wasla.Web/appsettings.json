{
  "ConnectionStrings": {
    "CentralDb": "Server=(localdb)\\MSSQLLocalDB;Database=Wasla_Central;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Wasla": {
    "ApiBaseUrl": "http://localhost:59451",
    "TenantOnboarding": {
      "MarketingBaseDomain": "wasla.local",
      "SqlAuth": "trusted",
      "TrialDays": 14
    },
    "PrintBridgeDownload": {
      "PackageFileName": "Wasla.PrintBridge-win-x64.zip",
      "PackagePath": ""
    }
  },
  "Platforms": {
    "ProviderMode": "Mock"
  },
  "Email": {
    "Provider": "Log",
    "FromEmail": "noreply@wasla.local",
    "FromName": "Wasla",
    "SmtpHost": "",
    "SmtpPort": 587,
    "SmtpUsername": "",
    "SmtpPassword": "",
    "EnableSsl": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.Extensions.Localization": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "Console": {
      "FormatterOptions": {
        "IncludeScopes": true
      }
    }
  },
  "AllowedHosts": "*"
}
