<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The food-platform provider library (WAS-233): the provider contract, the external order DTOs, the Trendyol GO and
    Yemeksepeti clients, the mock clients, the provider HTTP registration and the provider options. It references no
    Orders and no POS project; Orders composes it through AddWaslaIntegrations (see docs/integrations/food-platforms.md).
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Wasla.Integrations</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Wasla.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Platform/Mock/Scenarios/*.json">
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
  </ItemGroup>

</Project>
