<Project Sdk="Microsoft.NET.Sdk">

	<!--
		UI-independent Print Bridge engine: settings and token persistence, the Wasla API client,
		the polling/claim/print runtime, local print history and the Windows printer integration.
		It must not reference WinForms, WebView2 or any presentation code; desktop shells live in
		Wasla.PrintBridge and observe this engine. Windows-only by design (Windows print spooler).
	-->
	<PropertyGroup>
		<TargetFramework>net8.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
		<RootNamespace>Wasla.PrintBridge</RootNamespace>
		<AssemblyName>Wasla.PrintBridge.Core</AssemblyName>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
		<PackageReference Include="System.Drawing.Common" Version="8.0.10" />
		<PackageReference Include="System.Text.Json" Version="8.0.5" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Wasla.Application\Wasla.Application.csproj" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Wasla.PrintBridge" />
		<InternalsVisibleTo Include="Wasla.PrintBridge.Tests" />
	</ItemGroup>

</Project>
