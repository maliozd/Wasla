@model OrderHub.Web.Models.Signup.SignupViewModel
@using Microsoft.Extensions.Localization
@using OrderHub.Application.Abstractions.Plans
@inject IStringLocalizer<OrderHub.Web.SharedResource> L
@inject IOrderHubPlanCatalog PlanCatalog
@{
    Layout = "_PublicLayout";
    ViewData["Title"] = L["Signup.Title"];
    var domainPreview = string.IsNullOrWhiteSpace(Model.Slug)
        ? $"your-name.{Model.MarketingBaseDomain}"
        : $"{Model.Slug}.{Model.MarketingBaseDomain}";
    var publicPlans = PlanCatalog.GetPublicPlans();
}
<div class="oh-signup-page py-4 py-md-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-xl-9">
                <div class="text-center mb-4">
                    <h1 class="h3 fw-bold mb-2">@L["Signup.Title"]</h1>
                    <p class="text-secondary mb-0">@L["Signup.Subtitle"]</p>
                </div>

                <div class="card border-0 shadow-sm oh-signup-card">
                    <div class="card-body p-4 p-md-5">
                        <form asp-action="Index" method="post" novalidate>
                            @Html.AntiForgeryToken()
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                            <section class="oh-signup-section mb-4">
                                <div class="oh-signup-step-label mb-3">
                                    <span class="oh-signup-step-num">1</span>
                                    <span class="fw-semibold">@L["Signup.StepPlan"]</span>
                                </div>
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label asp-for="PlanCode" class="form-label"></label>
                                        <select asp-for="PlanCode" class="form-select" id="signupPlanCode">
                                            @foreach (var plan in publicPlans)
                                            {
                                                <option value="@plan.PlanCode"
                                                        data-contact-sales="@(plan.IsContactSales ? "true" : "false")"
                                                        selected="@(string.Equals(plan.PlanCode, Model.PlanCode, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">
                                                    @L[plan.DisplayNameKey]
                                                </option>
                                            }
                                        </select>
                                        <span asp-validation-for="PlanCode" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-6" id="signupBillingCol">
                                        <label asp-for="BillingPeriod" class="form-label"></label>
                                        <select asp-for="BillingPeriod" class="form-select">
                                            <option value="Monthly">@L["Signup.BillingMonthly"]</option>
                                            <option value="Yearly">@L["Signup.BillingYearly"]</option>
                                        </select>
                                        <div class="form-text">@L["Signup.BillingNote"]</div>
                                        <span asp-validation-for="BillingPeriod" class="text-danger small"></span>
                                    </div>
                                </div>
                            </section>

                            <div id="signupEnterpriseNotice" class="alert alert-info mb-4 @(Model.IsContactSalesPlan ? "" : "d-none")" role="status">
                                <div class="fw-semibold mb-1">@L["Signup.EnterpriseNoticeTitle"]</div>
                                <p class="small mb-3">@L["Signup.EnterpriseNoticeBody"]</p>
                                <a class="btn btn-outline-primary rounded-pill" href="mailto:support@orderhub.local">@L["Pricing.Cta.RequestOffer"]</a>
                            </div>

                            <div id="signupSelfServiceSections" class="@(Model.IsContactSalesPlan ? "d-none" : "")">
                            <section class="oh-signup-section mb-4">
                                <div class="oh-signup-step-label mb-3">
                                    <span class="oh-signup-step-num">2</span>
                                    <span class="fw-semibold">@L["Signup.StepBusiness"]</span>
                                </div>
                                <div class="row g-3">
                                    <div class="col-12">
                                        <label asp-for="BusinessName" class="form-label"></label>
                                        <input asp-for="BusinessName" class="form-control" id="signupBusinessName" autocomplete="organization" />
                                        <span asp-validation-for="BusinessName" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="BusinessType" class="form-label"></label>
                                        <input asp-for="BusinessType" class="form-control" placeholder="@L["Signup.BusinessTypePlaceholder"]" />
                                        <span asp-validation-for="BusinessType" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="BusinessPhone" class="form-label"></label>
                                        <input asp-for="BusinessPhone" class="form-control" autocomplete="tel" />
                                        <span asp-validation-for="BusinessPhone" class="text-danger small"></span>
                                    </div>
                                    <div class="col-12">
                                        <label asp-for="Slug" class="form-label"></label>
                                        <div class="input-group">
                                            <input asp-for="Slug" class="form-control" id="signupSlug" pattern="[a-z0-9][a-z0-9_-]*" />
                                            <span class="input-group-text text-muted">.@Model.MarketingBaseDomain</span>
                                        </div>
                                        <div class="form-text">
                                            @L["Signup.SlugHelp"]
                                            <span id="signupDomainPreview" class="fw-semibold">@domainPreview</span>
                                        </div>
                                        <span asp-validation-for="Slug" class="text-danger small"></span>
                                    </div>
                                </div>
                            </section>

                            <section class="oh-signup-section mb-4">
                                <div class="oh-signup-step-label mb-3">
                                    <span class="oh-signup-step-num">3</span>
                                    <span class="fw-semibold">@L["Signup.StepAddress"]</span>
                                </div>
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <label asp-for="Country" class="form-label"></label>
                                        <input asp-for="Country" class="form-control" autocomplete="country-name" />
                                        <span asp-validation-for="Country" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-4">
                                        <label asp-for="City" class="form-label"></label>
                                        <input asp-for="City" class="form-control" autocomplete="address-level2" />
                                        <span asp-validation-for="City" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-4">
                                        <label asp-for="District" class="form-label"></label>
                                        <input asp-for="District" class="form-control" autocomplete="address-level3" />
                                        <span asp-validation-for="District" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="Neighborhood" class="form-label"></label>
                                        <input asp-for="Neighborhood" class="form-control" />
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="PostalCode" class="form-label"></label>
                                        <input asp-for="PostalCode" class="form-control" autocomplete="postal-code" />
                                    </div>
                                    <div class="col-12">
                                        <label asp-for="AddressLine1" class="form-label"></label>
                                        <input asp-for="AddressLine1" class="form-control" autocomplete="street-address" />
                                        <span asp-validation-for="AddressLine1" class="text-danger small"></span>
                                    </div>
                                    <div class="col-12">
                                        <label asp-for="AddressLine2" class="form-label"></label>
                                        <input asp-for="AddressLine2" class="form-control" />
                                    </div>
                                </div>
                            </section>

                            <section class="oh-signup-section">
                                <div class="oh-signup-step-label mb-3">
                                    <span class="oh-signup-step-num">4</span>
                                    <span class="fw-semibold">@L["Signup.StepOwner"]</span>
                                </div>
                                <div class="row g-3">
                                    <div class="col-12">
                                        <label asp-for="OwnerFullName" class="form-label"></label>
                                        <input asp-for="OwnerFullName" class="form-control" autocomplete="name" />
                                        <span asp-validation-for="OwnerFullName" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="OwnerEmail" class="form-label"></label>
                                        <input asp-for="OwnerEmail" class="form-control" autocomplete="email" />
                                        <span asp-validation-for="OwnerEmail" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="OwnerPhone" class="form-label"></label>
                                        <input asp-for="OwnerPhone" class="form-control" autocomplete="tel" />
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="Password" class="form-label"></label>
                                        <input asp-for="Password" class="form-control" autocomplete="new-password" />
                                        <span asp-validation-for="Password" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="ConfirmPassword" class="form-label"></label>
                                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                                    </div>
                                </div>
                                <p class="text-secondary small mt-3 mb-3">@L["Signup.SetupLaterNote"]</p>
                                <button type="submit" id="signupSubmitButton" class="btn btn-primary btn-lg rounded-pill px-4">
                                    <i class="bi bi-arrow-right-circle me-2" aria-hidden="true"></i>@L["Signup.ContinueToPayment"]
                                </button>
                            </section>
                            </div>
                            <input type="hidden" id="signupBaseDomain" value="@Model.MarketingBaseDomain" />
                        </form>
                    </div>
                </div>

                <p class="text-center text-muted small mt-3 mb-0">
                    @L["Signup.AlreadyHaveAccount"]
                    <a href="/customer-access-required">@L["Landing.CustomerLogin"]</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/signup/signup-form.js" asp-append-version="true"></script>
}
