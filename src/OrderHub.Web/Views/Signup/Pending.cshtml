@model OrderHub.Web.Models.Signup.SignupPendingViewModel
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<OrderHub.Web.SharedResource> L
@{
    Layout = "_PublicLayout";
    ViewData["Title"] = L["Signup.PendingTitle"];
    var billingLabel = string.Equals(Model.BillingPeriod, "Yearly", StringComparison.OrdinalIgnoreCase)
        ? L["Signup.BillingYearly"]
        : L["Signup.BillingMonthly"];
}
<div class="oh-signup-page py-4 py-md-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm oh-signup-card">
                    <div class="card-body p-4 p-md-5 text-center">
                        <div class="mb-3">
                            <i class="bi bi-hourglass-split text-primary" style="font-size: 2.5rem;" aria-hidden="true"></i>
                        </div>
                        <h1 class="h4 fw-bold mb-2">@L["Signup.PendingTitle"]</h1>
                        <p class="text-secondary mb-4">@L["Signup.PendingSubtitle"]</p>

                        @if (!string.IsNullOrWhiteSpace(Model.BusinessName))
                        {
                            <div class="text-start bg-body-tertiary rounded p-3 mb-3">
                                <dl class="row small mb-0">
                                    <dt class="col-sm-4">@L["Signup.PendingLabelRestaurant"]</dt>
                                    <dd class="col-sm-8">@Model.BusinessName</dd>
                                    <dt class="col-sm-4">@L["Signup.PendingLabelOrderHubAddress"]</dt>
                                    <dd class="col-sm-8"><code>@Model.PrimaryDomain</code></dd>
                                    <dt class="col-sm-4">@L["Signup.PendingLabelPackage"]</dt>
                                    <dd class="col-sm-8">@Model.PlanDisplayName</dd>
                                    <dt class="col-sm-4">@L["Signup.PendingLabelPaymentPeriod"]</dt>
                                    <dd class="col-sm-8">@billingLabel</dd>
                                </dl>
                            </div>
                        }

                        <p class="small text-muted mb-3">@L["Signup.PendingCheckoutNote"]</p>

                        <div class="text-start mx-auto mb-4 oh-signup-pending-next-steps" style="max-width: 28rem;">
                            <p class="small text-muted mb-2">@L["Signup.PendingNextStepsTitle"]</p>
                            <ul class="small text-muted mb-0 ps-3">
                                <li>@L["Signup.PendingNextStep1"]</li>
                                <li>@L["Signup.PendingNextStep2"]</li>
                                <li>@L["Signup.PendingNextStep3"]</li>
                            </ul>
                        </div>

                        <p class="small text-muted mb-4 opacity-75">@L["Signup.PendingTestNote"]</p>

                        <div class="d-flex flex-column flex-sm-row justify-content-center gap-2">
                            <a class="btn btn-primary rounded-pill d-inline-flex align-items-center justify-content-center gap-2 px-4"
                               asp-controller="Checkout"
                               asp-action="Review"
                               asp-route-id="@Model.RegistrationId">
                                <i class="bi bi-credit-card" aria-hidden="true"></i>
                                <span>@L["Signup.ContinueToCheckout"]</span>
                            </a>
                            <a class="btn btn-outline-secondary rounded-pill px-4" href="/">@L["Signup.PendingBackHome"]</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
