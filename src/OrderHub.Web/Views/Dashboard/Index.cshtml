@model OrderHub.Web.Models.Dashboard.DashboardViewModel
@using OrderHub.Domain.Enums
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<OrderHub.Web.SharedResource> L
@{
    ViewData["Title"] = L["Dashboard.Title"];
    string StatusLabel(OrderStatus s) => L[$"OrderStatus.{s}"];
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h1 class="h4 mb-0">@L["Dashboard.Title"]</h1>
    <span class="text-muted small">@L["Common.Today"]</span>
</div>

<div class="row g-3 mb-4">
    <div class="col-12 col-md-3">
        <div class="card oh-card">
            <div class="card-body">
                <div class="text-muted small">@L["Dashboard.TodayOrders"]</div>
                <div class="display-6 fw-semibold">@Model.TodayOrderCount</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-3">
        <div class="card oh-card">
            <div class="card-body">
                <div class="text-muted small">@L["Dashboard.TodayRevenue"]</div>
                <div class="display-6 fw-semibold">@Model.TodayRevenue.ToString("C")</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-3">
        <div class="card oh-card">
            <div class="card-body">
                <div class="text-muted small">@L["Dashboard.ActiveOrders"]</div>
                <div class="display-6 fw-semibold">@Model.ActiveOrderCount</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-3">
        <div class="card oh-card">
            <div class="card-body">
                <div class="text-muted small">@L["Dashboard.CancelledOrders"]</div>
                <div class="display-6 fw-semibold">@Model.CancelledOrderCount</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-12 col-lg-7">
        <div class="card oh-card">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <h2 class="h6 mb-0">@L["Dashboard.RecentOrders"]</h2>
                    <a class="btn btn-sm btn-outline-primary" href="/orders">@L["Dashboard.ViewAll"]</a>
                </div>

                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                        <tr>
                            <th>@L["Orders.Platform"]</th>
                            <th>@L["Orders.OrderCode"]</th>
                            <th>@L["Orders.Customer"]</th>
                            <th>@L["Orders.Status"]</th>
                            <th class="text-end">@L["Orders.TotalAmount"]</th>
                        </tr>
                        </thead>
                        <tbody>
                        @if (Model.RecentOrders.Count == 0)
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">@L["Dashboard.NoRecentOrders"]</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var o in Model.RecentOrders)
                            {
                                <tr>
                                    <td>@o.Platform</td>
                                    <td><a href="/orders/details/@o.Id">@o.ExternalOrderCode</a></td>
                                    <td>@o.CustomerName</td>
                                    <td>@StatusLabel(o.Status)</td>
                                    <td class="text-end">@o.TotalAmount.ToString("C")</td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-5">
        <div class="card oh-card">
            <div class="card-body">
                <h2 class="h6">@L["Dashboard.PlatformSummary"]</h2>
                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <thead>
                        <tr>
                            <th>@L["Orders.Platform"]</th>
                            <th class="text-end">@L["Dashboard.Count"]</th>
                            <th class="text-end">@L["Dashboard.Revenue"]</th>
                        </tr>
                        </thead>
                        <tbody>
                        @if (Model.PlatformSummary.Count == 0)
                        {
                            <tr>
                                <td colspan="3" class="text-center text-muted py-4">@L["Dashboard.NoPlatformSummary"]</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var p in Model.PlatformSummary)
                            {
                                <tr>
                                    <td>@p.Platform</td>
                                    <td class="text-end">@p.Count</td>
                                    <td class="text-end">@p.Revenue.ToString("C")</td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

