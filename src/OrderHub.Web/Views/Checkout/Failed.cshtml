@model OrderHub.Web.Models.Checkout.CheckoutResultViewModel
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<OrderHub.Web.SharedResource> L
@{
    Layout = "_PublicLayout";
    ViewData["Title"] = L["Checkout.FailedTitle"];
}
<div class="oh-signup-page py-4 py-md-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm oh-signup-card">
                    <div class="card-body p-4 p-md-5 text-center">
                        <div class="mb-3 text-danger">
                            <i class="bi bi-x-circle-fill" style="font-size: 2.5rem;" aria-hidden="true"></i>
                        </div>
                        <h1 class="h4 fw-bold mb-2">@L["Checkout.FailedTitle"]</h1>
                        <p class="text-secondary mb-2">@L["Checkout.FailedMessage"]</p>
                        <p class="text-muted small mb-4">@L["Checkout.FailedNoWorkspace"]</p>

                        <div class="d-flex flex-column flex-sm-row justify-content-center gap-2">
                            <a class="btn btn-primary rounded-pill" asp-controller="Checkout" asp-action="Review" asp-route-id="@Model.RegistrationId">
                                @L["Checkout.TryAgain"]
                            </a>
                            <a class="btn btn-outline-secondary rounded-pill" href="/signup">@L["Checkout.RegisterAgain"]</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
