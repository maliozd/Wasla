@{
    Layout = null;
    ViewData["Title"] = "Wasla";
}
@using System.Globalization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<OrderHub.Web.SharedResource> L
@{
    var returnUrl = (Context.Request.Path.Value ?? "/") + (Context.Request.QueryString.HasValue ? Context.Request.QueryString.Value : "");
    var culture = CultureInfo.CurrentUICulture?.Name ?? "tr-TR";
    var isRtl = culture.StartsWith("ar", StringComparison.OrdinalIgnoreCase);
    var requestedHost = ViewData["RequestedHost"] as string;
    var signupUrl = ViewData["SignupUrl"] as string ?? "/signup";
}
<!DOCTYPE html>
<html lang="@culture" dir="@(isRtl ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@L["TenantNotFound.PageTitle"] - Wasla</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
    @if (isRtl)
    {
        <link rel="stylesheet" href="~/css/rtl.css" asp-append-version="true" />
    }
</head>
<body class="oh-landing">
<header class="border-bottom bg-white">
    <div class="container py-3 d-flex flex-wrap align-items-center justify-content-between gap-2">
        <div class="d-flex align-items-center gap-2">
            <div class="oh-logo-mark rounded-3 d-flex align-items-center justify-content-center">
                <i class="bi bi-basket2-fill text-white"></i>
            </div>
            <div>
                <div class="fw-bold text-dark">@L["Landing.Title"]</div>
                <div class="small text-muted">@L["Landing.Subtitle"]</div>
            </div>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-2">
            <div class="dropdown">
                <button class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" type="button">
                    <i class="bi bi-translate me-1"></i>@L["Common.Language"]
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li>
                        <a class="dropdown-item" asp-controller="Culture" asp-action="Set" asp-route-culture="tr-TR" asp-route-returnUrl="@returnUrl">Türkçe</a>
                    </li>
                    <li>
                        <a class="dropdown-item" asp-controller="Culture" asp-action="Set" asp-route-culture="en-US" asp-route-returnUrl="@returnUrl">English</a>
                    </li>
                    <li>
                        <a class="dropdown-item" asp-controller="Culture" asp-action="Set" asp-route-culture="ar-SA" asp-route-returnUrl="@returnUrl">العربية</a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</header>

<main class="py-5">
    <div class="container" style="max-width: 720px;">
        <div class="oh-customer-only-card border rounded-4 bg-white p-4 p-md-5 shadow-sm">
            <div class="text-center mb-4">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-light border" style="width: 72px; height: 72px;">
                    <i class="bi bi-exclamation-circle fs-1 text-warning"></i>
                </div>
                <h1 class="h3 fw-bold mt-3">@L["TenantNotFound.Title"]</h1>
                <p class="text-secondary mb-0">@L["TenantNotFound.Description"]</p>
            </div>

            <div class="alert alert-light border small mb-4">
                <ul class="mb-0 ps-3">
                    <li>@L["TenantNotFound.InfoLine1"]</li>
                    <li>@L["TenantNotFound.InfoLine2"]</li>
                    <li>@L["TenantNotFound.InfoLine3"]</li>
                </ul>
                @if (!string.IsNullOrWhiteSpace(requestedHost))
                {
                    <div class="mt-3 text-muted">
                        <i class="bi bi-globe2 me-1"></i>@L["TenantNotFound.HostLabel", requestedHost]
                    </div>
                }
            </div>

            <div class="d-flex flex-wrap gap-2 justify-content-center">
                <a class="btn btn-primary" href="@signupUrl">
                    <i class="bi bi-pencil-square me-1"></i>@L["TenantNotFound.BackToSignup"]
                </a>
            </div>
        </div>
    </div>
</main>

<footer class="border-top py-4 bg-light mt-auto">
    <div class="container d-flex flex-wrap align-items-center justify-content-between gap-2">
        <div class="text-muted small">© @DateTime.UtcNow.Year Wasla</div>
        <div class="small text-muted">@L["Landing.FooterTagline"]</div>
    </div>
</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
</body>
</html>
