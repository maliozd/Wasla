@model OrderHub.Web.Models.Auth.LoginViewModel
@using System.Globalization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<OrderHub.Web.SharedResource> L
@{
    Layout = null;
    ViewData["Title"] = L["Auth.LoginTitle"];
    var culture = CultureInfo.CurrentUICulture?.Name ?? "tr-TR";
    var isRtl = culture.StartsWith("ar", StringComparison.OrdinalIgnoreCase);
}

<!DOCTYPE html>
<html lang="@culture" dir="@(isRtl ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OrderHub</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @if (isRtl)
    {
        <link rel="stylesheet" href="~/css/rtl.css" asp-append-version="true" />
    }
</head>
<body class="oh-auth-bg">
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
            <div class="card oh-card">
                <div class="card-body p-4">
                    <h1 class="h4 mb-3">@L["Auth.LoginTitle"]</h1>

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger">@L["Auth.InvalidCredentials"]</div>
                    }

                    <form method="post" asp-action="Login" asp-controller="Auth">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ReturnUrl" />

                        <div class="mb-3">
                            <label class="form-label" asp-for="Email">@L["Auth.Email"]</label>
                            <input class="form-control" asp-for="Email" autocomplete="username" />
                            <span class="text-danger" asp-validation-for="Email"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" asp-for="Password">@L["Auth.Password"]</label>
                            <input class="form-control" asp-for="Password" type="password" autocomplete="current-password" />
                            <span class="text-danger" asp-validation-for="Password"></span>
                        </div>

                        <button class="btn btn-primary w-100" type="submit">@L["Auth.LoginButton"]</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await Html.PartialAsync("_ValidationScriptsPartial")
</body>
</html>

