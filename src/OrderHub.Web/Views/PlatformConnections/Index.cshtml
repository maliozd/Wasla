@model OrderHub.Web.Models.PlatformConnections.PlatformConnectionListViewModel
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<OrderHub.Web.SharedResource> L
@{
    ViewData["Title"] = L["PlatformConnections.Title"];
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h1 class="h4 mb-0">@L["PlatformConnections.Title"]</h1>
    <a class="btn btn-sm btn-primary" href="/platform-connections/create">@L["PlatformConnections.Create"]</a>
</div>

<div class="card oh-card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead>
                <tr>
                    <th>@L["PlatformConnections.Platform"]</th>
                    <th>@L["PlatformConnections.StoreId"]</th>
                    <th>@L["Common.Status"]</th>
                    <th class="text-end">@L["PlatformConnections.ErrorCount"]</th>
                    <th class="text-end">@L["PlatformConnections.CircuitOpenUntil"]</th>
                    <th class="text-end">@L["PlatformConnections.LastSuccessfulSync"]</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                @if (Model.Connections.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">@L["PlatformConnections.NoConnectionsFound"]</td>
                    </tr>
                }
                else
                {
                    @foreach (var c in Model.Connections)
                    {
                        <tr>
                            <td>@c.Platform</td>
                            <td>@c.StoreId</td>
                            <td>
                                @if (c.IsActive)
                                {
                                    <span class="badge text-bg-success">@L["Common.Active"]</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">@L["Common.Passive"]</span>
                                }
                            </td>
                            <td class="text-end">@c.ConsecutiveFailures</td>
                            <td class="text-end">@c.CircuitOpenUntilUtc?.ToString("u")</td>
                            <td class="text-end">@c.LastSuccessfulSyncUtc?.ToString("u")</td>
                            <td class="text-end">
                                <form method="post" action="/platform-connections/@c.Id/@(c.IsActive ? "deactivate" : "activate")">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-outline-primary" type="submit">
                                        @(c.IsActive ? L["PlatformConnections.Deactivate"] : L["PlatformConnections.Activate"])
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
        <div class="text-muted small mt-2">
            @L["PlatformConnections.NoteRole"]
        </div>
    </div>
</div>

