@model OrderHub.Web.Models.Orders.OrderListViewModel
@using OrderHub.Domain.Enums
@{
    ViewData["Title"] = "Siparişler";
    var f = Model.Filters;
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h1 class="h4 mb-0">Siparişler</h1>
    <span class="text-muted small">Toplam: @Model.TotalCount</span>
</div>

<div class="card oh-card mb-3">
    <div class="card-body">
        <form method="get" action="/orders" class="row g-2 align-items-end">
            <div class="col-12 col-md-3">
                <label class="form-label">Platform</label>
                <select class="form-select" name="platform">
                    <option value="">Hepsi</option>
                    @foreach (var p in Enum.GetValues<FoodPlatform>())
                    {
                        if (f.Platform == p)
                        {
                            <option value="@p" selected>@p</option>
                        }
                        else
                        {
                            <option value="@p">@p</option>
                        }
                    }
                </select>
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label">Durum</label>
                <select class="form-select" name="status">
                    <option value="">Hepsi</option>
                    @foreach (var s in Enum.GetValues<OrderStatus>())
                    {
                        if (f.Status == s)
                        {
                            <option value="@s" selected>@s</option>
                        }
                        else
                        {
                            <option value="@s">@s</option>
                        }
                    }
                </select>
            </div>
            <div class="col-12 col-md-2">
                <label class="form-label">Başlangıç (UTC)</label>
                <input class="form-control" type="datetime-local" name="startDate" value="@(f.StartDateUtc?.ToString("yyyy-MM-ddTHH:mm"))" />
            </div>
            <div class="col-12 col-md-2">
                <label class="form-label">Bitiş (UTC)</label>
                <input class="form-control" type="datetime-local" name="endDate" value="@(f.EndDateUtc?.ToString("yyyy-MM-ddTHH:mm"))" />
            </div>
            <div class="col-12 col-md-2">
                <button class="btn btn-primary w-100" type="submit">Filtrele</button>
            </div>
        </form>
    </div>
</div>

<div class="card oh-card">
    <div class="card-body">
        <div id="ordersTableContainer">
            @await Html.PartialAsync("_OrdersTable", Model)
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            function setUpdatedNow() {
                var el = document.getElementById("ordersLastUpdated");
                if (!el) return;
                el.textContent = new Date().toLocaleTimeString("tr-TR");
            }

            async function refreshOrdersTable() {
                try {
                    var url = new URL(window.location.origin + "/orders/table");
                    url.search = window.location.search || "";
                    url.searchParams.set("_", Date.now().toString());

                    var resp = await fetch(url.toString(), { headers: { "X-Requested-With": "fetch" } });
                    if (!resp.ok) return;

                    var html = await resp.text();
                    var container = document.getElementById("ordersTableContainer");
                    if (!container) return;
                    container.innerHTML = html;
                    setUpdatedNow();
                } catch { }
            }

            document.addEventListener("DOMContentLoaded", function () {
                setUpdatedNow();
                setInterval(refreshOrdersTable, 10000);
            });
        })();
    </script>
}

