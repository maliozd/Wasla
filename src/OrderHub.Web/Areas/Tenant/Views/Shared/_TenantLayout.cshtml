@using System.Security.Claims
@using OrderHub.Application.Abstractions.Tenant
@using System.Globalization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<OrderHub.Web.SharedResource> L
@inject ICurrentCustomerService CurrentCustomer
@{
    var path = Context.Request.Path.Value ?? "/";
    var returnUrl = (Context.Request.Path.Value ?? "/") + (Context.Request.QueryString.HasValue ? Context.Request.QueryString.Value : "");
    var culture = CultureInfo.CurrentUICulture?.Name ?? "tr-TR";
    var isRtl = culture.StartsWith("ar", StringComparison.OrdinalIgnoreCase);
    var currentLangLabel = culture.StartsWith("en", StringComparison.OrdinalIgnoreCase)
        ? "English"
        : (isRtl ? "العربية" : "Türkçe");
    var userName = User?.Identity?.IsAuthenticated == true
        ? (User.FindFirstValue(ClaimTypes.Name) ?? L["Layout.User"].Value)
        : L["Layout.Guest"].Value;

    var customerName = CurrentCustomer.CurrentCustomer?.Name ?? Context.Request.Host.Host;

    string Active(string href) => path.Equals(href, StringComparison.OrdinalIgnoreCase) || path.StartsWith(href + "/", StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<!DOCTYPE html>
<html lang="@culture" dir="@(isRtl ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OrderHub</title>
    <script>
        (function () {
            try {
                var t = localStorage.getItem("orderhub.theme");
                if (t !== "dark" && t !== "light") t = "light";
                document.documentElement.setAttribute("data-bs-theme", t);
            } catch (e) { }
        })();
    </script>
    <!-- TODO: replace CDN links with local AdminLTE assets (wwwroot/theme/adminlte/) before production. -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@4.0.0-rc3/dist/css/adminlte.min.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/lib/notyf/notyf.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/orderhub-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @if (isRtl)
    {
        <link rel="stylesheet" href="~/css/rtl.css" asp-append-version="true" />
    }
</head>
<body class="layout-fixed sidebar-expand-lg oh-app oh-tenant" data-bs-theme="light">
    <div class="app-wrapper">
        <nav id="ohAppHeader" class="app-header navbar navbar-expand border-bottom">
            <div class="container-fluid d-flex flex-wrap align-items-center gap-2">
                <button type="button" id="tenantSidebarToggle" class="btn btn-sm btn-outline-secondary d-none d-md-inline-flex"
                        data-title-collapse="@L["Layout.CollapseSidebar"]" data-title-expand="@L["Layout.ExpandSidebar"]"
                        data-label-toggle="@L["Layout.ToggleSidebar"]" title="@L["Layout.CollapseSidebar"]" aria-expanded="true" aria-controls="app-sidebar-tenant">
                    <i class="bi bi-layout-sidebar-inset" aria-hidden="true"></i>
                </button>
                <a class="navbar-brand text-decoration-none oh-sidebar-brand mb-0" asp-area="Tenant" asp-controller="Dashboard" asp-action="Index">
                    <span class="brand-text">OrderHub</span>
                </a>
                <span class="text-muted small d-none d-sm-inline customer-text">@customerName</span>
                <div class="ms-auto d-flex flex-wrap align-items-center gap-2">
                    <div class="dropdown">
                        <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-label="@L["Layout.Language"]">
                            <i class="bi bi-translate me-1"></i>@currentLangLabel
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <a class="dropdown-item" asp-controller="Culture" asp-action="Set" asp-route-culture="tr-TR" asp-route-returnUrl="@returnUrl">Türkçe</a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-controller="Culture" asp-action="Set" asp-route-culture="en-US" asp-route-returnUrl="@returnUrl">English</a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-controller="Culture" asp-action="Set" asp-route-culture="ar-SA" asp-route-returnUrl="@returnUrl">العربية</a>
                            </li>
                        </ul>
                    </div>
                    <button type="button" class="btn btn-outline-secondary btn-sm oh-theme-toggle" aria-pressed="false" aria-label="@L["Layout.Theme"]"
                            data-go-dark="@L["Layout.DarkMode"]" data-go-light="@L["Layout.LightMode"]">
                        <i class="bi bi-moon-stars oh-theme-moon"></i>
                        <i class="bi bi-sun oh-theme-sun d-none"></i>
                    </button>
                    @if (User?.Identity?.IsAuthenticated == true)
                    {
                        <div class="dropdown">
                            <button class="btn btn-outline-secondary btn-sm dropdown-toggle" data-bs-toggle="dropdown" type="button" aria-label="@L["Layout.UserMenu"]">
                                <i class="bi bi-person-circle me-1"></i>@userName
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                    <form method="post" asp-area="Tenant" asp-controller="Auth" asp-action="Logout" class="px-3 py-1">
                                        @Html.AntiForgeryToken()
                                        <button class="btn btn-sm btn-outline-danger w-100" type="submit">@L["Layout.Logout"]</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                </div>
            </div>
        </nav>

        <aside class="app-sidebar" id="app-sidebar-tenant" role="navigation" aria-label="Tenant">
            <nav class="sidebar-menu p-3">
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link @Active("/dashboard")" asp-area="Tenant" asp-controller="Dashboard" asp-action="Index">
                            <i class="bi bi-speedometer2 me-2"></i><span class="nav-text">@L["Layout.Dashboard"]</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @Active("/orders")" asp-area="Tenant" asp-controller="Orders" asp-action="Index">
                            <i class="bi bi-bag me-2"></i><span class="nav-text">@L["Layout.Orders"]</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @Active("/platform-connections")" asp-area="Tenant" asp-controller="PlatformConnections" asp-action="Index">
                            <i class="bi bi-plug me-2"></i><span class="nav-text">@L["Layout.PlatformConnections"]</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @Active("/branches")" asp-area="Tenant" asp-controller="Branches" asp-action="Index">
                            <i class="bi bi-diagram-3 me-2"></i><span class="nav-text">@L["Layout.Branches"]</span>
                        </a>
                    </li>
                </ul>
            </nav>
        </aside>

        <main class="app-main oh-content" role="main">
            <div class="app-content">
                <div class="container-fluid py-3">
                    @RenderBody()
                </div>
            </div>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/admin-lte@4.0.0-rc3/dist/js/adminlte.min.js" crossorigin="anonymous"></script>
    <script src="~/lib/notyf/notyf.min.js" asp-append-version="true"></script>
    <script src="~/js/orderhub-toast.js" asp-append-version="true"></script>
    <script src="~/js/theme-mode.js" asp-append-version="true"></script>
    <script src="~/js/sidebar-toggle.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
