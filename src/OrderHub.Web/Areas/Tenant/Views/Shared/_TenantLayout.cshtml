@using OrderHub.Application.Abstractions.Tenant

@using System.Globalization

@using Microsoft.Extensions.Localization

@inject IStringLocalizer<OrderHub.Web.SharedResource> L

@inject ICurrentCustomerService CurrentCustomer

@{

    var path = Context.Request.Path.Value ?? "/";

    var culture = CultureInfo.CurrentUICulture?.Name ?? "tr-TR";

    var isRtl = culture.StartsWith("ar", StringComparison.OrdinalIgnoreCase);

    var customerName = CurrentCustomer.CurrentCustomer?.Name ?? Context.Request.Host.Host;



    string Active(string href) => path.Equals(href, StringComparison.OrdinalIgnoreCase) || path.StartsWith(href + "/", StringComparison.OrdinalIgnoreCase) ? "active" : "";

    string ActiveOrders() => path.Equals("/orders", StringComparison.OrdinalIgnoreCase) || path.StartsWith("/orders/details/", StringComparison.OrdinalIgnoreCase) ? "active" : "";

}

<!DOCTYPE html>

<html lang="@culture" dir="@(isRtl ? "rtl" : "ltr")">

<head>

    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - OrderHub</title>

    <script>

        (function () {

            try {

                var t = localStorage.getItem("orderhub.theme");

                if (t !== "dark" && t !== "light") t = "light";

                document.documentElement.setAttribute("data-bs-theme", t);

            } catch (e) { }

        })();

    </script>

    <!-- TODO: replace CDN links with local AdminLTE assets (wwwroot/theme/adminlte/) before production. -->

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"

          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@4.0.0-rc3/dist/css/adminlte.min.css" crossorigin="anonymous" />

    <link rel="stylesheet" href="~/css/orderhub-theme.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/css/orderhub-toast.css" asp-append-version="true" />

    @if (isRtl)

    {

        <link rel="stylesheet" href="~/css/rtl.css" asp-append-version="true" />

    }

</head>

<body class="layout-fixed sidebar-expand-lg oh-app oh-tenant" data-bs-theme="light">

    <div class="app-wrapper">

        <aside class="app-sidebar" id="app-sidebar-tenant" role="navigation" aria-label="Tenant">

            <nav class="sidebar-menu oh-sidebar-shell">

                <div class="oh-sidebar-brand-area">

                    <div class="d-flex align-items-center justify-content-between gap-2">

                        <a class="oh-sidebar-brand text-decoration-none mb-0 min-w-0" asp-area="Tenant" asp-controller="Dashboard" asp-action="Index">

                            <span class="brand-text">OrderHub</span>

                        </a>

                        <button type="button" id="tenantSidebarToggle" class="btn btn-sm btn-outline-secondary oh-sidebar-collapse-btn flex-shrink-0"

                                data-title-collapse="@L["Layout.CollapseSidebar"]" data-title-expand="@L["Layout.ExpandSidebar"]"

                                data-label-toggle="@L["Layout.ToggleSidebar"]" title="@L["Layout.CollapseSidebar"]" aria-expanded="true" aria-controls="app-sidebar-tenant">

                            <i class="bi bi-layout-sidebar-inset" aria-hidden="true"></i>

                        </button>

                    </div>

                    <div class="customer-text text-muted small text-truncate mt-1" title="@customerName">@customerName</div>

                </div>



                <ul class="nav flex-column oh-sidebar-nav-main">

                    <li class="nav-item">

                        <a class="nav-link @Active("/dashboard")" asp-area="Tenant" asp-controller="Dashboard" asp-action="Index">

                            <i class="bi bi-speedometer2 me-2"></i><span class="nav-text">@L["Layout.Dashboard"]</span>

                        </a>

                    </li>

                    <li class="nav-item">

                        <a class="nav-link @ActiveOrders()" asp-area="Tenant" asp-controller="Orders" asp-action="Index">

                            <i class="bi bi-bag me-2"></i><span class="nav-text">@L["Layout.Orders"]</span>

                        </a>

                    </li>

                    <li class="nav-item">

                        <a class="nav-link @Active("/orders/history")" asp-area="Tenant" asp-controller="Orders" asp-action="History">

                            <i class="bi bi-clock-history me-2"></i><span class="nav-text">@L["Layout.OrderHistory"]</span>

                        </a>

                    </li>

                    <li class="nav-item">

                        <a class="nav-link @Active("/print-bridge")" asp-area="Tenant" asp-controller="PrintBridge" asp-action="Index">

                            <i class="bi bi-printer me-2"></i><span class="nav-text">@L["PrintBridge.Title"]</span>

                        </a>

                    </li>

                    <li class="nav-item">

                        <a class="nav-link @Active("/platform-connections")" asp-area="Tenant" asp-controller="PlatformConnections" asp-action="Index">

                            <i class="bi bi-plug me-2"></i><span class="nav-text">@L["Layout.PlatformConnections"]</span>

                        </a>

                    </li>

                    <li class="nav-item">

                        <a class="nav-link @Active("/branches")" asp-area="Tenant" asp-controller="Branches" asp-action="Index">

                            <i class="bi bi-diagram-3 me-2"></i><span class="nav-text">@L["Layout.Branches"]</span>

                        </a>

                    </li>

                </ul>



                <div class="oh-sidebar-footer">

                    @await Html.PartialAsync("_TenantSidebarFooter")

                    @await Html.PartialAsync("_TenantSettingsNav")

                </div>

            </nav>

        </aside>



        <main class="app-main oh-content" role="main">

            <div class="app-content">

                <div class="container-fluid py-3">

                    @RenderBody()

                </div>

            </div>

        </main>

    </div>



    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"

            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>

    <script src="https://cdn.jsdelivr.net/npm/admin-lte@4.0.0-rc3/dist/js/adminlte.min.js" crossorigin="anonymous"></script>

    <script src="~/js/orderhub-toast.js" asp-append-version="true"></script>

    <partial name="~/Views/Shared/_Notifications.cshtml" />

    <script src="~/js/theme-mode.js" asp-append-version="true"></script>

    <script src="~/js/sidebar-toggle.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>

