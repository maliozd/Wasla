@using Microsoft.Extensions.Localization
@inject IStringLocalizer<OrderHub.Web.SharedResource> L

@model (object? Platform, string? DisplayName)

@{
    var raw = Model.Platform?.ToString() ?? "";
    var norm = raw.Replace(" ", "").Replace("_", "").Replace("-", "").Trim().ToLowerInvariant();

    // Tolerant mapping: enum/string naming differences.
    var mapped = norm switch
    {
        "yemeksepeti" => "yemeksepeti",
        "getiryemek" => "getiryemek",
        "trendyolyemek" => "trendyolyemek",
        "trendyolgo" => "trendyolgo",
        "trendyol" => "trendyolyemek",
        _ => ""
    };

    var cssMod = mapped switch
    {
        "yemeksepeti" => "platform-badge--yemeksepeti",
        "getiryemek" => "platform-badge--getiryemek",
        "trendyolyemek" or "trendyolgo" => "platform-badge--trendyol",
        _ => ""
    };

    // Platform-specific badge variants:
    // - logo-only: show logo, hide text (keep aria-label/title)
    // - icon-text: show icon + text
    // - text-only: show text only (use when logo isn't readable in a compact badge)
    var badgeVariant = mapped switch
    {
        "yemeksepeti" => "logo-only",
        "getiryemek" => "logo-only",
        "trendyolyemek" or "trendyolgo" => "logo-only",
        _ => "icon-text"
    };

    var cssVariant = badgeVariant switch
    {
        "logo-only" => "platform-badge--wordmark",
        _ => ""
    };

    var iconPath = mapped switch
    {
        "yemeksepeti" => Url.Content("~/images/platforms/yemeksepeti.svg"),
        "getiryemek" => Url.Content("~/images/platforms/getiryemek.svg"),
        // Prefer Trendyol GO asset if it's the only available one; fall back to trendyolyemek.svg when present later.
        "trendyolyemek" => Url.Content("~/images/platforms/trendyolgo.svg"),
        "trendyolgo" => Url.Content("~/images/platforms/trendyolgo.svg"),
        _ => null
    };

    var localized = mapped switch
    {
        "yemeksepeti" => L["Orders.PlatformYemeksepeti"].Value,
        "getiryemek" => L["Orders.PlatformGetirYemek"].Value,
        "trendyolyemek" => L["Orders.PlatformTrendyolYemek"].Value,
        "trendyolgo" => L["Orders.PlatformTrendyolGo"].Value,
        _ => raw
    };

    var label = !string.IsNullOrWhiteSpace(Model.DisplayName) ? Model.DisplayName : localized;
}

<span class="platform-badge @cssMod @cssVariant" aria-label="@label" title="@label">
    @if (badgeVariant != "text-only" && !string.IsNullOrWhiteSpace(iconPath))
    {
        if (mapped == "getiryemek")
        {
            <span class="platform-badge__icon-wrap" aria-hidden="true">
                <img class="platform-badge__icon"
                     src="@iconPath"
                     alt=""
                     aria-hidden="true"
                     onerror="this.style.display='none'; this.closest('.platform-badge')?.classList.add('platform-badge--icon-missing');" />
            </span>
        }
        else
        {
            <img class="platform-badge__icon"
                 src="@iconPath"
                 alt=""
                 aria-hidden="true"
                 onerror="this.style.display='none'; this.closest('.platform-badge')?.classList.add('platform-badge--icon-missing');" />
        }
    }
    <span class="platform-badge__text">@label</span>
</span>
