@model OrderHub.Web.Models.Branches.BranchListViewModel
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<OrderHub.Web.SharedResource> L
@{
    ViewData["Title"] = L["Branches.Title"];
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h1 class="h4 mb-0">@L["Branches.Title"]</h1>
    <a class="btn btn-sm btn-primary" href="/branches/create">@L["Branches.Create"]</a>
</div>

<div class="card oh-card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead>
                <tr>
                    <th>@L["Branches.Name"]</th>
                    <th>@L["Branches.Address"]</th>
                    <th>@L["Common.Status"]</th>
                </tr>
                </thead>
                <tbody>
                @if (Model.Branches.Count == 0)
                {
                    <tr>
                        <td colspan="3" class="text-center text-muted py-4">@L["Branches.NoBranchesFound"]</td>
                    </tr>
                }
                else
                {
                    @foreach (var b in Model.Branches)
                    {
                        <tr>
                            <td class="fw-semibold">@b.Name</td>
                            <td>@b.Address</td>
                            <td>
                                @if (b.IsActive)
                                {
                                    <span class="badge text-bg-success">@L["Common.Active"]</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">@L["Common.Passive"]</span>
                                }
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

