@model OrderHub.Web.Models.Orders.OrderDetailViewModel
@using OrderHub.Domain.Enums
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<OrderHub.Web.SharedResource> L
@{
    ViewData["Title"] = L["Orders.DetailsTitle"];
    string StatusLabel(OrderStatus s) => L[$"OrderStatus.{s}"];
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h1 class="h4 mb-0">@L["Orders.DetailsTitle"]</h1>
        <div class="text-muted small">@Model.Platform - @Model.ExternalOrderCode</div>
    </div>
    <a class="btn btn-sm btn-outline-primary" href="/orders">@L["Common.Back"]</a>
</div>

<div class="row g-3">
    <div class="col-12 col-lg-5">
        <div class="card oh-card">
            <div class="card-body">
                <h2 class="h6">@L["Orders.Summary"]</h2>
                <dl class="row mb-0">
                    <dt class="col-5">@L["Common.Status"]</dt>
                    <dd class="col-7">@StatusLabel(Model.Status)</dd>

                    <dt class="col-5">@L["Orders.Customer"]</dt>
                    <dd class="col-7">@Model.CustomerName</dd>

                    <dt class="col-5">@L["Orders.Phone"]</dt>
                    <dd class="col-7">@Model.CustomerPhone</dd>

                    <dt class="col-5">@L["Orders.Address"]</dt>
                    <dd class="col-7">@Model.CustomerAddress</dd>

                    <dt class="col-5">@L["Common.Total"]</dt>
                    <dd class="col-7">@Model.TotalAmount.ToString("C")</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-7">
        <div class="card oh-card">
            <div class="card-body">
                <h2 class="h6">@L["Orders.Products"]</h2>
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                        <tr>
                            <th>@L["Orders.Product"]</th>
                            <th class="text-end">@L["Orders.Quantity"]</th>
                            <th class="text-end">@L["Orders.Unit"]</th>
                            <th class="text-end">@L["Orders.LineTotal"]</th>
                        </tr>
                        </thead>
                        <tbody>
                        @if (Model.Items.Count == 0)
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4">@L["Dashboard.NoRecentOrders"]</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var i in Model.Items)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold">@i.ProductName</div>
                                        @if (!string.IsNullOrWhiteSpace(i.Notes))
                                        {
                                            <div class="text-muted small">@i.Notes</div>
                                        }
                                        @if (i.Options.Count > 0)
                                        {
                                            <div class="text-muted small">
                                                @string.Join(", ", i.Options.Select(o => $"{o.Name} (+{o.Price:C})"))
                                            </div>
                                        }
                                    </td>
                                    <td class="text-end">@i.Quantity</td>
                                    <td class="text-end">@i.UnitPrice.ToString("C")</td>
                                    <td class="text-end">@i.TotalPrice.ToString("C")</td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

