@using System.Collections.Generic
@using System.Text.Json
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<OrderHub.Web.SharedResource> L
@using OrderHub.Web.Models.Ui
@{
    ViewData["Title"] = L["Settings.OrderSettings.Title"];
}

<div class="oh-order-settings-page">
    @await Html.PartialAsync("_CustomerPageHeader", new CustomerPageHeaderModel
    {
        Title = L["Settings.OrderSettings.Title"].Value,
        Subtitle = L["Settings.OrderSettings.Subtitle"].Value
    })

    <div id="ordersMessageHost"></div>

    <form id="orderSyncSettingsForm" method="post" action="/orders/sync-settings" class="d-none">
        @Html.AntiForgeryToken()
    </form>
    <form id="orderSettingsForm" method="post" action="/orders/order-settings" class="d-none">
        @Html.AntiForgeryToken()
    </form>

    <div class="card oh-card oh-settings-card">
        <div class="card-body p-0">
            <section class="oh-settings-section">
                <div class="oh-settings-section-row">
                    <div class="oh-settings-section-text">
                        <h2 class="h6 mb-1">@L["Settings.OrderSynchronization.Title"]</h2>
                        <p class="text-muted small mb-0">@L["Settings.OrderSynchronization.Description"]</p>
                    </div>
                    <div class="oh-settings-section-controls">
                        <span class="small text-muted text-nowrap">@L["Settings.OrderSynchronization.EnableOrderSync"]</span>
                        <div class="form-check form-switch m-0">
                            <input class="form-check-input" type="checkbox" role="switch" id="orderSyncToggle"
                                   aria-label="@L["Orders.OrderSyncToggleAriaLabel"]"
                                   title="@L["Settings.OrderSynchronization.EnableOrderSync"]" />
                        </div>
                        <span id="orderSyncStatusBadge" class="badge text-bg-secondary">…</span>
                    </div>
                </div>
            </section>

            <section class="oh-settings-section">
                <div class="oh-settings-section-row">
                    <div class="oh-settings-section-text">
                        <h2 class="h6 mb-1">@L["Settings.AutoApproval.Title"]</h2>
                        <p class="text-muted small mb-0">@L["Settings.AutoApproval.Description"]</p>
                    </div>
                    <div class="oh-settings-section-controls">
                        <span class="small text-muted text-nowrap">@L["Settings.AutoApproval.EnableAutoApprove"]</span>
                        <div class="form-check form-switch m-0">
                            <input class="form-check-input" type="checkbox" role="switch" id="autoApproveToggle"
                                   aria-label="@L["Settings.AutoApproval.EnableAutoApprove"]"
                                   title="@L["Orders.AutoApproveHelp"]" />
                        </div>
                        <span id="autoApproveStatusBadge" class="badge text-bg-secondary">@L["Settings.Passive"]</span>
                    </div>
                </div>
            </section>

            <section class="oh-settings-section">
                <div class="oh-settings-section-row">
                    <div class="oh-settings-section-text">
                        <h2 class="h6 mb-1">@L["Settings.Notifications.Title"]</h2>
                        <p class="text-muted small mb-0">@L["Settings.Notifications.Description"]</p>
                    </div>
                    <div class="oh-settings-section-controls oh-settings-section-controls--button">
                        <button type="button" class="btn btn-outline-primary btn-sm" id="notificationSettingsBtn">
                            <i class="bi bi-bell me-1"></i>@L["Settings.Notifications.ManageNotificationSettings"]
                        </button>
                    </div>
                </div>
            </section>
        </div>
    </div>
</div>

@await Html.PartialAsync("_NotificationSettingsModalShell")

@section Scripts {
    <script>
        window.orderHubOrdersOptions = {
            notificationSettingsUrl: "/notification-settings",
            notificationSettingsJsonUrl: "/notification-settings/current",
            orderSyncSettingsUrl: "/orders/sync-settings",
            orderSettingsUrl: "/orders/order-settings",
            messages: @Html.Raw(JsonSerializer.Serialize(new Dictionary<string, string>
            {
                ["genericError"] = L["Orders.GenericError"].Value,
                ["alertClose"] = L["Common.Close"].Value,
                ["settingsSaved"] = L["Notification.SettingsSaved"].Value,
                ["settingsSaveFailed"] = L["Notification.SettingsSaveFailed"].Value,
                ["commonSaved"] = L["Common.Saved"].Value,
                ["commonSaveFailed"] = L["Common.SaveFailed"].Value,
                ["soundEnabled"] = L["Notification.SoundEnabled"].Value,
                ["soundUnlockHint"] = L["Notification.SoundUnlockHint"].Value,
                ["notificationsOff"] = L["Notification.Disabled"].Value,
                ["notificationsOffHelp"] = L["Notification.NotificationsHelp"].Value,
                ["waitingForAudio"] = L["Notification.WaitingForBrowserAudio"].Value,
                ["waitingForAudioHelp"] = L["Notification.NotificationsHelp"].Value,
                ["notificationsOn"] = L["Notification.Enabled"].Value,
                ["notificationsOnHelp"] = L["Notification.NotificationsHelp"].Value,
                ["audioNotAllowed"] = L["Orders.AudioNotAllowed"].Value,
                ["audioPlayFailed"] = L["Orders.AudioPlayFailed"].Value,
                ["audioFileError"] = L["Orders.AudioFileError"].Value,
                ["notificationSettingsLoadFailed"] = L["Orders.NotificationSettingsLoadFailed"].Value,
                ["notificationSettingsUnexpectedFormat"] = L["Orders.NotificationSettingsUnexpectedFormat"].Value,
                ["notificationSettingsLoadException"] = L["Orders.NotificationSettingsLoadException"].Value,
                ["notificationSettingsModalOpenFailed"] = L["Orders.NotificationSettingsModalOpenFailed"].Value,
                ["notificationSettingsSaveFailed"] = L["Orders.NotificationSettingsSaveFailed"].Value,
                ["notificationSettingsSaveException"] = L["Orders.NotificationSettingsSaveException"].Value,
                ["ordersActive"] = L["Settings.Active"].Value,
                ["ordersPassive"] = L["Settings.Passive"].Value,
                ["orderSyncEnabledMessage"] = L["Orders.OrderSyncEnabledMessage"].Value,
                ["orderSyncDisabledMessage"] = L["Orders.OrderSyncDisabledMessage"].Value,
                ["orderSyncUpdateFailed"] = L["Orders.OrderSyncUpdateFailed"].Value,
                ["orderSettingsSaved"] = L["Settings.SavedSuccessfully"].Value,
                ["orderSettingsUpdateFailed"] = L["Settings.SaveFailed"].Value,
                ["receiptPrintCopyCountOutOfRange"] = L["Orders.ReceiptPrintCopyCountOutOfRange"].Value
            }))
        };
    </script>
    <script src="~/js/orders/orders-core.js" asp-append-version="true"></script>
    <script src="~/js/orders/orders-audio.js" asp-append-version="true"></script>
    <script src="~/js/orders/orders-notification-settings.js" asp-append-version="true"></script>
    <script src="~/js/orders/orders-sync-settings.js" asp-append-version="true"></script>
    <script src="~/js/orders/orders-order-settings.js" asp-append-version="true"></script>
    <script src="~/js/settings/order-settings-page.js" asp-append-version="true"></script>
}
