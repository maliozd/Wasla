@model OrderHub.Web.Models.Notifications.NotificationSettingsViewModel
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<OrderHub.Web.SharedResource> L

@{
    var saved = ViewData["Saved"] as bool? == true;
    var selectedLabel = Model.AvailableSounds.FirstOrDefault(x => x.Name == Model.NewOrderSoundName)?.Label ?? "Bell";
}

<div class="modal-header">
    <h5 class="modal-title">@L["Notification.Settings"]</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["Common.Close"]"></button>
</div>

<div class="modal-body">
    @if (saved)
    {
        <div class="alert alert-success py-2">@L["Notification.SaveSuccess"]</div>
    }

    <div class="d-flex align-items-start justify-content-between gap-3 mb-3">
        <div>
            <div class="d-flex align-items-center gap-2">
                <span id="notificationStatusBadge" class="badge text-bg-secondary">@L["Common.Status"]</span>
                <span class="text-muted small">@L["Notification.PersistentHelp"]</span>
            </div>
            <div id="notificationStatusHelp" class="small text-muted mt-1">
                @L["Notification.NotificationsHelp"]
            </div>
            <div id="notificationStatusWarning" class="small text-danger mt-2 d-none"></div>
        </div>
    </div>

    <input type="hidden" id="NewOrderSoundEnabled" name="NewOrderSoundEnabled" value="@(Model.NewOrderSoundEnabled ? "true" : "false")" />

    <div class="mb-3">
        <div class="d-flex align-items-center justify-content-between">
            <label class="form-label mb-0">@L["Notification.Notifications"]</label>
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" id="NewOrderSoundEnabledToggle" @(Model.NewOrderSoundEnabled ? "checked" : "")>
            </div>
        </div>
        <div class="small text-muted">@L["Notification.NotificationsHelp"]</div>
    </div>

    <div class="mb-3">
        <div class="d-flex align-items-center justify-content-between mb-2">
            <div>
                <div class="fw-semibold">@L["Notification.Sound"]</div>
                <div class="small text-muted">@L["Notification.SelectedSound"]: <span id="selectedSoundLabel">@selectedLabel</span></div>
            </div>
        </div>

        <div class="list-group" id="soundOptionsList">
            @foreach (var s in Model.AvailableSounds)
            {
                var active = string.Equals(Model.NewOrderSoundName, s.Name, StringComparison.OrdinalIgnoreCase);
                <div class="list-group-item d-flex align-items-center justify-content-between gap-2 sound-option @(active ? "active" : "")"
                     data-sound-name="@s.Name"
                     data-sound-url="@s.Url">
                    <div class="d-flex align-items-center gap-2">
                        <input class="form-check-input mt-0" type="radio" name="soundRadio" value="@s.Name" @(active ? "checked" : "")>
                        <div>@s.Label</div>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-light listen-sound-btn">@L["Notification.Play"]</button>
                </div>
            }
        </div>

        <input type="hidden" id="NewOrderSoundName" name="NewOrderSoundName" value="@Model.NewOrderSoundName" />
    </div>

    <div class="row g-2">
        <div class="col-12 col-md-6">
            <label class="form-label" for="NewOrderSoundRepeatCount">@L["Notification.RepeatCount"]</label>
            <select class="form-select" id="NewOrderSoundRepeatCount" name="NewOrderSoundRepeatCount">
                @foreach (var i in new[] { 1, 2, 3 })
                {
                    <option value="@i" selected="@(Model.NewOrderSoundRepeatCount == i)">@i</option>
                }
            </select>
        </div>

        <div class="col-12 col-md-6">
            <label class="form-label" for="NewOrderSoundVolumePercent">@L["Notification.Volume"]</label>
            <select class="form-select" id="NewOrderSoundVolumePercent" name="NewOrderSoundVolumePercent">
                <option value="25" selected="@(Model.NewOrderSoundVolumePercent == 25)">%25</option>
                <option value="50" selected="@(Model.NewOrderSoundVolumePercent == 50)">%50</option>
                <option value="75" selected="@(Model.NewOrderSoundVolumePercent == 75)">%75</option>
                <option value="100" selected="@(Model.NewOrderSoundVolumePercent == 100)">%100</option>
            </select>
        </div>

        <div class="col-12 col-md-6 d-flex align-items-end">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="ShowBrowserNotification" name="ShowBrowserNotification" value="true" @(Model.ShowBrowserNotification ? "checked" : "")>
                <input type="hidden" name="ShowBrowserNotification" value="false" />
                <label class="form-check-label" for="ShowBrowserNotification">@L["Notification.ShowBrowserNotification"]</label>
            </div>
        </div>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="mt-2 text-danger small">
            @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@e.ErrorMessage</div>
            }
        </div>
    }
</div>

<div class="modal-footer">
    <button type="button" class="btn btn-outline-primary" id="testSelectedSoundBtn">@L["Notification.TestSelectedSound"]</button>
    <button type="submit" class="btn btn-primary" id="saveNotificationsBtn">@L["Common.Save"]</button>
    <button type="button" class="btn btn-light" data-bs-dismiss="modal">@L["Common.Close"]</button>
</div>

