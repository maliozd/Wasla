@model OrderHub.Web.Models.Auth.LoginViewModel
@using System.Globalization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<OrderHub.Web.SharedResource> L
@{
    Layout = null;
    ViewData["Title"] = L["Auth.LoginTitle"];
    var culture = CultureInfo.CurrentUICulture?.Name ?? "tr-TR";
    var isRtl = culture.StartsWith("ar", StringComparison.OrdinalIgnoreCase);
}

<!DOCTYPE html>
<html lang="@culture" dir="@(isRtl ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Wasla</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @if (isRtl)
    {
        <link rel="stylesheet" href="~/css/rtl.css" asp-append-version="true" />
    }
</head>
<body class="oh-auth-bg">
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
            <div class="card oh-card">
                <div class="card-body p-4">
                    <h1 class="h4 mb-3">@L["Auth.LoginTitle"]</h1>

                    @if (TempData["AuthMessage"] is string authMessage && !string.IsNullOrWhiteSpace(authMessage))
                    {
                        <div class="alert alert-warning">@authMessage</div>
                    }

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger">@L["Auth.InvalidCredentials"]</div>
                    }

                    <form method="post" action="/auth/login">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ReturnUrl" />

                        <div class="mb-3">
                            <label class="form-label" asp-for="Email">@L["Auth.Email"]</label>
                            <input class="form-control" asp-for="Email" autocomplete="username" />
                            <span class="text-danger" asp-validation-for="Email"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" asp-for="Password">@L["Auth.Password"]</label>
                            <div class="input-group">
                                <input class="form-control" asp-for="Password" type="password" autocomplete="current-password" id="login-password" />
                                <button class="btn btn-outline-secondary" type="button" id="toggle-password"
                                        title="@L["Auth.ShowPassword"]"
                                        aria-label="@L["Auth.ShowPassword"]"
                                        data-show-label="@L["Auth.ShowPassword"]"
                                        data-hide-label="@L["Auth.HidePassword"]">
                                    <span id="toggle-password-icon">&#128065;</span>
                                </button>
                            </div>
                            <span class="text-danger" asp-validation-for="Password"></span>
                        </div>

                        <button class="btn btn-primary w-100" type="submit">@L["Auth.LoginButton"]</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await Html.PartialAsync("_ValidationScriptsPartial")
<script>
(function () {
    var btn = document.getElementById('toggle-password');
    var input = document.getElementById('login-password');
    if (!btn || !input) return;
    btn.addEventListener('click', function () {
        var isPassword = input.type === 'password';
        input.type = isPassword ? 'text' : 'password';
        var label = isPassword ? btn.dataset.hideLabel : btn.dataset.showLabel;
        btn.title = label;
        btn.setAttribute('aria-label', label);
        document.getElementById('toggle-password-icon').textContent = isPassword ? '\uD83D\uDE48' : '\uD83D\uDC41';
    });
}());
</script>
</body>
</html>

