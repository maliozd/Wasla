@using Microsoft.Extensions.Localization
@inject IStringLocalizer<OrderHub.Web.SharedResource> L
@{
    var path = Context.Request.Path.Value ?? "/";
    var devicesActive = path.Equals("/print-bridge", StringComparison.OrdinalIgnoreCase);
    var setupActive = path.StartsWith("/print-bridge/download", StringComparison.OrdinalIgnoreCase);
}
<ul class="nav nav-pills nav-fill flex-nowrap oh-print-bridge-nav mb-3" role="tablist">
    <li class="nav-item" role="presentation">
        <a class="nav-link @(devicesActive ? "active" : "")" href="/print-bridge">
            <i class="bi bi-hdd-network me-1"></i>@L["PrintBridge.NavDevices"]
        </a>
    </li>
    <li class="nav-item" role="presentation">
        <a class="nav-link @(setupActive ? "active" : "")" href="/print-bridge/download">
            <i class="bi bi-download me-1"></i>@L["PrintBridge.NavSetup"]
        </a>
    </li>
</ul>
