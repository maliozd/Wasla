@model OrderHub.Web.Models.PrintBridge.PrintBridgeSetupViewModel
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<OrderHub.Web.SharedResource> L
@{
    ViewData["Title"] = L["PrintBridge.SetupPageTitle"];
}

<div class="oh-print-bridge-page oh-print-bridge-setup-page">
<div class="oh-customer-page-header mb-3">
    <h1 class="oh-customer-page-header__title h4 mb-1">@L["PrintBridge.SetupPageTitle"]</h1>
    <p class="oh-customer-page-header__subtitle text-muted small mb-0">@L["PrintBridge.SetupPageSubtitle"]</p>
</div>

<section class="oh-print-bridge-guide-section card oh-card mb-3">
    <div class="card-body">
        <h2 class="h6 mb-2">@L["PrintBridge.WhatIsPrintBridgeTitle"]</h2>
        <p class="text-muted small mb-0">@L["PrintBridge.WhatIsPrintBridgeText"]</p>
    </div>
</section>

<section class="oh-print-bridge-guide-section card oh-card mb-3">
    <div class="card-body">
        <h2 class="h6 mb-2">@L["PrintBridge.BeforeYouStartTitle"]</h2>
        <ul class="oh-print-bridge-guide-checklist small text-muted mb-0">
            <li>@L["PrintBridge.BeforeYouStartItem1"]</li>
            <li>@L["PrintBridge.BeforeYouStartItem2"]</li>
            <li>@L["PrintBridge.BeforeYouStartItem3"]</li>
            <li>@L["PrintBridge.BeforeYouStartItem4"]</li>
            <li>@L["PrintBridge.BeforeYouStartItem5"]</li>
        </ul>
    </div>
</section>

<section class="oh-print-bridge-guide-step card oh-card mb-3">
    <div class="card-body">
        <div class="oh-print-bridge-guide-step__badge">1</div>
        <h2 class="h6 mb-2">@L["PrintBridge.GuideStep1Title"]</h2>
        <p class="text-muted small mb-2">
            <span class="badge text-bg-secondary">@L["PrintBridge.PackageTypeLabel"]</span>
        </p>
        <p class="text-muted small mb-3">@L["PrintBridge.GuideStep1Text"]</p>
        @if (Model.PackageAvailable)
        {
            <a class="btn btn-primary btn-sm" href="@Model.PackageDownloadUrl">
                <i class="bi bi-download me-1"></i>@L["PrintBridge.DownloadButton"]
            </a>
            <p class="small text-muted mt-2 mb-0">@Model.PackageFileName</p>
        }
        else
        {
            <div class="alert alert-warning small py-2 mb-2" role="alert">
                @L["PrintBridge.PackageNotPrepared"]
            </div>
            <p class="small text-muted mb-0">@L["PrintBridge.PackageNotPreparedHint"]</p>
        }
    </div>
</section>

<section class="oh-print-bridge-guide-step card oh-card mb-3">
    <div class="card-body">
        <div class="oh-print-bridge-guide-step__badge">2</div>
        <h2 class="h6 mb-2">@L["PrintBridge.GuideStep2Title"]</h2>
        <p class="text-muted small mb-3">@L["PrintBridge.GuideStep2Text"]</p>
        <a class="btn btn-outline-primary btn-sm" href="@Model.DevicesUrl">
            <i class="bi bi-hdd-network me-1"></i>@L["PrintBridge.GuideStep2Action"]
        </a>
    </div>
</section>

<section class="oh-print-bridge-guide-step card oh-card mb-3">
    <div class="card-body">
        <div class="oh-print-bridge-guide-step__badge">3</div>
        <h2 class="h6 mb-2">@L["PrintBridge.GuideStep3Title"]</h2>
        <p class="text-muted small mb-0">@L["PrintBridge.GuideStep3Text"]</p>
        <div class="oh-print-bridge-guide-placeholder mt-3" aria-hidden="true">
            <i class="bi bi-window-sidebar"></i>
            <span>@L["PrintBridge.GuideSettingsTabPlaceholder"]</span>
        </div>
    </div>
</section>

<section class="oh-print-bridge-guide-step card oh-card mb-3">
    <div class="card-body">
        <div class="oh-print-bridge-guide-step__badge">4</div>
        <h2 class="h6 mb-2">@L["PrintBridge.GuideStep4Title"]</h2>
        <p class="text-muted small mb-0">@L["PrintBridge.GuideStep4Text"]</p>
    </div>
</section>

<section class="oh-print-bridge-guide-step card oh-card mb-3">
    <div class="card-body">
        <div class="oh-print-bridge-guide-step__badge">5</div>
        <h2 class="h6 mb-2">@L["PrintBridge.GuideStep5Title"]</h2>
        <p class="text-muted small mb-0">@L["PrintBridge.GuideStep5Text"]</p>
    </div>
</section>

<section class="oh-print-bridge-guide-step card oh-card mb-3">
    <div class="card-body">
        <div class="oh-print-bridge-guide-step__badge">6</div>
        <h2 class="h6 mb-2">@L["PrintBridge.GuideStep6Title"]</h2>
        <p class="text-muted small mb-0">@L["PrintBridge.GuideStep6Text"]</p>
    </div>
</section>

<section class="oh-print-bridge-guide-step card oh-card mb-3">
    <div class="card-body">
        <div class="oh-print-bridge-guide-step__badge">7</div>
        <h2 class="h6 mb-2">@L["PrintBridge.GuideStep7Title"]</h2>
        <p class="text-muted small mb-0">@L["PrintBridge.GuideStep7Text"]</p>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(Model.ServerUrl))
{
    <section class="oh-print-bridge-guide-section card oh-card mb-3 oh-print-bridge-server-url-info">
        <div class="card-body">
            <h2 class="h6 mb-2 text-muted">@L["PrintBridge.ServerUrlInfoTitle"]</h2>
            <p class="text-muted small mb-2">@L["PrintBridge.ServerUrlInfoText"]</p>
            <code class="small user-select-all d-inline-block px-2 py-1 rounded border bg-body">@Model.ServerUrl</code>
        </div>
    </section>
}

<section class="oh-print-bridge-guide-section card oh-card mb-3">
    <div class="card-body">
        <h2 class="h6 mb-2">@L["PrintBridge.Troubleshooting"]</h2>
        <ul class="oh-print-bridge-troubleshooting list-unstyled small text-muted mb-0">
            <li>@L["PrintBridge.TroubleshootingGuide1"]</li>
            <li>@L["PrintBridge.TroubleshootingGuide2"]</li>
            <li>@L["PrintBridge.TroubleshootingGuide3"]</li>
            <li>@L["PrintBridge.TroubleshootingGuide4"]</li>
            <li>@L["PrintBridge.TroubleshootingGuide5"]</li>
            <li>@L["PrintBridge.TroubleshootingGuide6"]</li>
            <li>@L["PrintBridge.TroubleshootingGuide7"]</li>
        </ul>
    </div>
</section>
</div>
