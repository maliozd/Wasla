@model OrderHub.Web.Models.PrintBridge.PrintBridgeHelpViewModel
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<OrderHub.Web.SharedResource> L
@{
    ViewData["Title"] = L["PrintBridge.Title"];
}

<div class="card oh-card">
    <div class="card-body">
        <h1 class="h4 mb-3">@L["PrintBridge.Title"]</h1>
        <p class="text-muted">@L["PrintBridge.Intro"]</p>

        <h2 class="h6 mt-4">@L["PrintBridge.RequirementsTitle"]</h2>
        <ul class="small">
            <li>@L["PrintBridge.RequirementWindows"]</li>
            <li>@L["PrintBridge.RequirementUsbPrinter"]</li>
            <li>@L["PrintBridge.RequirementLocalApp"]</li>
        </ul>

        <h2 class="h6 mt-4">@L["PrintBridge.SetupTitle"]</h2>
        <ol class="small">
            <li>@L["PrintBridge.SetupStepDownload"]</li>
            <li>@L["PrintBridge.SetupStepToken"]</li>
            <li>@L["PrintBridge.SetupStepConfig"]</li>
            <li>@L["PrintBridge.SetupStepRun"]</li>
        </ol>

        <div class="d-flex flex-wrap gap-2 mt-3">
            <a class="btn btn-outline-primary btn-sm" href="@Model.DownloadUrl">@L["PrintBridge.Download"]</a>
            <button type="button" class="btn btn-primary btn-sm" id="printBridgeGenerateTokenBtn">@L["PrintBridge.GenerateToken"]</button>
        </div>

        <form id="printBridgeTokenForm" method="post" action="/print-bridge/generate-token" class="mt-3">
            @Html.AntiForgeryToken()
            <div class="row g-2 align-items-end">
                <div class="col-md-4">
                    <label class="form-label small" for="printBridgeDeviceName">@L["PrintBridge.DeviceName"]</label>
                    <input class="form-control form-control-sm" id="printBridgeDeviceName" name="deviceName" type="text" maxlength="200" placeholder="@L["PrintBridge.DeviceNamePlaceholder"]" />
                </div>
            </div>
        </form>

        <div id="printBridgeTokenResult" class="alert alert-warning small mt-3 d-none" role="alert"></div>

        <p class="text-muted small mt-4 mb-0">@L["PrintBridge.ApiHint"]</p>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var btn = document.getElementById("printBridgeGenerateTokenBtn");
            var form = document.getElementById("printBridgeTokenForm");
            var result = document.getElementById("printBridgeTokenResult");
            if (!btn || !form || !result) return;

            var messages = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
                tokenGeneratedOnce = L["PrintBridge.TokenGeneratedOnce"].Value,
                tokenGenerateFailed = L["PrintBridge.TokenGenerateFailed"].Value
            }));

            btn.addEventListener("click", function () {
                var tokenInput = form.querySelector("input[name='__RequestVerificationToken']");
                var deviceName = document.getElementById("printBridgeDeviceName");
                var body = new URLSearchParams();
                if (deviceName && deviceName.value) body.set("deviceName", deviceName.value);

                var headers = { "X-Requested-With": "fetch" };
                if (tokenInput) headers["RequestVerificationToken"] = tokenInput.value;

                fetch(form.action, { method: "POST", headers: headers, body: body })
                    .then(function (resp) {
                        if (!resp.ok) throw new Error("failed");
                        return resp.json();
                    })
                    .then(function (data) {
                        result.classList.remove("d-none", "alert-danger");
                        result.classList.add("alert-warning");
                        result.textContent = (data.message || messages.tokenGeneratedOnce) + " " + (data.token || "");
                    })
                    .catch(function () {
                        result.classList.remove("d-none", "alert-warning");
                        result.classList.add("alert-danger");
                        result.textContent = messages.tokenGenerateFailed;
                    });
            });
        })();
    </script>
}
