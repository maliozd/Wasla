@model OrderHub.Web.Models.PlatformConnections.CreatePlatformConnectionViewModel
@using OrderHub.Domain.Enums
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<OrderHub.Web.SharedResource> L
@{
    ViewData["Title"] = L["PlatformConnections.Create"];
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h1 class="h4 mb-0">@L["PlatformConnections.Create"]</h1>
    <a class="btn btn-sm btn-outline-primary" href="/platform-connections">@L["PlatformConnections.Back"]</a>
</div>

<div class="card oh-card">
    <div class="card-body">
        <form method="post" action="/platform-connections/create">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="row g-3">
                <div class="col-12 col-md-4">
                    <label class="form-label" asp-for="Platform"></label>
                    <select class="form-select" asp-for="Platform">
                        @foreach (var p in Enum.GetValues<FoodPlatform>())
                        {
                            <option value="@p">@p</option>
                        }
                    </select>
                    <span class="text-danger" asp-validation-for="Platform"></span>
                </div>

                <div class="col-12 col-md-8">
                    <label class="form-label" asp-for="StoreId"></label>
                    <input class="form-control" asp-for="StoreId" />
                    @* <div id="trendyolStoreIdHelp" class="form-text d-none">@L["PlatformConnections.TrendyolStoreIdHelp"]</div> *@
                    <span class="text-danger" asp-validation-for="StoreId"></span>
                </div>

                <div class="col-12 col-md-6">
                    <label class="form-label" asp-for="ApiKey"></label>
                    <input class="form-control" asp-for="ApiKey" />
                    <span class="text-danger" asp-validation-for="ApiKey"></span>
                </div>

                <div class="col-12 col-md-6">
                    <label class="form-label" asp-for="ApiSecret"></label>
                    <input class="form-control" asp-for="ApiSecret" />
                    <span class="text-danger" asp-validation-for="ApiSecret"></span>
                </div>

                <div class="col-12">
                    <div class="form-check">
                        <input class="form-check-input" asp-for="IsActive" />
                        <label class="form-check-label" asp-for="IsActive"></label>
                    </div>
                </div>

                <div class="col-12">
                    <button class="btn btn-primary" type="submit">@L["Common.Save"]</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        (function () {
            const select = document.querySelector("select[name='Platform']");
            const help = document.getElementById("trendyolStoreIdHelp");
            if (!select || !help) return;
            function update() {
                const v = (select.value || "").toLowerCase();
                const show = v === "trendyolyemek" || v === "trendyolgo" || v === "trendyol";
                help.classList.toggle("d-none", !show);
            }
            select.addEventListener("change", update);
            update();
        })();
    </script>
}

