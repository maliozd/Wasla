@model OrderHub.Web.Areas.Admin.Models.CentralAdminTenantDetailViewModel
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<OrderHub.Web.SharedResource> L
@{
    ViewData["Title"] = L["Admin.CustomerDetails"].Value;
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb small mb-0">
        <li class="breadcrumb-item"><a href="/admin">@L["Admin.DashboardTitle"]</a></li>
        <li class="breadcrumb-item"><a href="/admin/customers">@L["Admin.Customers"]</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
    </ol>
</nav>

<h1 class="h4 mb-3">@L["Admin.CustomerDetails"]</h1>

@if (!Model.IsActive)
{
    <div class="alert alert-warning" role="alert">@L["Admin.InactiveWarning"]</div>
}

<dl class="row small">
    <dt class="col-sm-3">@L["Admin.Name"]</dt>
    <dd class="col-sm-9">@Model.Name</dd>
    <dt class="col-sm-3">@L["Admin.Slug"]</dt>
    <dd class="col-sm-9"><code>@Model.Slug</code></dd>
    <dt class="col-sm-3">@L["Admin.PrimaryDomain"]</dt>
    <dd class="col-sm-9">@Model.PrimaryDomain</dd>
    <dt class="col-sm-3">@L["Admin.DatabaseName"]</dt>
    <dd class="col-sm-9">@Model.DatabaseName</dd>
    <dt class="col-sm-3">@L["Common.Status"]</dt>
    <dd class="col-sm-9">
        @if (Model.IsActive)
        {
            <span class="badge text-bg-success">@L["Admin.StatusActive"]</span>
        }
        else
        {
            <span class="badge text-bg-secondary">@L["Admin.StatusInactive"]</span>
        }
    </dd>
    <dt class="col-sm-3">@L["Admin.SchemaVersion"]</dt>
    <dd class="col-sm-9">@Model.SchemaVersion</dd>
    <dt class="col-sm-3">@L["Admin.LastMigrationAt"]</dt>
    <dd class="col-sm-9">@(Model.LastMigrationAt?.ToString("u") ?? "—")</dd>
    <dt class="col-sm-3">@L["Admin.LastMigrationResult"]</dt>
    <dd class="col-sm-9">@(Model.LastMigrationResult ?? "—")</dd>
    <dt class="col-sm-3">@L["Admin.CreatedAt"]</dt>
    <dd class="col-sm-9">@Model.CreatedAt.ToString("u")</dd>
    <dt class="col-sm-3">@L["Admin.UpdatedAt"]</dt>
    <dd class="col-sm-9">@Model.UpdatedAt.ToString("u")</dd>
</dl>

<div class="d-flex flex-wrap gap-2">
    <a class="btn btn-outline-secondary" href="/admin/customers">@L["Admin.BackToDashboard"]</a>
    @if (Model.IsActive)
    {
        <form method="post" action="/admin/customers/@Model.Id/deactivate" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-warning">@L["Admin.Deactivate"]</button>
        </form>
    }
    else
    {
        <form method="post" action="/admin/customers/@Model.Id/activate" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-success">@L["Admin.Activate"]</button>
        </form>
    }
</div>

