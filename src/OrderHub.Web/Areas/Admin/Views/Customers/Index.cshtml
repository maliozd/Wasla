@model OrderHub.Web.Areas.Admin.Models.CentralAdminDashboardViewModel
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<OrderHub.Web.SharedResource> L
@{
    ViewData["Title"] = L["Admin.Customers"].Value;
}

<h1 class="h4 mb-3">@L["Admin.Customers"]</h1>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead>
                <tr>
                    <th>@L["Admin.Name"]</th>
                    <th>@L["Admin.Slug"]</th>
                    <th>@L["Admin.PrimaryDomain"]</th>
                    <th>@L["Admin.DatabaseName"]</th>
                    <th>@L["Common.Status"]</th>
                    <th>@L["Admin.SchemaVersion"]</th>
                    <th>@L["Admin.LastMigrationAt"]</th>
                    <th>@L["Admin.LastMigrationResult"]</th>
                    <th>@L["Admin.CreatedAt"]</th>
                    <th class="text-end">@L["Admin.Actions"]</th>
                </tr>
                </thead>
                <tbody>
                @if (Model.Customers.Count == 0)
                {
                    <tr>
                        <td colspan="10" class="text-center text-muted py-4">@L["Admin.NoCustomers"]</td>
                    </tr>
                }
                else
                {
                    @foreach (var c in Model.Customers)
                    {
                        <tr>
                            <td>@c.Name</td>
                            <td><code class="small">@c.Slug</code></td>
                            <td class="small">@c.PrimaryDomain</td>
                            <td class="small">@c.DatabaseName</td>
                            <td>
                                @if (c.IsActive)
                                {
                                    <span class="badge text-bg-success">@L["Admin.StatusActive"]</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">@L["Admin.StatusInactive"]</span>
                                }
                            </td>
                            <td class="small">@c.SchemaVersion</td>
                            <td class="small">@(c.LastMigrationAt?.ToString("u"))</td>
                            <td class="small">@(c.LastMigrationResult ?? "—")</td>
                            <td class="small">@c.CreatedAt.ToString("u")</td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-sm btn-outline-primary" href="/admin/customers/@c.Id">@L["Admin.Details"]</a>
                                @if (c.IsActive)
                                {
                                    <form method="post" action="/admin/customers/@c.Id/deactivate" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-warning">@L["Admin.Deactivate"]</button>
                                    </form>
                                }
                                else
                                {
                                    <form method="post" action="/admin/customers/@c.Id/activate" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-success">@L["Admin.Activate"]</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

