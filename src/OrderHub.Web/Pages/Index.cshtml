@page "/"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@model OrderHub.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Panel";
}
<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="h3 mb-1">Panel</h1>
        <div class="text-muted">Hoş geldin, @Model.UserName!</div>
    </div>
</div>

@using OrderHub.Web.Pages.Helpers

@if (Model.LoadFailed || Model.Summary is null)
{
    <div class="alert alert-warning" role="alert">
        Veri yüklenemedi, lütfen sayfayı yenileyin.
    </div>
}
else
{
    var s = Model.Summary;
    var syncRatePct = s.SyncSuccessRate * 100.0;
    var recentOrders = s.RecentOrders ?? Array.Empty<OrderHub.Contracts.Orders.OrderListItemDto>();
    var platformBreakdown = s.PlatformBreakdown ?? Array.Empty<OrderHub.Contracts.Dashboard.PlatformBreakdownDto>();

    <div class="row g-3 mb-4">
        <div class="col-12 col-md-4">
            <div class="card shadow-sm border-start border-4 border-primary">
                <div class="card-body d-flex align-items-center">
                    <div>
                        <div class="text-muted">Bugünkü Sipariş</div>
                        <div class="fs-2 fw-bold">@s.TodayOrderCount</div>
                    </div>
                    <div class="ms-auto text-primary fs-1">
                        <i class="bi bi-bag"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card shadow-sm border-start border-4 border-primary">
                <div class="card-body d-flex align-items-center">
                    <div>
                        <div class="text-muted">Bugünkü Ciro</div>
                        <div class="fs-2 fw-bold">@FormatHelpers.TryCurrency(s.TodayRevenue)</div>
                    </div>
                    <div class="ms-auto text-primary fs-1">
                        <i class="bi bi-cash-stack"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card shadow-sm border-start border-4 @FormatHelpers.SyncRateClass(s.SyncSuccessRate)">
                <div class="card-body d-flex align-items-center">
                    <div>
                        <div class="text-muted">Sync Başarı Oranı</div>
                        <div class="fs-2 fw-bold">@syncRatePct.ToString("F1", System.Globalization.CultureInfo.GetCultureInfo("tr-TR"))%</div>
                        <div class="small text-muted">@s.TodaySyncSuccessCount/@s.TodaySyncTotalCount başarılı</div>
                    </div>
                    <div class="ms-auto fs-1">
                        <i class="bi bi-check-circle"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-12 col-md-7">
            <div class="card oh-card">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="fw-bold">Son Siparişler</div>
                        <a class="small text-decoration-none" href="/siparisler">Tümünü Gör</a>
                    </div>

                    @if (s.RecentOrders is null || s.RecentOrders.Count == 0)
                    {
                        <div class="text-muted text-center py-4">Bugün henüz sipariş yok</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Platform</th>
                                        <th>Müşteri</th>
                                        <th class="text-end">Tutar</th>
                                        <th>Durum</th>
                                        <th class="text-end">Saat</th>
                                    </tr>
                                </thead>
                                <tbody>
                                @foreach (var o in recentOrders)
                                {
                                    var platformColor = FormatHelpers.PlatformColor(o.Platform);
                                    var orderUrl = $"/siparisler/{o.Id}";
                                    <tr style="cursor:pointer" onclick="location.href='@orderUrl'">
                                        <td>
                                            <span class="badge" style="background:@platformColor">
                                                @FormatHelpers.PlatformName(o.Platform)
                                            </span>
                                        </td>
                                        <td>@o.CustomerName</td>
                                        <td class="text-end">@FormatHelpers.TryCurrency(o.TotalAmount)</td>
                                        <td>
                                            <span class="badge @FormatHelpers.StatusBadgeClass(o.InternalStatus)">
                                                @FormatHelpers.StatusName(o.InternalStatus)
                                            </span>
                                        </td>
                                        <td class="text-end">@FormatHelpers.IstanbulTimeHHmm(o.ReceivedAt)</td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-12 col-md-5">
            <div class="card oh-card">
                <div class="card-body">
                    <div class="fw-bold mb-3">Platform Dağılımı</div>

                    @{
                        var totalOrders = platformBreakdown.Sum(x => x.OrderCount);
                    }

                    @if (totalOrders == 0)
                    {
                        <div class="text-muted text-center py-4">Veri yok</div>
                    }
                    else
                    {
                        <div class="mb-3" style="max-height:260px;">
                            <canvas id="platformChart" height="220"></canvas>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-sm mb-0">
                                <thead>
                                    <tr>
                                        <th>Platform</th>
                                        <th class="text-end">Sipariş</th>
                                        <th class="text-end">Ciro</th>
                                    </tr>
                                </thead>
                                <tbody>
                                @foreach (var p in platformBreakdown)
                                {
                                    <tr>
                                        <td>@FormatHelpers.PlatformName(p.Platform)</td>
                                        <td class="text-end">@p.OrderCount</td>
                                        <td class="text-end">@FormatHelpers.TryCurrency(p.Revenue)</td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        (() => {
            // Auto refresh every 30s if idle >= 10s and tab is active
            let lastInteraction = Date.now();
            const bump = () => lastInteraction = Date.now();
            document.addEventListener("click", bump, { passive: true });
            document.addEventListener("keydown", bump, { passive: true });
            document.addEventListener("input", bump, { passive: true });

            setInterval(() => {
                if (document.hidden) return;
                if (Date.now() - lastInteraction < 10_000) return;
                location.reload();
            }, 30_000);
        })();
    </script>

    @if (platformBreakdown.Sum(x => x.OrderCount) > 0)
    {
        <script>
            (() => {
                const el = document.getElementById("platformChart");
                if (!el) return;

                const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(platformBreakdown.Select(x => OrderHub.Web.Pages.Helpers.FormatHelpers.PlatformName(x.Platform)).ToList()));
                const values = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(platformBreakdown.Select(x => x.OrderCount).ToList()));
                const colors = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(platformBreakdown.Select(x => OrderHub.Web.Pages.Helpers.FormatHelpers.PlatformColor(x.Platform)).ToList()));

                new Chart(el, {
                    type: "doughnut",
                    data: {
                        labels: labels,
                        datasets: [{
                            data: values,
                            backgroundColor: colors,
                            borderWidth: 0
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { position: "bottom" }
                        }
                    }
                });
            })();
        </script>
    }
}

