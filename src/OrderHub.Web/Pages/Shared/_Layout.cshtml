@using OrderHub.Web.Services
@inject IOrderHubApiClient Api
@{
    var path = Context.Request.Path.Value ?? "/";
    var user = await Api.GetCurrentUserAsync();
    var userName = user?.FullName ?? "Kullanıcı";

    // MVP: customer name is derived from hostname (tenant subdomain).
    var customerName = Context.Request.Host.Host;

    string Active(string href) => path.Equals(href, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OrderHub</title>

    <script>
        (function () {
            var saved = localStorage.getItem('orderhub.layout');
            var mode = (saved === 'navbar' || saved === 'sidebar') ? saved : 'sidebar';
            document.documentElement.classList.add('layout-' + mode);
        })();
    </script>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="oh-topbar border-bottom">
        <div class="container-fluid d-flex align-items-center gap-2">
            <button class="btn btn-link d-md-none oh-hamburger" type="button" aria-label="Menüyü aç/kapat">
                <i class="bi bi-list fs-3"></i>
            </button>

            <a class="oh-logo text-decoration-none" href="/">
                <span class="fw-bold">OrderHub</span>
            </a>

            <span class="oh-customer text-muted small d-none d-sm-inline">@customerName</span>

            <nav class="oh-nav d-none d-md-flex align-items-center gap-2 ms-3">
                <a class="oh-nav-link @Active("/")" href="/"><i class="bi bi-speedometer2 me-2"></i>Panel</a>
                <a class="oh-nav-link @Active("/siparisler")" href="/siparisler"><i class="bi bi-bag me-2"></i>Siparişler</a>
                <a class="oh-nav-link @Active("/platform-baglantilari")" href="/platform-baglantilari"><i class="bi bi-plug me-2"></i>Platform Bağlantıları</a>
                <a class="oh-nav-link @Active("/ayarlar")" href="/ayarlar"><i class="bi bi-gear me-2"></i>Ayarlar</a>
            </nav>

            <div class="ms-auto d-flex align-items-center gap-2">
                <button id="layoutToggle" class="btn btn-outline-primary btn-sm" type="button">
                    <i class="bi bi-layout-sidebar-inset"></i>
                    <span class="d-none d-sm-inline ms-1">Düzen</span>
                </button>

                <div class="dropdown">
                    <button class="btn btn-light btn-sm dropdown-toggle" data-bs-toggle="dropdown" type="button">
                        <i class="bi bi-person-circle me-1"></i>@userName
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" href="/cikis"><i class="bi bi-box-arrow-right me-2"></i>Çıkış yap</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </header>

    <aside class="oh-sidebar">
        <nav class="p-3">
            <a class="oh-side-link @Active("/")" href="/"><i class="bi bi-speedometer2 me-2"></i>Panel</a>
            <a class="oh-side-link @Active("/siparisler")" href="/siparisler"><i class="bi bi-bag me-2"></i>Siparişler</a>
            <a class="oh-side-link @Active("/platform-baglantilari")" href="/platform-baglantilari"><i class="bi bi-plug me-2"></i>Platform Bağlantıları</a>
            <a class="oh-side-link @Active("/ayarlar")" href="/ayarlar"><i class="bi bi-gear me-2"></i>Ayarlar</a>
        </nav>
    </aside>

    <main class="oh-content">
        <div class="container-fluid py-4">
            @RenderBody()
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
            crossorigin="anonymous"></script>
    <script src="~/js/layout.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>