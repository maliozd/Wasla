@page "/giris"
@model OrderHub.Web.Pages.GirisModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>OrderHub - Giriş</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="oh-auth-bg d-flex align-items-center justify-content-center p-3">
    <div class="card oh-card" style="max-width:420px; width:100%;">
        <div class="card-body p-4">
            <div class="text-center mb-4">
                <div class="fw-bold" style="color: var(--orderhub-primary); font-size: 1.5rem;">OrderHub</div>
                <div class="text-muted">Giriş Yap</div>
            </div>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
            }

            <form method="post" class="vstack gap-3">
                <div>
                    <label class="form-label">E-posta</label>
                    <input class="form-control" type="email" name="Email" value="@Model.Email" required />
                </div>
                <div>
                    <label class="form-label">Şifre</label>
                    <input class="form-control" type="password" name="Password" required />
                </div>
                <button class="btn btn-primary w-100" type="submit">Giriş</button>
            </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
            crossorigin="anonymous"></script>
</body>
</html>

