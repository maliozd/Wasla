{
  "ConnectionStrings": {
    "CentralDb": "Server=(localdb)\\MSSQLLocalDB;Database=OrderHub_Central;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "DataProtection": {
    "KeyPath": "C:\\OrderHub-keys"
  },
  "Platforms": {
    "ProviderMode": "Mock"
  },
  "Platform": {
    "Yemeksepeti": {
      "BaseUrl": "https://yemeksepeti.partner.deliveryhero.io",
      "TokenPath": "/v2/oauth/token",
      "DefaultPageSize": 20,
      "RequestTimeoutSeconds": 30
    },
    "TrendyolGo": {
      "BaseUrl": "https://stageapi.tgoapis.com",
      "AgentName": "OrderHub"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.Extensions.Localization": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Microsoft.Extensions.Localization": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  }
}
