<Project Sdk="Microsoft.NET.Sdk">

	<!-- One version for the app, the service and the installer (WAS-62). -->
	<Import Project="..\Wasla.PrintBridge.Version.props" />

	<!--
		The Print Bridge Windows Service (WAS-61): the only process that polls, claims, prints and reports receipt jobs.
		It runs as NT SERVICE\WaslaPrintBridge and serves the tray/WebView2 app (Wasla.PrintBridge.exe) over a local
		named pipe. See docs/integrations/print-bridge-service.md.
	-->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
		<RootNamespace>Wasla.PrintBridge</RootNamespace>
		<AssemblyName>Wasla.PrintBridge.Service</AssemblyName>
		<Product>Wasla Print Bridge</Product>
		<Description>Wasla Print Bridge printing service.</Description>
	</PropertyGroup>

	<!--
		The same shared framework as the app (Wasla.PrintBridge.exe, Windows Forms profile), so the installer ships both
		executables in one folder on one self-contained runtime (WAS-62): with only the base framework, the two publishes carry
		different files under the same names (System.Drawing.Common, System.Diagnostics.EventLog, WindowsBase and others).
		Nothing in the service uses Windows Forms; PrintBridgeCoreBoundaryTests checks its references.
	-->
	<ItemGroup>
		<FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
		<PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
		<PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />
		<PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
		<PackageReference Include="System.IO.Pipes.AccessControl" Version="5.0.0" />
		<PackageReference Include="System.Threading.AccessControl" Version="8.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Wasla.PrintBridge.Core\Wasla.PrintBridge.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Wasla.PrintBridge.Tests" />
	</ItemGroup>

</Project>
