# /etc/wasla/secrets.env (root:root 0600). Names only; values are generated on the server and never committed,
# printed or copied into a ticket. systemd reads this file as root and passes the values to the wasla processes.
#
# Base64 of 32 random bytes. Decrypts every tenant connection string: losing it makes every tenant database
# unreachable, so keep an offline copy with the database backups' recovery material.
ENCRYPTION_MASTER_KEY=""
# Runtime CentralDb identity (waslaprod_app: db_datareader + db_datawriter on WaslaProd_Central).
# Server=127.0.0.1,1433;Database=WaslaProd_Central;User Id=waslaprod_app;Password=...;Encrypt=True;TrustServerCertificate=True
ConnectionStrings__CentralDb=""
# At least 32 printable ASCII characters without spaces; the same for Web, Api and Worker.
Realtime__Internal__Secret=""
