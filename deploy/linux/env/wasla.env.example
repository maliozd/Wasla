# /etc/wasla/wasla.env (root:root 0600). Non-secret settings shared by Web, Api, Worker and the CLI.
# Values here are the production values for the single-VDS pilot topology; they are not secrets. Keep every value
# in double quotes without $, `, " or \ inside: systemd and deploy/linux/bin/wasla-cli read the same file.
ASPNETCORE_ENVIRONMENT="Production"
DOTNET_ENVIRONMENT="Production"
DOTNET_NOLOGO="true"
DOTNET_CLI_TELEMETRY_OPTOUT="true"
# Host shutdown timeout in seconds; the units allow 40 before SIGKILL.
DOTNET_SHUTDOWNTIMEOUTSECONDS="30"

# Host roles (WAS-66): marketing, application entry; tenants are {slug}.app.wasla.tr.
Wasla__TenantOnboarding__MarketingBaseDomain="wasla.tr"
Wasla__TenantOnboarding__ApplicationBaseDomain="app.wasla.tr"
# Public signup stays closed until billing can take a payment (WAS-76); tenants are added with the CLI.
Wasla__TenantOnboarding__PublicSignupEnabled="false"
# Wasla:ApiBaseUrl has no reader; cleared so the committed localhost value is not in the effective configuration.
Wasla__ApiBaseUrl=""

# Provider mode and endpoints, explicit so they do not depend on appsettings.Production.json being loaded.
Platforms__ProviderMode="Real"
Platform__TrendyolGo__BaseUrl="https://api.tgoapis.com"
Platform__Yemeksepeti__BaseUrl="https://yemeksepeti.partner.deliveryhero.io"

# Nginx on the same host is the only proxy; it connects over IPv4 loopback.
TrustedProxies__KnownProxies__0="127.0.0.1"
TrustedProxies__ForwardLimit="1"

# Loopback channel from Worker and Api to Web (port only; the secret is in secrets.env).
Realtime__Internal__Port="5290"

# Email stays Log until SMTP credentials exist: only the recipient domain and subject are logged, nothing is sent.
Email__Provider="Log"
