# /etc/wasla/operator.env (root:root 0600). Read only by deploy/linux/bin/wasla-cli with --operator, by the release
# gate and by the backup job. Never referenced by a running service. Names only; values are generated on the server.
#
# CentralDb as waslaprod_migrator (db_owner of WaslaProd_Central). Replaces the runtime CentralDb connection
# string for migrate-central and the release gate.
WASLA_MIGRATOR_CENTRAL_DB=""
# SQL Server that receives new tenant databases (CLI add-tenant / provision-signup-request).
TenantDb__ServerInstance="127.0.0.1,1433"
# Tenant database owner (waslaprod_tenant). add-tenant creates the database as this login and stores this
# credential, encrypted, as the tenant's connection string. CREATE ANY DATABASE is granted only while a tenant is
# provisioned and revoked afterwards.
WASLA_TENANT_SQL_LOGIN="waslaprod_tenant"
WASLA_TENANT_SQL_PASSWORD=""
# Backup job identity (waslaprod_backup): db_backupoperator in WaslaProd_Central and in every tenant database, and
# CREATE ANY DATABASE, which RESTORE VERIFYONLY requires. Not used by any running service.
WASLA_BACKUP_SQL_LOGIN="waslaprod_backup"
WASLA_BACKUP_SQL_PASSWORD=""
