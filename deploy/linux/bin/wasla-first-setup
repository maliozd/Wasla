#!/usr/bin/env bash
# First deployment only (WAS-77/78): creates the four Wasla SQL logins and generates every production secret on the
# server, straight into /etc/wasla, without printing any of them. Run on a terminal; it asks for a SQL
# administrator login once (input hidden) and never stores it.
#
#   sudo wasla-first-setup <wasla.env source file>
#
# Refuses to run when a secrets file already exists or when a Wasla production database or login already exists:
# regenerating ENCRYPTION_MASTER_KEY would make every tenant database unreachable.
set -euo pipefail

etc=${WASLA_ETC:-/etc/wasla}
central=WaslaProd_Central
logins=(waslaprod_migrator waslaprod_app waslaprod_tenant waslaprod_backup)
sqlcmd=/opt/mssql-tools18/bin/sqlcmd

die() { printf 'wasla-first-setup: %s\n' "$1" >&2; exit 2; }
[[ $EUID -eq 0 ]] || die 'run with sudo.'
(( $# == 1 )) && [[ -f "$1" ]] || die 'usage: wasla-first-setup <wasla.env source file>'
for f in secrets.env operator.env; do
  [[ ! -e "$etc/$f" ]] || die "$etc/$f already exists; this script never replaces secrets."
done

read -r -p 'SQL administrator login: ' admin < /dev/tty
read -r -s -p 'SQL administrator password: ' SQLCMDPASSWORD < /dev/tty; printf '\n' > /dev/tty
export SQLCMDPASSWORD
[[ "$admin" =~ ^[A-Za-z0-9_.-]+$ ]] || die 'unexpected characters in the login name.'
sql() { "$sqlcmd" -S tcp:127.0.0.1,1433 -U "$admin" -N -C -b -h -1 -W "$@"; }

[[ "$(sql -Q 'SET NOCOUNT ON; SELECT IS_SRVROLEMEMBER(N'"'"'sysadmin'"'"');')" == 1 ]] || die 'that login is not a sysadmin.'
echo 'Existing databases (names only):'
sql -Q 'SET NOCOUNT ON; SELECT name FROM sys.databases ORDER BY name;' | sed 's/^/  /'
taken=$(sql -Q "SET NOCOUNT ON; SELECT name FROM sys.databases WHERE name = N'$central' UNION ALL SELECT name FROM sys.server_principals WHERE name IN (N'${logins[0]}', N'${logins[1]}', N'${logins[2]}', N'${logins[3]}');")
[[ -z "$taken" ]] || die "already present, nothing changed: $(echo $taken)"

password() {
  local p
  while :; do
    p=$(openssl rand -base64 48 | tr -dc 'A-Za-z0-9' | head -c 32)
    [[ ${#p} -eq 32 && "$p" =~ [A-Z] && "$p" =~ [a-z] && "$p" =~ [0-9] ]] && { printf '%s' "$p"; return; }
  done
}
declare -A pw
for l in "${logins[@]}"; do pw[$l]=$(password); done

umask 077
script=$(mktemp /run/wasla-first-setup.XXXXXXXX)
trap 'rm -f -- "$script"' EXIT
{
  echo 'SET NOCOUNT ON;'
  for l in "${logins[@]}"; do
    echo "CREATE LOGIN [$l] WITH PASSWORD = N'${pw[$l]}', CHECK_POLICY = ON, CHECK_EXPIRATION = OFF, DEFAULT_DATABASE = [master];"
  done
  # migrate-central creates CentralDb (revoked after the first deployment); the tenant owner only while a tenant is
  # provisioned (revoked after); RESTORE VERIFYONLY needs CREATE DATABASE for the backup login.
  echo "GRANT CREATE ANY DATABASE TO [waslaprod_migrator];"
  echo "GRANT CREATE ANY DATABASE TO [waslaprod_tenant];"
  echo "GRANT CREATE ANY DATABASE TO [waslaprod_backup];"
} > "$script"
sql -i "$script" >/dev/null
rm -f -- "$script"
echo "Created logins: ${logins[*]}"

cs() { printf 'Server=127.0.0.1,1433;Database=%s;User Id=%s;Password=%s;Encrypt=True;TrustServerCertificate=True' "$central" "$1" "${pw[$1]}"; }
install -o root -g root -m 0600 "$1" "$etc/wasla.env.new"
mv -f "$etc/wasla.env.new" "$etc/wasla.env"
{
  echo '# Generated by wasla-first-setup. Never print, copy into a ticket or commit these values.'
  echo "ENCRYPTION_MASTER_KEY=\"$(openssl rand -base64 32)\""
  echo "ConnectionStrings__CentralDb=\"$(cs waslaprod_app)\""
  echo "Realtime__Internal__Secret=\"$(password)$(password)\""
} > "$etc/secrets.env.new"
{
  echo '# Generated by wasla-first-setup. Read only by wasla-cli --operator, the release gate and wasla-backup.'
  echo "WASLA_MIGRATOR_CENTRAL_DB=\"$(cs waslaprod_migrator)\""
  echo 'TenantDb__ServerInstance="127.0.0.1,1433"'
  echo 'WASLA_TENANT_SQL_LOGIN="waslaprod_tenant"'
  echo "WASLA_TENANT_SQL_PASSWORD=\"${pw[waslaprod_tenant]}\""
  echo 'WASLA_BACKUP_SQL_LOGIN="waslaprod_backup"'
  echo "WASLA_BACKUP_SQL_PASSWORD=\"${pw[waslaprod_backup]}\""
} > "$etc/operator.env.new"
chmod 0600 "$etc/secrets.env.new" "$etc/operator.env.new"
mv -f "$etc/secrets.env.new" "$etc/secrets.env"
mv -f "$etc/operator.env.new" "$etc/operator.env"
unset pw SQLCMDPASSWORD
echo "Wrote $etc/wasla.env, $etc/secrets.env and $etc/operator.env (root:root 0600)."
echo 'Keep an offline copy of ENCRYPTION_MASTER_KEY with the backup recovery material.'
