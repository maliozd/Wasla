<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.3.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.10" />
  </ItemGroup>

  <!-- The engine (Wasla.PrintBridge.Core) and the desktop host (Wasla.PrintBridge) are referenced as
       real assemblies so tests exercise the shipped code rather than linked copies of its source. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Wasla.Application\Wasla.Application.csproj" />
    <ProjectReference Include="..\..\src\Wasla.Infrastructure\Wasla.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Wasla.PrintBridge.Core\Wasla.PrintBridge.Core.csproj" />
    <ProjectReference Include="..\..\src\Wasla.PrintBridge\Wasla.PrintBridge.csproj" />
  </ItemGroup>

  <!-- Same as the desktop host: the WebView2 package's WPF wrapper is unused and conflicts with WinForms (MSB3277). -->
  <Target Name="ExcludeWebView2WpfReference" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

</Project>
